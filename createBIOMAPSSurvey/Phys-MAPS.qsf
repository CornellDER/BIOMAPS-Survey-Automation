SV_af3zj2ECGkezA5o","Element":"PL","PrimaryAttribute":"Preview Link","SecondaryAttribute":null,"TertiaryAttribute":null,"Payload":{"PreviewType":"Brand","PreviewID":"4310503e-e5fb-426c-8f64-6057f8d456e5"}},{"SurveyID":"SV_af3zj2ECGkezA5o","Element":"PROJ","PrimaryAttribute":"CORE","SecondaryAttribute":null,"TertiaryAttribute":"1.1.0","Payload":{"ProjectCategory":"CORE","SchemaVersion":"1.1.0"}},{"SurveyID":"SV_af3zj2ECGkezA5o","Element":"QC","PrimaryAttribute":"Survey Question Count","SecondaryAttribute":"50","TertiaryAttribute":null,"Payload":null},{"SurveyID":"SV_af3zj2ECGkezA5o","Element":"RS","PrimaryAttribute":"RS_88ELuL9na91P39k","SecondaryAttribute":"Default Response Set","TertiaryAttribute":null,"Payload":null},{"SurveyID":"SV_af3zj2ECGkezA5o","Element":"SCO","PrimaryAttribute":"Scoring","SecondaryAttribute":null,"TertiaryAttribute":null,"Payload":{"ScoringCategories":[],"ScoringCategoryGroups":[],"ScoringSummaryCategory":null,"ScoringSummaryAfterQuestions":0,"ScoringSummaryAfterSurvey":0,"DefaultScoringCategory":null,"AutoScoringCategory":null}},{"SurveyID":"SV_af3zj2ECGkezA5o","Element":"SO","PrimaryAttribute":"Survey Options","SecondaryAttribute":null,"TertiaryAttribute":null,"Payload":{"BackButton":"true","SaveAndContinue":"true","SurveyProtection":"PublicSurvey","BallotBoxStuffingPrevention":"false","NoIndex":"Yes","SurveyExpiration":null,"SurveyTermination":"DefaultMessage","Header":"Phys-MAPS Physiology Survey","Footer":"","ProgressBarDisplay":"None","PartialData":"+1 week","ValidationMessage":null,"PreviousButton":"  <<  ","NextButton":"  >>  ","SkinLibrary":"cornell","SkinType":"MQ","Skin":"skin1_update","NewScoring":1,"PreferJFE":true,"libraryId":"","nextButtonMid":"","previousButtonMid":"","headerMid":"","footerMid":"","QuestionsPerPage":"","PageTransition":"None","ExternalCSS":null,"HighlightQuestions":"off","EOSMessage":"","ShowExportTags":"false","CollectGeoLocation":"false","SurveyTitle":"Online Survey Software | Qualtrics Survey Solutions","SurveyMetaDescription":"Qualtrics sophisticated online survey software solutions make creating online surveys easy. Learn more about Research Suite and get a free account today.","PasswordProtection":"No","AnonymizeResponse":"No","Password":"","RefererCheck":"No","RefererURL":"http:\/\/","EOSMessageLibrary":"","EOSRedirectURL":"http:\/\/","EmailThankYou":"false","ThankYouEmailMessageLibrary":null,"ThankYouEmailMessage":null,"ValidateMessage":"false","ValidationMessageLibrary":null,"InactiveSurvey":"DefaultMessage","InactiveMessageLibrary":"","InactiveMessage":"","AvailableLanguages":{"EN":[]}}},{"SurveyID":"SV_af3zj2ECGkezA5o","Element":"SQ","PrimaryAttribute":"QID1","SecondaryAttribute":"The figure below represents how three different biomolecules (V, Z, and G) are made through inter...","TertiaryAttribute":null,"Payload":{"QuestionText":"The figure below represents how three different biomolecules (V, Z, and G) are made through interconnected enzymatic pathways. Bold arrows indicate the enzymatic conversion of one molecule to another.&nbsp; For example, E is converted into S. Some of the molecules in the biosynthesis pathway also act to inhibit, or slow down, upstream enzymes, as indicated by lighter-colored arrows and (-). For example, V can inhibit the enzyme that converts T into U. All enzymes involved in this pathway will proceed at equal rates with equal energy input, unless an enzyme is inhibited. &nbsp; &nbsp;\n<div style=\"text-align: center;\"><img src=\"https:\/\/cuboulder.qualtrics.com\/CP\/Graphic.php?IM=IM_0IYYHhTnCTeHySN\" style=\"width: 400px; height: 237px;\"><\/div>\n\n<div style=\"text-align: center;\">&nbsp; &nbsp;<\/div>\n\n<div><strong>Based on this information and your knowledge about biology, evaluate each statement as <u>likely<\/u> or <u>unlikely<\/u> to be true.<\/strong><br>\n&nbsp;<\/div>","DefaultChoices":false,"DataExportTag":"Q1","QuestionType":"Matrix","Selector":"Likert","SubSelector":"SingleAnswer","Configuration":{"QuestionDescriptionOption":"UseText","TextPosition":"inline","ChoiceColumnWidthPixels":503,"RepeatHeaders":"none","WhiteSpace":"OFF","MobileFirst":true},"QuestionDescription":"The figure below represents how three different biomolecules (V, Z, and G) are made through inter...","Choices":{"1":{"Display":"B1. When [Z] is high, less Y is available to be converted to Z."},"2":{"Display":"B2. When [V] is low and [Z] is high, more of T will be converted to U than to Y."},"3":{"Display":"B3. When [T] increases, more G will be synthesized."},"4":{"Display":"B4. Production of G can be influenced by the amount of V in the system."},"5":{"Display":"B5. [V] is as equally influenced by the amount of U as it is by the amount of T."},"6":{"Display":"B6. This system includes examples of negative feedback."}},"ChoiceOrder":[1,2,3,4,"5","6"],"Validation":{"Settings":{"ForceResponse":"OFF","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"Answers":{"1":{"Display":"Likely"},"2":{"Display":"Unlikely"}},"AnswerOrder":[1,2],"ChoiceDataExportTags":false,"QuestionID":"QID1"}},{"SurveyID":"SV_af3zj2ECGkezA5o","Element":"SQ","PrimaryAttribute":"QID11","SecondaryAttribute":"In order to receive credit for taking the survey, please provide the following information:","TertiaryAttribute":null,"Payload":{"QuestionText":"In order to receive credit for taking the survey, please provide the following information:","DefaultChoices":false,"DataExportTag":"Q11","QuestionType":"TE","Selector":"FORM","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"In order to receive credit for taking the survey, please provide the following information:","Choices":{"1":{"Display":"First Name"},"2":{"Display":"Last Name"},"3":{"Display":"ID"}},"ChoiceOrder":["1","2","3"],"Validation":{"Settings":{"ForceResponse":"OFF","ForceResponseType":"ON","Type":null}},"GradingData":[],"Language":[],"QuestionID":"QID11","DataVisibility":{"Private":false,"Hidden":false},"NextChoiceId":4,"NextAnswerId":1,"SearchSource":{"AllowFreeResponse":"false"}}},{"SurveyID":"SV_af3zj2ECGkezA5o","Element":"SQ","PrimaryAttribute":"QID12","SecondaryAttribute":"Background Questions","TertiaryAttribute":null,"Payload":{"QuestionText":"<b>Background Questions<\/b>","DefaultChoices":false,"DataExportTag":"Q12","QuestionID":"QID12","QuestionType":"DB","Selector":"TB","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Background Questions","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[]}},{"SurveyID":"SV_af3zj2ECGkezA5o","Element":"SQ","PrimaryAttribute":"QID13","SecondaryAttribute":"What was your score on the AP biology exam?","TertiaryAttribute":null,"Payload":{"QuestionText":"What was your score on the AP biology exam?","DataExportTag":"Q14","QuestionType":"MC","Selector":"SAVR","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"What was your score on the AP biology exam?","Choices":{"1":{"Display":"1"},"2":{"Display":"2"},"3":{"Display":"3"},"4":{"Display":"4"},"5":{"Display":"5"},"6":{"Display":"Not sure"},"7":{"Display":"Did not take the AP biology exam"}},"ChoiceOrder":[1,2,3,"4","5","6","7"],"Validation":{"Settings":{"ForceResponse":"OFF","ForceResponseType":"ON","Type":"None"}},"Language":[],"QuestionID":"QID13","DefaultChoices":false,"GradingData":[],"SubSelector":"TX","DisplayLogic":{"0":{"0":{"LogicType":"Question","QuestionID":"QID15","QuestionIsInLoop":"no","ChoiceLocator":"q:\/\/QID15\/SelectableChoice\/1","Operator":"Selected","QuestionIDFromLocator":"QID15","LeftOperand":"q:\/\/QID15\/SelectableChoice\/1","Type":"Expression","Description":"<span class=\"ConjDesc\">If<\/span> <span class=\"QuestionDesc\">Did you take AP biology in high school?<\/span> <span class=\"LeftOpDesc\">Yes<\/span> Is <span class=\"OpDesc\">Selected<\/span> "},"Type":"If"},"Type":"BooleanExpression","inPage":false}}},{"SurveyID":"SV_af3zj2ECGkezA5o","Element":"SQ","PrimaryAttribute":"QID14","SecondaryAttribute":"What is your race\/ethnicity (select all that apply)?","TertiaryAttribute":null,"Payload":{"QuestionText":"What is your race\/ethnicity (select all that apply)?","DataExportTag":"Q16","QuestionType":"MC","Selector":"MAVR","SubSelector":"TX","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"What is your race\/ethnicity (select all that apply)?","Choices":{"1":{"Display":"Black or African American"},"2":{"Display":"Asian"},"3":{"Display":"White"},"5":{"Display":"Hispanic or Latinx"},"6":{"Display":"American Indian or Alaska Native"},"7":{"Display":"Native Hawaiian or other Pacific Islander"},"9":{"Display":"Self-describe:","TextEntry":"true"},"10":{"Display":"Prefer not to disclose"}},"ChoiceOrder":[6,2,1,5,7,3,9,"10"],"Validation":{"Settings":{"ForceResponse":"OFF","ForceResponseType":"ON","Type":"None"}},"Language":[],"QuestionID":"QID14","DataVisibility":{"Private":false,"Hidden":false},"NextChoiceId":11,"NextAnswerId":1}},{"SurveyID":"SV_af3zj2ECGkezA5o","Element":"SQ","PrimaryAttribute":"QID15","SecondaryAttribute":"Did you take AP biology in high school?","TertiaryAttribute":null,"Payload":{"QuestionText":"Did you take AP biology in high school?","DataExportTag":"Q17","QuestionType":"MC","Selector":"SAVR","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Did you take AP biology in high school?","Choices":{"1":{"Display":"Yes"},"2":{"Display":"No"}},"ChoiceOrder":["1","2"],"Validation":{"Settings":{"ForceResponse":"OFF","ForceResponseType":"ON","Type":"None"}},"Language":[],"QuestionID":"QID15","DefaultChoices":false,"GradingData":[],"SubSelector":"TX"}},{"SurveyID":"SV_af3zj2ECGkezA5o","Element":"SQ","PrimaryAttribute":"QID16","SecondaryAttribute":"Are you 18 years of age or older?","TertiaryAttribute":null,"Payload":{"QuestionText":"Are you 18 years of age or older?","DataExportTag":"Q18","QuestionType":"MC","Selector":"SAVR","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Are you 18 years of age or older?","Choices":{"1":{"Display":"Yes"},"2":{"Display":"No"}},"ChoiceOrder":["1","2"],"Validation":{"Settings":{"ForceResponse":"OFF","ForceResponseType":"ON","Type":"None"}},"Language":[],"QuestionID":"QID16","DefaultChoices":false,"GradingData":[],"SubSelector":"TX"}},{"SurveyID":"SV_af3zj2ECGkezA5o","Element":"SQ","PrimaryAttribute":"QID17","SecondaryAttribute":"What is your current class standing?","TertiaryAttribute":null,"Payload":{"QuestionText":"What is your current class standing?","DataExportTag":"Q19","QuestionType":"MC","Selector":"SAVR","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"What is your current class standing?","Choices":{"1":{"Display":"First year"},"2":{"Display":"Sophomore"},"3":{"Display":"Junior"},"4":{"Display":"Senior"},"5":{"Display":"Postbacclaureate"},"6":{"Display":"Graduate Student"},"7":{"Display":"Other","TextEntry":"true"}},"ChoiceOrder":["1","2","3","4","5","6","7"],"Validation":{"Settings":{"ForceResponse":"OFF","ForceResponseType":"ON","Type":"None"}},"Language":[],"QuestionID":"QID17","DefaultChoices":false,"GradingData":[],"SubSelector":"TX"}},{"SurveyID":"SV_af3zj2ECGkezA5o","Element":"SQ","PrimaryAttribute":"QID19","SecondaryAttribute":"Are you a transfer student?","TertiaryAttribute":null,"Payload":{"QuestionText":"Are you a transfer student?","DataExportTag":"Q21","QuestionType":"MC","Selector":"SAVR","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Are you a transfer student?","Choices":{"1":{"Display":"Yes"},"2":{"Display":"No"}},"ChoiceOrder":["1","2"],"Validation":{"Settings":{"ForceResponse":"OFF","ForceResponseType":"ON","Type":"None"}},"Language":[],"QuestionID":"QID19","DefaultChoices":false,"GradingData":[],"SubSelector":"TX"}},{"SurveyID":"SV_af3zj2ECGkezA5o","Element":"SQ","PrimaryAttribute":"QID2","SecondaryAttribute":"The cell depicted to the right is a fictional cell. There is a positive charge along the interior...","TertiaryAttribute":null,"Payload":{"QuestionText":"<img src=\"https:\/\/cuboulder.qualtrics.com\/CP\/Graphic.php?IM=IM_5mXoFLcVwE543rL\" style=\"width: 300px; height: 272px; float: right;\" \/>The cell depicted to the right is a fictional cell. There is a positive charge along the interior side of the membrane and negative along the exterior. The cell membrane has chemically-gated magnesium (Mg<sup>++<\/sup>) and zinc (Zn<sup>++<\/sup>) channels that allow passive and specific movement of ions across the membrane when open. The cell <em>does not<\/em> have leakage channels, or any other channels in the membrane. &nbsp;\n<div><br \/>\nAssume the diagram represents the baseline state of the cell and that dots and circles represent the proportional concentrations of the ions.<br \/>\n<br \/>\n<strong>Based on this information and your knowledge about biology, evaluate each statement as <u>likely<\/u> or <u>unlikely<\/u> to be true.<\/strong><\/div>","DefaultChoices":false,"DataExportTag":"Q2","QuestionType":"Matrix","Selector":"Likert","SubSelector":"SingleAnswer","Configuration":{"QuestionDescriptionOption":"UseText","TextPosition":"inline","ChoiceColumnWidthPixels":504,"RepeatHeaders":"none","WhiteSpace":"OFF","MobileFirst":true},"QuestionDescription":"The cell depicted to the right is a fictional cell. There is a positive charge along the interior...","Choices":{"1":{"Display":"C1. Based only on the <em>concentration<\/em> gradient across the membrane of this cell, Zn<sup>++<\/sup> will move into the cell when its channels open."},"2":{"Display":"C2. Based only on the <em>electrical<\/em> gradient across the membrane of this cell, Zn<sup>++<\/sup> will move into the cell when its channels open."},"4":{"Display":"C3. There is more energy stored in the Mg<sup>++<\/sup> concentration gradient than in the Zn<sup>++<\/sup> concentration gradient."},"6":{"Display":"C4. In general, normal mammalian cell types have a separation of positive and negative charges across the cell membrane."},"7":{"Display":"C5. Proteins can diffuse directly and freely across cell membranes, like the one shown above."},"8":{"Display":"C6. Proteins&nbsp;can use open ion channels to move across the membrane."}},"ChoiceOrder":[1,2,4,6,"7","8"],"Validation":{"Settings":{"ForceResponse":"OFF","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"Answers":{"1":{"Display":"Likely"},"2":{"Display":"Unlikely"}},"AnswerOrder":[1,2],"ChoiceDataExportTags":false,"QuestionID":"QID2"}},{"SurveyID":"SV_af3zj2ECGkezA5o","Element":"SQ","PrimaryAttribute":"QID21","SecondaryAttribute":"The figure below depicts a typical gut epithelial cell of the small intestine. In the diagram, ar...","TertiaryAttribute":null,"Payload":{"QuestionText":"The figure below depicts a typical gut epithelial cell of the small intestine. In the diagram, arrows indicate the direction of flow of various molecules into or out of the cell when the associated transporter is active. Only water can move freely between sides A and B. &nbsp;Sodium from the extracellular fluid on Side B cannot move into the gut on Side A.\n<div>&nbsp;\n<div style=\"text-align: center;\"><img src=\"https:\/\/cuboulder.qualtrics.com\/CP\/Graphic.php?IM=IM_9oSLPqPRZFtdJfn\" style=\"width: 399px; height: 231px;\" \/><\/div>\n\n<div><br \/>\n&nbsp;<\/div>\n\n<div><strong>Based on this information and your knowledge about biology, evaluate each statement as <u>likely<\/u> or <u>unlikely<\/u> to be true.<\/strong><\/div>\n<\/div>","DefaultChoices":false,"DataExportTag":"Q21","QuestionType":"Matrix","Selector":"Likert","SubSelector":"SingleAnswer","Configuration":{"QuestionDescriptionOption":"UseText","TextPosition":"inline","ChoiceColumnWidthPixels":514,"RepeatHeaders":"none","WhiteSpace":"OFF","MobileFirst":true},"QuestionDescription":"The figure below depicts a typical gut epithelial cell of the small intestine. In the diagram, ar...","Choices":{"1":{"Display":"J1. Energy from the movement of Na<sup>+<\/sup> is used to move glucose into the cell."},"2":{"Display":"J2. Na<sup>+<\/sup> can move into the cell using the Na<sup>+<\/sup>\/Gluc transporter even without glucose."},"3":{"Display":"J3. Slowing down the Na<sup>+<\/sup>\/K<sup>+<\/sup> pump will decrease how much glucose enters the cell."},"4":{"Display":"J4. Because fructose does not get transported with Na<sup>+<\/sup>, the fructose transporter will require ATP."},"5":{"Display":"J5. Increasing Na<sup>+<\/sup> concentration inside the gut will move glucose into the cell faster."},"6":{"Display":"J6. This single gut cell can respond to a diet high or low in glucose by changing the number of transporters in its membrane."}},"ChoiceOrder":["1","2","3","4","5","6"],"Validation":{"Settings":{"ForceResponse":"OFF","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"Answers":{"1":{"Display":"Likely"},"3":{"Display":"Unlikely"}},"AnswerOrder":["1","3"],"ChoiceDataExportTags":false,"QuestionID":"QID21"}},{"SurveyID":"SV_af3zj2ECGkezA5o","Element":"SQ","PrimaryAttribute":"QID22","SecondaryAttribute":"Most animals, including laboratory mice,\u00a0experience pain from the venom of bark scorpions. Pain o..","TertiaryAttribute":null,"Payload":{"QuestionText":"<div><img src=\"https:\/\/cuboulder.qualtrics.com\/CP\/Graphic.php?IM=IM_9uTaO32R4e49GW9\" style=\"width: 299px; height: 303px; float: right;\" \/>Most animals, including laboratory mice,&nbsp;experience pain from the venom of bark scorpions. Pain occurs when the venom binds to Type A sodium channels on pain neurons, causing the pain neurons to increase their firing rate.<\/div>\n\n<div>\n<div><br \/>\nGrasshopper mice, however, regularly eat bark scorpions without intense pain from the venom. In grasshopper mice, the scorpion venom also binds to Type A sodium channels on pain neurons. However, in addition, the venom also binds Type B sodium channels on pain neurons. Because Type B channels have the opposite effect on neuron firing, the two signals counteract each other and prevent the pain neuron from firing to signal pain. While other animals, like laboratory mice, also have Type B sodium channels, only the Type B channel of the grasshopper mice can bind venom and stop the pain signal.<\/div>\n\n<div>\n<div><br \/>\n<strong>Based on this information and your knowledge about biology, evaluate each statement as <u>likely<\/u> or <u>unlikely<\/u> to be true.<\/strong><\/div>\n<\/div>\n<\/div>","DefaultChoices":false,"DataExportTag":"Q22","QuestionType":"Matrix","Selector":"Likert","SubSelector":"SingleAnswer","Configuration":{"QuestionDescriptionOption":"UseText","TextPosition":"inline","ChoiceColumnWidthPixels":514,"RepeatHeaders":"none","WhiteSpace":"OFF","MobileFirst":true},"QuestionDescription":"Most animals, including laboratory mice,\u00a0experience pain from the venom of bark scorpions. Pain o...","Choices":{"1":{"Display":"W1. The structural difference in the grasshopper mouse\u2019s Type B sodium channel that allows it to bind venom is equally likely to be on the extracellular side of channel as the intracellular side of the channel."},"2":{"Display":"W2. In a single individual, if a new mutation were to occur in the gene encoding the Type B channel, it would be equally likely to be in any part of the gene."},"3":{"Display":"W3. The grasshopper mouse\u2019s version of the Type B channel first appeared because the mouse needed to prevent the venom from being painful."},"4":{"Display":"W4. Even if grasshopper mice did not encounter scorpions, this new Type B channel could have arisen."},"5":{"Display":"W5. Even if grasshopper mice colonize a new area where they no longer eat scorpions, future generations may still have the allele for the new Type B channel."},"7":{"Display":"W6. Even though the Type B sodium channel of <u>laboratory<\/u> mice does not bind venom, the channel still has a function in pain signaling in laboratory mice."}},"ChoiceOrder":["1","2","3","4","5","7"],"Validation":{"Settings":{"ForceResponse":"OFF","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"Answers":{"1":{"Display":"Likely"},"3":{"Display":"Unlikely"}},"AnswerOrder":["1","3"],"ChoiceDataExportTags":false,"QuestionID":"QID22"}},{"SurveyID":"SV_af3zj2ECGkezA5o","Element":"SQ","PrimaryAttribute":"QID24","SecondaryAttribute":"Note: You may choose to leave any or all of these questions blank.\u00a0 Your answers will be used to...","TertiaryAttribute":null,"Payload":{"QuestionText":"<p><span style=\"font-family:&quot;Times New Roman&quot;\"><span style=\"font-size:16px;\"><span style=\"font-family:arial,helvetica,sans-serif;\">Note: You may choose to leave any or all of these questions blank.&nbsp; Your answers will be used to better understand characteristics of students taking this survey.&nbsp;&nbsp;<\/span><\/span><o:p><\/o:p><\/span><\/p>","DefaultChoices":false,"DataExportTag":"Q24","QuestionType":"DB","Selector":"TB","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Note: You may choose to leave any or all of these questions blank.\u00a0 Your answers will be used to...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"QuestionID":"QID24"}},{"SurveyID":"SV_af3zj2ECGkezA5o","Element":"SQ","PrimaryAttribute":"QID25","SecondaryAttribute":"What other types of institutions have you attended? (Select all that apply.)","TertiaryAttribute":null,"Payload":{"QuestionText":"What other types of institutions have you attended? (Select all that apply.)","DataExportTag":"Q25","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"What other types of institutions have you attended? (Select all that apply.)","Choices":{"1":{"Display":"Two-year college or community college"},"2":{"Display":"Four-year college or university"},"3":{"Display":"Other","TextEntry":"true"}},"ChoiceOrder":["1","2","3"],"Validation":{"Settings":{"ForceResponse":"OFF","ForceResponseType":"ON","Type":"None"}},"Language":[],"QuestionID":"QID25","DisplayLogic":{"0":{"0":{"LogicType":"Question","QuestionID":"QID19","QuestionIsInLoop":"no","ChoiceLocator":"q:\/\/QID19\/SelectableChoice\/1","Operator":"Selected","QuestionIDFromLocator":"QID19","LeftOperand":"q:\/\/QID19\/SelectableChoice\/1","Type":"Expression","Description":"<span class=\"ConjDesc\">If<\/span> <span class=\"QuestionDesc\">Are you a transfer student?<\/span> <span class=\"LeftOpDesc\">Yes<\/span> Is <span class=\"OpDesc\">Selected<\/span> "},"Type":"If"},"Type":"BooleanExpression","inPage":false}}},{"SurveyID":"SV_af3zj2ECGkezA5o","Element":"SQ","PrimaryAttribute":"QID26","SecondaryAttribute":"Approximately how many biology-related lecture courses have you taken, including any in which are...","TertiaryAttribute":null,"Payload":{"QuestionText":"Approximately how many <strong><em>biology<\/em><\/strong>-related lecture courses have you taken, including any in which are currently enrolled?","DefaultChoices":false,"DataExportTag":"Q26","QuestionID":"QID26","QuestionType":"TE","Selector":"SL","Configuration":{"QuestionDescriptionOption":"UseText","InputWidth":50},"QuestionDescription":"Approximately how many biology-related lecture courses have you taken, including any in which are...","Validation":{"Settings":{"ForceResponse":"OFF","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[]}},{"SurveyID":"SV_af3zj2ECGkezA5o","Element":"SQ","PrimaryAttribute":"QID27","SecondaryAttribute":"Have you declared, or are you planning to declare, a major in physiology?","TertiaryAttribute":null,"Payload":{"QuestionText":"Have you declared, or are you planning to declare, a major in <b><i>physiology<\/i><\/b>?","DataExportTag":"Q27","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Have you declared, or are you planning to declare, a major in physiology?","Choices":{"1":{"Display":"Yes"},"2":{"Display":"No"}},"ChoiceOrder":["1","2"],"Validation":{"Settings":{"ForceResponse":"OFF","ForceResponseType":"ON","Type":"None"}},"Language":[],"QuestionID":"QID27"}},{"SurveyID":"SV_af3zj2ECGkezA5o","Element":"SQ","PrimaryAttribute":"QID28","SecondaryAttribute":"Please check the sub discipline(s) of biology in which you have taken the most courses?","TertiaryAttribute":null,"Payload":{"QuestionText":"Please check the sub discipline(s) of biology in which you have taken the most courses?","DataExportTag":"Q28","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Please check the sub discipline(s) of biology in which you have taken the most courses?","Choices":{"1":{"Display":"Molecular\/Cell Biology"},"2":{"Display":"Physiology"},"3":{"Display":"Ecology\/Evolution"},"4":{"Display":"No specialization\/equal exposure"}},"ChoiceOrder":["1","2","3","4"],"Validation":{"Settings":{"ForceResponse":"OFF","ForceResponseType":"ON","Type":"None"}},"Language":[],"QuestionID":"QID28"}},{"SurveyID":"SV_af3zj2ECGkezA5o","Element":"SQ","PrimaryAttribute":"QID29","SecondaryAttribute":"What is your approximate current overall G.P.A.?","TertiaryAttribute":null,"Payload":{"QuestionText":"What is your approximate current overall G.P.A.?","DataExportTag":"Q29","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"What is your approximate current overall G.P.A.?","Choices":{"1":{"Display":"0.0 - 0.69 (E or F)"},"2":{"Display":"0.7 - 1.69 (D- to D+)"},"3":{"Display":"1.7 - 2.69 (C- to C+)"},"4":{"Display":"2.7 - 3.69 (B- to B+)"},"5":{"Display":"3.7 - 4.00 (A- to A+)"}},"ChoiceOrder":["1","2","3","4","5"],"Validation":{"Settings":{"ForceResponse":"OFF","ForceResponseType":"ON","Type":"None"}},"Language":[],"QuestionID":"QID29"}},{"SurveyID":"SV_af3zj2ECGkezA5o","Element":"SQ","PrimaryAttribute":"QID3","SecondaryAttribute":"A diabetic patient takes an insulin shot to manage her glucose levels. Insulin, a hydrophilic pep...","TertiaryAttribute":null,"Payload":{"QuestionText":"<p><span style=\"font-size:11.0pt;font-family:Arial;mso-fareast-font-family:Cambria;\nmso-fareast-theme-font:minor-latin\">A diabetic patient takes an insulin shot to\nmanage her glucose levels. Insulin, a hydrophilic peptide, enters a vein in\nher leg. It eventually reaches the liver, where the insulin molecules bind to\nmembrane receptors on the cells of her liver. The insulin causes increased\nglucose transport from the blood into the liver cells. Insulin receptors are\nalso found in many other tissues, including muscle and fat tissue.<\/span><span style=\"font-size:11.0pt;font-family:Arial;mso-fareast-font-family:Cambria;\nmso-fareast-theme-font:minor-latin;mso-bidi-language:EN-US\"><o:p><\/o:p><\/span><\/p>\n\n<p><strong><span style=\"font-size:11.0pt;font-family:\nArial;mso-fareast-font-family:Cambria;mso-fareast-theme-font:minor-latin\"><br><\/span><\/strong><\/p><p><strong><span style=\"font-size:11.0pt;font-family:\nArial;mso-fareast-font-family:Cambria;mso-fareast-theme-font:minor-latin\">Based\non this information and your knowledge about biology, evaluate each statement\nas <u>likely<\/u> or <u>unlikely<\/u> to be true.<o:p><\/o:p><\/span><\/strong><\/p>","DefaultChoices":false,"DataExportTag":"Q3","QuestionType":"Matrix","Selector":"Likert","SubSelector":"SingleAnswer","Configuration":{"QuestionDescriptionOption":"UseText","TextPosition":"inline","ChoiceColumnWidth":25,"RepeatHeaders":"none","WhiteSpace":"OFF","MobileFirst":true,"ChoiceColumnWidthPixels":504},"QuestionDescription":"A diabetic patient takes an insulin shot to manage her glucose levels. Insulin, a hydrophilic pep...","Choices":{"1":{"Display":"E1. Insulin molecules injected into a leg muscle will pass through the heart at least once before they can reach the liver."},"2":{"Display":"E2. When there is more than one path to the liver, the circulatory system will direct the insulin through the shortest possible path."},"3":{"Display":"E3. Even if a cell does not have an insulin receptor, it will still have a gene for the insulin receptor."},"4":{"Display":"E4. Considering the whole body, insulin injected into the body can influence the function of organs even if the cells of those organs do not have insulin receptors."},"5":{"Display":"E5. In a non-diabetic person, insulin's action to increase glucose transport into liver cells is part of a negative feedback system."},"6":{"Display":"E6. Peptide hormones other than insulin, but with the same structure as insulin, could activate receptors in the cytoplasm of a cell."}},"ChoiceOrder":[1,2,3,4,5,6],"Validation":{"Settings":{"ForceResponse":"OFF","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"Answers":{"1":{"Display":"Likely"},"2":{"Display":"Unlikely"}},"AnswerOrder":[1,2],"ChoiceDataExportTags":false,"QuestionID":"QID3"}},{"SurveyID":"SV_af3zj2ECGkezA5o","Element":"SQ","PrimaryAttribute":"QID30","SecondaryAttribute":"Gender","TertiaryAttribute":null,"Payload":{"QuestionText":"Gender","DataExportTag":"Q30","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Gender","Choices":{"1":{"Display":"Female"},"2":{"Display":"Male"},"3":{"Display":"Self-describe:","TextEntry":"true"},"4":{"Display":"Prefer not to disclose"}},"ChoiceOrder":["1","2","3","4"],"Validation":{"Settings":{"ForceResponse":"OFF","ForceResponseType":"ON","Type":"None"}},"Language":[],"QuestionID":"QID30","DataVisibility":{"Private":false,"Hidden":false},"NextChoiceId":5,"NextAnswerId":1}},{"SurveyID":"SV_af3zj2ECGkezA5o","Element":"SQ","PrimaryAttribute":"QID31","SecondaryAttribute":"Did you speak English at home when you were growing up?","TertiaryAttribute":null,"Payload":{"QuestionText":"Did you speak English at home when you were growing up?","DataExportTag":"Q31","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Did you speak English at home when you were growing up?","Choices":{"1":{"Display":"Yes"},"2":{"Display":"No"}},"ChoiceOrder":["1","2"],"Validation":{"Settings":{"ForceResponse":"OFF","ForceResponseType":"ON","Type":"None"}},"Language":[],"QuestionID":"QID31"}},{"SurveyID":"SV_af3zj2ECGkezA5o","Element":"SQ","PrimaryAttribute":"QID32","SecondaryAttribute":"What language did you speak at home?","TertiaryAttribute":null,"Payload":{"QuestionText":"What language did you speak at home?","DefaultChoices":false,"DataExportTag":"Q32","QuestionType":"TE","Selector":"SL","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"What language did you speak at home?","Validation":{"Settings":{"ForceResponse":"OFF","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"QuestionID":"QID32","DisplayLogic":{"0":{"0":{"LogicType":"Question","QuestionID":"QID31","QuestionIsInLoop":"no","ChoiceLocator":"q:\/\/QID31\/SelectableChoice\/2","Operator":"Selected","QuestionIDFromLocator":"QID31","LeftOperand":"q:\/\/QID31\/SelectableChoice\/2","Type":"Expression","Description":"<span class=\"ConjDesc\">If<\/span> <span class=\"QuestionDesc\">Did you speak English at home when you were growing up?<\/span> <span class=\"LeftOpDesc\">No<\/span> Is <span class=\"OpDesc\">Selected<\/span> "},"Type":"If"},"Type":"BooleanExpression","inPage":false}}},{"SurveyID":"SV_af3zj2ECGkezA5o","Element":"SQ","PrimaryAttribute":"QID33","SecondaryAttribute":"Highest level of education completed by at least one of your parent(s):","TertiaryAttribute":null,"Payload":{"QuestionText":"Highest level of education completed by at least one of your parent(s):","DataExportTag":"Q33","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Highest level of education completed by at least one of your parent(s):","Choices":{"1":{"Display":"Did not complete high school"},"2":{"Display":"High school \/ GED"},"3":{"Display":"Some college (but did not complete college)"},"4":{"Display":"Associate's degree (2-year degree)"},"5":{"Display":"Bachelor's degree"},"6":{"Display":"Master's degree"},"7":{"Display":"Advanced graduate degree (for example, DVM, MD, PhD)"},"8":{"Display":"Not sure"}},"ChoiceOrder":["1","2","3","4","5","6","7","8"],"Validation":{"Settings":{"ForceResponse":"OFF","ForceResponseType":"ON","Type":"None"}},"Language":[],"QuestionID":"QID33"}},{"SurveyID":"SV_af3zj2ECGkezA5o","Element":"SQ","PrimaryAttribute":"QID34","SecondaryAttribute":"Please think about the test you just completed. Mark the answer that best represents how you feel...","TertiaryAttribute":null,"Payload":{"QuestionText":"<p>Please think about the test you just completed. Mark the answer that best represents how you feel about statements 1 through 5 below.&nbsp;<\/p>","DefaultChoices":false,"DataExportTag":"Q34","QuestionType":"Matrix","Selector":"Likert","SubSelector":"SingleAnswer","Configuration":{"QuestionDescriptionOption":"UseText","TextPosition":"inline","ChoiceColumnWidthPixels":327,"RepeatHeaders":"none","WhiteSpace":"OFF","MobileFirst":true},"QuestionDescription":"Please think about the test you just completed. Mark the answer that best represents how you feel...","Choices":{"1":{"Display":"1. I engaged in good effort throughout this test."},"2":{"Display":"2. I gave my best effort on this test."},"3":{"Display":"3. While taking this test, I could have worked harder on it."},"4":{"Display":"4. I did not give this test my full attention while completing it."},"5":{"Display":"5. While taking this test, I was able to persist to completion of the task."}},"ChoiceOrder":["1","2","3","4","5"],"Validation":{"Settings":{"ForceResponse":"OFF","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"Answers":{"1":{"Display":"Strongly Disagree"},"2":{"Display":"Disagree"},"3":{"Display":"Neutral"},"4":{"Display":"Agree"},"5":{"Display":"Strongly Agree"}},"AnswerOrder":["1","2","3","4","5"],"ChoiceDataExportTags":false,"QuestionID":"QID34"}},{"SurveyID":"SV_af3zj2ECGkezA5o","Element":"SQ","PrimaryAttribute":"QID37","SecondaryAttribute":"When the body detects infection or injury, it activates a general immune response, including infl...","TertiaryAttribute":null,"Payload":{"QuestionText":"When the body detects infection or injury, it activates a general immune response, including inflammation and release of molecules called cytokines. As part of turning the immune response off, specialized sensory neurons can detect the presence of cytokines and initiate a neural signal to the brain. From the sensory neuron, the signal can pass through multiple parallel pathways. The signal can be passed from a sensory neuron to multiple interneurons. From each interneuron, the signal can be passed to V-neurons, and then to S-neurons. S-neurons then release norepinephrine (NE) from their axon terminals onto T-cells. The T-cells then release acetylcholine (ACh) that binds to receptors on the cytokine-containing macrophages, causing them to decrease their cytokine release.<br \/>\n<br \/>\nAssume each neural signal is excitatory.&nbsp;<br \/>\n&nbsp;\n<div style=\"text-align: center;\"><img src=\"https:\/\/cuboulder.qualtrics.com\/CP\/Graphic.php?IM=IM_baAG1vt2TR28tx3\" style=\"width: 600px; height: 108px;\" \/><\/div>\n&nbsp;\n\n<div><br \/>\n<strong>Based on this information and your knowledge about biology, evaluate each statement as <u>likely<\/u> or <u>unlikely<\/u> to be true<\/strong><strong>.<\/strong><\/div>","DefaultChoices":false,"DataExportTag":"Q38","QuestionType":"Matrix","Selector":"Likert","SubSelector":"SingleAnswer","Configuration":{"QuestionDescriptionOption":"UseText","TextPosition":"inline","ChoiceColumnWidth":25,"ChoiceColumnWidthPixels":514,"RepeatHeaders":"none","WhiteSpace":"OFF","MobileFirst":true},"QuestionDescription":"When the body detects infection or injury, it activates a general immune response, including infl...","Choices":{"1":{"Display":"V1. T-cells have NE receptors."},"2":{"Display":"V2. The neurotransmitter released by the axon of the V1 neuron can affect other cells outside of the immediate area of the S1 neuron."},"3":{"Display":"V3. For T-cells with twice as many NE receptors, more NE is required to initiate ACh release."},"4":{"Display":"V4. Other neural inputs to V neurons are present but not shown."},"5":{"Display":"V5. The interneuron can send signals back to the sensory neuron."}},"ChoiceOrder":[1,2,3,4,5],"Validation":{"Settings":{"ForceResponse":"OFF","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"Answers":{"1":{"Display":"Likely"},"2":{"Display":"Unlikely"}},"AnswerOrder":[1,2],"ChoiceDataExportTags":false,"QuestionID":"QID37"}},{"SurveyID":"SV_af3zj2ECGkezA5o","Element":"SQ","PrimaryAttribute":"QID38","SecondaryAttribute":"When a mosquito bites an animal and sucks up blood, it takes in a large amount of extra fluid. Th...","TertiaryAttribute":null,"Payload":{"QuestionText":"<p>When a mosquito bites an animal and sucks up blood, it takes in a large amount of extra fluid. The fluid enters the insect\u2019s gut and moves into the insect\u2019s body fluid surrounding its cells. Excess water from the body fluid is then removed from the body through specialized excretion tubes via the following process:<br>\n&nbsp;<br>\n1) After the mosquito ingests the blood, a sensor detects extra fluid in the body.<br>\n2) The sensor signals to other cells to release diuretic hormone (DH) into the body fluid.<br>\n3) DH binds to DH-receptors on the cells lining the excretion tubes.<br>\n4) DH-receptor activation initiates a cellular response ending with the <strong>passive<\/strong> movement of potassium (K<sup>+<\/sup>) ions and chloride (Cl<sup>-<\/sup>) ions into the excretion tubes.<br>\n5) Water flows via osmosis from the body fluid into the excretion tubes.<br>\n6) Once there is no more excess body fluid, DH release stops.<b><br><\/b><\/p><p><strong><br><\/strong><\/p><p><strong>Based on this information and your knowledge about biology, evaluate each statement as <u>likely<\/u> or <u>unlikely<\/u> to be true.&nbsp;&nbsp;<\/strong><br>\n<strong><span style=\"font-size:11.0pt;font-family:Arial\"><o:p><\/o:p><\/span><\/strong><\/p>","DefaultChoices":false,"DataExportTag":"Q40","QuestionType":"Matrix","Selector":"Likert","SubSelector":"SingleAnswer","Configuration":{"QuestionDescriptionOption":"UseText","TextPosition":"inline","ChoiceColumnWidth":25,"ChoiceColumnWidthPixels":512,"RepeatHeaders":"none","WhiteSpace":"OFF","MobileFirst":true},"QuestionDescription":"When a mosquito bites an animal and sucks up blood, it takes in a large amount of extra fluid. Th...","Choices":{"1":{"Display":"Z1. DH is regulated to keep DH levels within a specific range."},"2":{"Display":"Z2. The sensor constantly monitors the amount of body fluid regardless of whether the mosquito is feeding or not."},"3":{"Display":"Z3. Initially, there is a Cl<sup>-<\/sup> concentration gradient from high in the body fluid to low inside the excretion tube."},"4":{"Display":"Z4. A second hormone, not mentioned by name in this example, is needed to stop the process."},"6":{"Display":"Z5. Samples of excretion tube cells taken before and immediately after a meal will contain approximately the same number of <u>DH receptors<\/u>."},"7":{"Display":"Z6. If a problem caused too much potassium and chloride to be excreted, the mosquito could become dehydrated."}},"ChoiceOrder":[1,2,3,4,6,7],"Validation":{"Settings":{"ForceResponse":"OFF","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"Answers":{"1":{"Display":"Likely"},"2":{"Display":"Unlikely"}},"AnswerOrder":[1,2],"ChoiceDataExportTags":false,"QuestionID":"QID38"}},{"SurveyID":"SV_af3zj2ECGkezA5o","Element":"SQ","PrimaryAttribute":"QID39","SecondaryAttribute":"Approximately how many physiology-related lecture courses have you taken, including any in which...","TertiaryAttribute":null,"Payload":{"QuestionText":"<span style=\"color: rgb(51, 51, 51); font-family: sans-serif, Arial, Verdana, 'Trebuchet MS'; font-size: 13px;\">Approximately how many <b><i>physiology<\/i><\/b>-related lecture courses have you taken, including any in which are currently enrolled?<\/span>","DefaultChoices":false,"DataExportTag":"Q41","QuestionID":"QID39","QuestionType":"TE","Selector":"SL","Configuration":{"QuestionDescriptionOption":"UseText","InputWidth":50},"QuestionDescription":"Approximately how many physiology-related lecture courses have you taken, including any in which...","Validation":{"Settings":{"ForceResponse":"OFF","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[]}},{"SurveyID":"SV_af3zj2ECGkezA5o","Element":"SQ","PrimaryAttribute":"QID4","SecondaryAttribute":"Under normal conditions, a cell like the one depicted to the right continuously exports iron (Fe3...","TertiaryAttribute":null,"Payload":{"QuestionText":"<div><img src=\"https:\/\/cuboulder.qualtrics.com\/CP\/Graphic.php?IM=IM_09rOMHgOC0vuPlj\" style=\"width: 199px; height: 218px; float: right;\" \/>Under normal conditions, a cell like the one depicted to the right continuously exports iron (Fe<sup>3+<\/sup>) out of the cell and into the blood. However, under certain conditions, iron export is kept near zero. To reduce iron export from a normal level to zero, Hormone H is released into the blood and can then bind to R<sub>H<\/sub> receptors on these cells, resulting in the <strong><em>decrease <\/em><\/strong>of iron export to the blood. When low levels of iron in the blood are detected elsewhere, hormone H production <strong><em>increases<\/em><\/strong>.<\/div>\n&nbsp;<br \/>\nMeanwhile, a nearby population of cells that also export iron have an altered version of the R<sub>H<\/sub> receptor. The altered receptor (R<sub>H2<\/sub>) has the same extracellular structure but a different intracellular structure.<br \/>\n&nbsp;<br \/>\nIn the diagram, shapes of the receptor, hormone H, and molecule T represent general structural similarity\/dissimilarity.&nbsp;<br \/>\n<br \/>\n<strong>Based on this information and your knowledge about biology, evaluate each statement as <u>likely<\/u> or <u>unlikely <\/u>to be true.&nbsp;&nbsp;<\/strong>","DefaultChoices":false,"DataExportTag":"Q4","QuestionType":"Matrix","Selector":"Likert","SubSelector":"SingleAnswer","Configuration":{"QuestionDescriptionOption":"UseText","TextPosition":"inline","ChoiceColumnWidthPixels":504,"RepeatHeaders":"none","WhiteSpace":"OFF","MobileFirst":true},"QuestionDescription":"Under normal conditions, a cell like the one depicted to the right continuously exports iron (Fe3...","Choices":{"1":{"Display":"G1. The suppression of iron export is an example of negative feedback."},"3":{"Display":"G2. With hormone H levels constant, a cell with twice as many R<sub>H<\/sub> receptors will be more likely to respond to hormone H."},"4":{"Display":"G3. Molecule T can bind R<sub>H."},"5":{"Display":"G4. The altered form of the receptor, R<sub>H2<\/sub>, can bind hormone H."},"6":{"Display":"G5. Cells with the altered form of the receptor, R<sub>H2<\/sub>, will have the same response to hormone H as cells with R<sub>H<\/sub>."}},"ChoiceOrder":[1,3,4,5,6],"Validation":{"Settings":{"ForceResponse":"OFF","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"Answers":{"1":{"Display":"Likely"},"2":{"Display":"Unlikely"}},"AnswerOrder":[1,2],"ChoiceDataExportTags":false,"QuestionID":"QID4"}},{"SurveyID":"SV_af3zj2ECGkezA5o","Element":"SQ","PrimaryAttribute":"QID40","SecondaryAttribute":"Have you declared, or are you planning to declare, a major in\u00a0biology?","TertiaryAttribute":null,"Payload":{"QuestionText":"Have you declared, or are you planning to declare, a major in&nbsp;<strong><em>biology<\/em><\/strong>?","DataExportTag":"Q42","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Have you declared, or are you planning to declare, a major in\u00a0biology?","Choices":{"1":{"Display":"Yes"},"2":{"Display":"No"}},"ChoiceOrder":["1","2"],"Validation":{"Settings":{"ForceResponse":"OFF","ForceResponseType":"ON","Type":"None"}},"Language":[],"QuestionID":"QID40","DisplayLogic":{"0":{"0":{"LogicType":"Question","QuestionID":"QID27","QuestionIsInLoop":"no","ChoiceLocator":"q:\/\/QID27\/SelectableChoice\/2","Operator":"Selected","QuestionIDFromLocator":"QID27","LeftOperand":"q:\/\/QID27\/SelectableChoice\/2","Type":"Expression","Description":"<span class=\"ConjDesc\">If<\/span> <span class=\"QuestionDesc\">Have you declared, or are you planning to declare, a major in physiology?<\/span> <span class=\"LeftOpDesc\">No<\/span> Is <span class=\"OpDesc\">Selected<\/span> "},"Type":"If"},"Type":"BooleanExpression","inPage":false}}},{"SurveyID":"SV_af3zj2ECGkezA5o","Element":"SQ","PrimaryAttribute":"QID41","SecondaryAttribute":"Have you declared, or are you planning to declare, a physiology or physiology-related concentrati...","TertiaryAttribute":null,"Payload":{"QuestionText":"Have you declared, or are you planning to declare, a physiology or physiology-related <i>concentration<\/i>&nbsp;within your biology major?","DataExportTag":"Q43","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Have you declared, or are you planning to declare, a physiology or physiology-related concentrati...","Choices":{"1":{"Display":"Yes"},"2":{"Display":"No"}},"DisplayLogic":{"0":{"0":{"LogicType":"Question","QuestionID":"QID40","QuestionIsInLoop":"no","ChoiceLocator":"q:\/\/QID40\/SelectableChoice\/1","Operator":"Selected","QuestionIDFromLocator":"QID40","LeftOperand":"q:\/\/QID40\/SelectableChoice\/1","Type":"Expression","Description":"<span class=\"ConjDesc\">If<\/span> <span class=\"QuestionDesc\">Have you declared, or are you planning to declare, a major in&amp;nbsp;biology?<\/span> <span class=\"LeftOpDesc\">Yes<\/span> Is <span class=\"OpDesc\">Selected<\/span> "},"Type":"If"},"Type":"BooleanExpression","inPage":false},"ChoiceOrder":["1","2"],"Validation":{"Settings":{"ForceResponse":"OFF","ForceResponseType":"ON","Type":"None"}},"Language":[],"QuestionID":"QID41"}},{"SurveyID":"SV_af3zj2ECGkezA5o","Element":"SQ","PrimaryAttribute":"QID44","SecondaryAttribute":"\u200bParticipant Informed Consent Form \u00a0 You are invited to participate in a collaborative research p","TertiaryAttribute":null,"Payload":{"QuestionText":"<strong>\u200bParticipant Informed Consent Form<\/strong> &nbsp;\n<p>You are invited to participate in a collaborative research project being led by Prof. Michelle Smith, a faculty member in the Department of Ecology and Evolutionary Biology at Cornell University. The purpose of this research is to gauge student understanding of fundamental biology concepts.<br \/>\n&nbsp;<br \/>\n<strong>What we will ask you to do:<\/strong> This survey poses a number of questions asking you to reason about fundamental biology concepts. The primary purpose of the survey is for your instructor(s) and department to evaluate the effectiveness of their biology courses. This consent form asks for your permission to use your responses for additional research purposes.<br \/>\n&nbsp;<\/p>\n\n<p><strong>Risks and discomforts:<\/strong> We do not anticipate any risks from participating in this research.<br \/>\n&nbsp;<\/p>\n\n<p><strong>Benefits:<\/strong> There are no direct benefits other than the opportunity to learn, practice some new material, and contribute to future instructional innovations in biology education.<br \/>\n&nbsp;<\/p>\n\n<p><strong>Compensation for participation:<\/strong> You will either receive course credit or no compensation for your participation. If your instructor has assigned course credit for completing this survey, you must provide your name and student ID information at the end of the survey to receive this credit.<br \/>\n&nbsp;<\/p>\n\n<p><strong>Privacy\/Confidentiality\/Data Security:<\/strong> Your identifying information will be kept with your survey data for the purposes of matching survey responses. Your instructor will have access to your responses at the end of semester\/quarter. Your identity will never be associated with your responses publicly.<br \/>\n&nbsp;<\/p>\n\n<p><strong>Taking part is voluntary:<\/strong> You may choose whether to consent to having your survey data used for research purposes. Participation credit (if your instructor has assigned such credit) does not depend on any specific answers you provide in the survey or on whether you consent to have your answers used in research. You may complete this survey for your instructor without consenting to participate in the research. You must complete this survey for your instructor to obtain participation credit in your course (if applicable).<br \/>\n&nbsp;<\/p>\n\n<p><strong>If you have questions:<\/strong> If you have any questions about this study, please contact Prof. Michelle Smith (mks274@cornell.edu).<\/p>","DefaultChoices":false,"QuestionType":"DB","Selector":"TB","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"\u200bParticipant Informed Consent Form \u00a0 You are invited to participate in a collaborative research p...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionText_Unsafe":"<div style=\"text-align: center;\">\u200b<strong>Participant Informed Consent Form<\/strong><\/div>\n&nbsp;<br \/>\nYou are invited to participate in a research project being conducted by Michelle Smith, Natasha Holmes, and Cole Walsh (Cornell University), Sara Brownell and Christian Wright (Arizona State University), Brian Couch (University Nebraska-Lincoln), Alison Crowe (University of Washington), Jennifer Knight and Kate Semsar (University of Colorado-Boulder), and Mindi Summers (University of Calgary).&nbsp; The purpose of this research is to gauge student understanding of fundamental biology concepts.&nbsp; You are invited to participate in this study because you are enrolled in an undergraduate biology course.&nbsp;&nbsp;&nbsp;<br \/>\n&nbsp;<br \/>\n<strong>What Will You Be Asked to Do?<\/strong><br \/>\n&nbsp;<br \/>\nIf you decide to participate, your instructor or program will be ask you to complete the assessment as part of your normal course or program requirements.&nbsp; The assessment is expected to take roughly 30-60 minutes and will take place at a location determined by your course instructor or departmental representative. This consent form asks for your permission to use your responses for additional research purposes.<br \/>\n&nbsp;<br \/>\n<strong>Risks:<\/strong><br \/>\n<br \/>\nThere are no known risks or discomforts associated with this research other than the use of your time and that you may be inconvenienced.<br \/>\n&nbsp;<br \/>\n<strong>Benefits:<\/strong><br \/>\n<br \/>\nThere are no direct benefits to you as a research participant.&nbsp; Your responses may help improve your department&rsquo;s biology curriculum.<br \/>\n&nbsp;<br \/>\n<strong>Compensation:<\/strong><br \/>\n<br \/>\nCredit for completing this survey will be determined by your course instructor or departmental representative.&nbsp; You will receive no additional benefit by choosing to release your responses for research purposes.<br \/>\n&nbsp;<br \/>\n<strong>Confidentiality:<br \/>\n&nbsp; &nbsp;&nbsp;<\/strong><br \/>\nPrior to research analyses, a member of the research team will de-identify your responses by replacing your name with a unique code.&nbsp; A list of names and codes will be stored separately in a locked file cabinet in a researcher&rsquo;s office.&nbsp; Research data will be kept until the project is complete.&nbsp; Information obtained in this study may be published in scientific journals or presented at scientific meetings.&nbsp; Such data will always be reported in de-identified or aggregated formats.<br \/>\n&nbsp;<br \/>\n<strong>Voluntary:<\/strong><br \/>\n<br \/>\nParticipation in this study is voluntary.&nbsp; If you choose to take part in this study, you may stop at any time. You may skip any questions you do not wish to answer. You can refuse to allow your responses to be released for research purposes without harming your relationship with your course instructor\/departmental representative or your institution, or in any other way receive a penalty or loss of benefits to which you are otherwise entitled.<br \/>\n&nbsp;<br \/>\n<strong>Contact Information:<\/strong><br \/>\n<br \/>\nIf you have questions about this study, please ask your course instructor\/departmental representative or contact Dr. Michelle Smith at mks274@cornell.edu.&nbsp;<br \/>\n&nbsp;<br \/>\n<strong>Consent, Right to Receive a Copy:<\/strong><br \/>\n\u200b<br \/>\nYou are voluntarily making a decision whether or not to participate in this research study. &nbsp;Your agreement with the statement below certifies that you have decided to participate having read and understood the information presented. &nbsp;You may print a copy of this consent form to keep.","DataExportTag":"Q44","QuestionID":"QID44","DataVisibility":{"Private":false,"Hidden":false}}},{"SurveyID":"SV_af3zj2ECGkezA5o","Element":"SQ","PrimaryAttribute":"QID45","SecondaryAttribute":"\u200bPlease check one answer for each question:","TertiaryAttribute":null,"Payload":{"QuestionText":"<strong>\u200bPlease check one answer for each question:<\/strong>","DefaultChoices":false,"QuestionType":"DB","Selector":"TB","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"\u200bPlease check one answer for each question:","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionText_Unsafe":"<strong>\u200bPlease check one answer for each question:<\/strong>","DataExportTag":"Q45","QuestionID":"QID45"}},{"SurveyID":"SV_af3zj2ECGkezA5o","Element":"SQ","PrimaryAttribute":"QID46","SecondaryAttribute":"Statement of Consent","TertiaryAttribute":null,"Payload":{"QuestionText":"<strong>Statement of Consent<\/strong>","QuestionType":"MC","Selector":"MAVR","SubSelector":"TX","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Statement of Consent","Choices":{"5":{"Display":"I have read and understood the above information. I consent to take part in the study."}},"ChoiceOrder":["5"],"Validation":{"Settings":{"ForceResponse":"OFF","ForceResponseType":"ON","Type":"None"}},"Language":[],"NextChoiceId":7,"NextAnswerId":1,"QuestionText_Unsafe":"I agree to have my survey responses released for research purposes.","DataExportTag":"Q46","QuestionID":"QID46","DataVisibility":{"Private":false,"Hidden":false}}},{"SurveyID":"SV_af3zj2ECGkezA5o","Element":"SQ","PrimaryAttribute":"QID47","SecondaryAttribute":"Are you over 18?","TertiaryAttribute":null,"Payload":{"QuestionText":"Are you over 18?","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Are you over 18?","Choices":{"5":{"Display":"Yes"},"6":{"Display":"No"}},"ChoiceOrder":["5","6"],"Validation":{"Settings":{"ForceResponse":"OFF","ForceResponseType":"ON","Type":"None"}},"Language":[],"NextChoiceId":7,"NextAnswerId":1,"QuestionText_Unsafe":"Are you over 18?","DataExportTag":"Q47","QuestionID":"QID47"}},{"SurveyID":"SV_af3zj2ECGkezA5o","Element":"SQ","PrimaryAttribute":"QID48","SecondaryAttribute":"Click to write the question text","TertiaryAttribute":null,"Payload":{"QuestionText":"Click to write the question text","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Click to write the question text","Choices":{"1":{"Display":"Click to write Choice 1"},"2":{"Display":"Click to write Choice 2"},"3":{"Display":"Click to write Choice 3"}},"ChoiceOrder":["1","2","3"],"Validation":{"Settings":{"ForceResponse":"OFF","ForceResponseType":"ON","Type":"None"}},"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionText_Unsafe":"Click to write the question text","DataExportTag":"Q48","QuestionID":"QID48"}},{"SurveyID":"SV_af3zj2ECGkezA5o","Element":"SQ","PrimaryAttribute":"QID49","SecondaryAttribute":"Timing","TertiaryAttribute":null,"Payload":{"QuestionText":"Timing","DefaultChoices":false,"QuestionType":"Timing","Selector":"PageTimer","Configuration":{"QuestionDescriptionOption":"UseText","MinSeconds":"0","MaxSeconds":"0"},"QuestionDescription":"Timing","Choices":{"1":{"Display":"First Click"},"2":{"Display":"Last Click"},"3":{"Display":"Page Submit"},"4":{"Display":"Click Count"}},"GradingData":[],"Language":[],"NextChoiceId":16,"NextAnswerId":1,"QuestionText_Unsafe":"Timing","DataExportTag":"Q49","QuestionID":"QID49"}},{"SurveyID":"SV_af3zj2ECGkezA5o","Element":"SQ","PrimaryAttribute":"QID5","SecondaryAttribute":"You are studying the mechanism of a new herbal supplement that is being used to enhance muscle co...","TertiaryAttribute":null,"Payload":{"QuestionText":"<p>You are studying the mechanism of a new herbal supplement that is being used to enhance muscle contraction in people. Normally, neural stimulation of muscle cells opens calcium channels on the storage organelle membrane, resulting in the passive diffusion of calcium into the cytoplasm of the muscle cell. With calcium present in the cytoplasm, the muscle cell shortens. Then calcium reuptake pumps return calcium to the storage organelle, stopping the muscle cell contraction. The herbal supplement binds to these calcium reuptake pumps and prevents them from returning calcium into the storage organelle, resulting in calcium remaining in the cytoplasm and continued contraction of the muscle cell.&nbsp;<br \/>\n&nbsp;<\/p>\n\n<p style=\"text-align: center;\"><img src=\"https:\/\/cuboulder.qualtrics.com\/CP\/Graphic.php?IM=IM_equ9s74RNkKtyMl\" style=\"width: 600px; height: 124px;\" \/><\/p>\n\n<p><br \/>\n<strong>Based on this information and your knowledge about biology, evaluate each statement as <u>likely<\/u> or <u>unlikely<\/u> to be true.&nbsp;<\/strong><br \/>\n<br \/>\n<em><strong><o:p><\/o:p><\/strong><\/em><\/p>","DefaultChoices":false,"DataExportTag":"Q5","QuestionType":"Matrix","Selector":"Likert","SubSelector":"SingleAnswer","Configuration":{"QuestionDescriptionOption":"UseText","TextPosition":"inline","ChoiceColumnWidthPixels":513,"RepeatHeaders":"none","WhiteSpace":"OFF","MobileFirst":true},"QuestionDescription":"You are studying the mechanism of a new herbal supplement that is being used to enhance muscle co...","Choices":{"2":{"Display":"H2. After calcium moves into the cytoplasm, the concentrations of calcium inside and outside of the organelle are more similar."},"3":{"Display":"H3. After a single neural signal results in some calcium moving into the cytoplasm, energy is required to move the calcium back into the storage organelle."},"4":{"Display":"H4. With the reuptake pumps blocked, continued neural stimulation will result in further diffusion of calcium into the cytoplasm until all the calcium has left the organelle."},"6":{"Display":"H5. The types and numbers of channels in the muscle cell membrane will be similar to those in the storage organelle membrane."},"7":{"Display":"H6. When the muscle cell shortens, filament molecules inside of the muscle cell shorten."},"8":{"Display":"H1. If the supplement is similar in structure to a non-polar fatty acid chain, it will be able to reach the reuptake pumps by diffusing directly across the cell membrane."}},"ChoiceOrder":["8",2,3,4,6,7],"Validation":{"Settings":{"ForceResponse":"OFF","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"Answers":{"1":{"Display":"Likely"},"2":{"Display":"Unlikely"}},"AnswerOrder":[1,2],"ChoiceDataExportTags":false,"QuestionID":"QID5"}},{"SurveyID":"SV_af3zj2ECGkezA5o","Element":"SQ","PrimaryAttribute":"QID50","SecondaryAttribute":"Reminder: If your instructor has assigned course credit for completing this survey, you must prov...","TertiaryAttribute":null,"Payload":{"QuestionText":"<p>Reminder: If your instructor has assigned course credit for completing this survey, you must provide your name and student ID information <strong>at the end of the survey<\/strong> to receive this credit, independent of consenting to participate in the research study.<\/p>\n\n<p>&nbsp;<\/p>\nIf you have any questions or concerns regarding your rights as a subject in this study, you may contact the Institutional Review Board (IRB) for Human Participants at 607-255-6182 or access their website at http:\/\/www.irb.cornell.edu. You may also report your concerns or complaints anonymously through Ethicspoint online at www.hotline.cornell.edu or by calling toll free at 1-866-293-3077. Ethicspoint is an independent organization that serves as a liaison between the University and the person bringing the complaint so that anonymity can be ensured.","DefaultChoices":false,"DataExportTag":"Q41","QuestionType":"DB","Selector":"TB","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Reminder: If your instructor has assigned course credit for completing this survey, you must prov...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID50"}},{"SurveyID":"SV_af3zj2ECGkezA5o","Element":"SQ","PrimaryAttribute":"QID6","SecondaryAttribute":"The diagram below shows the effects of two neurotransmitters and two drugs that regulate blood pr...","TertiaryAttribute":null,"Payload":{"QuestionText":"<p><span style=\"font-size:11.0pt;font-family:Arial\">The diagram below shows the effects of two neurotransmitters and two drugs that regulate blood pressure. In a normal state, neural signals keep the blood vessel partially constricted. Neurotransmitters NT-A and NT-X activate their respective pathways in muscle cells to modify the degree of blood vessel constriction. Drug A binds to receptor A and <em>activates<\/em> it. Drug Z binds to receptor Z <em>to prevent<\/em> NT-Z from binding but does not activate the receptor on its own.<br \/>\n<br \/>\nAssume equal number of receptors, equal binding affinities, equal magnitude of signal responses, and the absence of drugs, unless otherwise noted.<\/span><br \/>\n&nbsp;<\/p>\n\n<p style=\"text-align: center;\"><img src=\"https:\/\/cuboulder.qualtrics.com\/CP\/Graphic.php?IM=IM_8qqXbH2nA3kwjEp\" style=\"width: 598px; height: 254px;\" \/><\/p>\n\n<p><br \/>\n<strong><span style=\"font-size:11.0pt;font-family:Arial\">Based on this information and your knowledge about biology, evaluate each statement as <u>likely<\/u> or <u>unlikely<\/u> to be true.&nbsp;<\/span><\/strong><\/p>","DefaultChoices":false,"DataExportTag":"Q6","QuestionType":"Matrix","Selector":"Likert","SubSelector":"SingleAnswer","Configuration":{"QuestionDescriptionOption":"UseText","TextPosition":"inline","ChoiceColumnWidthPixels":516,"RepeatHeaders":"none","WhiteSpace":"OFF","MobileFirst":true},"QuestionDescription":"The diagram below shows the effects of two neurotransmitters and two drugs that regulate blood pr...","Choices":{"2":{"Display":"I1. If NT-A and NT-Z are both present in equal concentrations and no drugs are present, blood vessels will dilate."},"3":{"Display":"I2. With neither NT-A nor NT-Z present, adding Drug A would constrict blood vessels."},"4":{"Display":"I3. With neither NT-A nor NT-Z present, adding Drug Z would dilate blood vessels."},"5":{"Display":"I4. With both NT-A and NT-Z present in equal concentrations, adding Drug Z would constrict blood vessels."},"7":{"Display":"I5. Receptor A can only be activated if NT-A is present."},"10":{"Display":"I6. Drug Z could be given to a patient to reduce chronically high blood pressure."}},"ChoiceOrder":[2,3,4,5,"7","10"],"Validation":{"Settings":{"ForceResponse":"OFF","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"Answers":{"1":{"Display":"LIkely"},"2":{"Display":"Unlikely"}},"AnswerOrder":[1,2],"ChoiceDataExportTags":false,"QuestionID":"QID6"}},{"SurveyID":"SV_af3zj2ECGkezA5o","Element":"SQ","PrimaryAttribute":"QID7","SecondaryAttribute":"Overnight, you can lose several pounds from water loss. Water loss occurs: in the nose, where air...","TertiaryAttribute":null,"Payload":{"QuestionText":"<p>Overnight, you can lose several pounds from water loss. Water loss occurs:<\/p>\n\n<ul>\n\t<li>in the nose, where air is humidified as it passes to the lungs.<\/li>\n\t<li>at the skin, as a cooling mechanism to maintain constant body temperature.<\/li>\n\t<li>during the first morning urination from water&rsquo;s movement through the kidney.<\/li>\n<\/ul>\n\n<p>Each pathway can, under the right circumstances, contribute to a measurable amount of water loss from the body.<br \/>\n<br \/>\n<strong>Based on this information and your knowledge about biology, evaluate each statement as <u>likely<\/u> or <u>unlikely<\/u> to be true.&nbsp;<\/strong><br \/>\n<strong><span style=\"font-size:11.0pt;font-family:Arial\"><o:p><\/o:p><\/span><\/strong><\/p>","DefaultChoices":false,"DataExportTag":"Q7","QuestionType":"Matrix","Selector":"Likert","SubSelector":"SingleAnswer","Configuration":{"QuestionDescriptionOption":"UseText","TextPosition":"inline","ChoiceColumnWidthPixels":515,"RepeatHeaders":"none","WhiteSpace":"OFF","MobileFirst":true},"QuestionDescription":"Overnight, you can lose several pounds from water loss. Water loss occurs: in the nose, where air...","Choices":{"1":{"Display":"K1. Overnight, increased sweating will decrease the amount of water lost through the nasal cavities."},"2":{"Display":"K2. Overnight, increased sweating will decrease the amount of urine produced."},"3":{"Display":"K3. Overnight, sleeping in a humid room will decrease water lost through the nasal cavities."},"7":{"Display":"K5. The kidney only filters blood coming directly from the heart."},"8":{"Display":"K4. After accounting for all three sources of water loss, increasing the amount of water lost through the nasal passages will also result in more water lost overall."}},"ChoiceOrder":[1,2,3,"8","7"],"Validation":{"Settings":{"ForceResponse":"OFF","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"Answers":{"1":{"Display":"Likely"},"2":{"Display":"Unlikely"}},"AnswerOrder":[1,2],"ChoiceDataExportTags":false,"QuestionID":"QID7"}},{"SurveyID":"SV_af3zj2ECGkezA5o","Element":"SQ","PrimaryAttribute":"QID8","SecondaryAttribute":"When fats and proteins are detected in the small intestine, a hormone called CCK is released from...","TertiaryAttribute":null,"Payload":{"QuestionText":"When fats and proteins are detected in the small intestine, a hormone called CCK is released from the small intestine into the blood. When CCK molecules reach the gall bladder, there are two separate actions that together cause the release of bile into the intestine to help digest fats. 1) Some CCK molecules bind to receptors on muscle cell membranes in the gall bladder wall, causing those muscle cells to <em>contract<\/em>. 2) Some CCK molecules bind to receptors on muscle cell membranes of the gall bladder sphincter, causing those muscle cells to <em>relax<\/em>. When fats and proteins are no longer detected in the intestine, CCK levels return to normal.\n<div>&nbsp;<\/div><div>\n<strong>Based on this information and your knowledge about biology, evaluate each statement as <u>likely<\/u> or <u>unlikely<\/u> to be true.&nbsp;<\/strong><\/div>","DefaultChoices":false,"DataExportTag":"Q8","QuestionType":"Matrix","Selector":"Likert","SubSelector":"SingleAnswer","Configuration":{"QuestionDescriptionOption":"UseText","TextPosition":"inline","ChoiceColumnWidthPixels":501,"RepeatHeaders":"none","WhiteSpace":"OFF","MobileFirst":true},"QuestionDescription":"When fats and proteins are detected in the small intestine, a hormone called CCK is released from...","Choices":{"2":{"Display":"F2. Even without fats and proteins in the small intestine, injecting CCK into the blood will result in bile being released into the gut."},"4":{"Display":"F3. It is possible the two types of muscle cells have the same CCK receptor type."},"5":{"Display":"F4. Any cells in the body that have CCK receptors will either contract or relax in the presence of CCK."},"6":{"Display":"F1. The body has a sensor to establish if there is too much or too little CCK in the blood."},"7":{"Display":"F5. The CCK released from the small intestine into the blood can reach organs all over the body."}},"ChoiceOrder":["6",2,4,5,"7"],"Validation":{"Settings":{"ForceResponse":"OFF","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"Answers":{"1":{"Display":"Likely"},"2":{"Display":"Unlikely"}},"AnswerOrder":[1,2],"ChoiceDataExportTags":false,"QuestionID":"QID8"}},{"SurveyID":"SV_af3zj2ECGkezA5o","Element":"STAT","PrimaryAttribute":"Survey Statistics","SecondaryAttribute":null,"TertiaryAttribute":null,"Payload":{"MobileCompatible":true,"ID":"Survey Statistics"}}]}
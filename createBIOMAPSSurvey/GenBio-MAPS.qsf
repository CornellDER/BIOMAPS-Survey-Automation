tion","QuestionID":"QID177","QuestionIsInLoop":"no","ChoiceLocator":"q:\/\/QID177\/SelectableChoice\/1","Operator":"Selected","QuestionIDFromLocator":"QID177","LeftOperand":"q:\/\/QID177\/SelectableChoice\/1","Type":"Expression","Description":"<span class=\"ConjDesc\">If<\/span> <span class=\"QuestionDesc\">Are you a Transfer\nStudent?<\/span> <span class=\"LeftOpDesc\">&lt;span style=\"font-size:16px;\"&gt;&lt;span style=\"font-family:times new roman,times,serif;\"&gt;Yes&lt;\/span&gt;&lt;\/span&gt;<\/span> Is <span class=\"OpDesc\">Selected<\/span> "},"Type":"If"},"Type":"BooleanExpression","inPage":false}}},{"SurveyID":"SV_dnk8xGmFyNl56Dk","Element":"SQ","PrimaryAttribute":"QID290","SecondaryAttribute":"Timing","TertiaryAttribute":null,"Payload":{"QuestionText":"Timing","DefaultChoices":false,"DataExportTag":"T-Trans","QuestionType":"Timing","Selector":"PageTimer","Configuration":{"QuestionDescriptionOption":"UseText","MinSeconds":"0","MaxSeconds":"0"},"QuestionDescription":"Timing","Choices":{"1":{"Display":"First Click"},"2":{"Display":"Last Click"},"3":{"Display":"Page Submit"},"4":{"Display":"Click Count"}},"GradingData":[],"Language":[],"QuestionID":"QID290"}},{"SurveyID":"SV_dnk8xGmFyNl56Dk","Element":"SQ","PrimaryAttribute":"QID291","SecondaryAttribute":"Did you take AP Biology in high school?","TertiaryAttribute":null,"Payload":{"QuestionText":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Did you take AP Biology in high school?<\/span><\/span>","DataExportTag":"AP","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Did you take AP Biology in high school?","Choices":{"1":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Yes<\/span><\/span>"},"2":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">No<\/span><\/span>"}},"ChoiceOrder":["1","2"],"Validation":{"Settings":{"ForceResponse":"OFF","ForceResponseType":"ON","Type":"None"}},"Language":[],"QuestionID":"QID291"}},{"SurveyID":"SV_dnk8xGmFyNl56Dk","Element":"SQ","PrimaryAttribute":"QID292","SecondaryAttribute":"Timing","TertiaryAttribute":null,"Payload":{"QuestionText":"Timing","DefaultChoices":false,"DataExportTag":"T-AP","QuestionType":"Timing","Selector":"PageTimer","Configuration":{"QuestionDescriptionOption":"UseText","MinSeconds":"0","MaxSeconds":"0"},"QuestionDescription":"Timing","Choices":{"1":{"Display":"First Click"},"2":{"Display":"Last Click"},"3":{"Display":"Page Submit"},"4":{"Display":"Click Count"}},"GradingData":[],"Language":[],"QuestionID":"QID292"}},{"SurveyID":"SV_dnk8xGmFyNl56Dk","Element":"SQ","PrimaryAttribute":"QID293","SecondaryAttribute":"What was your score on the AP Biology exam?","TertiaryAttribute":null,"Payload":{"QuestionText":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">What was your score on the AP Biology exam?<\/span><\/span>","DataExportTag":"AP+","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"What was your score on the AP Biology exam?","Choices":{"1":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">1<\/span><\/span>"},"2":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">2<\/span><\/span>"},"3":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">3<\/span><\/span>"},"4":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">4<\/span><\/span>"},"5":{"Display":"<span style=\"font-family:times new roman,times,serif;\"><span style=\"font-size:16px;\">5<\/span><\/span>"},"6":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Not sure<\/span><\/span>"},"7":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Did not take the AP Biology exam<\/span><\/span>"}},"ChoiceOrder":["1","2","3","4","5","6","7"],"Validation":{"Settings":{"ForceResponse":"OFF","ForceResponseType":"ON","Type":"None"}},"Language":[],"QuestionID":"QID293","DisplayLogic":{"0":{"0":{"LogicType":"Question","QuestionID":"QID291","QuestionIsInLoop":"no","ChoiceLocator":"q:\/\/QID291\/SelectableChoice\/1","Operator":"Selected","QuestionIDFromLocator":"QID291","LeftOperand":"q:\/\/QID291\/SelectableChoice\/1","Type":"Expression","Description":"<span class=\"ConjDesc\">If<\/span> <span class=\"QuestionDesc\">Did you take AP biology in high school?<\/span> <span class=\"LeftOpDesc\">&lt;span style=\"font-size:16px;\"&gt;&lt;span style=\"font-family:times new roman,times,serif;\"&gt;Yes&lt;\/span&gt;&lt;\/span&gt;<\/span> Is <span class=\"OpDesc\">Selected<\/span> "},"Type":"If"},"Type":"BooleanExpression","inPage":false}}},{"SurveyID":"SV_dnk8xGmFyNl56Dk","Element":"SQ","PrimaryAttribute":"QID294","SecondaryAttribute":"Have you declared or are you planning to declare a major in biology or another life science?","TertiaryAttribute":null,"Payload":{"QuestionText":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Have you declared or are you planning to declare a major in biology or another life science?<\/span><\/span>","DataExportTag":"Maj","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Have you declared or are you planning to declare a major in biology or another life science?","Choices":{"1":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Yes<\/span><\/span>"},"2":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">No<\/span><\/span>"}},"ChoiceOrder":["1","2"],"Validation":{"Settings":{"ForceResponse":"OFF","ForceResponseType":"ON","Type":"None"}},"Language":[],"QuestionID":"QID294","RecodeValues":{"1":"1","2":"2"}}},{"SurveyID":"SV_dnk8xGmFyNl56Dk","Element":"SQ","PrimaryAttribute":"QID295","SecondaryAttribute":"Click to write the question text","TertiaryAttribute":null,"Payload":{"QuestionText":"Click to write the question text","DefaultChoices":false,"DataExportTag":"Q120","QuestionType":"DB","Selector":"TB","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Click to write the question text","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID295"}},{"SurveyID":"SV_dnk8xGmFyNl56Dk","Element":"SQ","PrimaryAttribute":"QID296","SecondaryAttribute":"\u200bParticipant Informed Consent Form\u00a0 You are invited to participate in a collaborative research pr","TertiaryAttribute":null,"Payload":{"QuestionText":"<strong>\u200bParticipant Informed Consent Form&nbsp; <\/strong><br \/>\n<br \/>\n<br \/>\nYou are invited to participate in a collaborative research project being led by Prof. Michelle Smith, a faculty member in the Department of Ecology and Evolutionary Biology at Cornell University. The purpose of this research is to gauge student understanding of fundamental biology concepts.\n<p>&nbsp;<br \/>\n<strong>What we will ask you to do:<\/strong> This survey poses a number of questions asking you to reason about fundamental biology concepts. The primary purpose of the survey is for your instructor(s) and department to evaluate the effectiveness of their biology courses. This consent form asks for your permission to use your responses for additional research purposes.<br \/>\n&nbsp;<\/p>\n\n<p><strong>Risks and discomforts:<\/strong> We do not anticipate any risks from participating in this research.<br \/>\n&nbsp;<\/p>\n\n<p><strong>Benefits:<\/strong> There are no direct benefits other than the opportunity to learn, practice some new material, and contribute to future instructional innovations in biology education.<br \/>\n&nbsp;<\/p>\n\n<p><strong>Compensation for participation:<\/strong> You will either receive course credit or no compensation for your participation. If your instructor has assigned course credit for completing this survey, you must provide your name and student ID information at the end of the survey to receive this credit.<br \/>\n&nbsp;<\/p>\n\n<p><strong>Privacy\/Confidentiality\/Data Security:<\/strong> Your identifying information will be kept with your survey data for the purposes of matching survey responses. Your instructor will have access to your responses at the end of semester\/quarter. Your identity will never be associated with your responses publicly.<br \/>\n&nbsp;<\/p>\n\n<p><strong>Taking part is voluntary:<\/strong> You may choose whether to consent to having your survey data used for research purposes. Participation credit (if your instructor has assigned such credit) does not depend on any specific answers you provide in the survey or on whether you consent to have your answers used in research. You may complete this survey for your instructor without consenting to participate in the research. You must complete this survey for your instructor to obtain participation credit in your course (if applicable).<\/p>\n\n<p>&nbsp;<\/p>\n\n<p><strong>If you have questions:<\/strong> If you have any questions about this study, please contact Prof. Michelle Smith (mks274@cornell.edu).<\/p>","DefaultChoices":false,"QuestionType":"DB","Selector":"TB","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"\u200bParticipant Informed Consent Form\u00a0 You are invited to participate in a collaborative research pr...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionText_Unsafe":"<div style=\"text-align: center;\">\u200b<strong>Participant Informed Consent Form<\/strong><\/div>\n&nbsp;<br \/>\nYou are invited to participate in a research project being conducted by Michelle Smith, Natasha Holmes, and Cole Walsh (Cornell University), Sara Brownell and Christian Wright (Arizona State University), Brian Couch (University Nebraska-Lincoln), Alison Crowe (University of Washington), Jennifer Knight and Kate Semsar (University of Colorado-Boulder), and Mindi Summers (University of Calgary).&nbsp; The purpose of this research is to gauge student understanding of fundamental biology concepts.&nbsp; You are invited to participate in this study because you are enrolled in an undergraduate biology course.&nbsp;&nbsp;&nbsp;<br \/>\n&nbsp;<br \/>\n<strong>What Will You Be Asked to Do?<\/strong><br \/>\n&nbsp;<br \/>\nIf you decide to participate, your instructor or program will be ask you to complete the assessment as part of your normal course or program requirements.&nbsp; The assessment is expected to take roughly 30-60 minutes and will take place at a location determined by your course instructor or departmental representative. This consent form asks for your permission to use your responses for additional research purposes.<br \/>\n&nbsp;<br \/>\n<strong>Risks:<\/strong><br \/>\n<br \/>\nThere are no known risks or discomforts associated with this research other than the use of your time and that you may be inconvenienced.<br \/>\n&nbsp;<br \/>\n<strong>Benefits:<\/strong><br \/>\n<br \/>\nThere are no direct benefits to you as a research participant.&nbsp; Your responses may help improve your department&rsquo;s biology curriculum.<br \/>\n&nbsp;<br \/>\n<strong>Compensation:<\/strong><br \/>\n<br \/>\nCredit for completing this survey will be determined by your course instructor or departmental representative.&nbsp; You will receive no additional benefit by choosing to release your responses for research purposes.<br \/>\n&nbsp;<br \/>\n<strong>Confidentiality:<br \/>\n&nbsp; &nbsp;&nbsp;<\/strong><br \/>\nPrior to research analyses, a member of the research team will de-identify your responses by replacing your name with a unique code.&nbsp; A list of names and codes will be stored separately in a locked file cabinet in a researcher&rsquo;s office.&nbsp; Research data will be kept until the project is complete.&nbsp; Information obtained in this study may be published in scientific journals or presented at scientific meetings.&nbsp; Such data will always be reported in de-identified or aggregated formats.<br \/>\n&nbsp;<br \/>\n<strong>Voluntary:<\/strong><br \/>\n<br \/>\nParticipation in this study is voluntary.&nbsp; If you choose to take part in this study, you may stop at any time. You may skip any questions you do not wish to answer. You can refuse to allow your responses to be released for research purposes without harming your relationship with your course instructor\/departmental representative or your institution, or in any other way receive a penalty or loss of benefits to which you are otherwise entitled.<br \/>\n&nbsp;<br \/>\n<strong>Contact Information:<\/strong><br \/>\n<br \/>\nIf you have questions about this study, please ask your course instructor\/departmental representative or contact Dr. Michelle Smith at mks274@cornell.edu.&nbsp;<br \/>\n&nbsp;<br \/>\n<strong>Consent, Right to Receive a Copy:<\/strong><br \/>\n\u200b<br \/>\nYou are voluntarily making a decision whether or not to participate in this research study. &nbsp;Your agreement with the statement below certifies that you have decided to participate having read and understood the information presented. &nbsp;You may print a copy of this consent form to keep.","DataExportTag":"Q296","QuestionID":"QID296","DataVisibility":{"Private":false,"Hidden":false}}},{"SurveyID":"SV_dnk8xGmFyNl56Dk","Element":"SQ","PrimaryAttribute":"QID297","SecondaryAttribute":"\u200bPlease check one answer for each question:","TertiaryAttribute":null,"Payload":{"QuestionText":"<strong>\u200bPlease check one answer for each question:<\/strong>","DefaultChoices":false,"QuestionType":"DB","Selector":"TB","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"\u200bPlease check one answer for each question:","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionText_Unsafe":"<strong>\u200bPlease check one answer for each question:<\/strong>","DataExportTag":"Q297","QuestionID":"QID297"}},{"SurveyID":"SV_dnk8xGmFyNl56Dk","Element":"SQ","PrimaryAttribute":"QID298","SecondaryAttribute":"Statement of Consent","TertiaryAttribute":null,"Payload":{"QuestionText":"Statement of Consent","QuestionType":"MC","Selector":"MAVR","SubSelector":"TX","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Statement of Consent","Choices":{"5":{"Display":"I have read and understood the above information. I consent to take part in the study."}},"ChoiceOrder":["5"],"Validation":{"Settings":{"ForceResponse":"OFF","ForceResponseType":"ON","Type":"None"}},"Language":[],"NextChoiceId":7,"NextAnswerId":1,"QuestionText_Unsafe":"I agree to have my survey responses released for research purposes.","DataExportTag":"Q298","QuestionID":"QID298","DataVisibility":{"Private":false,"Hidden":false}}},{"SurveyID":"SV_dnk8xGmFyNl56Dk","Element":"SQ","PrimaryAttribute":"QID299","SecondaryAttribute":"Are you over 18?","TertiaryAttribute":null,"Payload":{"QuestionText":"Are you over 18?","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Are you over 18?","Choices":{"5":{"Display":"Yes"},"6":{"Display":"No"}},"ChoiceOrder":["5","6"],"Validation":{"Settings":{"ForceResponse":"OFF","ForceResponseType":"ON","Type":"None"}},"Language":[],"NextChoiceId":7,"NextAnswerId":1,"QuestionText_Unsafe":"Are you over 18?","DataExportTag":"Q299","QuestionID":"QID299"}},{"SurveyID":"SV_dnk8xGmFyNl56Dk","Element":"SQ","PrimaryAttribute":"QID300","SecondaryAttribute":"Click to write the question text","TertiaryAttribute":null,"Payload":{"QuestionText":"Click to write the question text","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Click to write the question text","Choices":{"1":{"Display":"Click to write Choice 1"},"2":{"Display":"Click to write Choice 2"},"3":{"Display":"Click to write Choice 3"}},"ChoiceOrder":["1","2","3"],"Validation":{"Settings":{"ForceResponse":"OFF","ForceResponseType":"ON","Type":"None"}},"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionText_Unsafe":"Click to write the question text","DataExportTag":"Q300","QuestionID":"QID300"}},{"SurveyID":"SV_dnk8xGmFyNl56Dk","Element":"SQ","PrimaryAttribute":"QID301","SecondaryAttribute":"Timing","TertiaryAttribute":null,"Payload":{"QuestionText":"Timing","DefaultChoices":false,"QuestionType":"Timing","Selector":"PageTimer","Configuration":{"QuestionDescriptionOption":"UseText","MinSeconds":"0","MaxSeconds":"0"},"QuestionDescription":"Timing","Choices":{"1":{"Display":"First Click"},"2":{"Display":"Last Click"},"3":{"Display":"Page Submit"},"4":{"Display":"Click Count"}},"GradingData":[],"Language":[],"NextChoiceId":16,"NextAnswerId":1,"QuestionText_Unsafe":"Timing","DataExportTag":"Q301","QuestionID":"QID301"}},{"SurveyID":"SV_dnk8xGmFyNl56Dk","Element":"SQ","PrimaryAttribute":"QID302","SecondaryAttribute":"Reminder: If your instructor has assigned course credit for completing this survey, you must prov...","TertiaryAttribute":null,"Payload":{"QuestionText":"<p>Reminder: If your instructor has assigned course credit for completing this survey, you must provide your name and student ID information <strong>at the end of the surve<\/strong>y to receive this credit, independent of consenting to participate in the research study.<br \/>\n&nbsp;<\/p>\n\n<p>If you have any questions or concerns regarding your rights as a subject in this study, you may contact the Institutional Review Board (IRB) for Human Participants at 607-255-6182 or access their website at http:\/\/www.irb.cornell.edu. You may also report your concerns or complaints anonymously through Ethicspoint online at www.hotline.cornell.edu or by calling toll free at 1-866-293-3077. Ethicspoint is an independent organization that serves as a liaison between the University and the person bringing the complaint so that anonymity can be ensured.&nbsp;<\/p>","DefaultChoices":false,"DataExportTag":"Q127","QuestionType":"DB","Selector":"TB","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Reminder: If your instructor has assigned course credit for completing this survey, you must prov...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID302"}},{"SurveyID":"SV_dnk8xGmFyNl56Dk","Element":"SQ","PrimaryAttribute":"QID59","SecondaryAttribute":"Directions","TertiaryAttribute":null,"Payload":{"QuestionText":"<span style=\"color:#0000FF;\"><span style=\"font-size: 24px;\">Step 3: For questions on the following pages, indicate whether each statement is true or false.<\/span><\/span>","DefaultChoices":false,"DataExportTag":"ID3","QuestionID":"QID59","QuestionType":"DB","Selector":"TB","Configuration":{"QuestionDescriptionOption":"SpecifyLabel"},"QuestionDescription":"Directions","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[]}},{"SurveyID":"SV_dnk8xGmFyNl56Dk","Element":"SQ","PrimaryAttribute":"QID7","SecondaryAttribute":"Participant Informed Consent Form IRB# 14618\u00a0 Title: Assessment development and implementation \u00a0..","TertiaryAttribute":null,"Payload":{"QuestionText":"<div style=\"text-align: center;\"><img height=\"82\" src=\"https:\/\/ssp.qualtrics.com\/CP\/Graphic.php?IM=IM_6WozSvuhnCyVktT\" width=\"648\" \/><br \/>\n<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\"><strong>Participant Informed Consent Form<\/strong><\/span><\/span><\/div>\n\n<div style=\"text-align: right;\"><span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">IRB# 14618&nbsp; <\/span><\/span><\/div>\n<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\"><strong>Title:<\/strong> Assessment development and implementation &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;&nbsp;&nbsp;<\/span><\/span>\n\n<p><br \/>\n<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\"><strong>Purpose:<\/strong><\/span><\/span><\/p>\n\n<p><span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">This research project aims to gauge student understanding of fundamental biology concepts.&nbsp; You are invited to participate in this study because you are enrolled in an undergraduate biology course.&nbsp;&nbsp;&nbsp; <\/span><\/span><span style=\"font-size:10.0pt;mso-bidi-font-size:12.0pt\"><o:p><\/o:p><\/span><\/p>\n\n<p><br \/>\n<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\"><strong>Procedures:<\/strong>&nbsp; &nbsp; &nbsp; &nbsp;&nbsp;<\/span><\/span><\/p>\n\n<p><span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Your instructor or program has asked you to complete the attached assessment as part of your normal course or program requirements.&nbsp; The assessment is expected to take roughly 30-40 minutes and will take place at a location determined by your course instructor or departmental representative. This consent form asks for your permission to use your responses for additional research purposes.&nbsp; <\/span><\/span><span style=\"font-size:10.0pt;mso-bidi-font-size:12.0pt\"><o:p><\/o:p><\/span><\/p>\n\n<p><br \/>\n<strong style=\"font-family: 'times new roman', times, serif; font-size: 16px;\">Benefits:<\/strong><\/p>\n\n<p><span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">There are no direct benefits to you as a research participant.&nbsp; Your responses may help improve your department&rsquo;s biology curriculum.<\/span><\/span><span style=\"font-size:10.0pt\"><o:p><\/o:p><\/span><\/p>\n\n<p><br \/>\n<strong style=\"font-family: 'times new roman', times, serif; font-size: 16px;\">Risks and\/or Discomforts:<\/strong><\/p>\n\n<p><span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">There are no known risks or discomforts associated with this research. <\/span><\/span><span style=\"font-size:10.0pt;mso-bidi-font-size:12.0pt\"><o:p><\/o:p><\/span><\/p>\n\n<p><br \/>\n<strong style=\"font-family: 'times new roman', times, serif; font-size: 16px;\">Confidentiality:&nbsp;<\/strong><\/p>\n\n<p><span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Your course instructor or departmental representative will have access to your survey responses in an identifiable manner, similar to that of normal course materials.&nbsp; Prior to research analyses, a member of the research team will de-identify your responses by replacing your name with a unique code.&nbsp; A list of names and codes will be stored separately in a locked file cabinet in the principal investigator&rsquo;s office.&nbsp; Research data will be kept for a total of five years or until the project is complete, whichever comes first.&nbsp; Information obtained in this study may be published in scientific journals or presented at scientific meetings.&nbsp; Such data will always be reported in de-identified or aggregated formats.<\/span><\/span><span style=\"font-size:10.0pt;mso-bidi-font-size:12.0pt\"><o:p><\/o:p><\/span><\/p>\n\n<p><br \/>\n<strong style=\"font-family: 'times new roman', times, serif; font-size: 16px;\">Compensation:<\/strong><\/p>\n\n<p><span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Credit for completing this survey will be determined by your course instructor or departmental representative.&nbsp; You will receive no additional benefit by choosing to release your responses for research purposes.&nbsp; &nbsp;<\/span><\/span><span style=\"font-size:10.0pt;mso-bidi-font-size:12.0pt\"><o:p><\/o:p><\/span><\/p>\n\n<p><br \/>\n<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\"><strong>Opportunity to Ask Questions:<\/strong><\/span><\/span><strong><span style=\"font-size:10.0pt;mso-bidi-font-size:12.0pt\"><o:p><\/o:p><\/span><\/strong><\/p>\n\n<p><span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">If you have questions about this study, please ask your course instructor\/departmental representative or contact the principle investigator (Dr. Brian Couch, bcouch2@unl.edu). &nbsp;For questions about your rights as a research participant, you may contact the University of Nebraska-Lincoln Institutional Review Board at 402-472-6965.<\/span><\/span><span style=\"font-size:10.0pt;mso-bidi-font-size:12.0pt\"><o:p><\/o:p><\/span><\/p>\n\n<p><br \/>\n<strong style=\"font-family: 'times new roman', times, serif; font-size: 16px;\">Freedom to Withdraw:<\/strong><\/p>\n\n<p><span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Participation in this study is voluntary. &nbsp;You can refuse to allow your responses to be released for research purposes without harming your relationship with your course instructor\/departmental representative or your institution, or in any other way receive a penalty or loss of benefits to which you are otherwise entitled.<\/span><\/span><span style=\"font-size: 10pt;\"><o:p><\/o:p><\/span><\/p>\n\n<p><br \/>\n<strong style=\"font-family: 'times new roman', times, serif; font-size: 16px;\">Consent, Right to Receive a Copy:<\/strong><\/p>\n\n<p><span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">You are voluntarily making a decision whether or not to participate in this research study. &nbsp;Your agreement with the statement below certifies that you have decided to participate having read and understood the information presented. &nbsp;You may print a copy of this consent form to keep.<\/span><\/span><span style=\"font-size:10.0pt\"><o:p><\/o:p><\/span><\/p>\n\n<p><br \/>\n<strong style=\"font-family: 'times new roman', times, serif; font-size: 16px;\">Name and Phone Number of Investigator(s):<\/strong><\/p>\n\n<p><span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Brian Couch, Ph.D.. Principal Investigator&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Email: bcouch2@unl.edu&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Phone: 402-472-2720<\/span><\/span><\/p>","DefaultChoices":false,"DataExportTag":"IC1","QuestionType":"DB","Selector":"PTB","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Participant Informed Consent Form IRB# 14618\u00a0 Title: Assessment development and implementation \u00a0...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"QuestionID":"QID7"}},{"SurveyID":"SV_dnk8xGmFyNl56Dk","Element":"SQ","PrimaryAttribute":"QID73","SecondaryAttribute":"Step 1:\nEnter your name.","TertiaryAttribute":null,"Payload":{"QuestionText":"<span style=\"color:#0000FF;\"><span style=\"font-size: 24px;\">Step 1: Enter your name.<\/span><\/span>","DefaultChoices":false,"DataExportTag":"ID1","QuestionType":"TE","Selector":"FORM","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Step 1:\nEnter your name.","Choices":{"1":{"Display":"First name:","TextEntry":"on","TextEntryLength":"Long","TextEntryValidation":"ForceResponse"},"2":{"Display":"Last name:","TextEntry":"on","TextEntryLength":"Long","TextEntryValidation":"ForceResponse"}},"ChoiceOrder":["1","2"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":null}},"GradingData":[],"Language":[],"QuestionID":"QID73"}},{"SurveyID":"SV_dnk8xGmFyNl56Dk","Element":"SQ","PrimaryAttribute":"QID75","SecondaryAttribute":"Step 2: Enter your Student ID.Example:","TertiaryAttribute":null,"Payload":{"QuestionText":"<span style=\"color:#0000FF;\"><span style=\"font-size: 24px;\">Step 2: Enter your Student ID.<\/span><\/span><br><span style=\"font-size: 19px;\">Example:<\/span><div><span style=\"font-size: 19px;\"><br><\/span><\/div>","DefaultChoices":false,"DataExportTag":"ID2","QuestionType":"TE","Selector":"FORM","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Step 2: Enter your Student ID.Example:","Choices":{"1":{"Display":"Student ID:","TextEntry":"on","TextEntryLength":"Long","TextEntryValidation":"ForceResponse"}},"ChoiceOrder":["1"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":null}},"GradingData":[],"Language":[],"QuestionID":"QID75"}},{"SurveyID":"SV_dnk8xGmFyNl56Dk","Element":"SQ","PrimaryAttribute":"QID8","SecondaryAttribute":"Timing","TertiaryAttribute":null,"Payload":{"QuestionText":"Timing","DefaultChoices":false,"DataExportTag":"T-IC","QuestionType":"Timing","Selector":"PageTimer","SubSelector":"undefined","Configuration":{"QuestionDescriptionOption":"UseText","MinSeconds":"0","MaxSeconds":"0"},"QuestionDescription":"Timing","Choices":{"1":{"Display":"First Click"},"2":{"Display":"Last Click"},"3":{"Display":"Page Submit"},"4":{"Display":"Click Count"}},"ChoiceOrder":["1","2","3"],"GradingData":[],"Language":[],"QuestionID":"QID8"}},{"SurveyID":"SV_dnk8xGmFyNl56Dk","Element":"SQ","PrimaryAttribute":"QID96","SecondaryAttribute":"A signal transduction pathway in yeast activates expression of the MAT1 gene.\u00a0 This pathway is ac..","TertiaryAttribute":null,"Payload":{"QuestionText":"<div>\n<p><span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\"><span style=\"color: windowtext;\">A signal transduction pathway in yeast activates expression of the <\/span><em style=\"color: windowtext; font-family: 'Times New Roman'; font-size: 12pt;\">MAT1<\/em><span style=\"color: windowtext;\"> gene.<\/span><span style=\"color: windowtext;\">&nbsp; <\/span><span style=\"color: windowtext;\">This pathway is activated when a neighboring cell secretes a large, hydrophilic growth factor called Alpha. <\/span><span style=\"color: windowtext;\">&nbsp;<\/span><span style=\"color: windowtext;\">Three cellular proteins, SEC2, TRA3, and BUB1, are essential components of the <\/span><em style=\"color: windowtext; font-family: 'Times New Roman'; font-size: 12pt;\">MAT1<\/em><span style=\"color: windowtext;\"> signaling pathway activated by Alpha. <\/span><span style=\"color: windowtext;\">&nbsp;<\/span><span style=\"color: windowtext;\">The subcellular locations of these proteins in the absence of Alpha are shown below.<\/span><span style=\"color: windowtext;\">&nbsp; <\/span><span style=\"color: windowtext;\">The bent arrow indicates the start site of transcription.<\/span><\/span><\/span><\/p>\n<\/div>\n\n<p style=\"text-align: center;\"><br \/>\n<img src=\"https:\/\/ssp.qualtrics.com\/CP\/Graphic.php?IM=IM_3xtnydxuL5B9HU1\" style=\"width: 400px; height: 194px;\" \/><br \/>\n&nbsp;<\/p>\n\n<p><span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\"><strong><span style=\"color: windowtext;\">Based on this information and your knowledge about biology, select true or false for each of the following statements.<\/span><\/strong><\/span><\/span><\/p>","QuestionJS":false,"DefaultChoices":false,"QuestionType":"SBS","Selector":"SBSMatrix","Configuration":{"QuestionDescriptionOption":"UseText","ChoiceColumnWidthPixels":671,"RepeatHeaders":"none","ColumnOrder":[1,0]},"QuestionDescription":"A signal transduction pathway in yeast activates expression of the MAT1 gene.\u00a0 This pathway is ac...","Choices":{"1":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">The TRA3 protein could function as a receptor for Alpha.<\/span><\/span>"},"2":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">In a cell treated with Alpha, the TRA3 protein could move into the nucleus.<\/span><\/span>"},"3":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">In a cell treated with Alpha, the entire SEC2 protein could move into the nucleus to activate the <em>MAT1<\/em> gene.<\/span><\/span>"},"4":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">In the absence of Alpha, the gene that codes for the TRA3 protein is located in the nucleus.<\/span><\/span>"},"5":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">A mutation in the <em>SEC2<\/em> gene could disrupt expression of the <em>MAT1<\/em> gene.<\/span><\/span>"}},"ChoiceOrder":[1,2,3,4,"5"],"Randomization":{"Type":"All","Advanced":null,"EvenPresentation":false,"TotalRandSubset":""},"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[{"ChoiceID":"4","AnswerID":"1","SeriesID":"1","Grades":{"SC1":"1"},"index":0},{"ChoiceID":"1","AnswerID":"1","SeriesID":"2","Grades":{"SC1":"1"},"index":1},{"ChoiceID":"2","AnswerID":"1","SeriesID":"1","Grades":{"SC1":"1"},"index":2},{"ChoiceID":"3","AnswerID":"1","SeriesID":"2","Grades":{"SC1":"1"},"index":3},{"ChoiceID":"5","AnswerID":"1","SeriesID":"1","Grades":{"SC1":"1"},"index":4}],"Language":[],"NumberOfQuestions":1,"AdditionalQuestions":{"1":{"QuestionText":"&nbsp;","Answers":{"1":{"Display":"True"},"2":{"Display":"False"}},"RecodeValues":{"1":"1","2":"2"},"VariableNaming":[],"AnalyzeChoices":[],"QuestionType":"Matrix","Selector":"Likert","SubSelector":"SingleAnswer","ChoiceColumnWidthPixels":null,"Configuration":{"ChoiceColumnWidthPixels":10,"QuestionDescriptionOption":"UseText"},"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[{"AnswerID":"1","ChoiceID":"4","Grades":{"SC1":"1"},"index":0},{"AnswerID":"2","ChoiceID":"1","Grades":{"SC1":"1"},"index":1},{"AnswerID":"1","ChoiceID":"2","Grades":{"SC1":"1"},"index":2},{"AnswerID":"2","ChoiceID":"3","Grades":{"SC1":"1"},"index":3},{"AnswerID":"1","ChoiceID":"5","Grades":{"SC1":"1"},"index":4}],"DataExportTag":"BM-01#1","QuestionID":"QID96#1","Choices":{"1":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">The TRA3 protein could function as a receptor for Alpha.<\/span><\/span>"},"2":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">In a cell treated with Alpha, the TRA3 protein could move into the nucleus.<\/span><\/span>"},"3":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">In a cell treated with Alpha, the entire SEC2 protein could move into the nucleus to activate the <em>MAT1<\/em> gene.<\/span><\/span>"},"4":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">In the absence of Alpha, the gene that codes for the TRA3 protein is located in the nucleus.<\/span><\/span>"},"5":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">A mutation in the <em>SEC2<\/em> gene could disrupt expression of the <em>MAT1<\/em> gene.<\/span><\/span>"}},"ChoiceDataExportTags":false,"QuestionDescription":" "}},"ChoiceDataExportTags":false,"QuestionText_Unsafe":"<p><span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">In humans, the muscle myosin <em>protein<\/em> is only found in muscle cells. <\/span><\/span><o:p><\/o:p><\/p>\n\n<p><o:p><span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">&nbsp;<\/span><\/span><\/o:p><\/p>\n\n<p><span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\"><strong><span style=\"line-height: 107%;\">Based on this information and your knowledge about biology, select true or false for each of the following statements.<\/span>&nbsp;&nbsp;<\/strong><\/span><\/span><o:p><\/o:p><\/p>","DataExportTag":"BM-01","QuestionID":"QID96","RecodeValues":{"1":"1"}}},{"SurveyID":"SV_dnk8xGmFyNl56Dk","Element":"SQ","PrimaryAttribute":"QID97","SecondaryAttribute":"Timing","TertiaryAttribute":null,"Payload":{"QuestionText":"Timing","DefaultChoices":false,"QuestionType":"Timing","Selector":"PageTimer","Configuration":{"QuestionDescriptionOption":"UseText","MinSeconds":"0","MaxSeconds":"0"},"QuestionDescription":"Timing","Choices":{"1":{"Display":"First Click"},"2":{"Display":"Last Click"},"3":{"Display":"Page Submit"},"4":{"Display":"Click Count"}},"ChoiceOrder":["1","2","3"],"GradingData":[],"Language":[],"QuestionText_Unsafe":"Timing","DataExportTag":"T-BM-01","QuestionID":"QID97"}},{"SurveyID":"SV_dnk8xGmFyNl56Dk","Element":"STAT","PrimaryAttribute":"Survey Statistics","SecondaryAttribute":null,"TertiaryAttribute":null,"Payload":{"MobileCompatible":true,"ID":"Survey Statistics"}}]}
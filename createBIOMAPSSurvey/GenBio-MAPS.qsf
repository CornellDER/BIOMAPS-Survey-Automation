aryAttribute":"QID199","SecondaryAttribute":"Timing","TertiaryAttribute":null,"Payload":{"QuestionText":"Timing","DefaultChoices":false,"DataExportTag":"T-Sem","QuestionType":"Timing","Selector":"PageTimer","Configuration":{"QuestionDescriptionOption":"UseText","MinSeconds":"0","MaxSeconds":"0"},"QuestionDescription":"Timing","Choices":{"1":{"Display":"First Click"},"2":{"Display":"Last Click"},"3":{"Display":"Page Submit"},"4":{"Display":"Click Count"}},"GradingData":[],"Language":[],"QuestionID":"QID199"}},{"SurveyID":"SV_dnk8xGmFyNl56Dk","Element":"SQ","PrimaryAttribute":"QID200","SecondaryAttribute":"Timing","TertiaryAttribute":null,"Payload":{"QuestionText":"Timing","DefaultChoices":false,"DataExportTag":"T-Maj\/Sub","QuestionType":"Timing","Selector":"PageTimer","Configuration":{"QuestionDescriptionOption":"UseText","MinSeconds":"0","MaxSeconds":"0"},"QuestionDescription":"Timing","Choices":{"1":{"Display":"First Click"},"2":{"Display":"Last Click"},"3":{"Display":"Page Submit"},"4":{"Display":"Click Count"}},"GradingData":[],"Language":[],"QuestionID":"QID200"}},{"SurveyID":"SV_dnk8xGmFyNl56Dk","Element":"SQ","PrimaryAttribute":"QID201","SecondaryAttribute":"Timing","TertiaryAttribute":null,"Payload":{"QuestionText":"Timing","DefaultChoices":false,"DataExportTag":"T-GPA","QuestionType":"Timing","Selector":"PageTimer","Configuration":{"QuestionDescriptionOption":"UseText","MinSeconds":"0","MaxSeconds":"0"},"QuestionDescription":"Timing","Choices":{"1":{"Display":"First Click"},"2":{"Display":"Last Click"},"3":{"Display":"Page Submit"},"4":{"Display":"Click Count"}},"GradingData":[],"Language":[],"QuestionID":"QID201"}},{"SurveyID":"SV_dnk8xGmFyNl56Dk","Element":"SQ","PrimaryAttribute":"QID202","SecondaryAttribute":"Timing","TertiaryAttribute":null,"Payload":{"QuestionText":"Timing","DefaultChoices":false,"DataExportTag":"T-Gen","QuestionType":"Timing","Selector":"PageTimer","Configuration":{"QuestionDescriptionOption":"UseText","MinSeconds":"0","MaxSeconds":"0"},"QuestionDescription":"Timing","Choices":{"1":{"Display":"First Click"},"2":{"Display":"Last Click"},"3":{"Display":"Page Submit"},"4":{"Display":"Click Count"}},"GradingData":[],"Language":[],"QuestionID":"QID202"}},{"SurveyID":"SV_dnk8xGmFyNl56Dk","Element":"SQ","PrimaryAttribute":"QID203","SecondaryAttribute":"Timing","TertiaryAttribute":null,"Payload":{"QuestionText":"Timing","DefaultChoices":false,"DataExportTag":"T-Ethn","QuestionType":"Timing","Selector":"PageTimer","Configuration":{"QuestionDescriptionOption":"UseText","MinSeconds":"0","MaxSeconds":"0"},"QuestionDescription":"Timing","Choices":{"1":{"Display":"First Click"},"2":{"Display":"Last Click"},"3":{"Display":"Page Submit"},"4":{"Display":"Click Count"}},"GradingData":[],"Language":[],"QuestionID":"QID203"}},{"SurveyID":"SV_dnk8xGmFyNl56Dk","Element":"SQ","PrimaryAttribute":"QID208","SecondaryAttribute":"A bacterium uses ammonia, NH3, as its only food source.\u00a0 This bacterium has an enzyme called ammo..","TertiaryAttribute":null,"Payload":{"QuestionText":"<div>\n<p><span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">A bacterium uses ammonia, NH<sub>3<\/sub>, as its only food source.&nbsp; This bacterium has an enzyme called ammonia monooxygenase that catalyzes the reaction shown below, which is energetically favorable under the conditions found in this bacterium.<\/span><\/span><\/p>\n\n<p style=\"text-align: center;\"><br \/>\n<img src=\"https:\/\/ssp.qualtrics.com\/CP\/Graphic.php?IM=IM_74H7EskYDYNmRZH\" style=\"width: 400px; height: 100px;\" \/><\/p>\n\n<p><br \/>\n<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\"><strong><span style=\"color: windowtext;\">Based on this information and your knowledge about biology, select true or false for each of the following statements.<\/span><\/strong><\/span><\/span><\/p>\n<\/div>","QuestionJS":false,"DefaultChoices":false,"QuestionType":"SBS","Selector":"SBSMatrix","Configuration":{"QuestionDescriptionOption":"UseText","ChoiceColumnWidthPixels":671,"RepeatHeaders":"none","ColumnOrder":[1,0]},"QuestionDescription":"A bacterium uses ammonia, NH3, as its only food source.\u00a0 This bacterium has an enzyme called ammo...","Choices":{"1":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Energy released during the conversion of ammonia to hydroxylamine could be used by the bacterium to drive ATP synthesis.&nbsp;<\/span><\/span>"},"2":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Enzymes, such as ammonia monooxygenase, are often inhibited by the products of the reactions that they catalyze.<\/span><\/span>"},"3":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Ammonia monooxygenase likely raises the activation energy of the reaction.<\/span><\/span>"},"4":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">A mutation in the ammonia monooxygenase gene could increase the fitness of this bacterium.<\/span><\/span>"}},"ChoiceOrder":[1,2,3,4],"Randomization":{"Type":"All","Advanced":null,"EvenPresentation":false,"TotalRandSubset":""},"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[{"ChoiceID":"4","AnswerID":"1","SeriesID":"1","Grades":{"SC1":"1"},"index":0},{"ChoiceID":"2","AnswerID":"1","SeriesID":"1","Grades":{"SC1":"1"},"index":1},{"ChoiceID":"3","AnswerID":"1","SeriesID":"2","Grades":{"SC1":"1"},"index":2},{"ChoiceID":"1","AnswerID":"1","SeriesID":"1","Grades":{"SC1":"1"},"index":3}],"Language":[],"NumberOfQuestions":1,"AdditionalQuestions":{"1":{"QuestionText":"&nbsp;","Answers":{"1":{"Display":"True"},"2":{"Display":"False"}},"RecodeValues":{"1":"1","2":"2"},"VariableNaming":[],"AnalyzeChoices":[],"QuestionType":"Matrix","Selector":"Likert","SubSelector":"SingleAnswer","ChoiceColumnWidthPixels":null,"Configuration":{"ChoiceColumnWidthPixels":10,"QuestionDescriptionOption":"UseText"},"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[{"AnswerID":"1","ChoiceID":"4","Grades":{"SC1":"1"},"index":0},{"AnswerID":"1","ChoiceID":"2","Grades":{"SC1":"1"},"index":1},{"AnswerID":"2","ChoiceID":"3","Grades":{"SC1":"1"},"index":2},{"AnswerID":"1","ChoiceID":"1","Grades":{"SC1":"1"},"index":3}],"DataExportTag":"BM-02#1","QuestionID":"QID208#1","Choices":{"1":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Energy released during the conversion of ammonia to hydroxylamine could be used by the bacterium to drive ATP synthesis.&nbsp;<\/span><\/span>"},"2":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Enzymes, such as ammonia monooxygenase, are often inhibited by the products of the reactions that they catalyze.<\/span><\/span>"},"3":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Ammonia monooxygenase likely raises the activation energy of the reaction.<\/span><\/span>"},"4":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">A mutation in the ammonia monooxygenase gene could increase the fitness of this bacterium.<\/span><\/span>"}},"ChoiceDataExportTags":false,"QuestionDescription":" "}},"ChoiceDataExportTags":false,"QuestionText_Unsafe":"<div>\n<p><span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\"><span style=\"color: windowtext;\">A signal transduction pathway in yeast activates expression of the <\/span><em style=\"color: windowtext; font-family: 'Times New Roman'; font-size: 12pt;\">MAT1<\/em><span style=\"color: windowtext;\"> gene.<\/span><span style=\"color: windowtext;\">&nbsp; <\/span><span style=\"color: windowtext;\">This pathway is activated when a neighboring cell secretes a large, hydrophilic growth factor called Alpha. <\/span><span style=\"color: windowtext;\">&nbsp;<\/span><span style=\"color: windowtext;\">Three cellular proteins, SEC2, TRA3, and BUB1, are essential components of the <\/span><em style=\"color: windowtext; font-family: 'Times New Roman'; font-size: 12pt;\">MAT1<\/em><span style=\"color: windowtext;\"> signaling pathway activated by Alpha. <\/span><span style=\"color: windowtext;\">&nbsp;<\/span><span style=\"color: windowtext;\">The subcellular locations of these proteins in the absence of Alpha are shown below.<\/span><span style=\"color: windowtext;\">&nbsp; <\/span><span style=\"color: windowtext;\">The bent arrow indicates the start site of transcription.<\/span><\/span><\/span><\/p>\n<\/div>\n\n<p>&nbsp;<\/p>\n\n<p style=\"text-align: center;\"><span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">INSERT FIGURE HERE<\/span><\/span><\/p>\n\n<p>&nbsp;<\/p>\n\n<p><span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\"><strong><span style=\"color: windowtext;\">Based on this information and your knowledge about biology, select true or false for each of the following statements.<\/span><\/strong><\/span><\/span><\/p>","RecodeValues":{"1":"1"},"DataExportTag":"BM-02","QuestionID":"QID208"}},{"SurveyID":"SV_dnk8xGmFyNl56Dk","Element":"SQ","PrimaryAttribute":"QID209","SecondaryAttribute":"Timing","TertiaryAttribute":null,"Payload":{"QuestionText":"Timing","DefaultChoices":false,"QuestionType":"Timing","Selector":"PageTimer","Configuration":{"QuestionDescriptionOption":"UseText","MinSeconds":"0","MaxSeconds":"0"},"QuestionDescription":"Timing","Choices":{"1":{"Display":"First Click"},"2":{"Display":"Last Click"},"3":{"Display":"Page Submit"},"4":{"Display":"Click Count"}},"ChoiceOrder":["1","2","3"],"GradingData":[],"Language":[],"QuestionText_Unsafe":"Timing","DataExportTag":"T-BM-02","QuestionID":"QID209"}},{"SurveyID":"SV_dnk8xGmFyNl56Dk","Element":"SQ","PrimaryAttribute":"QID210","SecondaryAttribute":"Human immune-deficiency virus, HIV, is a virus that infects human cells.\u00a0 When HIV infects a cell..","TertiaryAttribute":null,"Payload":{"QuestionText":"<div>\n<p><span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Human immune-deficiency virus, HIV, is a virus that infects human cells.&nbsp; When HIV infects a cell, the cell synthesizes a viral protein called HIV protease. The function of HIV protease is to bind and cut another viral protein called Gag-Pol to create two separate proteins, Gag and Pol.&nbsp; A newly discovered strain of HIV makes an altered form of the HIV protease that differs by a single amino acid substitution from the normal protease.&nbsp;<\/span><\/span><\/p><p><span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\"><br><\/span><\/span><\/p>\n<\/div>\n\n<p><span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\"><strong><span style=\"color: windowtext;\">Based on this information and your knowledge about biology, select true or false for each of the following statements.<\/span><\/strong><\/span><\/span><\/p>","QuestionJS":false,"DefaultChoices":false,"QuestionType":"SBS","Selector":"SBSMatrix","Configuration":{"QuestionDescriptionOption":"UseText","ChoiceColumnWidthPixels":671,"RepeatHeaders":"none","ColumnOrder":[1,0]},"QuestionDescription":"Human immune-deficiency virus, HIV, is a virus that infects human cells.\u00a0 When HIV infects a cell...","Choices":{"1":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">This altered protease is the result of a mutation within the viral genome.<\/span><\/span>"},"2":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">This altered protease could be more efficient at cutting Gag-Pol than the normal protease.<\/span><\/span>"},"3":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">This altered protease could bind less tightly to the Gag-pol protein.<\/span><\/span>"},"4":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">The HIV strain that makes this altered protease could be resistant to drugs designed to block the function of the normal protease.<\/span><\/span>"},"5":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">This altered protease will likely be shorter than the normal protease.<\/span><\/span>"}},"ChoiceOrder":[1,2,3,4,"5"],"Randomization":{"Type":"All","Advanced":null,"EvenPresentation":false,"TotalRandSubset":""},"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[{"ChoiceID":"4","AnswerID":"1","SeriesID":"1","Grades":{"SC1":"1"},"index":0},{"ChoiceID":"2","AnswerID":"1","SeriesID":"1","Grades":{"SC1":"1"},"index":1},{"ChoiceID":"1","AnswerID":"1","SeriesID":"1","Grades":{"SC1":"1"},"index":2},{"ChoiceID":"3","AnswerID":"1","SeriesID":"1","Grades":{"SC1":"1"},"index":3},{"ChoiceID":"5","AnswerID":"1","SeriesID":"2","Grades":{"SC1":"1"},"index":4}],"Language":[],"NumberOfQuestions":1,"AdditionalQuestions":{"1":{"QuestionText":"&nbsp;","Answers":{"1":{"Display":"True"},"2":{"Display":"False"}},"RecodeValues":{"1":"1","2":"2"},"VariableNaming":[],"AnalyzeChoices":[],"QuestionType":"Matrix","Selector":"Likert","SubSelector":"SingleAnswer","ChoiceColumnWidthPixels":null,"Configuration":{"ChoiceColumnWidthPixels":10,"QuestionDescriptionOption":"UseText"},"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[{"AnswerID":"1","ChoiceID":"4","Grades":{"SC1":"1"},"index":0},{"AnswerID":"1","ChoiceID":"2","Grades":{"SC1":"1"},"index":1},{"AnswerID":"1","ChoiceID":"1","Grades":{"SC1":"1"},"index":2},{"AnswerID":"1","ChoiceID":"3","Grades":{"SC1":"1"},"index":3},{"AnswerID":"2","ChoiceID":"5","Grades":{"SC1":"1"},"index":4}],"DataExportTag":"BM-03#1","QuestionID":"QID210#1","Choices":{"1":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">This altered protease is the result of a mutation within the viral genome.<\/span><\/span>"},"2":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">This altered protease could be more efficient at cutting Gag-Pol than the normal protease.<\/span><\/span>"},"3":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">This altered protease could bind less tightly to the Gag-pol protein.<\/span><\/span>"},"4":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">The HIV strain that makes this altered protease could be resistant to drugs designed to block the function of the normal protease.<\/span><\/span>"},"5":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">This altered protease will likely be shorter than the normal protease.<\/span><\/span>"}},"ChoiceDataExportTags":false,"QuestionDescription":" "}},"ChoiceDataExportTags":false,"QuestionText_Unsafe":"<div>\n<p><span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">A bacterium uses ammonia, NH<sub>3<\/sub>, as its only food source.&nbsp; This bacterium has an enzyme called ammonia monooxygenase that catalyzes the reaction shown below, which is energetically favorable under the conditions found in this bacterium.&nbsp;<\/span><\/span><br \/>\n&nbsp;<\/p>\n<\/div>\n\n<p style=\"text-align: center;\"><span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">INSERT FIGURE HERE<\/span><\/span><\/p>\n\n<p>&nbsp;<\/p>\n\n<p><span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\"><strong><span style=\"color: windowtext;\">Based on this information and your knowledge about biology, select true or false for each of the following statements.<\/span><\/strong><\/span><\/span><\/p>","RecodeValues":{"1":"1"},"DataExportTag":"BM-03","QuestionID":"QID210"}},{"SurveyID":"SV_dnk8xGmFyNl56Dk","Element":"SQ","PrimaryAttribute":"QID211","SecondaryAttribute":"Timing","TertiaryAttribute":null,"Payload":{"QuestionText":"Timing","DefaultChoices":false,"QuestionType":"Timing","Selector":"PageTimer","Configuration":{"QuestionDescriptionOption":"UseText","MinSeconds":"0","MaxSeconds":"0"},"QuestionDescription":"Timing","Choices":{"1":{"Display":"First Click"},"2":{"Display":"Last Click"},"3":{"Display":"Page Submit"},"4":{"Display":"Click Count"}},"ChoiceOrder":["1","2","3"],"GradingData":[],"Language":[],"QuestionText_Unsafe":"Timing","DataExportTag":"T-BM-03","QuestionID":"QID211"}},{"SurveyID":"SV_dnk8xGmFyNl56Dk","Element":"SQ","PrimaryAttribute":"QID212","SecondaryAttribute":"During the course of normal human development, the muscle myosin protein becomes expressed in mus...","TertiaryAttribute":null,"Payload":{"QuestionText":"<div>\n<p><span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">During the course of normal human development, the muscle myosin protein becomes expressed in muscle cells but not in non-muscle cells, such as liver cells.<\/span><\/span><\/p>\n\n<p>&nbsp;<\/p>\n<\/div>\n\n<p><span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\"><strong><span style=\"color: windowtext;\">Based on this information and your knowledge about biology, select true or false for each of the following statements.<\/span><\/strong><\/span><\/span><\/p>","QuestionJS":false,"DefaultChoices":false,"QuestionType":"SBS","Selector":"SBSMatrix","Configuration":{"QuestionDescriptionOption":"UseText","ChoiceColumnWidthPixels":671,"RepeatHeaders":"none","ColumnOrder":[1,0]},"QuestionDescription":"During the course of normal human development, the muscle myosin protein becomes expressed in mus...","Choices":{"1":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">This expression pattern could result from the muscle myosin gene being present in muscle cells but not in liver cells.<\/span><\/span>"},"2":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">This expression pattern could result from the regulatory sequence of the muscle myosin gene being different in muscle cells compared to liver cells.<\/span><\/span>"},"3":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">This expression pattern could result from epigenetic modifications, such as DNA methylation, being present on the myosin gene in liver cells but not in muscle cells.<\/span><\/span>"},"4":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">This expression pattern could result from a transcription factor that activates expression of the muscle myosin gene being present in muscle cells but not in liver cells.<\/span><\/span>"}},"ChoiceOrder":[1,2,3,4],"Randomization":{"Type":"All","Advanced":null,"EvenPresentation":false,"TotalRandSubset":""},"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[{"ChoiceID":"4","AnswerID":"1","SeriesID":"1","Grades":{"SC1":"1"},"index":0},{"ChoiceID":"1","AnswerID":"1","SeriesID":"2","Grades":{"SC1":"1"},"index":1},{"ChoiceID":"2","AnswerID":"1","SeriesID":"2","Grades":{"SC1":"1"},"index":2},{"ChoiceID":"3","AnswerID":"1","SeriesID":"1","Grades":{"SC1":"1"},"index":3}],"Language":[],"NumberOfQuestions":1,"AdditionalQuestions":{"1":{"QuestionText":"&nbsp;","Answers":{"1":{"Display":"True"},"2":{"Display":"False"}},"RecodeValues":{"1":"1","2":"2"},"VariableNaming":[],"AnalyzeChoices":[],"QuestionType":"Matrix","Selector":"Likert","SubSelector":"SingleAnswer","ChoiceColumnWidthPixels":null,"Configuration":{"ChoiceColumnWidthPixels":10,"QuestionDescriptionOption":"UseText"},"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[{"AnswerID":"1","ChoiceID":"4","Grades":{"SC1":"1"},"index":0},{"AnswerID":"2","ChoiceID":"1","Grades":{"SC1":"1"},"index":1},{"AnswerID":"2","ChoiceID":"2","Grades":{"SC1":"1"},"index":2},{"AnswerID":"1","ChoiceID":"3","Grades":{"SC1":"1"},"index":3}],"DataExportTag":"BM-04#1","QuestionID":"QID212#1","Choices":{"1":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">This expression pattern could result from the muscle myosin gene being present in muscle cells but not in liver cells.<\/span><\/span>"},"2":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">This expression pattern could result from the regulatory sequence of the muscle myosin gene being different in muscle cells compared to liver cells.<\/span><\/span>"},"3":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">This expression pattern could result from epigenetic modifications, such as DNA methylation, being present on the myosin gene in liver cells but not in muscle cells.<\/span><\/span>"},"4":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">This expression pattern could result from a transcription factor that activates expression of the muscle myosin gene being present in muscle cells but not in liver cells.<\/span><\/span>"}},"ChoiceDataExportTags":false,"QuestionDescription":" "}},"ChoiceDataExportTags":false,"QuestionText_Unsafe":"<div>\n<p><span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Human immune-deficiency virus, HIV, is a virus that infects human cells.&nbsp; When HIV infects a cell, the cell synthesizes a viral protein called HIV protease. The function of HIV protease is to bind and cut another viral protein called Gag-Pol to create two separate proteins, Gag and Pol.&nbsp; A newly discovered strain of HIV makes an altered form of the HIV protease that differs by a single amino acid substitution from the normal protease.&nbsp;<\/span><\/span><\/p><p><span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\"><br><\/span><\/span><\/p>\n<\/div>\n\n<p><span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\"><strong><span style=\"color: windowtext;\">Based on this information and your knowledge about biology, select true or false for each of the following statements.<\/span><\/strong><\/span><\/span><\/p>","RecodeValues":{"1":"1"},"DataExportTag":"BM-04","QuestionID":"QID212"}},{"SurveyID":"SV_dnk8xGmFyNl56Dk","Element":"SQ","PrimaryAttribute":"QID213","SecondaryAttribute":"Timing","TertiaryAttribute":null,"Payload":{"QuestionText":"Timing","DefaultChoices":false,"QuestionType":"Timing","Selector":"PageTimer","Configuration":{"QuestionDescriptionOption":"UseText","MinSeconds":"0","MaxSeconds":"0"},"QuestionDescription":"Timing","Choices":{"1":{"Display":"First Click"},"2":{"Display":"Last Click"},"3":{"Display":"Page Submit"},"4":{"Display":"Click Count"}},"ChoiceOrder":["1","2","3"],"GradingData":[],"Language":[],"QuestionText_Unsafe":"Timing","DataExportTag":"T-BM-04","QuestionID":"QID213"}},{"SurveyID":"SV_dnk8xGmFyNl56Dk","Element":"SQ","PrimaryAttribute":"QID214","SecondaryAttribute":"The EOT1 gene is required to promote toe development in normal mice.\u00a0 A mutation in this gene res..","TertiaryAttribute":null,"Payload":{"QuestionText":"<div>\n<p><span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">The <em>EOT1<\/em> gene is required to promote toe development in normal mice.&nbsp; A mutation in this gene results in a paw with two extra toes.<\/span><\/span><\/p>\n\n<p>&nbsp;<\/p>\n<\/div>\n\n<p><span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\"><strong><span style=\"color: windowtext;\">Based on this information and your knowledge about biology, select true or false for each of the following statements.<\/span><\/strong><\/span><\/span><\/p>","QuestionJS":false,"DefaultChoices":false,"QuestionType":"SBS","Selector":"SBSMatrix","Configuration":{"QuestionDescriptionOption":"UseText","ChoiceColumnWidthPixels":671,"RepeatHeaders":"none","ColumnOrder":[1,0]},"QuestionDescription":"The EOT1 gene is required to promote toe development in normal mice.\u00a0 A mutation in this gene res...","Choices":{"1":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">The mutation could be located in a regulatory region of the <em>EOT1<\/em> gene where an inhibitor protein normally binds.<\/span><\/span>"},"2":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">The two extra toes could result from a mutation in the <em>EOT1<\/em> gene that causes the EOT1 protein to be nonfunctional.<\/span><\/span>"},"3":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">The mutation could result in the mouse having lower than average fitness.<\/span><\/span>"},"4":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">If the extra toes result in the mouse having increased fitness, the mutation could increase in frequency in a population of mice over time.<\/span><\/span>"},"5":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">If the extra toes do not cause any change in the fitness of the mouse, the mutation could increase in frequency in a population of mice over time.<\/span><\/span>"}},"ChoiceOrder":[1,2,3,4,"5"],"Randomization":{"Type":"All","Advanced":null,"EvenPresentation":false,"TotalRandSubset":""},"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[{"ChoiceID":"4","AnswerID":"1","SeriesID":"1","Grades":{"SC1":"1"},"index":0},{"ChoiceID":"1","AnswerID":"1","SeriesID":"1","Grades":{"SC1":"1"},"index":1},{"ChoiceID":"2","AnswerID":"1","SeriesID":"2","Grades":{"SC1":"1"},"index":2},{"ChoiceID":"3","AnswerID":"1","SeriesID":"1","Grades":{"SC1":"1"},"index":3},{"ChoiceID":"5","AnswerID":"1","SeriesID":"1","Grades":{"SC1":"1"},"index":4}],"Language":[],"NumberOfQuestions":1,"AdditionalQuestions":{"1":{"QuestionText":"&nbsp;","Answers":{"1":{"Display":"True"},"2":{"Display":"False"}},"RecodeValues":{"1":"1","2":"2"},"VariableNaming":[],"AnalyzeChoices":[],"QuestionType":"Matrix","Selector":"Likert","SubSelector":"SingleAnswer","ChoiceColumnWidthPixels":null,"Configuration":{"ChoiceColumnWidthPixels":10,"QuestionDescriptionOption":"UseText"},"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[{"AnswerID":"1","ChoiceID":"4","Grades":{"SC1":"1"},"index":0},{"AnswerID":"1","ChoiceID":"1","Grades":{"SC1":"1"},"index":1},{"AnswerID":"2","ChoiceID":"2","Grades":{"SC1":"1"},"index":2},{"AnswerID":"1","ChoiceID":"3","Grades":{"SC1":"1"},"index":3},{"AnswerID":"1","ChoiceID":"5","Grades":{"SC1":"1"},"index":4}],"DataExportTag":"BM-07#1","QuestionID":"QID214#1","Choices":{"1":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">The mutation could be located in a regulatory region of the <em>EOT1<\/em> gene where an inhibitor protein normally binds.<\/span><\/span>"},"2":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">The two extra toes could result from a mutation in the <em>EOT1<\/em> gene that causes the EOT1 protein to be nonfunctional.<\/span><\/span>"},"3":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">The mutation could result in the mouse having lower than average fitness.<\/span><\/span>"},"4":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">If the extra toes result in the mouse having increased fitness, the mutation could increase in frequency in a population of mice over time.<\/span><\/span>"},"5":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">If the extra toes do not cause any change in the fitness of the mouse, the mutation could increase in frequency in a population of mice over time.<\/span><\/span>"}},"ChoiceDataExportTags":false,"QuestionDescription":" "}},"ChoiceDataExportTags":false,"QuestionText_Unsafe":"<div>\n<p><span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">During the course of normal human development, the muscle myosin protein becomes expressed in muscle cells but not in non-muscle cells, such as liver cells.<\/span><\/span><\/p>\n\n<p>&nbsp;<\/p>\n<\/div>\n\n<p><span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\"><strong><span style=\"color: windowtext;\">Based on this information and your knowledge about biology, select true or false for each of the following statements.<\/span><\/strong><\/span><\/span><\/p>","RecodeValues":{"1":"1"},"DataExportTag":"BM-07","QuestionID":"QID214"}},{"SurveyID":"SV_dnk8xGmFyNl56Dk","Element":"SQ","PrimaryAttribute":"QID215","SecondaryAttribute":"Timing","TertiaryAttribute":null,"Payload":{"QuestionText":"Timing","DefaultChoices":false,"QuestionType":"Timing","Selector":"PageTimer","Configuration":{"QuestionDescriptionOption":"UseText","MinSeconds":"0","MaxSeconds":"0"},"QuestionDescription":"Timing","Choices":{"1":{"Display":"First Click"},"2":{"Display":"Last Click"},"3":{"Display":"Page Submit"},"4":{"Display":"Click Count"}},"ChoiceOrder":["1","2","3"],"GradingData":[],"Language":[],"QuestionText_Unsafe":"Timing","DataExportTag":"T-BM-07","QuestionID":"QID215"}},{"SurveyID":"SV_dnk8xGmFyNl56Dk","Element":"SQ","PrimaryAttribute":"QID216","SecondaryAttribute":"A single species of bacteria only spreads by physical contact between living birds of the same sp...","TertiaryAttribute":null,"Payload":{"QuestionText":"<div>\n<p><span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">A single species of bacteria only spreads by physical contact between living birds of the same species.&nbsp; The bacteria infect the birds&rsquo; eyes and can cause inflammation leading to blindness and death.&nbsp; &nbsp;<br \/>\n&nbsp;<br \/>\nOver the past 15 years, the way this bacterial species infects and kills birds has shifted: an Eastern Canadian strain now causes severe infection and rapid death, while strains of the same species of bacteria that spread to Western Canada do not cause severe infection or death. &nbsp;Although birds in Western Canada do not experience severe infection and do not die, the Western bacterial strain still lives in these birds. Both strains of bacteria divide every 20 minutes, while birds take approximately 3 years to reach reproductive age.&nbsp;<\/span><\/span><br \/>\n&nbsp;<\/p>\n<\/div>\n\n<p><span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\"><strong><span style=\"color: windowtext;\">Based on this information and your knowledge about biology, select true or false for each of the following statements.<\/span><\/strong><\/span><\/span><\/p>","QuestionJS":false,"DefaultChoices":false,"QuestionType":"SBS","Selector":"SBSMatrix","Configuration":{"QuestionDescriptionOption":"UseText","ChoiceColumnWidthPixels":671,"RepeatHeaders":"none","ColumnOrder":[1,0]},"QuestionDescription":"A single species of bacteria only spreads by physical contact between living birds of the same sp...","Choices":{"1":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">During this 15 year period, both bacterial strains have the capacity to accumulate genetic changes more rapidly than birds.<\/span><\/span>"},"2":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">The Eastern Canadian bacterial strain is still evolving, but Eastern Canadian birds are no longer evolving.<\/span><\/span>"},"3":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">In Western Canada, a bird that survives bacterial infection due to the bird&rsquo;s specific genetic makeup is likely to have offspring who survive infection by the same strain of bacteria.<\/span><\/span>"},"4":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">The difference in the severity of infection in Eastern and Western Canada could be due to genetic differences in Eastern and Western bird hosts.&nbsp;<\/span><\/span>"}},"ChoiceOrder":[1,2,3,4],"Randomization":{"Type":"All","Advanced":null,"EvenPresentation":false,"TotalRandSubset":""},"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[{"ChoiceID":"4","AnswerID":"1","SeriesID":"1","Grades":{"SC1":"1"},"index":0},{"ChoiceID":"1","AnswerID":"1","SeriesID":"1","Grades":{"SC1":"1"},"index":1},{"ChoiceID":"2","AnswerID":"1","SeriesID":"2","Grades":{"SC1":"1"},"index":2},{"ChoiceID":"3","AnswerID":"1","SeriesID":"1","Grades":{"SC1":"1"},"index":3}],"Language":[],"NumberOfQuestions":1,"AdditionalQuestions":{"1":{"QuestionText":"&nbsp;","Answers":{"1":{"Display":"True"},"2":{"Display":"False"}},"RecodeValues":{"1":"1","2":"2"},"VariableNaming":[],"AnalyzeChoices":[],"QuestionType":"Matrix","Selector":"Likert","SubSelector":"SingleAnswer","ChoiceColumnWidthPixels":null,"Configuration":{"ChoiceColumnWidthPixels":10,"QuestionDescriptionOption":"UseText"},"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[{"AnswerID":"1","ChoiceID":"4","Grades":{"SC1":"1"},"index":0},{"AnswerID":"1","ChoiceID":"1","Grades":{"SC1":"1"},"index":1},{"AnswerID":"2","ChoiceID":"2","Grades":{"SC1":"1"},"index":2},{"AnswerID":"1","ChoiceID":"3","Grades":{"SC1":"1"},"index":3}],"DataExportTag":"BM-08#1","QuestionID":"QID216#1","Choices":{"1":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">During this 15 year period, both bacterial strains have the capacity to accumulate genetic changes more rapidly than birds.<\/span><\/span>"},"2":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">The Eastern Canadian bacterial strain is still evolving, but Eastern Canadian birds are no longer evolving.<\/span><\/span>"},"3":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">In Western Canada, a bird that survives bacterial infection due to the bird&rsquo;s specific genetic makeup is likely to have offspring who survive infection by the same strain of bacteria.<\/span><\/span>"},"4":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">The difference in the severity of infection in Eastern and Western Canada could be due to genetic differences in Eastern and Western bird hosts.&nbsp;<\/span><\/span>"}},"ChoiceDataExportTags":false,"QuestionDescription":" "}},"ChoiceDataExportTags":false,"QuestionText_Unsafe":"<div>\n<p><span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">The <em>EOT1<\/em> gene is required to promote toe development in normal mice.&nbsp; A mutation in this gene results in a paw with two extra toes.<\/span><\/span><\/p>\n\n<p>&nbsp;<\/p>\n<\/div>\n\n<p><span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\"><strong><span style=\"color: windowtext;\">Based on this information and your knowledge about biology, select true or false for each of the following statements.<\/span><\/strong><\/span><\/span><\/p>","RecodeValues":{"1":"1"},"DataExportTag":"BM-08","QuestionID":"QID216"}},{"SurveyID":"SV_dnk8xGmFyNl56Dk","Element":"SQ","PrimaryAttribute":"QID217","SecondaryAttribute":"Timing","TertiaryAttribute":null,"Payload":{"QuestionText":"Timing","DefaultChoices":false,"QuestionType":"Timing","Selector":"PageTimer","Configuration":{"QuestionDescriptionOption":"UseText","MinSeconds":"0","MaxSeconds":"0"},"QuestionDescription":"Timing","Choices":{"1":{"Display":"First Click"},"2":{"Display":"Last Click"},"3":{"Display":"Page Submit"},"4":{"Display":"Click Count"}},"ChoiceOrder":["1","2","3"],"GradingData":[],"Language":[],"QuestionText_Unsafe":"Timing","DataExportTag":"T-BM-08","QuestionID":"QID217"}},{"SurveyID":"SV_dnk8xGmFyNl56Dk","Element":"SQ","PrimaryAttribute":"QID218","SecondaryAttribute":"One way that dwarfism occurs is from the premature inhibition of cell division in bone precursor...","TertiaryAttribute":null,"Payload":{"QuestionText":"<div>\n<p><span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">One way that dwarfism occurs is from the premature inhibition of cell division in bone precursor cells, controlled by the signaling pathway shown in the diagram below.&nbsp; Fibroblast Growth Factor 3 (FGF3) binds to the FGF3 receptor, triggering the phosphorylation of the STAT transcription activator.&nbsp; Phosphorylated STAT then binds to the regulatory region of the <em>CYC<\/em> gene and activates transcription of the <em>CYC<\/em> gene.&nbsp; The <em>CYC<\/em> gene product inhibits cell division.&nbsp; The bent arrow indicates the start site of transcription.<\/span><\/span><\/p>\n\n<p style=\"text-align: center;\"><br \/>\n<img src=\"https:\/\/ssp.qualtrics.com\/CP\/Graphic.php?IM=IM_eeWaAlsqxFgCh93\" style=\"width: 400px; height: 239px;\" \/><\/p>\n\n<p><br \/>\n<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\"><strong><span style=\"color: windowtext;\">Based on this information and your knowledge about biology, select true or false for each of the following statements.<\/span><\/strong><\/span><\/span><\/p>\n<\/div>","QuestionJS":false,"DefaultChoices":false,"QuestionType":"SBS","Selector":"SBSMatrix","Configuration":{"QuestionDescriptionOption":"UseText","ChoiceColumnWidthPixels":671,"RepeatHeaders":"none","ColumnOrder":[1,0]},"QuestionDescription":"One way that dwarfism occurs is from the premature inhibition of cell division in bone precursor...","Choices":{"1":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Other signaling pathways could also regulate expression of the <em>CYC<\/em> gene.<\/span><\/span>"},"2":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Dwarfism could be caused by a loss of function of the STAT protein.<\/span><\/span>"},"3":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">If FGF3 binds to the same FGF3 receptors on a different cell type, the FGF3 receptors on those cells could activate different downstream signaling pathways.<\/span><\/span>"},"4":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Phosphorylation of the STAT protein changes its shape in a way that allows it to bind to the <em>CYC<\/em> gene regulatory sequence.<\/span><\/span>"},"5":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">The phosphorylated STAT protein can bind as well as dissociate from the <em>CYC<\/em> regulatory sequence.<\/span><\/span>"}},"ChoiceOrder":[1,2,3,4,"5"],"Randomization":{"Type":"All","Advanced":null,"EvenPresentation":false,"TotalRandSubset":""},"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[{"ChoiceID":"4","AnswerID":"1","SeriesID":"1","Grades":{"SC1":"1"},"index":0},{"ChoiceID":"1","AnswerID":"1","SeriesID":"1","Grades":{"SC1":"1"},"index":1},{"ChoiceID":"2","AnswerID":"1","SeriesID":"2","Grades":{"SC1":"1"},"index":2},{"ChoiceID":"3","AnswerID":"1","SeriesID":"1","Grades":{"SC1":"1"},"index":3},{"ChoiceID":"5","AnswerID":"1","SeriesID":"1","Grades":{"SC1":"1"},"index":4}],"Language":[],"NumberOfQuestions":1,"AdditionalQuestions":{"1":{"QuestionText":"&nbsp;","Answers":{"1":{"Display":"True"},"2":{"Display":"False"}},"RecodeValues":{"1":"1","2":"2"},"VariableNaming":[],"AnalyzeChoices":[],"QuestionType":"Matrix","Selector":"Likert","SubSelector":"SingleAnswer","ChoiceColumnWidthPixels":null,"Configuration":{"ChoiceColumnWidthPixels":10,"QuestionDescriptionOption":"UseText"},"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[{"AnswerID":"1","ChoiceID":"4","Grades":{"SC1":"1"},"index":0},{"AnswerID":"1","ChoiceID":"1","Grades":{"SC1":"1"},"index":1},{"AnswerID":"2","ChoiceID":"2","Grades":{"SC1":"1"},"index":2},{"AnswerID":"1","ChoiceID":"3","Grades":{"SC1":"1"},"index":3},{"AnswerID":"1","ChoiceID":"5","Grades":{"SC1":"1"},"index":4}],"DataExportTag":"BM-12#1","QuestionID":"QID218#1","Choices":{"1":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Other signaling pathways could also regulate expression of the <em>CYC<\/em> gene.<\/span><\/span>"},"2":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Dwarfism could be caused by a loss of function of the STAT protein.<\/span><\/span>"},"3":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">If FGF3 binds to the same FGF3 receptors on a different cell type, the FGF3 receptors on those cells could activate different downstream signaling pathways.<\/span><\/span>"},"4":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Phosphorylation of the STAT protein changes its shape in a way that allows it to bind to the <em>CYC<\/em> gene regulatory sequence.<\/span><\/span>"},"5":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">The phosphorylated STAT protein can bind as well as dissociate from the <em>CYC<\/em> regulatory sequence.<\/span><\/span>"}},"ChoiceDataExportTags":false,"QuestionDescription":" "}},"ChoiceDataExportTags":false,"QuestionText_Unsafe":"<div>\n<p><span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">A single species of bacteria only spreads by physical contact between living birds of the same species.&nbsp; The bacteria infect the birds&rsquo; eyes and can cause inflammation leading to blindness and death.&nbsp; &nbsp;<br \/>\n&nbsp;<br \/>\nOver the past 15 years, the way this bacterial species infects and kills birds has shifted: an Eastern Canadian strain now causes severe infection and rapid death, while strains of the same species of bacteria that spread to Western Canada do not cause severe infection or death. &nbsp;Although birds in Western Canada do not experience severe infection and do not die, the Western bacterial strain still lives in these birds. Both strains of bacteria divide every 20 minutes, while birds take approximately 3 years to reach reproductive age.&nbsp;<\/span><\/span><br \/>\n&nbsp;<\/p>\n<\/div>\n\n<p><span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\"><strong><span style=\"color: windowtext;\">Based on this information and your knowledge about biology, select true or false for each of the following statements.<\/span><\/strong><\/span><\/span><\/p>","RecodeValues":{"1":"1"},"DataExportTag":"BM-12","QuestionID":"QID218"}},{"SurveyID":"SV_dnk8xGmFyNl56Dk","Element":"SQ","PrimaryAttribute":"QID219","SecondaryAttribute":"Timing","TertiaryAttribute":null,"Payload":{"QuestionText":"Timing","DefaultChoices":false,"QuestionType":"Timing","Selector":"PageTimer","Configuration":{"QuestionDescriptionOption":"UseText","MinSeconds":"0","MaxSeconds":"0"},"QuestionDescription":"Timing","Choices":{"1":{"Display":"First Click"},"2":{"Display":"Last Click"},"3":{"Display":"Page Submit"},"4":{"Display":"Click Count"}},"ChoiceOrder":["1","2","3"],"GradingData":[],"Language":[],"QuestionText_Unsafe":"Timing","DataExportTag":"T-BM-12","QuestionID":"QID219"}},{"SurveyID":"SV_dnk8xGmFyNl56Dk","Element":"SQ","PrimaryAttribute":"QID220","SecondaryAttribute":"There are several kinds of motor neurons in the adult spinal cord, all of which extend axons to d...","TertiaryAttribute":null,"Payload":{"QuestionText":"<div>\n<p><span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">There are several kinds of motor neurons in the adult spinal cord, all of which extend axons to different kinds of muscles. The left side of the figure below shows a normally developing neural tube and notochord. The notochord interacts with the neural tube, secreting a signaling molecule that influences the development of the neural tube. The right side of the figure shows the results of an experiment in which a developing neural tube is exposed to an extra set of notochord cells.<\/span><\/span><\/p>\n\n<p style=\"text-align: center;\"><br \/>\n<img src=\"https:\/\/ssp.qualtrics.com\/CP\/Graphic.php?IM=IM_4YLkYDgtZfQEmWx\" style=\"width: 700px; height: 309px;\" \/><\/p>\n\n<p><br \/>\n<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\"><strong><span style=\"color: windowtext;\">Based on this information and your knowledge about biology, select true or false for each of the following statements.<\/span><\/strong><\/span><\/span><\/p>\n<\/div>","QuestionJS":false,"DefaultChoices":false,"QuestionType":"SBS","Selector":"SBSMatrix","Configuration":{"QuestionDescriptionOption":"UseText","ChoiceColumnWidthPixels":671,"RepeatHeaders":"none","ColumnOrder":[1,0]},"QuestionDescription":"There are several kinds of motor neurons in the adult spinal cord, all of which extend axons to d...","Choices":{"1":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">The relative concentration of the signaling molecule secreted by the notochord can determine the identity of different kinds of cells in the neural tube.<\/span><\/span>"},"2":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Prior to notochord signaling, only cells in Region A have the potential to develop into motor neurons.<\/span><\/span>"},"3":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">The cells of the neural tube have a receptor that allows them to respond to the signal from the notochord.<\/span><\/span>"},"4":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Motor neurons move from the spinal cord through the blood to signal to the muscle cells.<\/span><\/span>"}},"ChoiceOrder":[1,2,3,4],"Randomization":{"Type":"All","Advanced":null,"EvenPresentation":false,"TotalRandSubset":""},"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[{"ChoiceID":"1","AnswerID":"1","SeriesID":"1","Grades":{"SC1":"1"},"index":0},{"ChoiceID":"2","AnswerID":"1","SeriesID":"2","Grades":{"SC1":"1"},"index":1},{"ChoiceID":"3","AnswerID":"1","SeriesID":"1","Grades":{"SC1":"1"},"index":2},{"ChoiceID":"4","AnswerID":"1","SeriesID":"2","Grades":{"SC1":"1"},"index":3}],"Language":[],"NumberOfQuestions":1,"AdditionalQuestions":{"1":{"QuestionText":"&nbsp;","Answers":{"1":{"Display":"True"},"2":{"Display":"False"}},"RecodeValues":{"1":"1","2":"2"},"VariableNaming":[],"AnalyzeChoices":[],"QuestionType":"Matrix","Selector":"Likert","SubSelector":"SingleAnswer","ChoiceColumnWidthPixels":null,"Configuration":{"ChoiceColumnWidthPixels":10,"QuestionDescriptionOption":"UseText"},"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[{"AnswerID":"1","ChoiceID":"1","Grades":{"SC1":"1"},"index":0},{"AnswerID":"2","ChoiceID":"2","Grades":{"SC1":"1"},"index":1},{"AnswerID":"1","ChoiceID":"3","Grades":{"SC1":"1"},"index":2},{"AnswerID":"2","ChoiceID":"4","Grades":{"SC1":"1"},"index":3}],"DataExportTag":"BM-13#1","QuestionID":"QID220#1","Choices":{"1":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">The relative concentration of the signaling molecule secreted by the notochord can determine the identity of different kinds of cells in the neural tube.<\/span><\/span>"},"2":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Prior to notochord signaling, only cells in Region A have the potential to develop into motor neurons.<\/span><\/span>"},"3":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">The cells of the neural tube have a receptor that allows them to respond to the signal from the notochord.<\/span><\/span>"},"4":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Motor neurons move from the spinal cord through the blood to signal to the muscle cells.<\/span><\/span>"}},"ChoiceDataExportTags":false,"QuestionDescription":" "}},"ChoiceDataExportTags":false,"QuestionText_Unsafe":"<div>\n<p><span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">One way that dwarfism occurs is from the premature inhibition of cell division in bone precursor cells, controlled by the signaling pathway shown in the diagram below.&nbsp; Fibroblast Growth Factor 3 (FGF3) binds to the FGF3 receptor, triggering the phosphorylation of the STAT transcription activator.&nbsp; Phosphorylated STAT then binds to the regulatory region of the <em>CYC<\/em> gene and activates transcription of the <em>CYC<\/em> gene.&nbsp; The <em>CYC<\/em> gene product inhibits cell division.&nbsp; The bent arrow indicates the start site of transcription.<\/span><\/span><br>\n&nbsp;<\/p>\n\n<p style=\"text-align: center;\"><span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">INSERT FIGURE HERE<\/span><\/span><\/p><p style=\"text-align: center;\"><span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\"><br><\/span><\/span><\/p>\n<\/div>\n\n<p><span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\"><strong><span style=\"color: windowtext;\">Based on this information and your knowledge about biology, select true or false for each of the following statements.<\/span><\/strong><\/span><\/span><\/p>","RecodeValues":{"1":"1"},"DataExportTag":"BM-13","QuestionID":"QID220"}},{"SurveyID":"SV_dnk8xGmFyNl56Dk","Element":"SQ","PrimaryAttribute":"QID221","SecondaryAttribute":"Timing","TertiaryAttribute":null,"Payload":{"QuestionText":"Timing","DefaultChoices":false,"QuestionType":"Timing","Selector":"PageTimer","Configuration":{"QuestionDescriptionOption":"UseText","MinSeconds":"0","MaxSeconds":"0"},"QuestionDescription":"Timing","Choices":{"1":{"Display":"First Click"},"2":{"Display":"Last Click"},"3":{"Display":"Page Submit"},"4":{"Display":"Click Count"}},"ChoiceOrder":["1","2","3"],"GradingData":[],"Language":[],"QuestionText_Unsafe":"Timing","DataExportTag":"T-BM-13","QuestionID":"QID221"}},{"SurveyID":"SV_dnk8xGmFyNl56Dk","Element":"SQ","PrimaryAttribute":"QID222","SecondaryAttribute":"The phylogenetic trees below are based on DNA sequence data.\u00a0\u00a0 Based on this information and your.","TertiaryAttribute":null,"Payload":{"QuestionText":"<div>\n<p><span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">The phylogenetic trees below are based on DNA sequence data.&nbsp;&nbsp;<\/span><\/span><\/p>\n\n<p style=\"text-align: center;\"><br \/>\n<img src=\"https:\/\/ssp.qualtrics.com\/CP\/Graphic.php?IM=IM_3xGK2nFIqw4ijRj\" style=\"width: 600px; height: 280px;\" \/><\/p>\n\n<p><br \/>\n<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\"><strong><span style=\"color: windowtext;\">Based on this information and your knowledge about biology, select true or false for each of the following statements.<\/span><\/strong><\/span><\/span><\/p>\n<\/div>","QuestionJS":false,"DefaultChoices":false,"QuestionType":"SBS","Selector":"SBSMatrix","Configuration":{"QuestionDescriptionOption":"UseText","ChoiceColumnWidthPixels":671,"RepeatHeaders":"none","ColumnOrder":[1,0]},"QuestionDescription":"The phylogenetic trees below are based on DNA sequence data.\u00a0\u00a0 Based on this information and your...","Choices":{"1":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">In Tree #1, turtles share a more recent common ancestor with snakes than with birds.<\/span><\/span>"},"2":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Tree #1 shows that lizards evolved from snakes.<\/span><\/span>"},"3":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Based on these phylogenies, it is most likely that legs were lost only in the lineage that gave rise to snakes.<\/span><\/span>"},"4":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">The evolutionary relationships shown in Tree #1 are the same as the evolutionary relationships shown in Tree #2.<\/span><\/span>"}},"ChoiceOrder":[1,2,3,4],"Randomization":{"Type":"All","Advanced":null,"EvenPresentation":false,"TotalRandSubset":""},"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[{"ChoiceID":"4","AnswerID":"1","SeriesID":"1","Grades":{"SC1":"1"},"index":0},{"ChoiceID":"1","AnswerID":"1","SeriesID":"2","Grades":{"SC1":"1"},"index":1},{"ChoiceID":"2","AnswerID":"1","SeriesID":"2","Grades":{"SC1":"1"},"index":2},{"ChoiceID":"3","AnswerID":"1","SeriesID":"1","Grades":{"SC1":"1"},"index":3}],"Language":[],"NumberOfQuestions":1,"AdditionalQuestions":{"1":{"QuestionText":"&nbsp;","Answers":{"1":{"Display":"True"},"2":{"Display":"False"}},"RecodeValues":{"1":"1","2":"2"},"VariableNaming":[],"AnalyzeChoices":[],"QuestionType":"Matrix","Selector":"Likert","SubSelector":"SingleAnswer","ChoiceColumnWidthPixels":null,"Configuration":{"ChoiceColumnWidthPixels":10,"QuestionDescriptionOption":"UseText"},"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[{"AnswerID":"1","ChoiceID":"4","Grades":{"SC1":"1"},"index":0},{"AnswerID":"2","ChoiceID":"1","Grades":{"SC1":"1"},"index":1},{"AnswerID":"2","ChoiceID":"2","Grades":{"SC1":"1"},"index":2},{"AnswerID":"1","ChoiceID":"3","Grades":{"SC1":"1"},"index":3}],"DataExportTag":"BM-14#1","QuestionID":"QID222#1","Choices":{"1":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">In Tree #1, turtles share a more recent common ancestor with snakes than with birds.<\/span><\/span>"},"2":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Tree #1 shows that lizards evolved from snakes.<\/span><\/span>"},"3":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Based on these phylogenies, it is most likely that legs were lost only in the lineage that gave rise to snakes.<\/span><\/span>"},"4":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">The evolutionary relationships shown in Tree #1 are the same as the evolutionary relationships shown in Tree #2.<\/span><\/span>"}},"ChoiceDataExportTags":false,"QuestionDescription":" "}},"ChoiceDataExportTags":false,"QuestionText_Unsafe":"<div>\n<p><span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">There are several kinds of motor neurons in the adult spinal cord, all of which extend axons to different kinds of muscles. The left side of the figure below shows a normally developing neural tube and notochord. The notochord interacts with the neural tube, secreting a signaling molecule that influences the development of the neural tube. The right side of the figure shows the results of an experiment in which a developing neural tube is exposed to an extra set of notochord cells.<\/span><\/span><br \/>\n<br \/>\n&nbsp;<\/p>\n\n<p style=\"text-align: center;\"><span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">INSERT FIGURE HERE<\/span><\/span><\/p>\n\n<p style=\"text-align: center;\">&nbsp;<\/p>\n<\/div>\n\n<p><span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\"><strong><span style=\"color: windowtext;\">Based on this information and your knowledge about biology, select true or false for each of the following statements.<\/span><\/strong><\/span><\/span><\/p>","RecodeValues":{"1":"1"},"DataExportTag":"BM-14","QuestionID":"QID222"}},{"SurveyID":"SV_dnk8xGmFyNl56Dk","Element":"SQ","PrimaryAttribute":"QID223","SecondaryAttribute":"Timing","TertiaryAttribute":null,"Payload":{"QuestionText":"Timing","DefaultChoices":false,"QuestionType":"Timing","Selector":"PageTimer","Configuration":{"QuestionDescriptionOption":"UseText","MinSeconds":"0","MaxSeconds":"0"},"QuestionDescription":"Timing","Choices":{"1":{"Display":"First Click"},"2":{"Display":"Last Click"},"3":{"Display":"Page Submit"},"4":{"Display":"Click Count"}},"ChoiceOrder":["1","2","3"],"GradingData":[],"Language":[],"QuestionText_Unsafe":"Timing","DataExportTag":"T-BM-14","QuestionID":"QID223"}},{"SurveyID":"SV_dnk8xGmFyNl56Dk","Element":"SQ","PrimaryAttribute":"QID224","SecondaryAttribute":"An island had two small populations of lizard species: the spiny lizard occupied the trees and th...","TertiaryAttribute":null,"Payload":{"QuestionText":"<div>\n<p><span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">An island had two small populations of lizard species: the spiny lizard occupied the trees and the horned lizard occupied the ground as shown below.&nbsp; A hurricane caused a tidal surge, killing all of the horned lizards.<br \/>\n&nbsp;<br \/>\nImmediately after the hurricane, individual spiny lizards could be found moving between the trees and the ground.&nbsp; Ten years later, a small number of horned lizards naturally repopulated the island, and it took three additional years for their population size to stabilize. &nbsp;During these three years, as the horned lizard population increased on the ground, the spiny lizard population decreased on the ground.&nbsp; Neither lizard species preys upon the other lizard species.<\/span><\/span><\/p>\n\n<p style=\"text-align: center;\"><br \/>\n<img src=\"https:\/\/ssp.qualtrics.com\/CP\/Graphic.php?IM=IM_eb7im1LjpAms9qR\" style=\"width: 400px; height: 189px;\" \/><\/p>\n\n<p><br \/>\n<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\"><strong><span style=\"color: windowtext;\">Based on this information and your knowledge about biology, select true or false for each of the following statements.<\/span><\/strong><\/span><\/span><\/p>\n<\/div>","QuestionJS":false,"DefaultChoices":false,"QuestionType":"SBS","Selector":"SBSMatrix","Configuration":{"QuestionDescriptionOption":"UseText","ChoiceColumnWidthPixels":671,"RepeatHeaders":"none","ColumnOrder":[1,0]},"QuestionDescription":"An island had two small populations of lizard species: the spiny lizard occupied the trees and th...","Choices":{"1":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Before the hurricane, the spiny lizard was capable of surviving and reproducing on the ground in the absence of the horned lizard.<\/span><\/span>"},"2":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">For several years before the hurricane, allele frequencies likely remained the same in the spiny lizard population.<\/span><\/span>"},"3":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Horned lizards likely outcompete spiny lizards on the ground.<\/span><\/span>"},"4":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">During the ten years when individual spiny lizards could be found moving between the trees and the ground, the spiny lizards likely diverged into two different species.<\/span><\/span>"}},"ChoiceOrder":[1,2,3,4],"Randomization":{"Type":"All","Advanced":null,"EvenPresentation":false,"TotalRandSubset":""},"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[{"ChoiceID":"1","AnswerID":"1","SeriesID":"1","Grades":{"SC1":"1"},"index":0},{"ChoiceID":"2","AnswerID":"1","SeriesID":"2","Grades":{"SC1":"1"},"index":1},{"ChoiceID":"3","AnswerID":"1","SeriesID":"1","Grades":{"SC1":"1"},"index":2},{"ChoiceID":"4","AnswerID":"1","SeriesID":"2","Grades":{"SC1":"1"},"index":3}],"Language":[],"NumberOfQuestions":1,"AdditionalQuestions":{"1":{"QuestionText":"&nbsp;","Answers":{"1":{"Display":"True"},"2":{"Display":"False"}},"RecodeValues":{"1":"1","2":"2"},"VariableNaming":[],"AnalyzeChoices":[],"QuestionType":"Matrix","Selector":"Likert","SubSelector":"SingleAnswer","ChoiceColumnWidthPixels":null,"Configuration":{"ChoiceColumnWidthPixels":10,"QuestionDescriptionOption":"UseText"},"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[{"AnswerID":"1","ChoiceID":"1","Grades":{"SC1":"1"},"index":0},{"AnswerID":"2","ChoiceID":"2","Grades":{"SC1":"1"},"index":1},{"AnswerID":"1","ChoiceID":"3","Grades":{"SC1":"1"},"index":2},{"AnswerID":"2","ChoiceID":"4","Grades":{"SC1":"1"},"index":3}],"DataExportTag":"BM-15#1","QuestionID":"QID224#1","Choices":{"1":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Before the hurricane, the spiny lizard was capable of surviving and reproducing on the ground in the absence of the horned lizard.<\/span><\/span>"},"2":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">For several years before the hurricane, allele frequencies likely remained the same in the spiny lizard population.<\/span><\/span>"},"3":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Horned lizards likely outcompete spiny lizards on the ground.<\/span><\/span>"},"4":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">During the ten years when individual spiny lizards could be found moving between the trees and the ground, the spiny lizards likely diverged into two different species.<\/span><\/span>"}},"ChoiceDataExportTags":false,"QuestionDescription":" "}},"ChoiceDataExportTags":false,"QuestionText_Unsafe":"<div>\n<p><span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">The phylogenetic trees below are based on DNA sequence data.&nbsp;&nbsp;<\/span><\/span><br \/>\n<br \/>\n&nbsp;<\/p>\n\n<p style=\"text-align: center;\"><span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">INSERT FIGURE HERE<\/span><\/span><\/p>\n\n<p style=\"text-align: center;\">&nbsp;<\/p>\n<\/div>\n\n<p><span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\"><strong><span style=\"color: windowtext;\">Based on this information and your knowledge about biology, select true or false for each of the following statements.<\/span><\/strong><\/span><\/span><\/p>","RecodeValues":{"1":"1"},"DataExportTag":"BM-15","QuestionID":"QID224"}},{"SurveyID":"SV_dnk8xGmFyNl56Dk","Element":"SQ","PrimaryAttribute":"QID225","SecondaryAttribute":"Timing","TertiaryAttribute":null,"Payload":{"QuestionText":"Timing","DefaultChoices":false,"QuestionType":"Timing","Selector":"PageTimer","Configuration":{"QuestionDescriptionOption":"UseText","MinSeconds":"0","MaxSeconds":"0"},"QuestionDescription":"Timing","Choices":{"1":{"Display":"First Click"},"2":{"Display":"Last Click"},"3":{"Display":"Page Submit"},"4":{"Display":"Click Count"}},"ChoiceOrder":["1","2","3"],"GradingData":[],"Language":[],"QuestionText_Unsafe":"Timing","DataExportTag":"T-BM-15","QuestionID":"QID225"}},{"SurveyID":"SV_dnk8xGmFyNl56Dk","Element":"SQ","PrimaryAttribute":"QID226","SecondaryAttribute":"In the diagram below, the arrowheads point to consumers.\u00a0 For example, toads are eaten by snakes...","TertiaryAttribute":null,"Payload":{"QuestionText":"<div>\n<p><span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">In the diagram below, the arrowheads point to consumers.&nbsp; For example, toads are eaten by snakes.&nbsp; Biomass refers to the total mass of living biological material, excluding water.&nbsp; For this question, assume that no other outside organisms affect the biomass or population sizes of the organisms shown.&nbsp;&nbsp;<\/span><\/span><\/p>\n\n<p style=\"text-align: center;\"><br \/>\n<img src=\"https:\/\/ssp.qualtrics.com\/CP\/Graphic.php?IM=IM_71ytwfu9aQAX4a1\" style=\"width: 250px; height: 200px;\" \/><\/p>\n\n<p><br \/>\n<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\"><strong><span style=\"color: windowtext;\">Based on this information and your knowledge about biology, select true or false for each of the following statements.<\/span><\/strong><\/span><\/span><\/p>\n<\/div>","QuestionJS":false,"DefaultChoices":false,"QuestionType":"SBS","Selector":"SBSMatrix","Configuration":{"QuestionDescriptionOption":"UseText","ChoiceColumnWidthPixels":671,"RepeatHeaders":"none","ColumnOrder":[1,0]},"QuestionDescription":"In the diagram below, the arrowheads point to consumers.\u00a0 For example, toads are eaten by snakes....","Choices":{"1":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Assuming there is an abundance of clover, the mouse population size would likely increase if most of the hawks were eliminated from this environment.<\/span><\/span>"},"2":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">If more toads were added to this ecosystem, the number of grasshoppers and spiders would likely decrease before the number of sparrows decreases.<\/span><\/span>","InputWidth":30},"3":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">If a field of clover is sprayed with a chemical that cannot be broken down, over time grasshoppers will likely accumulate a higher concentration of this chemical than hawks.<\/span><\/span>"},"4":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Over the course of one year, the amount of grasshopper biomass produced is greater than the amount of snake biomass produced.<\/span><\/span>"}},"ChoiceOrder":[1,2,3,4],"Randomization":{"Type":"All","Advanced":null,"EvenPresentation":false,"TotalRandSubset":""},"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[{"ChoiceID":"4","AnswerID":"1","SeriesID":"1","Grades":{"SC1":"1"},"index":0},{"ChoiceID":"2","AnswerID":"1","SeriesID":"1","Grades":{"SC1":"1"},"index":1},{"ChoiceID":"3","AnswerID":"1","SeriesID":"2","Grades":{"SC1":"1"},"index":2},{"ChoiceID":"1","AnswerID":"1","SeriesID":"1","Grades":{"SC1":"1"},"index":3}],"Language":[],"NumberOfQuestions":1,"AdditionalQuestions":{"1":{"QuestionText":"&nbsp;","Answers":{"1":{"Display":"True"},"2":{"Display":"False"}},"RecodeValues":{"1":"1","2":"2"},"VariableNaming":[],"AnalyzeChoices":[],"QuestionType":"Matrix","Selector":"Likert","SubSelector":"SingleAnswer","ChoiceColumnWidthPixels":null,"Configuration":{"ChoiceColumnWidthPixels":10,"QuestionDescriptionOption":"UseText"},"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[{"AnswerID":"1","ChoiceID":"4","Grades":{"SC1":"1"},"index":0},{"AnswerID":"1","ChoiceID":"2","Grades":{"SC1":"1"},"index":1},{"AnswerID":"2","ChoiceID":"3","Grades":{"SC1":"1"},"index":2},{"AnswerID":"1","ChoiceID":"1","Grades":{"SC1":"1"},"index":3}],"DataExportTag":"BM-16#1","QuestionID":"QID226#1","Choices":{"1":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Assuming there is an abundance of clover, the mouse population size would likely increase if most of the hawks were eliminated from this environment.<\/span><\/span>"},"2":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">If more toads were added to this ecosystem, the number of grasshoppers and spiders would likely decrease before the number of sparrows decreases.<\/span><\/span>","InputWidth":30},"3":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">If a field of clover is sprayed with a chemical that cannot be broken down, over time grasshoppers will likely accumulate a higher concentration of this chemical than hawks.<\/span><\/span>"},"4":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Over the course of one year, the amount of grasshopper biomass produced is greater than the amount of snake biomass produced.<\/span><\/span>"}},"ChoiceDataExportTags":false,"QuestionDescription":" "}},"ChoiceDataExportTags":false,"QuestionText_Unsafe":"<div>\n<p><span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">An island had two small populations of lizard species: the spiny lizard occupied the trees and the horned lizard occupied the ground as shown below.&nbsp; A hurricane caused a tidal surge, killing all of the horned lizards.<br \/>\n&nbsp;<br \/>\nImmediately after the hurricane, individual spiny lizards could be found moving between the trees and the ground.&nbsp; Ten years later, a small number of horned lizards naturally repopulated the island, and it took three additional years for their population size to stabilize. &nbsp;During these three years, as the horned lizard population increased on the ground, the spiny lizard population decreased on the ground.&nbsp; Neither lizard species preys upon the other lizard species.<\/span><\/span><br \/>\n<br \/>\n<br \/>\n&nbsp;<\/p>\n\n<p style=\"text-align: center;\"><span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">INSERT FIGURE HERE<\/span><\/span><\/p>\n\n<p style=\"text-align: center;\">&nbsp;<\/p>\n<\/div>\n\n<p><span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\"><strong><span style=\"color: windowtext;\">Based on this information and your knowledge about biology, select true or false for each of the following statements.<\/span><\/strong><\/span><\/span><\/p>","RecodeValues":{"1":"1"},"DataExportTag":"BM-16","QuestionID":"QID226"}},{"SurveyID":"SV_dnk8xGmFyNl56Dk","Element":"SQ","PrimaryAttribute":"QID227","SecondaryAttribute":"Timing","TertiaryAttribute":null,"Payload":{"QuestionText":"Timing","DefaultChoices":false,"QuestionType":"Timing","Selector":"PageTimer","Configuration":{"QuestionDescriptionOption":"UseText","MinSeconds":"0","MaxSeconds":"0"},"QuestionDescription":"Timing","Choices":{"1":{"Display":"First Click"},"2":{"Display":"Last Click"},"3":{"Display":"Page Submit"},"4":{"Display":"Click Count"}},"ChoiceOrder":["1","2","3"],"GradingData":[],"Language":[],"QuestionText_Unsafe":"Timing","DataExportTag":"T-BM-16","QuestionID":"QID227"}},{"SurveyID":"SV_dnk8xGmFyNl56Dk","Element":"SQ","PrimaryAttribute":"QID230","SecondaryAttribute":"A protein exists in two forms that differ only in their folded shapes.\u00a0 Form A is found in normal..","TertiaryAttribute":null,"Payload":{"QuestionText":"<div>\n<p><span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">A protein exists in two forms that differ only in their folded shapes.&nbsp; Form A is found in normal brain tissue and performs normal cellular processes.&nbsp; Form B is found in animals with certain brain diseases and is thought to play a causative role in these diseases.&nbsp; Form B is infectious, meaning that when it is introduced to normal brain tissue, it can cause Form A to be converted to Form B, thereby increasing the amount of the disease form.&nbsp;<\/span><\/span><br \/>\n&nbsp;<\/p>\n<\/div>\n\n<p><span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\"><strong><span style=\"color: windowtext;\">Based on this information and your knowledge about biology, select true or false for each of the following statements.<\/span><\/strong><\/span><\/span><\/p>","QuestionJS":false,"DefaultChoices":false,"QuestionType":"SBS","Selector":"SBSMatrix","Configuration":{"QuestionDescriptionOption":"UseText","ChoiceColumnWidthPixels":671,"RepeatHeaders":"none","ColumnOrder":[1,0]},"QuestionDescription":"A protein exists in two forms that differ only in their folded shapes.\u00a0 Form A is found in normal...","Choices":{"1":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Form A likely functions differently than Form B because they have different shapes.<\/span><\/span>"},"2":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Form A and Form B folding are determined entirely by their amino acid sequences.<\/span><\/span>"},"3":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Form A and Form B must be expressed from two different genes.<\/span><\/span>"},"4":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Form A to Form B conversion likely requires a change in Form A&rsquo;s amino acid sequence.<\/span><\/span>"}},"ChoiceOrder":[1,2,3,4],"Randomization":{"Type":"All","Advanced":null,"EvenPresentation":false,"TotalRandSubset":""},"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[{"ChoiceID":"3","AnswerID":"1","SeriesID":"2","Grades":{"SC1":"1"},"index":0},{"ChoiceID":"1","AnswerID":"1","SeriesID":"1","Grades":{"SC1":"1"},"index":1},{"ChoiceID":"2","AnswerID":"1","SeriesID":"2","Grades":{"SC1":"1"},"index":2},{"ChoiceID":"4","AnswerID":"1","SeriesID":"2","Grades":{"SC1":"1"},"index":3}],"Language":[],"NumberOfQuestions":1,"AdditionalQuestions":{"1":{"QuestionText":"&nbsp;","Answers":{"1":{"Display":"True"},"2":{"Display":"False"}},"RecodeValues":{"1":"1","2":"2"},"VariableNaming":[],"AnalyzeChoices":[],"QuestionType":"Matrix","Selector":"Likert","SubSelector":"SingleAnswer","ChoiceColumnWidthPixels":null,"Configuration":{"ChoiceColumnWidthPixels":10,"QuestionDescriptionOption":"UseText"},"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[{"AnswerID":"2","ChoiceID":"3","Grades":{"SC1":"1"},"index":0},{"AnswerID":"1","ChoiceID":"1","Grades":{"SC1":"1"},"index":1},{"AnswerID":"2","ChoiceID":"2","Grades":{"SC1":"1"},"index":2},{"AnswerID":"2","ChoiceID":"4","Grades":{"SC1":"1"},"index":3}],"DataExportTag":"BM-18#1","QuestionID":"QID230#1","Choices":{"1":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Form A likely functions differently than Form B because they have different shapes.<\/span><\/span>"},"2":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Form A and Form B folding are determined entirely by their amino acid sequences.<\/span><\/span>"},"3":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Form A and Form B must be expressed from two different genes.<\/span><\/span>"},"4":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Form A to Form B conversion likely requires a change in Form A&rsquo;s amino acid sequence.<\/span><\/span>"}},"ChoiceDataExportTags":false,"QuestionDescription":" "}},"ChoiceDataExportTags":false,"QuestionText_Unsafe":"<div>\n<p><span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">A single species of bacteria only spreads by physical contact between living birds of the same species.&nbsp; The bacteria infect the birds&rsquo; eyes and can cause inflammation leading to blindness and death.&nbsp; &nbsp;<br \/>\n&nbsp;<br \/>\nOver the past 15 years, the way this bacterial species infects and kills birds has shifted: an Eastern Canadian strain now causes severe infection and rapid death, while strains of the same species of bacteria that spread to Western Canada do not cause severe infection or death. &nbsp;Although birds in Western Canada do not experience severe infection and do not die, the Western bacterial strain still lives in these birds. Both strains of bacteria divide every 20 minutes, while birds take approximately 3 years to reach reproductive age.&nbsp;<\/span><\/span><br \/>\n&nbsp;<\/p>\n<\/div>\n\n<p><span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\"><strong><span style=\"color: windowtext;\">Based on this information and your knowledge about biology, select true or false for each of the following statements.<\/span><\/strong><\/span><\/span><\/p>","RecodeValues":{"1":"1"},"DataExportTag":"BM-18","QuestionID":"QID230"}},{"SurveyID":"SV_dnk8xGmFyNl56Dk","Element":"SQ","PrimaryAttribute":"QID231","SecondaryAttribute":"Timing","TertiaryAttribute":null,"Payload":{"QuestionText":"Timing","DefaultChoices":false,"QuestionType":"Timing","Selector":"PageTimer","Configuration":{"QuestionDescriptionOption":"UseText","MinSeconds":"0","MaxSeconds":"0"},"QuestionDescription":"Timing","Choices":{"1":{"Display":"First Click"},"2":{"Display":"Last Click"},"3":{"Display":"Page Submit"},"4":{"Display":"Click Count"}},"ChoiceOrder":["1","2","3"],"GradingData":[],"Language":[],"QuestionText_Unsafe":"Timing","DataExportTag":"T-BM-18","QuestionID":"QID231"}},{"SurveyID":"SV_dnk8xGmFyNl56Dk","Element":"SQ","PrimaryAttribute":"QID232","SecondaryAttribute":"SRY is a protein that binds to certain DNA sequences and activates genes involved in male sexual...","TertiaryAttribute":null,"Payload":{"QuestionText":"<div>\n<p><span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">SRY is a protein that binds to certain DNA sequences and activates genes involved in male sexual development.&nbsp; Mutations in the <em>SRY<\/em> gene can result in abnormal sexual development and possible fertility issues.&nbsp; To investigate this phenomenon, separate cells are constructed to express either normal or mutant SRY protein.&nbsp; The relative amount of SRY protein located in the nucleus and cytoplasm of these cells is shown below.<\/span><\/span><\/p>\n\n<p style=\"text-align: center;\"><br \/>\n<img src=\"https:\/\/ssp.qualtrics.com\/CP\/Graphic.php?IM=IM_5aoHcgfjtqiYQo5\" style=\"width: 400px; height: 207px;\" \/><\/p>\n\n<p><br \/>\n<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\"><strong><span style=\"color: windowtext;\">Based on this information and your knowledge about biology, select true or false for each of the following statements.<\/span><\/strong><\/span><\/span><\/p>\n<\/div>","QuestionJS":false,"DefaultChoices":false,"QuestionType":"SBS","Selector":"SBSMatrix","Configuration":{"QuestionDescriptionOption":"UseText","ChoiceColumnWidthPixels":671,"RepeatHeaders":"none","ColumnOrder":[1,0]},"QuestionDescription":"SRY is a protein that binds to certain DNA sequences and activates genes involved in male sexual...","Choices":{"1":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Normal SRY protein is made in the nucleus.<\/span><\/span>"},"2":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">The mutant <em>SRY<\/em> gene is unable to be transcribed in the nucleus.<\/span><\/span>"},"3":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Mutant SRY protein is likely less able to be imported into the nucleus.<\/span><\/span>"},"4":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Normal SRY protein will be more likely to directly activate genes than the mutant SRY protein.<\/span><\/span>"}},"ChoiceOrder":[1,2,3,4],"Randomization":{"Type":"All","Advanced":null,"EvenPresentation":false,"TotalRandSubset":""},"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[{"ChoiceID":"4","AnswerID":"1","SeriesID":"1","Grades":{"SC1":"1"},"index":0},{"ChoiceID":"1","AnswerID":"1","SeriesID":"2","Grades":{"SC1":"1"},"index":1},{"ChoiceID":"2","AnswerID":"1","SeriesID":"2","Grades":{"SC1":"1"},"index":2},{"ChoiceID":"3","AnswerID":"1","SeriesID":"1","Grades":{"SC1":"1"},"index":3}],"Language":[],"NumberOfQuestions":1,"AdditionalQuestions":{"1":{"QuestionText":"&nbsp;","Answers":{"1":{"Display":"True"},"2":{"Display":"False"}},"RecodeValues":{"1":"1","2":"2"},"VariableNaming":[],"AnalyzeChoices":[],"QuestionType":"Matrix","Selector":"Likert","SubSelector":"SingleAnswer","ChoiceColumnWidthPixels":null,"Configuration":{"ChoiceColumnWidthPixels":10,"QuestionDescriptionOption":"UseText"},"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[{"AnswerID":"1","ChoiceID":"4","Grades":{"SC1":"1"},"index":0},{"AnswerID":"2","ChoiceID":"1","Grades":{"SC1":"1"},"index":1},{"AnswerID":"2","ChoiceID":"2","Grades":{"SC1":"1"},"index":2},{"AnswerID":"1","ChoiceID":"3","Grades":{"SC1":"1"},"index":3}],"DataExportTag":"BM-19#1","QuestionID":"QID232#1","Choices":{"1":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Normal SRY protein is made in the nucleus.<\/span><\/span>"},"2":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">The mutant <em>SRY<\/em> gene is unable to be transcribed in the nucleus.<\/span><\/span>"},"3":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Mutant SRY protein is likely less able to be imported into the nucleus.<\/span><\/span>"},"4":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Normal SRY protein will be more likely to directly activate genes than the mutant SRY protein.<\/span><\/span>"}},"ChoiceDataExportTags":false,"QuestionDescription":" "}},"ChoiceDataExportTags":false,"QuestionText_Unsafe":"<div>\n<p><span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">A protein exists in two forms that differ only in their folded shapes.&nbsp; Form A is found in normal brain tissue and performs normal cellular processes.&nbsp; Form B is found in animals with certain brain diseases and is thought to play a causative role in these diseases.&nbsp; Form B is infectious, meaning that when it is introduced to normal brain tissue, it can cause Form A to be converted to Form B, thereby increasing the amount of the disease form.&nbsp;<\/span><\/span><br \/>\n&nbsp;<\/p>\n<\/div>\n\n<p><span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\"><strong><span style=\"color: windowtext;\">Based on this information and your knowledge about biology, select true or false for each of the following statements.<\/span><\/strong><\/span><\/span><\/p>","RecodeValues":{"1":"1"},"DataExportTag":"BM-19","QuestionID":"QID232"}},{"SurveyID":"SV_dnk8xGmFyNl56Dk","Element":"SQ","PrimaryAttribute":"QID233","SecondaryAttribute":"Timing","TertiaryAttribute":null,"Payload":{"QuestionText":"Timing","DefaultChoices":false,"QuestionType":"Timing","Selector":"PageTimer","Configuration":{"QuestionDescriptionOption":"UseText","MinSeconds":"0","MaxSeconds":"0"},"QuestionDescription":"Timing","Choices":{"1":{"Display":"First Click"},"2":{"Display":"Last Click"},"3":{"Display":"Page Submit"},"4":{"Display":"Click Count"}},"ChoiceOrder":["1","2","3"],"GradingData":[],"Language":[],"QuestionText_Unsafe":"Timing","DataExportTag":"T-BM-19","QuestionID":"QID233"}},{"SurveyID":"SV_dnk8xGmFyNl56Dk","Element":"SQ","PrimaryAttribute":"QID236","SecondaryAttribute":"Red blood cells (RBCs) are full of hemoglobin, a protein that allows them to carry oxygen.\u00a0 Durin..","TertiaryAttribute":null,"Payload":{"QuestionText":"<div>\n<p><span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Red blood cells (RBCs) are full of hemoglobin, a protein that allows them to carry oxygen.&nbsp; During the maturation process of typical mammalian RBCs, a precursor cell loses its nucleus as well as many organelles, including mitochondria.&nbsp; Though mature RBCs are smaller than precursor cells, they can carry more hemoglobin proteins as a result of this maturation process.&nbsp; Individuals within a species have natural variation in the concentration of hemoglobin in their mature RBCs.&nbsp;&nbsp; <\/span><\/span><\/p>\n\n<p style=\"text-align: center;\"><br \/>\n<img src=\"https:\/\/ssp.qualtrics.com\/CP\/Graphic.php?IM=IM_4O6UwilaJWhVebX\" style=\"width: 400px; height: 187px;\" \/><\/p>\n\n<p><br \/>\n<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\"><strong><span style=\"color: windowtext;\">Based on this information and your knowledge about biology, select true or false for each of the following statements.<\/span><\/strong><\/span><\/span><\/p>\n<\/div>","QuestionJS":false,"DefaultChoices":false,"QuestionType":"SBS","Selector":"SBSMatrix","Configuration":{"QuestionDescriptionOption":"UseText","ChoiceColumnWidthPixels":671,"RepeatHeaders":"none","ColumnOrder":[1,0]},"QuestionDescription":"Red blood cells (RBCs) are full of hemoglobin, a protein that allows them to carry oxygen.\u00a0 Durin...","Choices":{"1":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Mature RBCs are no longer able to produce new mRNA molecules.<\/span><\/span>"},"2":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Mature RBCs have a surface-area-to-volume ratio that is less than that of the precursor cells.<\/span><\/span>"},"3":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Mature RBCs can undergo mitosis to produce additional RBCs.<\/span><\/span>"},"4":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Precursor cells are better able to travel through capillaries than mature RBCs.<\/span><\/span>"},"5":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">All else being equal, in populations living at high altitudes, natural selection would likely favor individuals with a higher concentration of hemoglobin in their mature RBCs.<\/span><\/span>"}},"ChoiceOrder":[1,2,3,4,"5"],"Randomization":{"Type":"All","Advanced":null,"EvenPresentation":false,"TotalRandSubset":""},"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[{"ChoiceID":"3","AnswerID":"1","SeriesID":"2","Grades":{"SC1":"1"},"index":0},{"ChoiceID":"1","AnswerID":"1","SeriesID":"1","Grades":{"SC1":"1"},"index":1},{"ChoiceID":"2","AnswerID":"1","SeriesID":"2","Grades":{"SC1":"1"},"index":2},{"ChoiceID":"4","AnswerID":"1","SeriesID":"2","Grades":{"SC1":"1"},"index":3},{"ChoiceID":"5","AnswerID":"1","SeriesID":"1","Grades":{"SC1":"1"},"index":4}],"Language":[],"NumberOfQuestions":1,"AdditionalQuestions":{"1":{"QuestionText":"&nbsp;","Answers":{"1":{"Display":"True"},"2":{"Display":"False"}},"RecodeValues":{"1":"1","2":"2"},"VariableNaming":[],"AnalyzeChoices":[],"QuestionType":"Matrix","Selector":"Likert","SubSelector":"SingleAnswer","ChoiceColumnWidthPixels":null,"Configuration":{"ChoiceColumnWidthPixels":10,"QuestionDescriptionOption":"UseText"},"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[{"AnswerID":"2","ChoiceID":"3","Grades":{"SC1":"1"},"index":0},{"AnswerID":"1","ChoiceID":"1","Grades":{"SC1":"1"},"index":1},{"AnswerID":"2","ChoiceID":"2","Grades":{"SC1":"1"},"index":2},{"AnswerID":"2","ChoiceID":"4","Grades":{"SC1":"1"},"index":3},{"AnswerID":"1","ChoiceID":"5","Grades":{"SC1":"1"},"index":4}],"DataExportTag":"BM-20#1","QuestionID":"QID236#1","Choices":{"1":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Mature RBCs are no longer able to produce new mRNA molecules.<\/span><\/span>"},"2":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Mature RBCs have a surface-area-to-volume ratio that is less than that of the precursor cells.<\/span><\/span>"},"3":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Mature RBCs can undergo mitosis to produce additional RBCs.<\/span><\/span>"},"4":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Precursor cells are better able to travel through capillaries than mature RBCs.<\/span><\/span>"},"5":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">All else being equal, in populations living at high altitudes, natural selection would likely favor individuals with a higher concentration of hemoglobin in their mature RBCs.<\/span><\/span>"}},"ChoiceDataExportTags":false,"QuestionDescription":" "}},"ChoiceDataExportTags":false,"QuestionText_Unsafe":"<div>\n<p><span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">SRY is a protein that binds to certain DNA sequences and activates genes involved in male sexual development.&nbsp; Mutations in the <em>SRY<\/em> gene can result in abnormal sexual development and possible fertility issues.&nbsp; To investigate this phenomenon, separate cells are constructed to express either normal or mutant SRY protein.&nbsp; The relative amount of SRY protein located in the nucleus and cytoplasm of these cells is shown below.<\/span><\/span><br>\n&nbsp;<\/p>\n\n<p style=\"text-align: center;\"><span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">INSERT FIGURE HERE<\/span><\/span><\/p><p style=\"text-align: center;\"><span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\"><br><\/span><\/span><\/p>\n<\/div>\n\n<p><span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\"><strong><span style=\"color: windowtext;\">Based on this information and your knowledge about biology, select true or false for each of the following statements.<\/span><\/strong><\/span><\/span><\/p>","RecodeValues":{"1":"1"},"DataExportTag":"BM-20","QuestionID":"QID236"}},{"SurveyID":"SV_dnk8xGmFyNl56Dk","Element":"SQ","PrimaryAttribute":"QID237","SecondaryAttribute":"Timing","TertiaryAttribute":null,"Payload":{"QuestionText":"Timing","DefaultChoices":false,"QuestionType":"Timing","Selector":"PageTimer","Configuration":{"QuestionDescriptionOption":"UseText","MinSeconds":"0","MaxSeconds":"0"},"QuestionDescription":"Timing","Choices":{"1":{"Display":"First Click"},"2":{"Display":"Last Click"},"3":{"Display":"Page Submit"},"4":{"Display":"Click Count"}},"ChoiceOrder":["1","2","3"],"GradingData":[],"Language":[],"QuestionText_Unsafe":"Timing","DataExportTag":"T-BM-20","QuestionID":"QID237"}},{"SurveyID":"SV_dnk8xGmFyNl56Dk","Element":"SQ","PrimaryAttribute":"QID238","SecondaryAttribute":"Figure A depicts two functional receptor proteins found in human cells: the growth factor recepto...","TertiaryAttribute":null,"Payload":{"QuestionText":"<div>\n<p><span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Figure A depicts two functional receptor proteins found in human cells: the growth factor receptor (GFR) and the adhesion receptor (ADR).&nbsp; The structures of these two receptors are completely different from each other, except that both proteins have similar transmembrane regions.&nbsp; The amino acid sequences of these proteins are also completely different from each other, including within the transmembrane regions.<br \/>\n&nbsp;<br \/>\nFigure B depicts the equivalent functional receptor proteins found in mice.&nbsp; The structures of the mouse receptors are similar to their human counterparts. The amino acid sequences of the mouse receptors are also 88% identical to the amino acid sequences of the human receptors. <\/span><\/span><\/p>\n\n<p style=\"text-align: center;\"><br \/>\n<img src=\"https:\/\/ssp.qualtrics.com\/CP\/Graphic.php?IM=IM_6Md8FfVRbKcvV53\" style=\"width: 600px; height: 267px;\" \/><\/p>\n\n<p><br \/>\n<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\"><strong><span style=\"color: windowtext;\">Based on this information and your knowledge about biology, select true or false for each of the following statements.<\/span><\/strong><\/span><\/span><\/p>\n<\/div>","QuestionJS":false,"DefaultChoices":false,"QuestionType":"SBS","Selector":"SBSMatrix","Configuration":{"QuestionDescriptionOption":"UseText","ChoiceColumnWidthPixels":671,"RepeatHeaders":"none","ColumnOrder":[1,0]},"QuestionDescription":"Figure A depicts two functional receptor proteins found in human cells: the growth factor recepto...","Choices":{"1":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">The transmembrane region of the proteins will mostly be comprised of amino acids with hydrophilic side chains.<\/span><\/span>"},"2":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">The sequence and structure of the transmembrane regions together indicate that the human GFR gene and the human ADR gene likely evolved from the same ancestral gene.<\/span><\/span>"},"3":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">The GFR genes found in humans and mice likely arose from a common ancestral gene.<\/span><\/span>"},"4":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">A growth factor signal has to bind to the intracellular region of the GFR receptor to cause an intracellular response.<\/span><\/span>"}},"ChoiceOrder":[1,2,3,4],"Randomization":{"Type":"All","Advanced":null,"EvenPresentation":false,"TotalRandSubset":""},"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[{"ChoiceID":"1","AnswerID":"1","SeriesID":"2","Grades":{"SC1":"1"},"index":0},{"ChoiceID":"2","AnswerID":"1","SeriesID":"2","Grades":{"SC1":"1"},"index":1},{"ChoiceID":"3","AnswerID":"1","SeriesID":"1","Grades":{"SC1":"1"},"index":2},{"ChoiceID":"4","AnswerID":"1","SeriesID":"2","Grades":{"SC1":"1"},"index":3}],"Language":[],"NumberOfQuestions":1,"AdditionalQuestions":{"1":{"QuestionText":"&nbsp;","Answers":{"1":{"Display":"True"},"2":{"Display":"False"}},"RecodeValues":{"1":"1","2":"2"},"VariableNaming":[],"AnalyzeChoices":[],"QuestionType":"Matrix","Selector":"Likert","SubSelector":"SingleAnswer","ChoiceColumnWidthPixels":null,"Configuration":{"ChoiceColumnWidthPixels":10,"QuestionDescriptionOption":"UseText"},"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[{"AnswerID":"2","ChoiceID":"1","Grades":{"SC1":"1"},"index":0},{"AnswerID":"2","ChoiceID":"2","Grades":{"SC1":"1"},"index":1},{"AnswerID":"1","ChoiceID":"3","Grades":{"SC1":"1"},"index":2},{"AnswerID":"2","ChoiceID":"4","Grades":{"SC1":"1"},"index":3}],"DataExportTag":"BM-21#1","QuestionID":"QID238#1","Choices":{"1":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">The transmembrane region of the proteins will mostly be comprised of amino acids with hydrophilic side chains.<\/span><\/span>"},"2":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">The sequence and structure of the transmembrane regions together indicate that the human GFR gene and the human ADR gene likely evolved from the same ancestral gene.<\/span><\/span>"},"3":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">The GFR genes found in humans and mice likely arose from a common ancestral gene.<\/span><\/span>"},"4":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">A growth factor signal has to bind to the intracellular region of the GFR receptor to cause an intracellular response.<\/span><\/span>"}},"ChoiceDataExportTags":false,"QuestionDescription":" "}},"ChoiceDataExportTags":false,"QuestionText_Unsafe":"<div>\n<p><span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">A single species of bacteria only spreads by physical contact between living birds of the same species.&nbsp; The bacteria infect the birds&rsquo; eyes and can cause inflammation leading to blindness and death.&nbsp; &nbsp;<br \/>\n&nbsp;<br \/>\nOver the past 15 years, the way this bacterial species infects and kills birds has shifted: an Eastern Canadian strain now causes severe infection and rapid death, while strains of the same species of bacteria that spread to Western Canada do not cause severe infection or death. &nbsp;Although birds in Western Canada do not experience severe infection and do not die, the Western bacterial strain still lives in these birds. Both strains of bacteria divide every 20 minutes, while birds take approximately 3 years to reach reproductive age.&nbsp;<\/span><\/span><br \/>\n&nbsp;<\/p>\n<\/div>\n\n<p><span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\"><strong><span style=\"color: windowtext;\">Based on this information and your knowledge about biology, select true or false for each of the following statements.<\/span><\/strong><\/span><\/span><\/p>","RecodeValues":{"1":"1"},"DataExportTag":"BM-21","QuestionID":"QID238"}},{"SurveyID":"SV_dnk8xGmFyNl56Dk","Element":"SQ","PrimaryAttribute":"QID239","SecondaryAttribute":"Timing","TertiaryAttribute":null,"Payload":{"QuestionText":"Timing","DefaultChoices":false,"QuestionType":"Timing","Selector":"PageTimer","Configuration":{"QuestionDescriptionOption":"UseText","MinSeconds":"0","MaxSeconds":"0"},"QuestionDescription":"Timing","Choices":{"1":{"Display":"First Click"},"2":{"Display":"Last Click"},"3":{"Display":"Page Submit"},"4":{"Display":"Click Count"}},"ChoiceOrder":["1","2","3"],"GradingData":[],"Language":[],"QuestionText_Unsafe":"Timing","DataExportTag":"T-BM-21","QuestionID":"QID239"}},{"SurveyID":"SV_dnk8xGmFyNl56Dk","Element":"SQ","PrimaryAttribute":"QID240","SecondaryAttribute":"During periods of heavy exercise, the human body increases the production and release of the horm...","TertiaryAttribute":null,"Payload":{"QuestionText":"<div>\n<p><span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">During periods of heavy exercise, the human body increases the production and release of the hormone epinephrine. Epinephrine can bind to specific membrane receptors on the heart, increasing the heart&rsquo;s contraction rate. &nbsp;Epinephrine can also bind to receptors on liver cells, increasing glucose release by liver cells.&nbsp;Epinephrine initiates the following signaling cascades.<\/span><\/span><\/p>\n\n<p style=\"text-align: center;\"><br \/>\n<img src=\"https:\/\/ssp.qualtrics.com\/CP\/Graphic.php?IM=IM_0pp5dxX8qLpEbOJ\" style=\"width: 600px; height: 125px;\" \/><\/p>\n\n<p><br \/>\n<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">In each cell type, epinephrine binds to &beta; receptors, which activates adenylate cyclase enzymes.&nbsp; These enzymes catalyze the production of cAMP, leading to different physiological effects.<br \/>\n<br \/>\n<strong><span style=\"color: windowtext;\">Based on this information and your knowledge about biology, select true or false for each of the following statements.<\/span><\/strong><\/span><\/span><\/p>\n<\/div>","QuestionJS":false,"DefaultChoices":false,"QuestionType":"SBS","Selector":"SBSMatrix","Configuration":{"QuestionDescriptionOption":"UseText","ChoiceColumnWidthPixels":671,"RepeatHeaders":"none","ColumnOrder":[1,0]},"QuestionDescription":"During periods of heavy exercise, the human body increases the production and release of the horm...","Choices":{"1":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Injection of epinephrine into the bloodstream will initiate the specified pathways in the absence of exercise.<\/span><\/span>"},"2":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Any cells in the body that have &beta;<sub>2<\/sub> receptors will release glucose when epinephrine binds to those receptors.<\/span><\/span>"},"3":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">The different effects of epinephrine binding to receptors in liver and heart cells is likely due to the presence of different proteins downstream of cAMP in these two cell types.<\/span><\/span>"},"4":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Binding of one molecule of epinephrine to one &beta;<sub>1<\/sub> receptor in a heart cell will lead to the production of one cAMP molecule.<\/span><\/span>"}},"ChoiceOrder":[1,2,3,4],"Randomization":{"Type":"All","Advanced":null,"EvenPresentation":false,"TotalRandSubset":""},"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[{"ChoiceID":"1","AnswerID":"1","SeriesID":"1","Grades":{"SC1":"1"},"index":0},{"ChoiceID":"2","AnswerID":"1","SeriesID":"2","Grades":{"SC1":"1"},"index":1},{"ChoiceID":"3","AnswerID":"1","SeriesID":"1","Grades":{"SC1":"1"},"index":2},{"ChoiceID":"4","AnswerID":"1","SeriesID":"2","Grades":{"SC1":"1"},"index":3}],"Language":[],"NumberOfQuestions":1,"AdditionalQuestions":{"1":{"QuestionText":"&nbsp;","Answers":{"1":{"Display":"True"},"2":{"Display":"False"}},"RecodeValues":{"1":"1","2":"2"},"VariableNaming":[],"AnalyzeChoices":[],"QuestionType":"Matrix","Selector":"Likert","SubSelector":"SingleAnswer","ChoiceColumnWidthPixels":null,"Configuration":{"ChoiceColumnWidthPixels":10,"QuestionDescriptionOption":"UseText"},"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[{"AnswerID":"1","ChoiceID":"1","Grades":{"SC1":"1"},"index":0},{"AnswerID":"2","ChoiceID":"2","Grades":{"SC1":"1"},"index":1},{"AnswerID":"1","ChoiceID":"3","Grades":{"SC1":"1"},"index":2},{"AnswerID":"2","ChoiceID":"4","Grades":{"SC1":"1"},"index":3}],"DataExportTag":"BM-22#1","QuestionID":"QID240#1","Choices":{"1":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Injection of epinephrine into the bloodstream will initiate the specified pathways in the absence of exercise.<\/span><\/span>"},"2":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Any cells in the body that have &beta;<sub>2<\/sub> receptors will release glucose when epinephrine binds to those receptors.<\/span><\/span>"},"3":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">The different effects of epinephrine binding to receptors in liver and heart cells is likely due to the presence of different proteins downstream of cAMP in these two cell types.<\/span><\/span>"},"4":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Binding of one molecule of epinephrine to one &beta;<sub>1<\/sub> receptor in a heart cell will lead to the production of one cAMP molecule.<\/span><\/span>"}},"ChoiceDataExportTags":false,"QuestionDescription":" "}},"ChoiceDataExportTags":false,"QuestionText_Unsafe":"<div>\n<p><span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Human immune-deficiency virus, HIV, is a virus that infects human cells.&nbsp; When HIV infects a cell, the cell synthesizes a viral protein called HIV protease. The function of HIV protease is to bind and cut another viral protein called Gag-Pol to create two separate proteins, Gag and Pol.&nbsp; A newly discovered strain of HIV makes an altered form of the HIV protease that differs by a single amino acid substitution from the normal protease.&nbsp;<\/span><\/span><\/p><p><span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\"><br><\/span><\/span><\/p>\n<\/div>\n\n<p><span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\"><strong><span style=\"color: windowtext;\">Based on this information and your knowledge about biology, select true or false for each of the following statements.<\/span><\/strong><\/span><\/span><\/p>","RecodeValues":{"1":"1"},"DataExportTag":"BM-22","QuestionID":"QID240"}},{"SurveyID":"SV_dnk8xGmFyNl56Dk","Element":"SQ","PrimaryAttribute":"QID241","SecondaryAttribute":"Timing","TertiaryAttribute":null,"Payload":{"QuestionText":"Timing","DefaultChoices":false,"QuestionType":"Timing","Selector":"PageTimer","Configuration":{"QuestionDescriptionOption":"UseText","MinSeconds":"0","MaxSeconds":"0"},"QuestionDescription":"Timing","Choices":{"1":{"Display":"First Click"},"2":{"Display":"Last Click"},"3":{"Display":"Page Submit"},"4":{"Display":"Click Count"}},"ChoiceOrder":["1","2","3"],"GradingData":[],"Language":[],"QuestionText_Unsafe":"Timing","DataExportTag":"T-BM-22","QuestionID":"QID241"}},{"SurveyID":"SV_dnk8xGmFyNl56Dk","Element":"SQ","PrimaryAttribute":"QID242","SecondaryAttribute":"A palm tree adapted to the desert grows approximately one meter in a growing season.\u00a0 In the stat..","TertiaryAttribute":null,"Payload":{"QuestionText":"<div>\n<p><span style=\"font-family:times new roman,times,serif;\"><span style=\"font-size:16px;\"><span style=\"line-height: 107%; color: windowtext;\">A palm tree adapted to the desert grows approximately one meter in a growing season.&nbsp; In the statements below, biomass refers to an organism&rsquo;s total mass, excluding water.<\/span><\/span><\/span><\/p>\n\n<p style=\"text-align: center;\"><br \/>\n<img src=\"https:\/\/ssp.qualtrics.com\/CP\/Graphic.php?IM=IM_cHfAaalF7nCzmL3\" style=\"width: 150px; height: 169px;\" \/><\/p>\n\n<p><br \/>\n<span style=\"font-family:times new roman,times,serif;\"><span style=\"font-size:16px;\"><strong><span style=\"color: windowtext;\">Based on this information and your knowledge about biology, select true or false for each of the following statements.<\/span><\/strong><\/span><\/span><\/p>\n<\/div>","QuestionJS":false,"DefaultChoices":false,"QuestionType":"SBS","Selector":"SBSMatrix","Configuration":{"QuestionDescriptionOption":"UseText","ChoiceColumnWidthPixels":671,"RepeatHeaders":"none","ColumnOrder":[1,0]},"QuestionDescription":"A palm tree adapted to the desert grows approximately one meter in a growing season.\u00a0 In the stat...","Choices":{"1":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Carbon from carbon dioxide gas makes up a large portion of the tree&rsquo;s biomass.<\/span><\/span>"},"2":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Cellular respiration does not occur in the tree.<\/span><\/span>"},"3":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">In the tree, light energy is transformed into chemical energy stored in glucose.<\/span><\/span>"},"4":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">The primary purpose of photosynthesis is to produce oxygen for animals to breathe.<\/span><\/span>"}},"ChoiceOrder":[1,2,3,4],"Randomization":{"Type":"All","Advanced":null,"EvenPresentation":false,"TotalRandSubset":""},"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[{"ChoiceID":"1","AnswerID":"1","SeriesID":"1","Grades":{"SC1":"1"},"index":0},{"ChoiceID":"2","AnswerID":"1","SeriesID":"2","Grades":{"SC1":"1"},"index":1},{"ChoiceID":"3","AnswerID":"1","SeriesID":"1","Grades":{"SC1":"1"},"index":2},{"ChoiceID":"4","AnswerID":"1","SeriesID":"2","Grades":{"SC1":"1"},"index":3}],"Language":[],"NumberOfQuestions":1,"AdditionalQuestions":{"1":{"QuestionText":"&nbsp;","Answers":{"1":{"Display":"True"},"2":{"Display":"False"}},"RecodeValues":{"1":"1","2":"2"},"VariableNaming":[],"AnalyzeChoices":[],"QuestionType":"Matrix","Selector":"Likert","SubSelector":"SingleAnswer","ChoiceColumnWidthPixels":null,"Configuration":{"ChoiceColumnWidthPixels":10,"QuestionDescriptionOption":"UseText"},"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[{"AnswerID":"1","ChoiceID":"1","Grades":{"SC1":"1"},"index":0},{"AnswerID":"2","ChoiceID":"2","Grades":{"SC1":"1"},"index":1},{"AnswerID":"1","ChoiceID":"3","Grades":{"SC1":"1"},"index":2},{"AnswerID":"2","ChoiceID":"4","Grades":{"SC1":"1"},"index":3}],"DataExportTag":"BM-23#1","QuestionID":"QID242#1","Choices":{"1":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Carbon from carbon dioxide gas makes up a large portion of the tree&rsquo;s biomass.<\/span><\/span>"},"2":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Cellular respiration does not occur in the tree.<\/span><\/span>"},"3":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">In the tree, light energy is transformed into chemical energy stored in glucose.<\/span><\/span>"},"4":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">The primary purpose of photosynthesis is to produce oxygen for animals to breathe.<\/span><\/span>"}},"ChoiceDataExportTags":false,"QuestionDescription":" "}},"ChoiceDataExportTags":false,"QuestionText_Unsafe":"<div>\n<p><span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">During periods of heavy exercise, the human body increases the production and release of the hormone epinephrine. Epinephrine can bind to specific membrane receptors on the heart, increasing the heart\u2019s contraction rate. &nbsp;Epinephrine can also bind to receptors on liver cells, increasing glucose release by liver cells.&nbsp;Epinephrine initiates the following signaling cascades.<\/span><\/span><br>\n<br>\n&nbsp;<\/p>\n\n<p style=\"text-align: center;\"><span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">INSERT IMAGE HERE<\/span><\/span><\/p>\n\n<p><br>\n<br>\n<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">In each cell type, epinephrine binds to \u03b2 receptors, which activates adenylate cyclase enzymes.&nbsp; These enzymes catalyze the production of cAMP, leading to different physiological effects.<\/span><\/span><\/p>\n\n<p>&nbsp;<\/p>\n\n<p>&nbsp;<\/p>\n<\/div>\n\n<p><span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\"><strong><span style=\"color: windowtext;\">Based on this information and your knowledge about biology, select true or false for each of the following statements.<\/span><\/strong><\/span><\/span><\/p>","RecodeValues":{"1":"1"},"DataExportTag":"BM-23","QuestionID":"QID242"}},{"SurveyID":"SV_dnk8xGmFyNl56Dk","Element":"SQ","PrimaryAttribute":"QID243","SecondaryAttribute":"Timing","TertiaryAttribute":null,"Payload":{"QuestionText":"Timing","DefaultChoices":false,"QuestionType":"Timing","Selector":"PageTimer","Configuration":{"QuestionDescriptionOption":"UseText","MinSeconds":"0","MaxSeconds":"0"},"QuestionDescription":"Timing","Choices":{"1":{"Display":"First Click"},"2":{"Display":"Last Click"},"3":{"Display":"Page Submit"},"4":{"Display":"Click Count"}},"ChoiceOrder":["1","2","3"],"GradingData":[],"Language":[],"QuestionText_Unsafe":"Timing","DataExportTag":"T-BM-23","QuestionID":"QID243"}},{"SurveyID":"SV_dnk8xGmFyNl56Dk","Element":"SQ","PrimaryAttribute":"QID244","SecondaryAttribute":"During DNA replication in a human liver cell, DNA polymerase mistakenly adds a guanine (G) nucleo...","TertiaryAttribute":null,"Payload":{"QuestionText":"<div>\n<p><span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">During DNA replication in a human liver cell, DNA polymerase mistakenly adds a guanine (G) nucleotide instead of an adenine (A) nucleotide to a newly made strand of DNA in a gene that codes for a protein. This mutation occurs in a protein-coding region of the gene and is not repaired by the cell.<\/span><\/span><br><\/p><p><span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\"><br><\/span><\/span><\/p>\n\n<p><strong style=\"font-family: 'times new roman', times, serif; font-size: 16px;\"><span style=\"color: windowtext;\">Based on this information and your knowledge about biology, select true or false for each of the following statements.<\/span><\/strong><\/p><\/div>","QuestionJS":false,"DefaultChoices":false,"QuestionType":"SBS","Selector":"SBSMatrix","Configuration":{"QuestionDescriptionOption":"UseText","ChoiceColumnWidthPixels":671,"RepeatHeaders":"none","ColumnOrder":[1,0]},"QuestionDescription":"During DNA replication in a human liver cell, DNA polymerase mistakenly adds a guanine (G) nucleo...","Choices":{"1":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">This mutation will likely not change the sequence of the mRNA produced from this gene.<\/span><\/span>"},"2":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">This mutation will likely be copied into the DNA of other existing neighboring liver cells.<\/span><\/span>"},"3":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">More proteins produced from this gene will be affected by this mutation than if a similar mistake had occurred during mRNA synthesis.<\/span><\/span>"},"4":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">This mutation represents an effort by the cell to adapt to altered environmental conditions.<\/span><\/span>"},"5":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Cells derived from this liver cell will likely contain this mutation on both the maternal and paternal versions of this gene.<\/span><\/span>"}},"ChoiceOrder":[1,2,3,4,"5"],"Randomization":{"Type":"All","Advanced":null,"EvenPresentation":false,"TotalRandSubset":""},"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[{"ChoiceID":"1","AnswerID":"1","SeriesID":"2","Grades":{"SC1":"1"},"index":0},{"ChoiceID":"2","AnswerID":"1","SeriesID":"2","Grades":{"SC1":"1"},"index":1},{"ChoiceID":"3","AnswerID":"1","SeriesID":"1","Grades":{"SC1":"1"},"index":2},{"ChoiceID":"4","AnswerID":"1","SeriesID":"2","Grades":{"SC1":"1"},"index":3},{"ChoiceID":"5","AnswerID":"1","SeriesID":"2","Grades":{"SC1":"1"},"index":4}],"Language":[],"NumberOfQuestions":1,"AdditionalQuestions":{"1":{"QuestionText":"&nbsp;","Answers":{"1":{"Display":"True"},"2":{"Display":"False"}},"RecodeValues":{"1":"1","2":"2"},"VariableNaming":[],"AnalyzeChoices":[],"QuestionType":"Matrix","Selector":"Likert","SubSelector":"SingleAnswer","ChoiceColumnWidthPixels":null,"Configuration":{"ChoiceColumnWidthPixels":10,"QuestionDescriptionOption":"UseText"},"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[{"AnswerID":"2","ChoiceID":"1","Grades":{"SC1":"1"},"index":0},{"AnswerID":"2","ChoiceID":"2","Grades":{"SC1":"1"},"index":1},{"AnswerID":"1","ChoiceID":"3","Grades":{"SC1":"1"},"index":2},{"AnswerID":"2","ChoiceID":"4","Grades":{"SC1":"1"},"index":3},{"AnswerID":"2","ChoiceID":"5","Grades":{"SC1":"1"},"index":4}],"DataExportTag":"BM-24#1","QuestionID":"QID244#1","Choices":{"1":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">This mutation will likely not change the sequence of the mRNA produced from this gene.<\/span><\/span>"},"2":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">This mutation will likely be copied into the DNA of other existing neighboring liver cells.<\/span><\/span>"},"3":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">More proteins produced from this gene will be affected by this mutation than if a similar mistake had occurred during mRNA synthesis.<\/span><\/span>"},"4":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">This mutation represents an effort by the cell to adapt to altered environmental conditions.<\/span><\/span>"},"5":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Cells derived from this liver cell will likely contain this mutation on both the maternal and paternal versions of this gene.<\/span><\/span>"}},"ChoiceDataExportTags":false,"QuestionDescription":" "}},"ChoiceDataExportTags":false,"QuestionText_Unsafe":"<div>\n<p><span style=\"font-family:times new roman,times,serif;\"><span style=\"font-size:16px;\"><span style=\"line-height: 107%; color: windowtext;\">A palm tree adapted to the desert grows approximately one meter in a growing season.&nbsp; In the statements below, biomass refers to an organism&rsquo;s total mass, excluding water.<\/span>&nbsp; &nbsp;&nbsp;<\/span><\/span><br \/>\n&nbsp;<\/p>\n\n<p style=\"text-align: center;\"><span style=\"font-family:times new roman,times,serif;\"><span style=\"font-size:16px;\">INSERT IMAGE HERE<\/span><\/span><\/p>\n\n<p><span style=\"font-family:times new roman,times,serif;\"><span style=\"font-size:16px;\">&nbsp;<\/span><\/span><\/p>\n<\/div>\n\n<p><span style=\"font-family:times new roman,times,serif;\"><span style=\"font-size:16px;\"><strong><span style=\"color: windowtext;\">Based on this information and your knowledge about biology, select true or false for each of the following statements.<\/span><\/strong><\/span><\/span><\/p>","RecodeValues":{"1":"1"},"DataExportTag":"BM-24","QuestionID":"QID244"}},{"SurveyID":"SV_dnk8xGmFyNl56Dk","Element":"SQ","PrimaryAttribute":"QID245","SecondaryAttribute":"Timing","TertiaryAttribute":null,"Payload":{"QuestionText":"Timing","DefaultChoices":false,"QuestionType":"Timing","Selector":"PageTimer","Configuration":{"QuestionDescriptionOption":"UseText","MinSeconds":"0","MaxSeconds":"0"},"QuestionDescription":"Timing","Choices":{"1":{"Display":"First Click"},"2":{"Display":"Last Click"},"3":{"Display":"Page Submit"},"4":{"Display":"Click Count"}},"ChoiceOrder":["1","2","3"],"GradingData":[],"Language":[],"QuestionText_Unsafe":"Timing","DataExportTag":"T-BM-24","QuestionID":"QID245"}},{"SurveyID":"SV_dnk8xGmFyNl56Dk","Element":"SQ","PrimaryAttribute":"QID246","SecondaryAttribute":"At the neuromuscular junction of vertebrates, the neurotransmitter acetylcholine is released from...","TertiaryAttribute":null,"Payload":{"QuestionText":"<div>\n<p><span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">At the neuromuscular junction of vertebrates, the neurotransmitter acetylcholine is released from the pre-synaptic neuron into the synaptic cleft, where it interacts with specific acetylcholine receptors on skeletal muscle cells.&nbsp; The diagram below illustrates the release of acetylcholine into the synaptic cleft. <\/span><\/span><\/p>\n\n<p style=\"text-align: center;\"><br \/>\n<img src=\"https:\/\/ssp.qualtrics.com\/CP\/Graphic.php?IM=IM_ebqtIegNn3eYvoV\" style=\"width: 400px; height: 271px;\" \/><\/p>\n\n<p><br \/>\n<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\"><strong style=\"font-family: 'times new roman', times, serif; font-size: 16px;\"><span style=\"color: windowtext;\">Based on this information and your knowledge about biology, select true or false for each of the following statements.<\/span><\/strong><\/span><\/span><\/p>\n<\/div>","QuestionJS":false,"DefaultChoices":false,"QuestionType":"SBS","Selector":"SBSMatrix","Configuration":{"QuestionDescriptionOption":"UseText","ChoiceColumnWidthPixels":671,"RepeatHeaders":"none","ColumnOrder":[1,0]},"QuestionDescription":"At the neuromuscular junction of vertebrates, the neurotransmitter acetylcholine is released from...","Choices":{"1":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">When acetylcholine is in the synaptic cleft, the acetylcholine receptor sends out chemical signals to attract acetylcholine.<\/span><\/span>"},"2":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Decreasing the distance across the synaptic cleft will increase the probability that acetylcholine binds to its receptors on the skeletal muscle cell.<\/span><\/span>"},"3":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Drugs that increase the amount of time that acetylcholine remains in the synaptic cleft will increase acetylcholine signaling.<\/span><\/span>"},"4":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Once bound to its receptor, acetylcholine cannot dissociate from the receptor.<\/span><\/span>"},"5":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">The response of the skeletal muscle cell requires that acetylcholine enters into the muscle cell after it binds its receptor.<\/span><\/span>"}},"ChoiceOrder":[1,2,3,4,"5"],"Randomization":{"Type":"All","Advanced":null,"EvenPresentation":false,"TotalRandSubset":""},"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[{"ChoiceID":"1","AnswerID":"1","SeriesID":"2","Grades":{"SC1":"1"},"index":0},{"ChoiceID":"2","AnswerID":"1","SeriesID":"1","Grades":{"SC1":"1"},"index":1},{"ChoiceID":"3","AnswerID":"1","SeriesID":"1","Grades":{"SC1":"1"},"index":2},{"ChoiceID":"4","AnswerID":"1","SeriesID":"2","Grades":{"SC1":"1"},"index":3},{"ChoiceID":"5","AnswerID":"1","SeriesID":"2","Grades":{"SC1":"1"},"index":4}],"Language":[],"NumberOfQuestions":1,"AdditionalQuestions":{"1":{"QuestionText":"&nbsp;","Answers":{"1":{"Display":"True"},"2":{"Display":"False"}},"RecodeValues":{"1":"1","2":"2"},"VariableNaming":[],"AnalyzeChoices":[],"QuestionType":"Matrix","Selector":"Likert","SubSelector":"SingleAnswer","ChoiceColumnWidthPixels":null,"Configuration":{"ChoiceColumnWidthPixels":10,"QuestionDescriptionOption":"UseText"},"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[{"AnswerID":"2","ChoiceID":"1","Grades":{"SC1":"1"},"index":0},{"AnswerID":"1","ChoiceID":"2","Grades":{"SC1":"1"},"index":1},{"AnswerID":"1","ChoiceID":"3","Grades":{"SC1":"1"},"index":2},{"AnswerID":"2","ChoiceID":"4","Grades":{"SC1":"1"},"index":3},{"AnswerID":"2","ChoiceID":"5","Grades":{"SC1":"1"},"index":4}],"DataExportTag":"BM-27#1","QuestionID":"QID246#1","Choices":{"1":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">When acetylcholine is in the synaptic cleft, the acetylcholine receptor sends out chemical signals to attract acetylcholine.<\/span><\/span>"},"2":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Decreasing the distance across the synaptic cleft will increase the probability that acetylcholine binds to its receptors on the skeletal muscle cell.<\/span><\/span>"},"3":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Drugs that increase the amount of time that acetylcholine remains in the synaptic cleft will increase acetylcholine signaling.<\/span><\/span>"},"4":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Once bound to its receptor, acetylcholine cannot dissociate from the receptor.<\/span><\/span>"},"5":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">The response of the skeletal muscle cell requires that acetylcholine enters into the muscle cell after it binds its receptor.<\/span><\/span>"}},"ChoiceDataExportTags":false,"QuestionDescription":" "}},"ChoiceDataExportTags":false,"QuestionText_Unsafe":"<div>\n<p><span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">During DNA replication in a human liver cell, DNA polymerase mistakenly adds a guanine (G) nucleotide instead of an adenine (A) nucleotide to a newly made strand of DNA in a gene that codes for a protein. This mutation occurs in a protein-coding region of the gene and is not repaired by the cell.<\/span><\/span><br><\/p><p><span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\"><br><\/span><\/span><\/p>\n\n<p><strong style=\"font-family: 'times new roman', times, serif; font-size: 16px;\"><span style=\"color: windowtext;\">Based on this information and your knowledge about biology, select true or false for each of the following statements.<\/span><\/strong><\/p><\/div>","RecodeValues":{"1":"1"},"DataExportTag":"BM-27","QuestionID":"QID246"}},{"SurveyID":"SV_dnk8xGmFyNl56Dk","Element":"SQ","PrimaryAttribute":"QID247","SecondaryAttribute":"Timing","TertiaryAttribute":null,"Payload":{"QuestionText":"Timing","DefaultChoices":false,"QuestionType":"Timing","Selector":"PageTimer","Configuration":{"QuestionDescriptionOption":"UseText","MinSeconds":"0","MaxSeconds":"0"},"QuestionDescription":"Timing","Choices":{"1":{"Display":"First Click"},"2":{"Display":"Last Click"},"3":{"Display":"Page Submit"},"4":{"Display":"Click Count"}},"ChoiceOrder":["1","2","3"],"GradingData":[],"Language":[],"QuestionText_Unsafe":"Timing","DataExportTag":"T-BM-27","QuestionID":"QID247"}},{"SurveyID":"SV_dnk8xGmFyNl56Dk","Element":"SQ","PrimaryAttribute":"QID248","SecondaryAttribute":"The table below summarizes some characteristics of three types of cells found in an individual br...","TertiaryAttribute":null,"Payload":{"QuestionText":"<div>\n<p><span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">The table below summarizes some characteristics of three types of cells found in an individual brown bear.&nbsp; The &ldquo;+&rdquo; signs indicate the relative amount of mitochondria found in a given cell type, with more &ldquo;+&rdquo; signs indicating relatively more mitochondria being present.&nbsp;<\/span><\/span><\/p>\n\n<p style=\"text-align: center;\"><br \/>\n<img src=\"https:\/\/ssp.qualtrics.com\/CP\/Graphic.php?IM=IM_0ClUHpS4VG6iXjf\" style=\"width: 600px; height: 89px;\" \/><\/p>\n\n<p><br \/>\n<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\"><strong style=\"font-family: 'times new roman', times, serif; font-size: 16px;\"><span style=\"color: windowtext;\">Based on this information and your knowledge about biology, select true or false for each of the following statements.<\/span><\/strong><\/span><\/span><\/p>\n<\/div>","QuestionJS":false,"DefaultChoices":false,"QuestionType":"SBS","Selector":"SBSMatrix","Configuration":{"QuestionDescriptionOption":"UseText","ChoiceColumnWidthPixels":671,"RepeatHeaders":"none","ColumnOrder":[1,0]},"QuestionDescription":"The table below summarizes some characteristics of three types of cells found in an individual br...","Choices":{"1":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Type 1 cells likely have different genes compared to Type 2 cells.<\/span><\/span>"},"2":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">The amount of CO<sub>2<\/sub> released from Type 1 cells is likely higher than the amount of CO<sub>2<\/sub> released from Type 3 cells when the bear is moving.<\/span><\/span>"},"3":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">An increase in the release of CO<sub>2 <\/sub>from Type 3 cells will contribute to an increase in the bear&rsquo;s breathing rate.<\/span><\/span>"},"4":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Assuming the same density of nutrient transport proteins, Type 2 cells with a lower surface-area-to-volume ratio would have an increased capacity to absorb nutrients than Type 2 cells with a higher surface-area-to-volume ratio.<\/span><\/span>"},"5":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Increasing the number of Type 1 cells in the body would have a larger impact on the energetic demands of the organism than increasing the number of Type 3 cells.<\/span><\/span>"}},"ChoiceOrder":[1,2,3,4,"5"],"Randomization":{"Type":"All","Advanced":null,"EvenPresentation":false,"TotalRandSubset":""},"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[{"ChoiceID":"1","AnswerID":"1","SeriesID":"2","Grades":{"SC1":"1"},"index":0},{"ChoiceID":"2","AnswerID":"1","SeriesID":"1","Grades":{"SC1":"1"},"index":1},{"ChoiceID":"3","AnswerID":"1","SeriesID":"1","Grades":{"SC1":"1"},"index":2},{"ChoiceID":"4","AnswerID":"1","SeriesID":"2","Grades":{"SC1":"1"},"index":3},{"ChoiceID":"5","AnswerID":"1","SeriesID":"1","Grades":{"SC1":"1"},"index":4}],"Language":[],"NumberOfQuestions":1,"AdditionalQuestions":{"1":{"QuestionText":"&nbsp;","Answers":{"1":{"Display":"True"},"2":{"Display":"False"}},"RecodeValues":{"1":"1","2":"2"},"VariableNaming":[],"AnalyzeChoices":[],"QuestionType":"Matrix","Selector":"Likert","SubSelector":"SingleAnswer","ChoiceColumnWidthPixels":null,"Configuration":{"ChoiceColumnWidthPixels":10,"QuestionDescriptionOption":"UseText"},"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[{"AnswerID":"2","ChoiceID":"1","Grades":{"SC1":"1"},"index":0},{"AnswerID":"1","ChoiceID":"2","Grades":{"SC1":"1"},"index":1},{"AnswerID":"1","ChoiceID":"3","Grades":{"SC1":"1"},"index":2},{"AnswerID":"2","ChoiceID":"4","Grades":{"SC1":"1"},"index":3},{"AnswerID":"1","ChoiceID":"5","Grades":{"SC1":"1"},"index":4}],"DataExportTag":"BM-28#1","QuestionID":"QID248#1","Choices":{"1":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Type 1 cells likely have different genes compared to Type 2 cells.<\/span><\/span>"},"2":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">The amount of CO<sub>2<\/sub> released from Type 1 cells is likely higher than the amount of CO<sub>2<\/sub> released from Type 3 cells when the bear is moving.<\/span><\/span>"},"3":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">An increase in the release of CO<sub>2 <\/sub>from Type 3 cells will contribute to an increase in the bear&rsquo;s breathing rate.<\/span><\/span>"},"4":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Assuming the same density of nutrient transport proteins, Type 2 cells with a lower surface-area-to-volume ratio would have an increased capacity to absorb nutrients than Type 2 cells with a higher surface-area-to-volume ratio.<\/span><\/span>"},"5":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Increasing the number of Type 1 cells in the body would have a larger impact on the energetic demands of the organism than increasing the number of Type 3 cells.<\/span><\/span>"}},"ChoiceDataExportTags":false,"QuestionDescription":" "}},"ChoiceDataExportTags":false,"QuestionText_Unsafe":"<div>\n<p><span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">At the neuromuscular junction of vertebrates, the neurotransmitter acetylcholine is released from the pre-synaptic neuron into the synaptic cleft, where it interacts with specific acetylcholine receptors on skeletal muscle cells.&nbsp; The diagram below illustrates the release of acetylcholine into the synaptic cleft.&nbsp;<\/span><\/span><\/p>\n\n<p style=\"text-align: center;\"><span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">INSERT IMAGE HERE<\/span><\/span><\/p>\n\n<p>&nbsp;<\/p>\n\n<p><span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\"><strong style=\"font-family: 'times new roman', times, serif; font-size: 16px;\"><span style=\"color: windowtext;\">Based on this information and your knowledge about biology, select true or false for each of the following statements.<\/span><\/strong><\/span><\/span><\/p>\n<\/div>","RecodeValues":{"1":"1"},"DataExportTag":"BM-28","QuestionID":"QID248"}},{"SurveyID":"SV_dnk8xGmFyNl56Dk","Element":"SQ","PrimaryAttribute":"QID249","SecondaryAttribute":"Timing","TertiaryAttribute":null,"Payload":{"QuestionText":"Timing","DefaultChoices":false,"QuestionType":"Timing","Selector":"PageTimer","Configuration":{"QuestionDescriptionOption":"UseText","MinSeconds":"0","MaxSeconds":"0"},"QuestionDescription":"Timing","Choices":{"1":{"Display":"First Click"},"2":{"Display":"Last Click"},"3":{"Display":"Page Submit"},"4":{"Display":"Click Count"}},"ChoiceOrder":["1","2","3"],"GradingData":[],"Language":[],"QuestionText_Unsafe":"Timing","DataExportTag":"T-BM-28","QuestionID":"QID249"}},{"SurveyID":"SV_dnk8xGmFyNl56Dk","Element":"SQ","PrimaryAttribute":"QID250","SecondaryAttribute":"The nephron is the functional unit of the kidney that is responsible for processing blood. \u00a0The n..","TertiaryAttribute":null,"Payload":{"QuestionText":"<div>\n<p><span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">The nephron is the functional unit of the kidney that is responsible for processing blood. &nbsp;The nephron also generates a concentration gradient in the kidney, which facilitates the diffusion of water out of the urine in the collecting duct and back into the blood. This mechanism ultimately helps to concentrate the urine.&nbsp;&nbsp;<br \/>\n&nbsp;<br \/>\nBelow are images of nephrons from three different species of mice that occupy different habitats. For this scenario, assume the mice are equivalent in all other aspects of their physiology and behavior, excluding their nephron structure.<\/span><\/span><\/p>\n\n<p style=\"text-align: center;\"><br \/>\n<img src=\"https:\/\/ssp.qualtrics.com\/CP\/Graphic.php?IM=IM_5ata2slddKz4c4J\" style=\"width: 600px; height: 335px;\" \/><\/p>\n\n<p><br \/>\n<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\"><strong style=\"font-family: 'times new roman', times, serif; font-size: 16px;\"><span style=\"color: windowtext;\">Based on this information and your knowledge about biology, select true or false for each of the following statements.<\/span><\/strong><\/span><\/span><\/p>\n<\/div>","QuestionJS":false,"DefaultChoices":false,"QuestionType":"SBS","Selector":"SBSMatrix","Configuration":{"QuestionDescriptionOption":"UseText","ChoiceColumnWidthPixels":671,"RepeatHeaders":"none","ColumnOrder":[1,0]},"QuestionDescription":"The nephron is the functional unit of the kidney that is responsible for processing blood. \u00a0The n...","Choices":{"1":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Mouse 1 likely has less capacity to remove water from its urine than Mouse 2.<\/span><\/span>"},"2":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Mouse 1&rsquo;s nephron is less evolved than Mouse 3&rsquo;s nephron.<\/span><\/span>"},"3":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">An increase in blood volume in Mouse 2 will likely lead to increased solute concentration in its urine.<\/span><\/span>"},"4":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">The longer nephron in Mouse 3 compared to Mouse 1 could represent an adaptation to a dry, desert habitat.<\/span><\/span>"}},"ChoiceOrder":[1,2,3,4],"Randomization":{"Type":"All","Advanced":null,"EvenPresentation":false,"TotalRandSubset":""},"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[{"ChoiceID":"4","AnswerID":"1","SeriesID":"1","Grades":{"SC1":"1"},"index":0},{"ChoiceID":"3","AnswerID":"1","SeriesID":"2","Grades":{"SC1":"1"},"index":1},{"ChoiceID":"1","AnswerID":"1","SeriesID":"1","Grades":{"SC1":"1"},"index":2},{"ChoiceID":"2","AnswerID":"1","SeriesID":"2","Grades":{"SC1":"1"},"index":3}],"Language":[],"NumberOfQuestions":1,"AdditionalQuestions":{"1":{"QuestionText":"&nbsp;","Answers":{"1":{"Display":"True"},"2":{"Display":"False"}},"RecodeValues":{"1":"1","2":"2"},"VariableNaming":[],"AnalyzeChoices":[],"QuestionType":"Matrix","Selector":"Likert","SubSelector":"SingleAnswer","ChoiceColumnWidthPixels":null,"Configuration":{"ChoiceColumnWidthPixels":10,"QuestionDescriptionOption":"UseText"},"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[{"AnswerID":"1","ChoiceID":"4","Grades":{"SC1":"1"},"index":0},{"AnswerID":"2","ChoiceID":"3","Grades":{"SC1":"1"},"index":1},{"AnswerID":"1","ChoiceID":"1","Grades":{"SC1":"1"},"index":2},{"AnswerID":"2","ChoiceID":"2","Grades":{"SC1":"1"},"index":3}],"DataExportTag":"BM-30#1","QuestionID":"QID250#1","Choices":{"1":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Mouse 1 likely has less capacity to remove water from its urine than Mouse 2.<\/span><\/span>"},"2":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Mouse 1&rsquo;s nephron is less evolved than Mouse 3&rsquo;s nephron.<\/span><\/span>"},"3":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">An increase in blood volume in Mouse 2 will likely lead to increased solute concentration in its urine.<\/span><\/span>"},"4":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">The longer nephron in Mouse 3 compared to Mouse 1 could represent an adaptation to a dry, desert habitat.<\/span><\/span>"}},"ChoiceDataExportTags":false,"QuestionDescription":" "}},"ChoiceDataExportTags":false,"QuestionText_Unsafe":"<div>\n<p><span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">The table below summarizes some characteristics of three types of cells found in an individual brown bear.&nbsp; The \u201c+\u201d signs indicate the relative amount of mitochondria found in a given cell type, with more \u201c+\u201d signs indicating relatively more mitochondria being present.&nbsp;<\/span><\/span><\/p><p><span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\"><br><\/span><\/span><\/p>\n\n<p style=\"text-align: center;\"><span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">INSERT TABLE HERE<\/span><\/span><\/p>\n\n<p>&nbsp;<\/p>\n\n<p><span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\"><strong style=\"font-family: 'times new roman', times, serif; font-size: 16px;\"><span style=\"color: windowtext;\">Based on this information and your knowledge about biology, select true or false for each of the following statements.<\/span><\/strong><\/span><\/span><\/p>\n<\/div>","RecodeValues":{"1":"1"},"DataExportTag":"BM-30","QuestionID":"QID250"}},{"SurveyID":"SV_dnk8xGmFyNl56Dk","Element":"SQ","PrimaryAttribute":"QID251","SecondaryAttribute":"Timing","TertiaryAttribute":null,"Payload":{"QuestionText":"Timing","DefaultChoices":false,"QuestionType":"Timing","Selector":"PageTimer","Configuration":{"QuestionDescriptionOption":"UseText","MinSeconds":"0","MaxSeconds":"0"},"QuestionDescription":"Timing","Choices":{"1":{"Display":"First Click"},"2":{"Display":"Last Click"},"3":{"Display":"Page Submit"},"4":{"Display":"Click Count"}},"ChoiceOrder":["1","2","3"],"GradingData":[],"Language":[],"QuestionText_Unsafe":"Timing","DataExportTag":"T-BM-30","QuestionID":"QID251"}},{"SurveyID":"SV_dnk8xGmFyNl56Dk","Element":"SQ","PrimaryAttribute":"QID252","SecondaryAttribute":"Consider a scenario where a person eats a cupcake composed of glucose molecules.\u00a0 The person has...","TertiaryAttribute":null,"Payload":{"QuestionText":"<p><span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Consider a scenario where a person eats a cupcake composed of glucose molecules.&nbsp; The person has digested the cupcake, and the glucose has been absorbed into the bloodstream.&nbsp;<\/span><\/span><br>\n&nbsp;<\/p>\n\n<p><span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\"><strong style=\"font-family: 'times new roman', times, serif; font-size: 16px;\"><span style=\"color: windowtext;\">Based on this information and your knowledge about biology, select true or false for each of the following statements.<\/span><\/strong><\/span><\/span><\/p>","QuestionJS":false,"DefaultChoices":false,"QuestionType":"SBS","Selector":"SBSMatrix","Configuration":{"QuestionDescriptionOption":"UseText","ChoiceColumnWidthPixels":671,"RepeatHeaders":"none","ColumnOrder":[1,0]},"QuestionDescription":"Consider a scenario where a person eats a cupcake composed of glucose molecules.\u00a0 The person has...","Choices":{"1":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Carbon atoms from glucose could be exhaled by the person as carbon dioxide.<\/span><\/span>"},"2":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Carbon atoms from glucose could later be found in a plant cell.<\/span><\/span>"},"3":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Some of the energy stored in glucose will eventually be transformed into heat.<\/span><\/span>"},"4":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Carbon atoms from glucose could be converted into oxygen during metabolism.<\/span><\/span>"}},"ChoiceOrder":[1,2,3,4],"Randomization":{"Type":"All","Advanced":null,"EvenPresentation":false,"TotalRandSubset":""},"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[{"ChoiceID":"2","AnswerID":"1","SeriesID":"1","Grades":{"SC1":"1"},"index":0},{"ChoiceID":"1","AnswerID":"1","SeriesID":"1","Grades":{"SC1":"1"},"index":1},{"ChoiceID":"3","AnswerID":"1","SeriesID":"1","Grades":{"SC1":"1"},"index":2},{"ChoiceID":"4","AnswerID":"1","SeriesID":"2","Grades":{"SC1":"1"},"index":3}],"Language":[],"NumberOfQuestions":1,"AdditionalQuestions":{"1":{"QuestionText":"&nbsp;","Answers":{"1":{"Display":"True"},"2":{"Display":"False"}},"RecodeValues":{"1":"1","2":"2"},"VariableNaming":[],"AnalyzeChoices":[],"QuestionType":"Matrix","Selector":"Likert","SubSelector":"SingleAnswer","ChoiceColumnWidthPixels":null,"Configuration":{"ChoiceColumnWidthPixels":10,"QuestionDescriptionOption":"UseText"},"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[{"AnswerID":"1","ChoiceID":"2","Grades":{"SC1":"1"},"index":0},{"AnswerID":"1","ChoiceID":"1","Grades":{"SC1":"1"},"index":1},{"AnswerID":"1","ChoiceID":"3","Grades":{"SC1":"1"},"index":2},{"AnswerID":"2","ChoiceID":"4","Grades":{"SC1":"1"},"index":3}],"DataExportTag":"BM-31#1","QuestionID":"QID252#1","Choices":{"1":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Carbon atoms from glucose could be exhaled by the person as carbon dioxide.<\/span><\/span>"},"2":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Carbon atoms from glucose could later be found in a plant cell.<\/span><\/span>"},"3":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Some of the energy stored in glucose will eventually be transformed into heat.<\/span><\/span>"},"4":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Carbon atoms from glucose could be converted into oxygen during metabolism.<\/span><\/span>"}},"ChoiceDataExportTags":false,"QuestionDescription":" "}},"ChoiceDataExportTags":false,"QuestionText_Unsafe":"<div>\n<p><span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">The nephron is the functional unit of the kidney that is responsible for processing blood. &nbsp;The nephron also generates a concentration gradient in the kidney, which facilitates the diffusion of water out of the urine in the collecting duct and back into the blood. This mechanism ultimately helps to concentrate the urine.&nbsp;&nbsp;<br \/>\n&nbsp;<br \/>\nBelow are images of nephrons from three different species of mice that occupy different habitats. For this scenario, assume the mice are equivalent in all other aspects of their physiology and behavior, excluding their nephron structure.<\/span><\/span><\/p>\n\n<p style=\"text-align: center;\"><span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">INSERT IMAGE HERE<\/span><\/span><\/p>\n\n<p>&nbsp;<\/p>\n\n<p><span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\"><strong style=\"font-family: 'times new roman', times, serif; font-size: 16px;\"><span style=\"color: windowtext;\">Based on this information and your knowledge about biology, select true or false for each of the following statements.<\/span><\/strong><\/span><\/span><\/p>\n<\/div>","RecodeValues":{"1":"1"},"DataExportTag":"BM-31","QuestionID":"QID252"}},{"SurveyID":"SV_dnk8xGmFyNl56Dk","Element":"SQ","PrimaryAttribute":"QID253","SecondaryAttribute":"Timing","TertiaryAttribute":null,"Payload":{"QuestionText":"Timing","DefaultChoices":false,"QuestionType":"Timing","Selector":"PageTimer","Configuration":{"QuestionDescriptionOption":"UseText","MinSeconds":"0","MaxSeconds":"0"},"QuestionDescription":"Timing","Choices":{"1":{"Display":"First Click"},"2":{"Display":"Last Click"},"3":{"Display":"Page Submit"},"4":{"Display":"Click Count"}},"ChoiceOrder":["1","2","3"],"GradingData":[],"Language":[],"QuestionText_Unsafe":"Timing","DataExportTag":"T-BM-31","QuestionID":"QID253"}},{"SurveyID":"SV_dnk8xGmFyNl56Dk","Element":"SQ","PrimaryAttribute":"QID254","SecondaryAttribute":"Leptin is a protein that controls appetite.\u00a0 Leptin is secreted by fat cells and binds to specifi..","TertiaryAttribute":null,"Payload":{"QuestionText":"<p><span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Leptin is a protein that controls appetite.&nbsp; Leptin is secreted by fat cells and binds to specific receptors in the brain to signal that the organism is no longer hungry.&nbsp; As shown below, mice engineered to not produce either the leptin protein or the leptin receptor become severely obese.<\/span><\/span><\/p>\n\n<p style=\"text-align: center;\"><br \/>\n<img src=\"https:\/\/ssp.qualtrics.com\/CP\/Graphic.php?IM=IM_6loTLESMqrMrcsB\" style=\"width: 400px; height: 144px;\" \/><\/p>\n\n<p><br \/>\n<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\"><strong style=\"font-family: 'times new roman', times, serif; font-size: 16px;\"><span style=\"color: windowtext;\">Based on this information and your knowledge about biology, select true or false for each of the following statements.<\/span><\/strong><\/span><\/span><\/p>","QuestionJS":false,"DefaultChoices":false,"QuestionType":"SBS","Selector":"SBSMatrix","Configuration":{"QuestionDescriptionOption":"UseText","ChoiceColumnWidthPixels":671,"RepeatHeaders":"none","ColumnOrder":[1,0]},"QuestionDescription":"Leptin is a protein that controls appetite.\u00a0 Leptin is secreted by fat cells and binds to specifi...","Choices":{"1":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Administering leptin into the blood of Strain 3 mice will reduce their appetite.<\/span><\/span>"},"2":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Administering leptin receptors into the blood of Strain 3 mice will reduce their appetite.<\/span><\/span>"},"3":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">If abnormally high levels of leptin were administered to Strain 1 mice for an extended period of time, leptin receptors in the brain may be downregulated to maintain homeostasis.<\/span><\/span>"},"4":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Administering an antibody that binds to and blocks leptin receptors in Strain 2 mice will reduce their appetite.<\/span><\/span>"},"5":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Fat cells located far from the brain in Strain 1 mice will not have an effect on appetite.<\/span><\/span>"}},"ChoiceOrder":[1,2,3,4,"5"],"Randomization":{"Type":"All","Advanced":null,"EvenPresentation":false,"TotalRandSubset":""},"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[{"ChoiceID":"1","AnswerID":"1","SeriesID":"2","Grades":{"SC1":"1"},"index":0},{"ChoiceID":"2","AnswerID":"1","SeriesID":"2","Grades":{"SC1":"1"},"index":1},{"ChoiceID":"3","AnswerID":"1","SeriesID":"1","Grades":{"SC1":"1"},"index":2},{"ChoiceID":"4","AnswerID":"1","SeriesID":"2","Grades":{"SC1":"1"},"index":3},{"ChoiceID":"5","AnswerID":"1","SeriesID":"2","Grades":{"SC1":"1"},"index":4}],"Language":[],"NumberOfQuestions":1,"AdditionalQuestions":{"1":{"QuestionText":"&nbsp;","Answers":{"1":{"Display":"True"},"2":{"Display":"False"}},"RecodeValues":{"1":"1","2":"2"},"VariableNaming":[],"AnalyzeChoices":[],"QuestionType":"Matrix","Selector":"Likert","SubSelector":"SingleAnswer","ChoiceColumnWidthPixels":null,"Configuration":{"ChoiceColumnWidthPixels":10,"QuestionDescriptionOption":"UseText"},"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[{"AnswerID":"2","ChoiceID":"1","Grades":{"SC1":"1"},"index":0},{"AnswerID":"2","ChoiceID":"2","Grades":{"SC1":"1"},"index":1},{"AnswerID":"1","ChoiceID":"3","Grades":{"SC1":"1"},"index":2},{"AnswerID":"2","ChoiceID":"4","Grades":{"SC1":"1"},"index":3},{"AnswerID":"2","ChoiceID":"5","Grades":{"SC1":"1"},"index":4}],"DataExportTag":"BM-32#1","QuestionID":"QID254#1","Choices":{"1":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Administering leptin into the blood of Strain 3 mice will reduce their appetite.<\/span><\/span>"},"2":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Administering leptin receptors into the blood of Strain 3 mice will reduce their appetite.<\/span><\/span>"},"3":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">If abnormally high levels of leptin were administered to Strain 1 mice for an extended period of time, leptin receptors in the brain may be downregulated to maintain homeostasis.<\/span><\/span>"},"4":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Administering an antibody that binds to and blocks leptin receptors in Strain 2 mice will reduce their appetite.<\/span><\/span>"},"5":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Fat cells located far from the brain in Strain 1 mice will not have an effect on appetite.<\/span><\/span>"}},"ChoiceDataExportTags":false,"QuestionDescription":" "}},"ChoiceDataExportTags":false,"QuestionText_Unsafe":"<p><span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Consider a scenario where a person eats a cupcake composed of glucose molecules. The person has digested the cupcake, and the glucose has been absorbed into the bloodstream.&nbsp;<\/span><\/span><br \/>\n&nbsp;<\/p>\n\n<p><span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\"><strong style=\"font-family: 'times new roman', times, serif; font-size: 16px;\"><span style=\"color: windowtext;\">Based on this information and your knowledge about biology, select true or false for each of the following statements.<\/span><\/strong><\/span><\/span><\/p>","RecodeValues":{"1":"1"},"DataExportTag":"BM-32","QuestionID":"QID254"}},{"SurveyID":"SV_dnk8xGmFyNl56Dk","Element":"SQ","PrimaryAttribute":"QID255","SecondaryAttribute":"Timing","TertiaryAttribute":null,"Payload":{"QuestionText":"Timing","DefaultChoices":false,"QuestionType":"Timing","Selector":"PageTimer","Configuration":{"QuestionDescriptionOption":"UseText","MinSeconds":"0","MaxSeconds":"0"},"QuestionDescription":"Timing","Choices":{"1":{"Display":"First Click"},"2":{"Display":"Last Click"},"3":{"Display":"Page Submit"},"4":{"Display":"Click Count"}},"ChoiceOrder":["1","2","3"],"GradingData":[],"Language":[],"QuestionText_Unsafe":"Timing","DataExportTag":"T-BM-32","QuestionID":"QID255"}},{"SurveyID":"SV_dnk8xGmFyNl56Dk","Element":"SQ","PrimaryAttribute":"QID256","SecondaryAttribute":"In rodents, certain stimuli can induce a signaling pathway that ultimately causes the release of...","TertiaryAttribute":null,"Payload":{"QuestionText":"<p><span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">In rodents, certain stimuli can induce a signaling pathway that ultimately causes the release of the nonpolar steroid hormone corticosterone from the adrenal gland into the blood.&nbsp; Corticosterone can bind to intracellular receptors in kidney cells.&nbsp; After binding corticosterone, corticosterone receptors function as transcription factors by binding DNA and activating gene expression.&nbsp;<\/span><\/span><br \/>\n&nbsp;<\/p>\n\n<p><span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\"><strong style=\"font-family: 'times new roman', times, serif; font-size: 16px;\"><span style=\"color: windowtext;\">Based on this information and your knowledge about biology, select true or false for each of the following statements.<\/span><\/strong><\/span><\/span><\/p>","QuestionJS":false,"DefaultChoices":false,"QuestionType":"SBS","Selector":"SBSMatrix","Configuration":{"QuestionDescriptionOption":"UseText","ChoiceColumnWidthPixels":671,"RepeatHeaders":"none","ColumnOrder":[1,0]},"QuestionDescription":"In rodents, certain stimuli can induce a signaling pathway that ultimately causes the release of...","Choices":{"1":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Corticosterone has a specific three-dimensional shape that is essential for proper binding to its receptor.<\/span><\/span>"},"2":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Corticosterone can have indirect effects on cells that do not have corticosterone receptors.&nbsp;<\/span><\/span>"},"3":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Corticosterone receptors can bind to any DNA sequence in order to activate transcription.<\/span><\/span>"},"4":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Corticosterone can enter target cells through simple diffusion across the plasma membrane.&nbsp;<\/span><\/span>"},"5":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Under normal conditions, corticosterone levels in the blood will eventually return to their original levels once the initial stimulus is removed.<\/span><\/span>"}},"ChoiceOrder":[1,2,3,4,"5"],"Randomization":{"Type":"All","Advanced":null,"EvenPresentation":false,"TotalRandSubset":""},"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[{"ChoiceID":"4","AnswerID":"1","SeriesID":"1","Grades":{"SC1":"1"},"index":0},{"ChoiceID":"2","AnswerID":"1","SeriesID":"1","Grades":{"SC1":"1"},"index":1},{"ChoiceID":"3","AnswerID":"1","SeriesID":"2","Grades":{"SC1":"1"},"index":2},{"ChoiceID":"1","AnswerID":"1","SeriesID":"1","Grades":{"SC1":"1"},"index":3},{"ChoiceID":"5","AnswerID":"1","SeriesID":"1","Grades":{"SC1":"1"},"index":4}],"Language":[],"NumberOfQuestions":1,"AdditionalQuestions":{"1":{"QuestionText":"&nbsp;","Answers":{"1":{"Display":"True"},"2":{"Display":"False"}},"RecodeValues":{"1":"1","2":"2"},"VariableNaming":[],"AnalyzeChoices":[],"QuestionType":"Matrix","Selector":"Likert","SubSelector":"SingleAnswer","ChoiceColumnWidthPixels":null,"Configuration":{"ChoiceColumnWidthPixels":10,"QuestionDescriptionOption":"UseText"},"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[{"AnswerID":"1","ChoiceID":"4","Grades":{"SC1":"1"},"index":0},{"AnswerID":"1","ChoiceID":"2","Grades":{"SC1":"1"},"index":1},{"AnswerID":"2","ChoiceID":"3","Grades":{"SC1":"1"},"index":2},{"AnswerID":"1","ChoiceID":"1","Grades":{"SC1":"1"},"index":3},{"AnswerID":"1","ChoiceID":"5","Grades":{"SC1":"1"},"index":4}],"DataExportTag":"BM-33#1","QuestionID":"QID256#1","Choices":{"1":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Corticosterone has a specific three-dimensional shape that is essential for proper binding to its receptor.<\/span><\/span>"},"2":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Corticosterone can have indirect effects on cells that do not have corticosterone receptors.&nbsp;<\/span><\/span>"},"3":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Corticosterone receptors can bind to any DNA sequence in order to activate transcription.<\/span><\/span>"},"4":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Corticosterone can enter target cells through simple diffusion across the plasma membrane.&nbsp;<\/span><\/span>"},"5":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Under normal conditions, corticosterone levels in the blood will eventually return to their original levels once the initial stimulus is removed.<\/span><\/span>"}},"ChoiceDataExportTags":false,"QuestionDescription":" "}},"ChoiceDataExportTags":false,"QuestionText_Unsafe":"<p><span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Leptin is a protein that controls appetite.&nbsp; Leptin is secreted by fat cells and binds to specific receptors in the brain to signal that the organism is no longer hungry.&nbsp; As shown below, mice engineered to not produce either the leptin protein or the leptin receptor become severely obese.<\/span><\/span><br \/>\n&nbsp;<\/p>\n\n<p style=\"text-align: center;\"><span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">INSERT TABLE HERE<\/span><\/span><\/p>\n\n<p>&nbsp;<\/p>\n\n<p><span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\"><strong style=\"font-family: 'times new roman', times, serif; font-size: 16px;\"><span style=\"color: windowtext;\">Based on this information and your knowledge about biology, select true or false for each of the following statements.<\/span><\/strong><\/span><\/span><\/p>","RecodeValues":{"1":"1"},"DataExportTag":"BM-33","QuestionID":"QID256"}},{"SurveyID":"SV_dnk8xGmFyNl56Dk","Element":"SQ","PrimaryAttribute":"QID257","SecondaryAttribute":"Timing","TertiaryAttribute":null,"Payload":{"QuestionText":"Timing","DefaultChoices":false,"QuestionType":"Timing","Selector":"PageTimer","Configuration":{"QuestionDescriptionOption":"UseText","MinSeconds":"0","MaxSeconds":"0"},"QuestionDescription":"Timing","Choices":{"1":{"Display":"First Click"},"2":{"Display":"Last Click"},"3":{"Display":"Page Submit"},"4":{"Display":"Click Count"}},"ChoiceOrder":["1","2","3"],"GradingData":[],"Language":[],"QuestionText_Unsafe":"Timing","DataExportTag":"T-BM-33","QuestionID":"QID257"}},{"SurveyID":"SV_dnk8xGmFyNl56Dk","Element":"SQ","PrimaryAttribute":"QID258","SecondaryAttribute":"The arrows in this diagram represent relationships between organisms with the arrowheads pointing...","TertiaryAttribute":null,"Payload":{"QuestionText":"<p><span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">The arrows in this diagram represent relationships between organisms with the arrowheads pointing to consumers.&nbsp; For example, <em>Prokelisia<\/em> are eaten by <em>Tytthus<\/em>.&nbsp; Biomass refers to the total mass of living biological material, excluding water.&nbsp; For this question, assume that no other outside organisms affect the biomass or population sizes of the organisms shown.<\/span><\/span><\/p>\n\n<p style=\"text-align: center;\"><br \/>\n<img src=\"https:\/\/ssp.qualtrics.com\/CP\/Graphic.php?IM=IM_6nZDHQYkajrm2Ox\" style=\"width: 300px; height: 283px;\" \/><\/p>\n\n<p><br \/>\n<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\"><strong style=\"font-family: 'times new roman', times, serif; font-size: 16px;\"><span style=\"color: windowtext;\">Based on this information and your knowledge about biology, select true or false for each of the following statements.<\/span><\/strong><\/span><\/span><\/p>","QuestionJS":false,"DefaultChoices":false,"QuestionType":"SBS","Selector":"SBSMatrix","Configuration":{"QuestionDescriptionOption":"UseText","ChoiceColumnWidthPixels":671,"RepeatHeaders":"none","ColumnOrder":[1,0]},"QuestionDescription":"The arrows in this diagram represent relationships between organisms with the arrowheads pointing...","Choices":{"1":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">If nitrogen run-off flows into this habitat from nearby farm fields and acts as a fertilizer for <em>Spartina<\/em>, there is likely to be no impact on <em>Pardosa<\/em> population size.<\/span><\/span>"},"2":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">If a viral disease eliminates only the <em>Pardosa<\/em> population, there is likely to be an increase in <em>Tytthus <\/em>population size.<\/span><\/span>"},"3":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Over one growing season, the total biomass of all of the <em>Prokelisia<\/em> that is produced is greater than the combined biomass of all of the <em>Grammonata<\/em>, <em>Pardosa<\/em>, <em>Tytthus<\/em>, and <em>Hogna<\/em> that is produced.<\/span><\/span>"},"4":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\"><em>Spartina<\/em> biomass is higher when all of the species pictured are present than when only <em>Spartina<\/em> and <em>Prokelisia<\/em> are present.<\/span><\/span>"}},"ChoiceOrder":[1,2,3,4],"Randomization":{"Type":"All","Advanced":null,"EvenPresentation":false,"TotalRandSubset":""},"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[{"ChoiceID":"4","AnswerID":"1","SeriesID":"1","Grades":{"SC1":"1"},"index":0},{"ChoiceID":"1","AnswerID":"1","SeriesID":"2","Grades":{"SC1":"1"},"index":1},{"ChoiceID":"2","AnswerID":"1","SeriesID":"1","Grades":{"SC1":"1"},"index":2},{"ChoiceID":"3","AnswerID":"1","SeriesID":"1","Grades":{"SC1":"1"},"index":3}],"Language":[],"NumberOfQuestions":1,"AdditionalQuestions":{"1":{"QuestionText":"&nbsp;","Answers":{"1":{"Display":"True"},"2":{"Display":"False"}},"RecodeValues":{"1":"1","2":"2"},"VariableNaming":[],"AnalyzeChoices":[],"QuestionType":"Matrix","Selector":"Likert","SubSelector":"SingleAnswer","ChoiceColumnWidthPixels":null,"Configuration":{"ChoiceColumnWidthPixels":10,"QuestionDescriptionOption":"UseText"},"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[{"AnswerID":"1","ChoiceID":"4","Grades":{"SC1":"1"},"index":0},{"AnswerID":"2","ChoiceID":"1","Grades":{"SC1":"1"},"index":1},{"AnswerID":"1","ChoiceID":"2","Grades":{"SC1":"1"},"index":2},{"AnswerID":"1","ChoiceID":"3","Grades":{"SC1":"1"},"index":3}],"DataExportTag":"BM-35#1","QuestionID":"QID258#1","Choices":{"1":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">If nitrogen run-off flows into this habitat from nearby farm fields and acts as a fertilizer for <em>Spartina<\/em>, there is likely to be no impact on <em>Pardosa<\/em> population size.<\/span><\/span>"},"2":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">If a viral disease eliminates only the <em>Pardosa<\/em> population, there is likely to be an increase in <em>Tytthus <\/em>population size.<\/span><\/span>"},"3":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Over one growing season, the total biomass of all of the <em>Prokelisia<\/em> that is produced is greater than the combined biomass of all of the <em>Grammonata<\/em>, <em>Pardosa<\/em>, <em>Tytthus<\/em>, and <em>Hogna<\/em> that is produced.<\/span><\/span>"},"4":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\"><em>Spartina<\/em> biomass is higher when all of the species pictured are present than when only <em>Spartina<\/em> and <em>Prokelisia<\/em> are present.<\/span><\/span>"}},"ChoiceDataExportTags":false,"QuestionDescription":" "}},"ChoiceDataExportTags":false,"QuestionText_Unsafe":"<p><span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">In rodents, certain stimuli can induce a signaling pathway that ultimately causes the release of the nonpolar steroid hormone corticosterone from the adrenal gland into the blood.&nbsp; Corticosterone can bind to intracellular receptors in kidney cells.&nbsp; After binding corticosterone, corticosterone receptors function as transcription factors by binding DNA and activating gene expression.&nbsp;<\/span><\/span><br \/>\n&nbsp;<\/p>\n\n<p><span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\"><strong style=\"font-family: 'times new roman', times, serif; font-size: 16px;\"><span style=\"color: windowtext;\">Based on this information and your knowledge about biology, select true or false for each of the following statements.<\/span><\/strong><\/span><\/span><\/p>","RecodeValues":{"1":"1"},"DataExportTag":"BM-35","QuestionID":"QID258"}},{"SurveyID":"SV_dnk8xGmFyNl56Dk","Element":"SQ","PrimaryAttribute":"QID259","SecondaryAttribute":"Timing","TertiaryAttribute":null,"Payload":{"QuestionText":"Timing","DefaultChoices":false,"QuestionType":"Timing","Selector":"PageTimer","Configuration":{"QuestionDescriptionOption":"UseText","MinSeconds":"0","MaxSeconds":"0"},"QuestionDescription":"Timing","Choices":{"1":{"Display":"First Click"},"2":{"Display":"Last Click"},"3":{"Display":"Page Submit"},"4":{"Display":"Click Count"}},"ChoiceOrder":["1","2","3"],"GradingData":[],"Language":[],"QuestionText_Unsafe":"Timing","DataExportTag":"T-BM-35","QuestionID":"QID259"}},{"SurveyID":"SV_dnk8xGmFyNl56Dk","Element":"SQ","PrimaryAttribute":"QID260","SecondaryAttribute":"The chromosomes drawn below are found in a human skin cell. \u00a0The lines represent the chromosomes...","TertiaryAttribute":null,"Payload":{"QuestionText":"<p><span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">The chromosomes drawn below are found in a human skin cell. &nbsp;The lines represent the chromosomes themselves.&nbsp; The letters indicate the location of a particular version of a gene.<\/span><\/span><\/p>\n\n<p style=\"text-align: center;\"><br \/>\n<img src=\"https:\/\/ssp.qualtrics.com\/CP\/Graphic.php?IM=IM_5w37SuXloctgwPX\" style=\"width: 200px; height: 132px;\" \/><\/p>\n\n<p><br \/>\n<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\"><strong style=\"font-family: 'times new roman', times, serif; font-size: 16px;\"><span style=\"color: windowtext;\">Based on this information and your knowledge about biology, select true or false for each of the following statements.<\/span><\/strong><\/span><\/span><\/p>","QuestionJS":false,"DefaultChoices":false,"QuestionType":"SBS","Selector":"SBSMatrix","Configuration":{"QuestionDescriptionOption":"UseText","ChoiceColumnWidthPixels":671,"RepeatHeaders":"none","ColumnOrder":[1,0]},"QuestionDescription":"The chromosomes drawn below are found in a human skin cell. \u00a0The lines represent the chromosomes...","Choices":{"1":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">An individual&rsquo;s offspring are more likely to inherit a <em>D<sub>1<\/sub><\/em> and <em>R<\/em> together than a <em>D<sub>1<\/sub><\/em> and <em>T<sub>9<\/sub><\/em> together.<\/span><\/span>"},"2":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">About 50% of the egg cells from this individual will have both <em>T<sub>9<\/sub><\/em> and <em>BA<sub>5<\/sub><\/em>.<\/span><\/span>"},"3":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Because <em>r<\/em> is recessive, the frequency at which the <em>r <\/em>version of the gene occurs in a population is lower than the frequency at which the <em>R<\/em> version occurs in the population.<\/span><\/span>"},"4":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">If the protein produced by the <em>BA<\/em> gene is involved in the formation of ovaries, then the <em>BA<\/em> gene is likely located on a sex chromosome.<\/span><\/span>"},"5":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Because the genes shown here are found in skin cells, these genes code for proteins required for skin cell function.<\/span><\/span>"}},"ChoiceOrder":[1,2,3,4,"5"],"Randomization":{"Type":"All","Advanced":null,"EvenPresentation":false,"TotalRandSubset":""},"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[{"ChoiceID":"3","AnswerID":"1","SeriesID":"2","Grades":{"SC1":"1"},"index":0},{"ChoiceID":"2","AnswerID":"1","SeriesID":"2","Grades":{"SC1":"1"},"index":1},{"ChoiceID":"4","AnswerID":"1","SeriesID":"2","Grades":{"SC1":"1"},"index":2},{"ChoiceID":"5","AnswerID":"1","SeriesID":"2","Grades":{"SC1":"1"},"index":3},{"ChoiceID":"1","AnswerID":"1","SeriesID":"1","Grades":{"SC1":"1"},"index":4}],"Language":[],"NumberOfQuestions":1,"AdditionalQuestions":{"1":{"QuestionText":"&nbsp;","Answers":{"1":{"Display":"True"},"2":{"Display":"False"}},"RecodeValues":{"1":"1","2":"2"},"VariableNaming":[],"AnalyzeChoices":[],"QuestionType":"Matrix","Selector":"Likert","SubSelector":"SingleAnswer","ChoiceColumnWidthPixels":null,"Configuration":{"ChoiceColumnWidthPixels":10,"QuestionDescriptionOption":"UseText"},"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[{"AnswerID":"2","ChoiceID":"3","Grades":{"SC1":"1"},"index":0},{"AnswerID":"2","ChoiceID":"2","Grades":{"SC1":"1"},"index":1},{"AnswerID":"2","ChoiceID":"4","Grades":{"SC1":"1"},"index":2},{"AnswerID":"2","ChoiceID":"5","Grades":{"SC1":"1"},"index":3},{"AnswerID":"1","ChoiceID":"1","Grades":{"SC1":"1"},"index":4}],"DataExportTag":"BM-36#1","QuestionID":"QID260#1","Choices":{"1":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">An individual&rsquo;s offspring are more likely to inherit a <em>D<sub>1<\/sub><\/em> and <em>R<\/em> together than a <em>D<sub>1<\/sub><\/em> and <em>T<sub>9<\/sub><\/em> together.<\/span><\/span>"},"2":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">About 50% of the egg cells from this individual will have both <em>T<sub>9<\/sub><\/em> and <em>BA<sub>5<\/sub><\/em>.<\/span><\/span>"},"3":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Because <em>r<\/em> is recessive, the frequency at which the <em>r <\/em>version of the gene occurs in a population is lower than the frequency at which the <em>R<\/em> version occurs in the population.<\/span><\/span>"},"4":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">If the protein produced by the <em>BA<\/em> gene is involved in the formation of ovaries, then the <em>BA<\/em> gene is likely located on a sex chromosome.<\/span><\/span>"},"5":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Because the genes shown here are found in skin cells, these genes code for proteins required for skin cell function.<\/span><\/span>"}},"ChoiceDataExportTags":false,"QuestionDescription":" "}},"ChoiceDataExportTags":false,"QuestionText_Unsafe":"<p><span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">The arrows in this diagram represent relationships between organisms with the arrowheads pointing to consumers.&nbsp; For example, <em>Prokelisia<\/em> are eaten by <em>Tytthus<\/em>.&nbsp; Biomass refers to the total mass of living biological material, excluding water.&nbsp; For this question, assume that no other outside organisms affect the biomass or population sizes of the organisms shown.&nbsp;&nbsp;<\/span><\/span><br \/>\n&nbsp;<\/p>\n\n<p style=\"text-align: center;\"><span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">INSERT IMAGE HERE<\/span><\/span><br \/>\n&nbsp;<\/p>\n\n<p><span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\"><strong style=\"font-family: 'times new roman', times, serif; font-size: 16px;\"><span style=\"color: windowtext;\">Based on this information and your knowledge about biology, select true or false for each of the following statements.<\/span><\/strong><\/span><\/span><\/p>","RecodeValues":{"1":"1"},"DataExportTag":"BM-36","QuestionID":"QID260"}},{"SurveyID":"SV_dnk8xGmFyNl56Dk","Element":"SQ","PrimaryAttribute":"QID261","SecondaryAttribute":"Timing","TertiaryAttribute":null,"Payload":{"QuestionText":"Timing","DefaultChoices":false,"QuestionType":"Timing","Selector":"PageTimer","Configuration":{"QuestionDescriptionOption":"UseText","MinSeconds":"0","MaxSeconds":"0"},"QuestionDescription":"Timing","Choices":{"1":{"Display":"First Click"},"2":{"Display":"Last Click"},"3":{"Display":"Page Submit"},"4":{"Display":"Click Count"}},"ChoiceOrder":["1","2","3"],"GradingData":[],"Language":[],"QuestionText_Unsafe":"Timing","DataExportTag":"T-BM-36","QuestionID":"QID261"}},{"SurveyID":"SV_dnk8xGmFyNl56Dk","Element":"SQ","PrimaryAttribute":"QID262","SecondaryAttribute":"For the following reaction sequence, not all substrates and products are shown. ADH and ADLH are...","TertiaryAttribute":null,"Payload":{"QuestionText":"<p><span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">For the following reaction sequence, not all substrates and products are shown.<\/span><\/span><\/p>\n\n<p style=\"text-align: center;\"><br \/>\n<img src=\"https:\/\/ssp.qualtrics.com\/CP\/Graphic.php?IM=IM_6zgIrgwUi9cImGx\" style=\"width: 400px; height: 73px;\" \/><\/p>\n\n<p><br \/>\n<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">ADH and ADLH are enzymes that catalyze each reaction in liver cells. &nbsp;A buildup of acetaldehyde is toxic to cells.&nbsp; Many different versions of the enzymes are present in human populations. &nbsp;Some versions have faster or slower reaction rates than others.&nbsp;<\/span><\/span><br \/>\n&nbsp;<\/p>\n\n<p><span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\"><strong style=\"font-family: 'times new roman', times, serif; font-size: 16px;\"><span style=\"color: windowtext;\">Based on this information and your knowledge about biology, select true or false for each of the following statements.<\/span><\/strong><\/span><\/span><\/p>","QuestionJS":false,"DefaultChoices":false,"QuestionType":"SBS","Selector":"SBSMatrix","Configuration":{"QuestionDescriptionOption":"UseText","ChoiceColumnWidthPixels":671,"RepeatHeaders":"none","ColumnOrder":[1,0]},"QuestionDescription":"For the following reaction sequence, not all substrates and products are shown. ADH and ADLH are...","Choices":{"1":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Different versions of the ADH and ADLH enzymes could have arisen in the population through errors that occurred during DNA replication.&nbsp;<\/span><\/span>"},"2":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">The observation that many different versions of these enzymes exist in human populations means that the enzymes are not critical for survival and reproduction.<\/span><\/span>"},"3":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Individuals with slow ADLH enzymes are more likely to suffer adverse effects from ethanol consumption than individuals with fast ADLH enzymes.&nbsp;<\/span><\/span>"},"4":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">The genes that code for the ADH and ADLH enzymes are found only in liver cells.<\/span><\/span>"},"5":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">If a person takes in large quantities of ethanol in a short amount of time, mutations will occur that lead to faster ADH reaction rates.&nbsp;&nbsp;<\/span><\/span>"}},"ChoiceOrder":[1,2,3,4,"5"],"Randomization":{"Type":"All","Advanced":null,"EvenPresentation":false,"TotalRandSubset":""},"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[{"ChoiceID":"1","AnswerID":"1","SeriesID":"1","Grades":{"SC1":"1"},"index":0},{"ChoiceID":"2","AnswerID":"1","SeriesID":"2","Grades":{"SC1":"1"},"index":1},{"ChoiceID":"3","AnswerID":"1","SeriesID":"1","Grades":{"SC1":"1"},"index":2},{"ChoiceID":"4","AnswerID":"1","SeriesID":"2","Grades":{"SC1":"1"},"index":3},{"ChoiceID":"5","AnswerID":"1","SeriesID":"2","Grades":{"SC1":"1"},"index":4}],"Language":[],"NumberOfQuestions":1,"AdditionalQuestions":{"1":{"QuestionText":"&nbsp;","Answers":{"1":{"Display":"True"},"2":{"Display":"False"}},"RecodeValues":{"1":"1","2":"2"},"VariableNaming":[],"AnalyzeChoices":[],"QuestionType":"Matrix","Selector":"Likert","SubSelector":"SingleAnswer","ChoiceColumnWidthPixels":null,"Configuration":{"ChoiceColumnWidthPixels":10,"QuestionDescriptionOption":"UseText"},"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[{"AnswerID":"1","ChoiceID":"1","Grades":{"SC1":"1"},"index":0},{"AnswerID":"2","ChoiceID":"2","Grades":{"SC1":"1"},"index":1},{"AnswerID":"1","ChoiceID":"3","Grades":{"SC1":"1"},"index":2},{"AnswerID":"2","ChoiceID":"4","Grades":{"SC1":"1"},"index":3},{"AnswerID":"2","ChoiceID":"5","Grades":{"SC1":"1"},"index":4}],"DataExportTag":"BM-37#1","QuestionID":"QID262#1","Choices":{"1":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Different versions of the ADH and ADLH enzymes could have arisen in the population through errors that occurred during DNA replication.&nbsp;<\/span><\/span>"},"2":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">The observation that many different versions of these enzymes exist in human populations means that the enzymes are not critical for survival and reproduction.<\/span><\/span>"},"3":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Individuals with slow ADLH enzymes are more likely to suffer adverse effects from ethanol consumption than individuals with fast ADLH enzymes.&nbsp;<\/span><\/span>"},"4":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">The genes that code for the ADH and ADLH enzymes are found only in liver cells.<\/span><\/span>"},"5":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">If a person takes in large quantities of ethanol in a short amount of time, mutations will occur that lead to faster ADH reaction rates.&nbsp;&nbsp;<\/span><\/span>"}},"ChoiceDataExportTags":false,"QuestionDescription":" "}},"ChoiceDataExportTags":false,"QuestionText_Unsafe":"<p><span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">The chromosomes drawn below are found in a human skin cell. &nbsp;The lines represent the chromosomes themselves.&nbsp; The letters indicate the location of a particular version of a gene.<\/span><\/span><br \/>\n&nbsp;<\/p>\n\n<p style=\"text-align: center;\"><span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">INSERT IMAGE HERE<\/span><\/span><br \/>\n&nbsp;<\/p>\n\n<p><span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\"><strong style=\"font-family: 'times new roman', times, serif; font-size: 16px;\"><span style=\"color: windowtext;\">Based on this information and your knowledge about biology, select true or false for each of the following statements.<\/span><\/strong><\/span><\/span><\/p>","RecodeValues":{"1":"1"},"DataExportTag":"BM-37","QuestionID":"QID262"}},{"SurveyID":"SV_dnk8xGmFyNl56Dk","Element":"SQ","PrimaryAttribute":"QID263","SecondaryAttribute":"Timing","TertiaryAttribute":null,"Payload":{"QuestionText":"Timing","DefaultChoices":false,"QuestionType":"Timing","Selector":"PageTimer","Configuration":{"QuestionDescriptionOption":"UseText","MinSeconds":"0","MaxSeconds":"0"},"QuestionDescription":"Timing","Choices":{"1":{"Display":"First Click"},"2":{"Display":"Last Click"},"3":{"Display":"Page Submit"},"4":{"Display":"Click Count"}},"ChoiceOrder":["1","2","3"],"GradingData":[],"Language":[],"QuestionText_Unsafe":"Timing","DataExportTag":"T-BM-37","QuestionID":"QID263"}},{"SurveyID":"SV_dnk8xGmFyNl56Dk","Element":"SQ","PrimaryAttribute":"QID264","SecondaryAttribute":"The diagram below shows different sections of the AJC gene. White boxes are regulatory sequences....","TertiaryAttribute":null,"Payload":{"QuestionText":"<div><span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">The diagram below shows different sections of the <em>AJC<\/em> gene.<\/span><\/span><\/div>\n\n<div style=\"text-align: center;\"><br \/>\n<img src=\"https:\/\/ssp.qualtrics.com\/CP\/Graphic.php?IM=IM_baBHSVxPUY25Qvr\" style=\"width: 600px; height: 60px;\" \/><\/div>\n\n<div><br \/>\n<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\"><span style=\"line-height: 107%;\">White boxes are regulatory sequences.&nbsp; Black boxes are exons that contain information that specifies part of this gene&rsquo;s protein.&nbsp; Striped boxes are introns, which are sections that do not code for the final protein.&nbsp; The bent arrow indicates the transcription start site.&nbsp; There is only one transcription start site for this gene.<\/span><\/span><\/span><br \/>\n<br \/>\n<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\"><strong><span style=\"color: windowtext;\">Based on this information and your knowledge about biology, select true or false for each of the following statements.<\/span><\/strong><\/span><\/span><\/div>","QuestionJS":false,"DefaultChoices":false,"QuestionType":"SBS","Selector":"SBSMatrix","Configuration":{"QuestionDescriptionOption":"UseText","ChoiceColumnWidthPixels":671,"RepeatHeaders":"none","ColumnOrder":[1,0]},"QuestionDescription":"The diagram below shows different sections of the AJC gene. White boxes are regulatory sequences....","Choices":{"1":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Only mutations that occur in the exons can have an impact on the cell.<\/span><\/span>"},"2":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">A protein that binds to a regulatory sequence could reduce the amount of mRNA produced from this gene.<\/span><\/span>"},"3":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">The gene sequence shown in the diagram above could code for proteins of different sizes.<\/span><\/span>"},"4":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Signals originating from outside the cell could regulate expression of this gene.&nbsp;&nbsp;<\/span><\/span>"},"5":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">A mutation in the regulatory region will likely result in a change in the nucleotide sequence of the mRNA produced from this gene.<\/span><\/span>"}},"ChoiceOrder":[1,2,3,4,"5"],"Randomization":{"Type":"All","Advanced":null,"EvenPresentation":false,"TotalRandSubset":""},"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[{"ChoiceID":"4","AnswerID":"1","SeriesID":"1","Grades":{"SC1":"1"},"index":0},{"ChoiceID":"1","AnswerID":"1","SeriesID":"2","Grades":{"SC1":"1"},"index":1},{"ChoiceID":"2","AnswerID":"1","SeriesID":"1","Grades":{"SC1":"1"},"index":2},{"ChoiceID":"3","AnswerID":"1","SeriesID":"1","Grades":{"SC1":"1"},"index":3},{"ChoiceID":"5","AnswerID":"1","SeriesID":"2","Grades":{"SC1":"1"},"index":4}],"Language":[],"NumberOfQuestions":1,"AdditionalQuestions":{"1":{"QuestionText":"&nbsp;","Answers":{"1":{"Display":"True"},"2":{"Display":"False"}},"RecodeValues":{"1":"1","2":"2"},"VariableNaming":[],"AnalyzeChoices":[],"QuestionType":"Matrix","Selector":"Likert","SubSelector":"SingleAnswer","ChoiceColumnWidthPixels":null,"Configuration":{"ChoiceColumnWidthPixels":10,"QuestionDescriptionOption":"UseText"},"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[{"AnswerID":"1","ChoiceID":"4","Grades":{"SC1":"1"},"index":0},{"AnswerID":"2","ChoiceID":"1","Grades":{"SC1":"1"},"index":1},{"AnswerID":"1","ChoiceID":"2","Grades":{"SC1":"1"},"index":2},{"AnswerID":"1","ChoiceID":"3","Grades":{"SC1":"1"},"index":3},{"AnswerID":"2","ChoiceID":"5","Grades":{"SC1":"1"},"index":4}],"DataExportTag":"BM-38#1","QuestionID":"QID264#1","Choices":{"1":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Only mutations that occur in the exons can have an impact on the cell.<\/span><\/span>"},"2":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">A protein that binds to a regulatory sequence could reduce the amount of mRNA produced from this gene.<\/span><\/span>"},"3":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">The gene sequence shown in the diagram above could code for proteins of different sizes.<\/span><\/span>"},"4":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Signals originating from outside the cell could regulate expression of this gene.&nbsp;&nbsp;<\/span><\/span>"},"5":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">A mutation in the regulatory region will likely result in a change in the nucleotide sequence of the mRNA produced from this gene.<\/span><\/span>"}},"ChoiceDataExportTags":false,"QuestionDescription":" "}},"ChoiceDataExportTags":false,"QuestionText_Unsafe":"<p><span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">For the following reaction sequence, not all substrates and products are shown.<\/span><\/span><\/p>\n\n<p style=\"text-align: center;\"><br \/>\n<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">INSERT IMAGE HERE<\/span><\/span><br \/>\n&nbsp;<\/p>\n\n<p><span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">ADH and ADLH are enzymes that catalyze each reaction in liver cells. &nbsp;A buildup of acetaldehyde is toxic to cells.&nbsp; Many different versions of the enzymes are present in human populations. &nbsp;Some versions have faster or slower reaction rates than others.&nbsp;<\/span><\/span><br \/>\n&nbsp;<\/p>\n\n<p><span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\"><strong style=\"font-family: 'times new roman', times, serif; font-size: 16px;\"><span style=\"color: windowtext;\">Based on this information and your knowledge about biology, select true or false for each of the following statements.<\/span><\/strong><\/span><\/span><\/p>","RecodeValues":{"1":"1"},"DataExportTag":"BM-38","QuestionID":"QID264"}},{"SurveyID":"SV_dnk8xGmFyNl56Dk","Element":"SQ","PrimaryAttribute":"QID265","SecondaryAttribute":"Timing","TertiaryAttribute":null,"Payload":{"QuestionText":"Timing","DefaultChoices":false,"QuestionType":"Timing","Selector":"PageTimer","Configuration":{"QuestionDescriptionOption":"UseText","MinSeconds":"0","MaxSeconds":"0"},"QuestionDescription":"Timing","Choices":{"1":{"Display":"First Click"},"2":{"Display":"Last Click"},"3":{"Display":"Page Submit"},"4":{"Display":"Click Count"}},"ChoiceOrder":["1","2","3"],"GradingData":[],"Language":[],"QuestionText_Unsafe":"Timing","DataExportTag":"T-BM-38","QuestionID":"QID265"}},{"SurveyID":"SV_dnk8xGmFyNl56Dk","Element":"SQ","PrimaryAttribute":"QID266","SecondaryAttribute":"Compound X is a molecule that is used to kill cockroaches.\u00a0 It acts by binding to and blocking th..","TertiaryAttribute":null,"Payload":{"QuestionText":"<div><span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Compound X is a molecule that is used to kill cockroaches.&nbsp; It acts by binding to and blocking the function of nR proteins in cockroaches.&nbsp; A mutation occurs in the <em>nR<\/em> gene that leads to a mutated nR protein.&nbsp; Compound X is less likely to bind to this mutated nR protein.&nbsp;<\/span><\/span><\/div>\n\n<p>&nbsp;<\/p>\n\n<p><span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\"><strong><span style=\"color: windowtext;\">Based on this information and your knowledge about biology, select true or false for each of the following statements.<\/span><\/strong><\/span><\/span><\/p>","QuestionJS":false,"DefaultChoices":false,"QuestionType":"SBS","Selector":"SBSMatrix","Configuration":{"QuestionDescriptionOption":"UseText","ChoiceColumnWidthPixels":671,"RepeatHeaders":"none","ColumnOrder":[1,0]},"QuestionDescription":"Compound X is a molecule that is used to kill cockroaches.\u00a0 It acts by binding to and blocking th...","Choices":{"1":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">This mutation will only occur in cockroaches that are exposed to Compound X.<\/span><\/span>"},"2":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">If the mutated form of the <em>nR<\/em> gene increases in frequency in the population, alleles that are located nearby the <em>nR<\/em> gene on the same chromosome are also likely to increase in frequency.<\/span><\/span>"},"3":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">The ability of Compound X to bind to a specific site on the nR protein depends on that site&rsquo;s shape and charge.<\/span><\/span>","InputWidth":50},"4":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">When Compound X binds to the nR protein in a cockroach, it changes that cockroach&rsquo;s genetic information.<\/span><\/span>"}},"ChoiceOrder":[1,2,3,4],"Randomization":{"Type":"All","Advanced":null,"EvenPresentation":false,"TotalRandSubset":""},"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[{"ChoiceID":"1","AnswerID":"1","SeriesID":"2","Grades":{"SC1":"1"},"index":0},{"ChoiceID":"2","AnswerID":"1","SeriesID":"1","Grades":{"SC1":"1"},"index":1},{"ChoiceID":"3","AnswerID":"1","SeriesID":"1","Grades":{"SC1":"1"},"index":2},{"ChoiceID":"4","AnswerID":"1","SeriesID":"2","Grades":{"SC1":"1"},"index":3}],"Language":[],"NumberOfQuestions":1,"AdditionalQuestions":{"1":{"QuestionText":"&nbsp;","Answers":{"1":{"Display":"True"},"2":{"Display":"False"}},"RecodeValues":{"1":"1","2":"2"},"VariableNaming":[],"AnalyzeChoices":[],"QuestionType":"Matrix","Selector":"Likert","SubSelector":"SingleAnswer","ChoiceColumnWidthPixels":null,"Configuration":{"ChoiceColumnWidthPixels":10,"QuestionDescriptionOption":"UseText"},"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[{"AnswerID":"2","ChoiceID":"1","Grades":{"SC1":"1"},"index":0},{"AnswerID":"1","ChoiceID":"2","Grades":{"SC1":"1"},"index":1},{"AnswerID":"1","ChoiceID":"3","Grades":{"SC1":"1"},"index":2},{"AnswerID":"2","ChoiceID":"4","Grades":{"SC1":"1"},"index":3}],"DataExportTag":"BM-40#1","QuestionID":"QID266#1","Choices":{"1":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">This mutation will only occur in cockroaches that are exposed to Compound X.<\/span><\/span>"},"2":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">If the mutated form of the <em>nR<\/em> gene increases in frequency in the population, alleles that are located nearby the <em>nR<\/em> gene on the same chromosome are also likely to increase in frequency.<\/span><\/span>"},"3":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">The ability of Compound X to bind to a specific site on the nR protein depends on that site&rsquo;s shape and charge.<\/span><\/span>","InputWidth":50},"4":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">When Compound X binds to the nR protein in a cockroach, it changes that cockroach&rsquo;s genetic information.<\/span><\/span>"}},"ChoiceDataExportTags":false,"QuestionDescription":" "}},"ChoiceDataExportTags":false,"QuestionText_Unsafe":"<div><span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">The diagram below shows different sections of the <em>AJC<\/em> gene.<\/span><\/span><br \/>\n&nbsp;<\/div>\n\n<p style=\"text-align: center;\"><span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">INSERT IMAGE HERE<\/span><\/span><\/p>\n\n<p><br \/>\n<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\"><span style=\"line-height: 107%;\">White boxes are regulatory sequences.&nbsp; Black boxes are exons that contain information that specifies part of this gene&rsquo;s protein.&nbsp; Striped boxes are introns, which are sections that do not code for the final protein.&nbsp; The bent arrow indicates the transcription start site.&nbsp; There is only one transcription start site for this gene. <\/span>&nbsp; &nbsp;&nbsp;<\/span><\/span><\/p>\n\n<p>&nbsp;<\/p>\n\n<p><span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\"><strong><span style=\"color: windowtext;\">Based on this information and your knowledge about biology, select true or false for each of the following statements.<\/span><\/strong><\/span><\/span><\/p>","RecodeValues":{"1":"1"},"DataExportTag":"BM-40","QuestionID":"QID266"}},{"SurveyID":"SV_dnk8xGmFyNl56Dk","Element":"SQ","PrimaryAttribute":"QID267","SecondaryAttribute":"Timing","TertiaryAttribute":null,"Payload":{"QuestionText":"Timing","DefaultChoices":false,"QuestionType":"Timing","Selector":"PageTimer","Configuration":{"QuestionDescriptionOption":"UseText","MinSeconds":"0","MaxSeconds":"0"},"QuestionDescription":"Timing","Choices":{"1":{"Display":"First Click"},"2":{"Display":"Last Click"},"3":{"Display":"Page Submit"},"4":{"Display":"Click Count"}},"ChoiceOrder":["1","2","3"],"GradingData":[],"Language":[],"QuestionText_Unsafe":"Timing","DataExportTag":"T-BM-40","QuestionID":"QID267"}},{"SurveyID":"SV_dnk8xGmFyNl56Dk","Element":"SQ","PrimaryAttribute":"QID268","SecondaryAttribute":"Bigleaf maple trees have the largest leaves of any of the 128 maple species.\u00a0 Leaf size varies wi..","TertiaryAttribute":null,"Payload":{"QuestionText":"<div><span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Bigleaf maple trees have the largest leaves of any of the 128 maple species.&nbsp; Leaf size varies within and among individual bigleaf maple trees.&nbsp;&nbsp;<\/span><\/span><\/div>\n\n<p>&nbsp;<\/p>\n\n<p><span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\"><strong><span style=\"color: windowtext;\">Based on this information and your knowledge about biology, select true or false for each of the following statements.<\/span><\/strong><\/span><\/span><\/p>","QuestionJS":false,"DefaultChoices":false,"QuestionType":"SBS","Selector":"SBSMatrix","Configuration":{"QuestionDescriptionOption":"UseText","ChoiceColumnWidthPixels":671,"RepeatHeaders":"none","ColumnOrder":[1,0]},"QuestionDescription":"Bigleaf maple trees have the largest leaves of any of the 128 maple species.\u00a0 Leaf size varies wi...","Choices":{"1":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Bigleaf maple trees absorb water for photosynthesis primarily through their leaves.<\/span><\/span>"},"2":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">A difference in genotype could explain why leaf size varies among different trees within the same species.<\/span><\/span>"},"3":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">A difference in genotype likely explains why leaf size varies within a single individual tree.<\/span><\/span>"},"4":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">If a habitat becomes hotter and drier, trees with more total leaf surface area would likely have higher fitness than trees with less total leaf surface area.<\/span><\/span>"},"5":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">In response to shading, leaves on the lower branches of a bigleaf maple may grow larger than leaves on the upper branches of the same tree.&nbsp;<\/span><\/span>"}},"ChoiceOrder":[1,2,3,4,"5"],"Randomization":{"Type":"All","Advanced":null,"EvenPresentation":false,"TotalRandSubset":""},"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[{"ChoiceID":"1","AnswerID":"1","SeriesID":"2","Grades":{"SC1":"1"},"index":0},{"ChoiceID":"2","AnswerID":"1","SeriesID":"1","Grades":{"SC1":"1"},"index":1},{"ChoiceID":"3","AnswerID":"1","SeriesID":"2","Grades":{"SC1":"1"},"index":2},{"ChoiceID":"4","AnswerID":"1","SeriesID":"2","Grades":{"SC1":"1"},"index":3},{"ChoiceID":"5","AnswerID":"1","SeriesID":"1","Grades":{"SC1":"1"},"index":4}],"Language":[],"NumberOfQuestions":1,"AdditionalQuestions":{"1":{"QuestionText":"&nbsp;","Answers":{"1":{"Display":"True"},"2":{"Display":"False"}},"RecodeValues":{"1":"1","2":"2"},"VariableNaming":[],"AnalyzeChoices":[],"QuestionType":"Matrix","Selector":"Likert","SubSelector":"SingleAnswer","ChoiceColumnWidthPixels":null,"Configuration":{"ChoiceColumnWidthPixels":10,"QuestionDescriptionOption":"UseText"},"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[{"AnswerID":"2","ChoiceID":"1","Grades":{"SC1":"1"},"index":0},{"AnswerID":"1","ChoiceID":"2","Grades":{"SC1":"1"},"index":1},{"AnswerID":"2","ChoiceID":"3","Grades":{"SC1":"1"},"index":2},{"AnswerID":"2","ChoiceID":"4","Grades":{"SC1":"1"},"index":3},{"AnswerID":"1","ChoiceID":"5","Grades":{"SC1":"1"},"index":4}],"DataExportTag":"BM-43#1","QuestionID":"QID268#1","Choices":{"1":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Bigleaf maple trees absorb water for photosynthesis primarily through their leaves.<\/span><\/span>"},"2":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">A difference in genotype could explain why leaf size varies among different trees within the same species.<\/span><\/span>"},"3":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">A difference in genotype likely explains why leaf size varies within a single individual tree.<\/span><\/span>"},"4":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">If a habitat becomes hotter and drier, trees with more total leaf surface area would likely have higher fitness than trees with less total leaf surface area.<\/span><\/span>"},"5":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">In response to shading, leaves on the lower branches of a bigleaf maple may grow larger than leaves on the upper branches of the same tree.&nbsp;<\/span><\/span>"}},"ChoiceDataExportTags":false,"QuestionDescription":" "}},"ChoiceDataExportTags":false,"QuestionText_Unsafe":"<div><span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Compound X is a molecule that is used to kill cockroaches.&nbsp; It acts by binding to and blocking the function of nR proteins in cockroaches.&nbsp; A mutation occurs in the <em>nR<\/em> gene that leads to a mutated nR protein.&nbsp; Compound X is less likely to bind to this mutated nR protein.&nbsp;<\/span><\/span><\/div>\n\n<p>&nbsp;<\/p>\n\n<p><span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\"><strong><span style=\"color: windowtext;\">Based on this information and your knowledge about biology, select true or false for each of the following statements.<\/span><\/strong><\/span><\/span><\/p>","RecodeValues":{"1":"1"},"DataExportTag":"BM-43","QuestionID":"QID268"}},{"SurveyID":"SV_dnk8xGmFyNl56Dk","Element":"SQ","PrimaryAttribute":"QID269","SecondaryAttribute":"Timing","TertiaryAttribute":null,"Payload":{"QuestionText":"Timing","DefaultChoices":false,"QuestionType":"Timing","Selector":"PageTimer","Configuration":{"QuestionDescriptionOption":"UseText","MinSeconds":"0","MaxSeconds":"0"},"QuestionDescription":"Timing","Choices":{"1":{"Display":"First Click"},"2":{"Display":"Last Click"},"3":{"Display":"Page Submit"},"4":{"Display":"Click Count"}},"ChoiceOrder":["1","2","3"],"GradingData":[],"Language":[],"QuestionText_Unsafe":"Timing","DataExportTag":"T-BM-43","QuestionID":"QID269"}},{"SurveyID":"SV_dnk8xGmFyNl56Dk","Element":"SQ","PrimaryAttribute":"QID270","SecondaryAttribute":"ATP is produced when glucose is metabolized in cells.\u00a0 In addition to being a product of metaboli..","TertiaryAttribute":null,"Payload":{"QuestionText":"<div><span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">ATP is produced when glucose is metabolized in cells.&nbsp; In addition to being a product of metabolism, ATP serves as both a substrate and as a regulator for one of the enzymes involved in glucose metabolism.&nbsp; This enzyme has two sites where ATP binds: an active site where the reaction required for glucose metabolism occurs and a regulatory site.&nbsp; ATP binding to the regulatory site blocks the enzyme&rsquo;s activity.<\/span><\/span><\/div>\n\n<div style=\"text-align: center;\"><br \/>\n<img src=\"https:\/\/ssp.qualtrics.com\/CP\/Graphic.php?IM=IM_3fyu1IKhTaOt28R\" style=\"width: 500px; height: 142px;\" \/><\/div>\n\n<div><br \/>\n<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\"><strong><span style=\"color: windowtext;\">Based on this information and your knowledge about biology, select true or false for each of the following statements.<\/span><\/strong><\/span><\/span><\/div>","QuestionJS":false,"DefaultChoices":false,"QuestionType":"SBS","Selector":"SBSMatrix","Configuration":{"QuestionDescriptionOption":"UseText","ChoiceColumnWidthPixels":671,"RepeatHeaders":"none","ColumnOrder":[1,0]},"QuestionDescription":"ATP is produced when glucose is metabolized in cells.\u00a0 In addition to being a product of metaboli...","Choices":{"1":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">At low cellular ATP concentrations, ATP is more likely to be bound to the active site than the regulatory site.<\/span><\/span>"},"2":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">At high cellular ATP concentrations, the glucose oxidation pathway will speed up.<\/span><\/span>"},"3":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">At high temperatures, ATP will bind to the regulatory site longer.<\/span><\/span>"},"4":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">ATP binding to the regulatory site likely induces a change in the structure of the active site.<\/span><\/span>"},"5":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">The regulatory site and the active site have identical structures because they both bind ATP.<\/span><\/span>"}},"ChoiceOrder":[1,2,3,4,"5"],"Randomization":{"Type":"All","Advanced":null,"EvenPresentation":false,"TotalRandSubset":""},"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[{"ChoiceID":"4","AnswerID":"1","SeriesID":"1","Grades":{"SC1":"1"},"index":0},{"ChoiceID":"3","AnswerID":"1","SeriesID":"2","Grades":{"SC1":"1"},"index":1},{"ChoiceID":"1","AnswerID":"1","SeriesID":"1","Grades":{"SC1":"1"},"index":2},{"ChoiceID":"2","AnswerID":"1","SeriesID":"2","Grades":{"SC1":"1"},"index":3},{"ChoiceID":"5","AnswerID":"1","SeriesID":"2","Grades":{"SC1":"1"},"index":4}],"Language":[],"NumberOfQuestions":1,"AdditionalQuestions":{"1":{"QuestionText":"&nbsp;","Answers":{"1":{"Display":"True"},"2":{"Display":"False"}},"RecodeValues":{"1":"1","2":"2"},"VariableNaming":[],"AnalyzeChoices":[],"QuestionType":"Matrix","Selector":"Likert","SubSelector":"SingleAnswer","ChoiceColumnWidthPixels":null,"Configuration":{"ChoiceColumnWidthPixels":10,"QuestionDescriptionOption":"UseText"},"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[{"AnswerID":"1","ChoiceID":"4","Grades":{"SC1":"1"},"index":0},{"AnswerID":"2","ChoiceID":"3","Grades":{"SC1":"1"},"index":1},{"AnswerID":"1","ChoiceID":"1","Grades":{"SC1":"1"},"index":2},{"AnswerID":"2","ChoiceID":"2","Grades":{"SC1":"1"},"index":3},{"AnswerID":"2","ChoiceID":"5","Grades":{"SC1":"1"},"index":4}],"DataExportTag":"BM-44#1","QuestionID":"QID270#1","Choices":{"1":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">At low cellular ATP concentrations, ATP is more likely to be bound to the active site than the regulatory site.<\/span><\/span>"},"2":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">At high cellular ATP concentrations, the glucose oxidation pathway will speed up.<\/span><\/span>"},"3":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">At high temperatures, ATP will bind to the regulatory site longer.<\/span><\/span>"},"4":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">ATP binding to the regulatory site likely induces a change in the structure of the active site.<\/span><\/span>"},"5":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">The regulatory site and the active site have identical structures because they both bind ATP.<\/span><\/span>"}},"ChoiceDataExportTags":false,"QuestionDescription":" "}},"ChoiceDataExportTags":false,"QuestionText_Unsafe":"<div><span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Bigleaf maple trees have the largest leaves of any of the 128 maple species.&nbsp; Leaf size varies within and among individual bigleaf maple trees.&nbsp;&nbsp;<\/span><\/span><\/div>\n\n<p>&nbsp;<\/p>\n\n<p><span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\"><strong><span style=\"color: windowtext;\">Based on this information and your knowledge about biology, select true or false for each of the following statements.<\/span><\/strong><\/span><\/span><\/p>","RecodeValues":{"1":"1"},"DataExportTag":"BM-44","QuestionID":"QID270"}},{"SurveyID":"SV_dnk8xGmFyNl56Dk","Element":"SQ","PrimaryAttribute":"QID271","SecondaryAttribute":"Timing","TertiaryAttribute":null,"Payload":{"QuestionText":"Timing","DefaultChoices":false,"QuestionType":"Timing","Selector":"PageTimer","Configuration":{"QuestionDescriptionOption":"UseText","MinSeconds":"0","MaxSeconds":"0"},"QuestionDescription":"Timing","Choices":{"1":{"Display":"First Click"},"2":{"Display":"Last Click"},"3":{"Display":"Page Submit"},"4":{"Display":"Click Count"}},"ChoiceOrder":["1","2","3"],"GradingData":[],"Language":[],"QuestionText_Unsafe":"Timing","DataExportTag":"T-BM-44","QuestionID":"QID271"}},{"SurveyID":"SV_dnk8xGmFyNl56Dk","Element":"SQ","PrimaryAttribute":"QID272","SecondaryAttribute":"The drawing below shows the shoot and root systems for different species of grassland plants. Bas...","TertiaryAttribute":null,"Payload":{"QuestionText":"<div><span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">The drawing below shows the shoot and root systems for different species of grassland plants.<\/span><\/span><\/div>\n\n<div style=\"text-align: center;\"><br \/>\n<img src=\"https:\/\/ssp.qualtrics.com\/CP\/Graphic.php?IM=IM_6y8FBdB5hk5bZOt\" style=\"width: 200px; height: 315px;\" \/><\/div>\n\n<div><br \/>\n<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\"><strong><span style=\"color: windowtext;\">Based on this information and your knowledge about biology, select true or false for each of the following statements.<\/span><\/strong><\/span><\/span><\/div>","QuestionJS":false,"DefaultChoices":false,"QuestionType":"SBS","Selector":"SBSMatrix","Configuration":{"QuestionDescriptionOption":"UseText","ChoiceColumnWidthPixels":671,"RepeatHeaders":"none","ColumnOrder":[1,0]},"QuestionDescription":"The drawing below shows the shoot and root systems for different species of grassland plants. Bas...","Choices":{"1":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">To transport water from the soil to leaves, species with deep roots must expend more energy than species with shallow roots.&nbsp;<\/span><\/span>"},"2":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Sugars found in the roots of these plants have been primarily transported from the leaves.<\/span><\/span>"},"3":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">If two root systems have the same total surface area, less sugar can be stored in a system of many thin roots versus a few thick roots.<\/span><\/span>"},"4":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">The shallow root system found in Species A is advantageous in soils that have low oxygen levels.&nbsp;<\/span><\/span>"},"5":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Species with deep root systems like those found in Species C will likely outcompete species with shorter root systems in habitats with frequent, light rains that do not penetrate the soil deeply.<\/span><\/span>"}},"ChoiceOrder":[1,2,3,4,"5"],"Randomization":{"Type":"All","Advanced":null,"EvenPresentation":false,"TotalRandSubset":""},"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[{"ChoiceID":"4","AnswerID":"1","SeriesID":"1","Grades":{"SC1":"1"},"index":0},{"ChoiceID":"1","AnswerID":"1","SeriesID":"2","Grades":{"SC1":"1"},"index":1},{"ChoiceID":"2","AnswerID":"1","SeriesID":"1","Grades":{"SC1":"1"},"index":2},{"ChoiceID":"3","AnswerID":"1","SeriesID":"1","Grades":{"SC1":"1"},"index":3},{"ChoiceID":"5","AnswerID":"1","SeriesID":"2","Grades":{"SC1":"1"},"index":4}],"Language":[],"NumberOfQuestions":1,"AdditionalQuestions":{"1":{"QuestionText":"&nbsp;","Answers":{"1":{"Display":"True"},"2":{"Display":"False"}},"RecodeValues":{"1":"1","2":"2"},"VariableNaming":[],"AnalyzeChoices":[],"QuestionType":"Matrix","Selector":"Likert","SubSelector":"SingleAnswer","ChoiceColumnWidthPixels":null,"Configuration":{"ChoiceColumnWidthPixels":10,"QuestionDescriptionOption":"UseText"},"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[{"AnswerID":"1","ChoiceID":"4","Grades":{"SC1":"1"},"index":0},{"AnswerID":"2","ChoiceID":"1","Grades":{"SC1":"1"},"index":1},{"AnswerID":"1","ChoiceID":"2","Grades":{"SC1":"1"},"index":2},{"AnswerID":"1","ChoiceID":"3","Grades":{"SC1":"1"},"index":3},{"AnswerID":"2","ChoiceID":"5","Grades":{"SC1":"1"},"index":4}],"DataExportTag":"BM-45#1","QuestionID":"QID272#1","Choices":{"1":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">To transport water from the soil to leaves, species with deep roots must expend more energy than species with shallow roots.&nbsp;<\/span><\/span>"},"2":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Sugars found in the roots of these plants have been primarily transported from the leaves.<\/span><\/span>"},"3":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">If two root systems have the same total surface area, less sugar can be stored in a system of many thin roots versus a few thick roots.<\/span><\/span>"},"4":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">The shallow root system found in Species A is advantageous in soils that have low oxygen levels.&nbsp;<\/span><\/span>"},"5":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Species with deep root systems like those found in Species C will likely outcompete species with shorter root systems in habitats with frequent, light rains that do not penetrate the soil deeply.<\/span><\/span>"}},"ChoiceDataExportTags":false,"QuestionDescription":" "}},"ChoiceDataExportTags":false,"QuestionText_Unsafe":"<div><span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">ATP is produced when glucose is metabolized in cells.&nbsp; In addition to being a product of metabolism, ATP serves as both a substrate and as a regulator for one of the enzymes involved in glucose metabolism.&nbsp; This enzyme has two sites where ATP binds: an active site where the reaction required for glucose metabolism occurs and a regulatory site.&nbsp; ATP binding to the regulatory site blocks the enzyme\u2019s activity.<\/span><\/span><br><br><\/div>\n\n<div style=\"text-align: center;\"><span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">INSERT IMAGE HERE<\/span><\/span><\/div>\n\n<p>&nbsp;<\/p>\n\n<p><span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\"><strong><span style=\"color: windowtext;\">Based on this information and your knowledge about biology, select true or false for each of the following statements.<\/span><\/strong><\/span><\/span><\/p>","RecodeValues":{"1":"1"},"DataExportTag":"BM-45","QuestionID":"QID272"}},{"SurveyID":"SV_dnk8xGmFyNl56Dk","Element":"SQ","PrimaryAttribute":"QID273","SecondaryAttribute":"Timing","TertiaryAttribute":null,"Payload":{"QuestionText":"Timing","DefaultChoices":false,"QuestionType":"Timing","Selector":"PageTimer","Configuration":{"QuestionDescriptionOption":"UseText","MinSeconds":"0","MaxSeconds":"0"},"QuestionDescription":"Timing","Choices":{"1":{"Display":"First Click"},"2":{"Display":"Last Click"},"3":{"Display":"Page Submit"},"4":{"Display":"Click Count"}},"ChoiceOrder":["1","2","3"],"GradingData":[],"Language":[],"QuestionText_Unsafe":"Timing","DataExportTag":"T-BM-45","QuestionID":"QID273"}},{"SurveyID":"SV_dnk8xGmFyNl56Dk","Element":"SQ","PrimaryAttribute":"QID274","SecondaryAttribute":"Many marine bacteria have a protein called proteorhodopsin in their plasma membranes.\u00a0 Absorption..","TertiaryAttribute":null,"Payload":{"QuestionText":"<div><span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Many marine bacteria have a protein called proteorhodopsin in their plasma membranes.&nbsp; Absorption of light causes proteorhodopsin to change shape and move protons from inside the cell to outside the cell.&nbsp;&nbsp;<\/span><\/span><\/div>\n\n<p>&nbsp;<\/p>\n\n<p><span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\"><strong><span style=\"color: windowtext;\">Based on this information and your knowledge about biology, select true or false for each of the following statements.<\/span><\/strong><\/span><\/span><\/p>","QuestionJS":false,"DefaultChoices":false,"QuestionType":"SBS","Selector":"SBSMatrix","Configuration":{"QuestionDescriptionOption":"UseText","ChoiceColumnWidthPixels":671,"RepeatHeaders":"none","ColumnOrder":[1,0]},"QuestionDescription":"Many marine bacteria have a protein called proteorhodopsin in their plasma membranes.\u00a0 Absorption...","Choices":{"1":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">These marine bacteria do not require ATP.<\/span><\/span>"},"2":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Proteorhodopsin transforms light energy into electrochemical energy in the form of a proton gradient.<\/span><\/span>"},"3":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Over time, proteorhodopsin has likely evolved to be 100% efficient under optimal conditions of light, temperature, and pH.<\/span><\/span>"},"4":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">These marine bacteria would likely grow faster in the presence of a molecule that increases the permeability of their plasma membranes to protons.<\/span><\/span>"}},"ChoiceOrder":[1,2,3,4],"Randomization":{"Type":"All","Advanced":null,"EvenPresentation":false,"TotalRandSubset":""},"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[{"ChoiceID":"1","AnswerID":"1","SeriesID":"2","Grades":{"SC1":"1"},"index":0},{"ChoiceID":"2","AnswerID":"1","SeriesID":"1","Grades":{"SC1":"1"},"index":1},{"ChoiceID":"3","AnswerID":"1","SeriesID":"2","Grades":{"SC1":"1"},"index":2},{"ChoiceID":"4","AnswerID":"1","SeriesID":"2","Grades":{"SC1":"1"},"index":3}],"Language":[],"NumberOfQuestions":1,"AdditionalQuestions":{"1":{"QuestionText":"&nbsp;","Answers":{"1":{"Display":"True"},"2":{"Display":"False"}},"RecodeValues":{"1":"1","2":"2"},"VariableNaming":[],"AnalyzeChoices":[],"QuestionType":"Matrix","Selector":"Likert","SubSelector":"SingleAnswer","ChoiceColumnWidthPixels":null,"Configuration":{"ChoiceColumnWidthPixels":10,"QuestionDescriptionOption":"UseText"},"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[{"AnswerID":"2","ChoiceID":"1","Grades":{"SC1":"1"},"index":0},{"AnswerID":"1","ChoiceID":"2","Grades":{"SC1":"1"},"index":1},{"AnswerID":"2","ChoiceID":"3","Grades":{"SC1":"1"},"index":2},{"AnswerID":"2","ChoiceID":"4","Grades":{"SC1":"1"},"index":3}],"DataExportTag":"BM-49#1","QuestionID":"QID274#1","Choices":{"1":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">These marine bacteria do not require ATP.<\/span><\/span>"},"2":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Proteorhodopsin transforms light energy into electrochemical energy in the form of a proton gradient.<\/span><\/span>"},"3":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Over time, proteorhodopsin has likely evolved to be 100% efficient under optimal conditions of light, temperature, and pH.<\/span><\/span>"},"4":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">These marine bacteria would likely grow faster in the presence of a molecule that increases the permeability of their plasma membranes to protons.<\/span><\/span>"}},"ChoiceDataExportTags":false,"QuestionDescription":" "}},"ChoiceDataExportTags":false,"QuestionText_Unsafe":"<div><span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">The drawing below shows the shoot and root systems for different species of grassland plants.&nbsp;<\/span><\/span><br \/>\n<br \/>\n&nbsp;<\/div>\n\n<div style=\"text-align: center;\"><span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">INSERT IMAGE HERE<\/span><\/span><\/div>\n\n<p>&nbsp;<\/p>\n\n<p><span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\"><strong><span style=\"color: windowtext;\">Based on this information and your knowledge about biology, select true or false for each of the following statements.<\/span><\/strong><\/span><\/span><\/p>","RecodeValues":{"1":"1"},"DataExportTag":"BM-49","QuestionID":"QID274"}},{"SurveyID":"SV_dnk8xGmFyNl56Dk","Element":"SQ","PrimaryAttribute":"QID275","SecondaryAttribute":"Timing","TertiaryAttribute":null,"Payload":{"QuestionText":"Timing","DefaultChoices":false,"QuestionType":"Timing","Selector":"PageTimer","Configuration":{"QuestionDescriptionOption":"UseText","MinSeconds":"0","MaxSeconds":"0"},"QuestionDescription":"Timing","Choices":{"1":{"Display":"First Click"},"2":{"Display":"Last Click"},"3":{"Display":"Page Submit"},"4":{"Display":"Click Count"}},"ChoiceOrder":["1","2","3"],"GradingData":[],"Language":[],"QuestionText_Unsafe":"Timing","DataExportTag":"T-BM-49","QuestionID":"QID275"}},{"SurveyID":"SV_dnk8xGmFyNl56Dk","Element":"SQ","PrimaryAttribute":"QID276","SecondaryAttribute":"The figure below shows a cross-sectional view of a lake. \u00a0The arrows in the diagram below indicat..","TertiaryAttribute":null,"Payload":{"QuestionText":"<div><span style=\"font-family:times new roman,times,serif;\"><span style=\"font-size:16px;\">The figure below shows a cross-sectional view of a lake. &nbsp;The arrows in the diagram below indicate how phosphorus moves through the lake. &nbsp;Phosphorus is a growth-limiting nutrient for the organisms in this ecosystem, meaning that adding phosphorus results in their increased growth.&nbsp; For the statements below, assume that no organisms enter or leave the lake ecosystem.<\/span><\/span><\/div>\n\n<div style=\"text-align: center;\"><br \/>\n<img src=\"https:\/\/ssp.qualtrics.com\/CP\/Graphic.php?IM=IM_b2RprQjvEjfdfLv\" style=\"width: 500px; height: 263px;\" \/><\/div>\n\n<div><br \/>\n<span style=\"font-family:times new roman,times,serif;\"><span style=\"font-size:16px;\"><strong><span style=\"color: windowtext;\">Based on this information and your knowledge about biology, select true or false for each of the following statements.<\/span><\/strong><\/span><\/span><\/div>","QuestionJS":false,"DefaultChoices":false,"QuestionType":"SBS","Selector":"SBSMatrix","Configuration":{"QuestionDescriptionOption":"UseText","ChoiceColumnWidthPixels":671,"RepeatHeaders":"none","ColumnOrder":[1,0]},"QuestionDescription":"The figure below shows a cross-sectional view of a lake. \u00a0The arrows in the diagram below indicat...","Choices":{"1":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Phosphorus in the lake water could be incorporated into the newly synthesized DNA of a plant in the lake.<\/span><\/span>"},"2":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">All of the phosphorus in the lake will likely eventually be permanently deposited in the sediments.<\/span><\/span>"},"3":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Continually adding excess amounts of phosphorus to the lake will eventually lead to a decrease in average oxygen levels in the lake.<\/span><\/span>"},"4":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">An increase in the release of phosphorus from sediments back into solution could result in a short-term increase in the population size of predators.<\/span><\/span>"},"5":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">A phosphorus atom found in a predator could not become part of a plant in the lake.<\/span><\/span>"}},"ChoiceOrder":[1,2,3,4,"5"],"Randomization":{"Type":"All","Advanced":null,"EvenPresentation":false,"TotalRandSubset":""},"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[{"ChoiceID":"4","AnswerID":"1","SeriesID":"1","Grades":{"SC1":"1"},"index":0},{"ChoiceID":"1","AnswerID":"1","SeriesID":"1","Grades":{"SC1":"1"},"index":1},{"ChoiceID":"2","AnswerID":"1","SeriesID":"2","Grades":{"SC1":"1"},"index":2},{"ChoiceID":"3","AnswerID":"1","SeriesID":"1","Grades":{"SC1":"1"},"index":3},{"ChoiceID":"5","AnswerID":"1","SeriesID":"2","Grades":{"SC1":"1"},"index":4}],"Language":[],"NumberOfQuestions":1,"AdditionalQuestions":{"1":{"QuestionText":"&nbsp;","Answers":{"1":{"Display":"True"},"2":{"Display":"False"}},"RecodeValues":{"1":"1","2":"2"},"VariableNaming":[],"AnalyzeChoices":[],"QuestionType":"Matrix","Selector":"Likert","SubSelector":"SingleAnswer","ChoiceColumnWidthPixels":null,"Configuration":{"ChoiceColumnWidthPixels":10,"QuestionDescriptionOption":"UseText"},"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[{"AnswerID":"1","ChoiceID":"4","Grades":{"SC1":"1"},"index":0},{"AnswerID":"1","ChoiceID":"1","Grades":{"SC1":"1"},"index":1},{"AnswerID":"2","ChoiceID":"2","Grades":{"SC1":"1"},"index":2},{"AnswerID":"1","ChoiceID":"3","Grades":{"SC1":"1"},"index":3},{"AnswerID":"2","ChoiceID":"5","Grades":{"SC1":"1"},"index":4}],"DataExportTag":"BM-50#1","QuestionID":"QID276#1","Choices":{"1":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Phosphorus in the lake water could be incorporated into the newly synthesized DNA of a plant in the lake.<\/span><\/span>"},"2":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">All of the phosphorus in the lake will likely eventually be permanently deposited in the sediments.<\/span><\/span>"},"3":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Continually adding excess amounts of phosphorus to the lake will eventually lead to a decrease in average oxygen levels in the lake.<\/span><\/span>"},"4":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">An increase in the release of phosphorus from sediments back into solution could result in a short-term increase in the population size of predators.<\/span><\/span>"},"5":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">A phosphorus atom found in a predator could not become part of a plant in the lake.<\/span><\/span>"}},"ChoiceDataExportTags":false,"QuestionDescription":" "}},"ChoiceDataExportTags":false,"QuestionText_Unsafe":"<div><span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Many marine bacteria have a protein called proteorhodopsin in their plasma membranes.&nbsp; Absorption of light causes proteorhodopsin to change shape and move protons from inside the cell to outside the cell.&nbsp;&nbsp;<\/span><\/span><\/div>\n\n<p>&nbsp;<\/p>\n\n<p><span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\"><strong><span style=\"color: windowtext;\">Based on this information and your knowledge about biology, select true or false for each of the following statements.<\/span><\/strong><\/span><\/span><\/p>","RecodeValues":{"1":"1"},"DataExportTag":"BM-50","QuestionID":"QID276"}},{"SurveyID":"SV_dnk8xGmFyNl56Dk","Element":"SQ","PrimaryAttribute":"QID277","SecondaryAttribute":"Timing","TertiaryAttribute":null,"Payload":{"QuestionText":"Timing","DefaultChoices":false,"QuestionType":"Timing","Selector":"PageTimer","Configuration":{"QuestionDescriptionOption":"UseText","MinSeconds":"0","MaxSeconds":"0"},"QuestionDescription":"Timing","Choices":{"1":{"Display":"First Click"},"2":{"Display":"Last Click"},"3":{"Display":"Page Submit"},"4":{"Display":"Click Count"}},"ChoiceOrder":["1","2","3"],"GradingData":[],"Language":[],"QuestionText_Unsafe":"Timing","DataExportTag":"T-BM-50","QuestionID":"QID277"}},{"SurveyID":"SV_dnk8xGmFyNl56Dk","Element":"SQ","PrimaryAttribute":"QID278","SecondaryAttribute":"Air and water are exchanged through openings in plant leaves called stomatal pores.\u00a0 Guard cells...","TertiaryAttribute":null,"Payload":{"QuestionText":"<div><span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Air and water are exchanged through openings in plant leaves called stomatal pores.&nbsp; Guard cells that surround the stomatal pores regulate the size of the opening in response to the hormone ABA.&nbsp; In response to low humidity, ABA levels increase in guard cells causing the stomatal pores to close.&nbsp; The diagram below shows the first steps in the ABA signal transduction pathway leading to stomatal closure.&nbsp; ABA binding to its receptor results in an increase in Ca<sup>2+<\/sup>, which in turn opens Cl<sup>-<\/sup> channels that allow the movement of Cl<sup>-<\/sup> out of the cell.<\/span><\/span><\/div>\n\n<div style=\"text-align: center;\"><br \/>\n<img src=\"https:\/\/ssp.qualtrics.com\/CP\/Graphic.php?IM=IM_9B1OCp6jhzyrRc1\" style=\"width: 400px; height: 168px;\" \/><\/div>\n<br \/>\n<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\"><strong><span style=\"color: windowtext;\">Based on this information and your knowledge about biology, select true or false for each of the following statements.<\/span><\/strong><\/span><\/span>","QuestionJS":false,"DefaultChoices":false,"QuestionType":"SBS","Selector":"SBSMatrix","Configuration":{"QuestionDescriptionOption":"UseText","ChoiceColumnWidthPixels":671,"RepeatHeaders":"none","ColumnOrder":[1,0]},"QuestionDescription":"Air and water are exchanged through openings in plant leaves called stomatal pores.\u00a0 Guard cells...","Choices":{"1":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">All else being equal, plants with larger stomatal pores are more adapted to low humidity environments than plants with smaller stomatal pores.<\/span><\/span>"},"2":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">An increase in free cytosolic Ca<sup>2+<\/sup> in guard cells in the absence of ABA would likely cause stomatal pores to close.<\/span><\/span>"},"3":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">A decrease in Cl<sup>-<\/sup> concentration in guard cells would be expected to lead to an increase in water movement across the guard cell membrane and into the guard cells.<\/span><\/span>"},"4":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Movement of Cl<sup>-<\/sup> ions out of the guard cell will initially make the membrane potential more positive.<\/span><\/span>"}},"ChoiceOrder":[1,2,3,4],"Randomization":{"Type":"All","Advanced":null,"EvenPresentation":false,"TotalRandSubset":""},"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[{"ChoiceID":"4","AnswerID":"1","SeriesID":"1","Grades":{"SC1":"1"},"index":0},{"ChoiceID":"1","AnswerID":"1","SeriesID":"2","Grades":{"SC1":"1"},"index":1},{"ChoiceID":"2","AnswerID":"1","SeriesID":"1","Grades":{"SC1":"1"},"index":2},{"ChoiceID":"3","AnswerID":"1","SeriesID":"2","Grades":{"SC1":"1"},"index":3}],"Language":[],"NumberOfQuestions":1,"AdditionalQuestions":{"1":{"QuestionText":"&nbsp;","Answers":{"1":{"Display":"True"},"2":{"Display":"False"}},"RecodeValues":{"1":"1","2":"2"},"VariableNaming":[],"AnalyzeChoices":[],"QuestionType":"Matrix","Selector":"Likert","SubSelector":"SingleAnswer","ChoiceColumnWidthPixels":null,"Configuration":{"ChoiceColumnWidthPixels":10,"QuestionDescriptionOption":"UseText"},"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[{"AnswerID":"1","ChoiceID":"4","Grades":{"SC1":"1"},"index":0},{"AnswerID":"2","ChoiceID":"1","Grades":{"SC1":"1"},"index":1},{"AnswerID":"1","ChoiceID":"2","Grades":{"SC1":"1"},"index":2},{"AnswerID":"2","ChoiceID":"3","Grades":{"SC1":"1"},"index":3}],"DataExportTag":"BM-54#1","QuestionID":"QID278#1","Choices":{"1":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">All else being equal, plants with larger stomatal pores are more adapted to low humidity environments than plants with smaller stomatal pores.<\/span><\/span>"},"2":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">An increase in free cytosolic Ca<sup>2+<\/sup> in guard cells in the absence of ABA would likely cause stomatal pores to close.<\/span><\/span>"},"3":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">A decrease in Cl<sup>-<\/sup> concentration in guard cells would be expected to lead to an increase in water movement across the guard cell membrane and into the guard cells.<\/span><\/span>"},"4":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Movement of Cl<sup>-<\/sup> ions out of the guard cell will initially make the membrane potential more positive.<\/span><\/span>"}},"ChoiceDataExportTags":false,"QuestionDescription":" "}},"ChoiceDataExportTags":false,"QuestionText_Unsafe":"<div><span style=\"font-family:times new roman,times,serif;\"><span style=\"font-size:16px;\">The figure below shows a cross-sectional view of a lake. &nbsp;The arrows in the diagram below indicate how phosphorus moves through the lake. &nbsp;Phosphorus is a growth-limiting nutrient for the organisms in this ecosystem, meaning that adding phosphorus results in their increased growth.&nbsp; For the statements below, assume that no organisms enter or leave the lake ecosystem.<\/span><\/span><br \/>\n<br \/>\n&nbsp;<\/div>\n\n<div style=\"text-align: center;\"><span style=\"font-family:times new roman,times,serif;\"><span style=\"font-size:16px;\">INSERT IMAGE HERE<\/span><\/span><\/div>\n\n<p>&nbsp;<\/p>\n\n<p><span style=\"font-family:times new roman,times,serif;\"><span style=\"font-size:16px;\"><strong><span style=\"color: windowtext;\">Based on this information and your knowledge about biology, select true or false for each of the following statements.<\/span><\/strong><\/span><\/span><\/p>","RecodeValues":{"1":"1"},"DataExportTag":"BM-54","QuestionID":"QID278"}},{"SurveyID":"SV_dnk8xGmFyNl56Dk","Element":"SQ","PrimaryAttribute":"QID279","SecondaryAttribute":"Timing","TertiaryAttribute":null,"Payload":{"QuestionText":"Timing","DefaultChoices":false,"QuestionType":"Timing","Selector":"PageTimer","Configuration":{"QuestionDescriptionOption":"UseText","MinSeconds":"0","MaxSeconds":"0"},"QuestionDescription":"Timing","Choices":{"1":{"Display":"First Click"},"2":{"Display":"Last Click"},"3":{"Display":"Page Submit"},"4":{"Display":"Click Count"}},"ChoiceOrder":["1","2","3"],"GradingData":[],"Language":[],"QuestionText_Unsafe":"Timing","DataExportTag":"T-BM-54","QuestionID":"QID279"}},{"SurveyID":"SV_dnk8xGmFyNl56Dk","Element":"SQ","PrimaryAttribute":"QID280","SecondaryAttribute":"Corn plants have several different responses after being damaged by moth larvae.\u00a0 Damaged cells i..","TertiaryAttribute":null,"Payload":{"QuestionText":"<div><span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Corn plants have several different responses after being damaged by moth larvae.&nbsp; Damaged cells in the corn plant produce a hormone called Hormone X.&nbsp; Hormone X diffuses to other tissues in the plant and triggers the production of compounds called protease inhibitors that help the plant defend against moths.&nbsp; Damaged corn plants also release Hormone X into the air.&nbsp; Hormone X is sensed by other corn plants that respond by producing protease inhibitors.&nbsp; Corn plants also release Chemical Y into the air in response to damage by moth larvae.&nbsp; Chemical Y is only produced by corn plants.&nbsp; Female wasps respond to Chemical Y by laying eggs in the moth larvae, eventually killing them.&nbsp; The wasps only parasitize moth larvae, and this species of moth larvae only eats corn plants.<\/span><\/span><\/div>\n\n<div style=\"text-align: center;\"><br>\n<img src=\"https:\/\/ssp.qualtrics.com\/CP\/Graphic.php?IM=IM_0qdqzIRju7qV0a1\" style=\"width: 300px; height: 274px;\"><\/div>\n<br>\n<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\"><strong><span style=\"color: windowtext;\">Based on this information and your knowledge about biology, select true or false for each of the following statements.<\/span><\/strong><\/span><\/span>","QuestionJS":false,"DefaultChoices":false,"QuestionType":"SBS","Selector":"SBSMatrix","Configuration":{"QuestionDescriptionOption":"UseText","ChoiceColumnWidthPixels":671,"RepeatHeaders":"none","ColumnOrder":[1,0]},"QuestionDescription":"Corn plants have several different responses after being damaged by moth larvae.\u00a0 Damaged cells i...","Choices":{"1":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">A corn plant growing near a corn plant that has been damaged by moths is likely to be more resistant to moth attacks than a corn plant growing far from any damaged plant.<\/span><\/span>"},"2":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Eliminating corn plants from this system would likely cause a reduction in the wasp population.<\/span><\/span>"},"3":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Corn plants that produce protease inhibitors all the time are likely to have increased fitness compared to corn plants that produce protease inhibitors only in response to moth attacks.<\/span><\/span>"},"4":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">If a subpopulation of these wasps evolved to prey on a different moth species found on other plants, these wasps could lose the ability to recognize Chemical Y after many generations.<\/span><\/span>"},"5":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Female wasps likely express a receptor that binds to Chemical Y.<\/span><\/span>"}},"ChoiceOrder":[1,2,3,4,"5"],"Randomization":{"Type":"All","Advanced":null,"EvenPresentation":false,"TotalRandSubset":""},"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[{"ChoiceID":"4","AnswerID":"1","SeriesID":"1","Grades":{"SC1":"1"},"index":0},{"ChoiceID":"2","AnswerID":"1","SeriesID":"1","Grades":{"SC1":"1"},"index":1},{"ChoiceID":"3","AnswerID":"1","SeriesID":"2","Grades":{"SC1":"1"},"index":2},{"ChoiceID":"1","AnswerID":"1","SeriesID":"1","Grades":{"SC1":"1"},"index":3},{"ChoiceID":"5","AnswerID":"1","SeriesID":"1","Grades":{"SC1":"1"},"index":4}],"Language":[],"NumberOfQuestions":1,"AdditionalQuestions":{"1":{"QuestionText":"&nbsp;","Answers":{"1":{"Display":"True"},"2":{"Display":"False"}},"RecodeValues":{"1":"1","2":"2"},"VariableNaming":[],"AnalyzeChoices":[],"QuestionType":"Matrix","Selector":"Likert","SubSelector":"SingleAnswer","ChoiceColumnWidthPixels":null,"Configuration":{"ChoiceColumnWidthPixels":10,"QuestionDescriptionOption":"UseText"},"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[{"AnswerID":"1","ChoiceID":"4","Grades":{"SC1":"1"},"index":0},{"AnswerID":"1","ChoiceID":"2","Grades":{"SC1":"1"},"index":1},{"AnswerID":"2","ChoiceID":"3","Grades":{"SC1":"1"},"index":2},{"AnswerID":"1","ChoiceID":"1","Grades":{"SC1":"1"},"index":3},{"AnswerID":"1","ChoiceID":"5","Grades":{"SC1":"1"},"index":4}],"DataExportTag":"BM-55#1","QuestionID":"QID280#1","Choices":{"1":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">A corn plant growing near a corn plant that has been damaged by moths is likely to be more resistant to moth attacks than a corn plant growing far from any damaged plant.<\/span><\/span>"},"2":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Eliminating corn plants from this system would likely cause a reduction in the wasp population.<\/span><\/span>"},"3":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Corn plants that produce protease inhibitors all the time are likely to have increased fitness compared to corn plants that produce protease inhibitors only in response to moth attacks.<\/span><\/span>"},"4":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">If a subpopulation of these wasps evolved to prey on a different moth species found on other plants, these wasps could lose the ability to recognize Chemical Y after many generations.<\/span><\/span>"},"5":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Female wasps likely express a receptor that binds to Chemical Y.<\/span><\/span>"}},"ChoiceDataExportTags":false,"QuestionDescription":" "}},"ChoiceDataExportTags":false,"QuestionText_Unsafe":"<div><span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Air and water are exchanged through openings in plant leaves called stomatal pores.&nbsp; Guard cells that surround the stomatal pores regulate the size of the opening in response to the hormone ABA.&nbsp; In response to low humidity, ABA levels increase in guard cells causing the stomatal pores to close.&nbsp; The diagram below shows the first steps in the ABA signal transduction pathway leading to stomatal closure.&nbsp; ABA binding to its receptor results in an increase in Ca<sup>2+<\/sup>, which in turn opens Cl<sup>-<\/sup> channels that allow the movement of Cl<sup>-<\/sup> out of the cell.&nbsp;<\/span><\/span><br \/>\n<br \/>\n&nbsp;<\/div>\n\n<div style=\"text-align: center;\"><span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">INSERT IMAGE HERE<\/span><\/span><\/div>\n\n<p>&nbsp;<\/p>\n\n<p><span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\"><strong><span style=\"color: windowtext;\">Based on this information and your knowledge about biology, select true or false for each of the following statements.<\/span><\/strong><\/span><\/span><\/p>","RecodeValues":{"1":"1"},"DataExportTag":"BM-55","QuestionID":"QID280"}},{"SurveyID":"SV_dnk8xGmFyNl56Dk","Element":"SQ","PrimaryAttribute":"QID281","SecondaryAttribute":"Timing","TertiaryAttribute":null,"Payload":{"QuestionText":"Timing","DefaultChoices":false,"QuestionType":"Timing","Selector":"PageTimer","Configuration":{"QuestionDescriptionOption":"UseText","MinSeconds":"0","MaxSeconds":"0"},"QuestionDescription":"Timing","Choices":{"1":{"Display":"First Click"},"2":{"Display":"Last Click"},"3":{"Display":"Page Submit"},"4":{"Display":"Click Count"}},"ChoiceOrder":["1","2","3"],"GradingData":[],"Language":[],"QuestionText_Unsafe":"Timing","DataExportTag":"T-BM-55","QuestionID":"QID281"}},{"SurveyID":"SV_dnk8xGmFyNl56Dk","Element":"SQ","PrimaryAttribute":"QID282","SecondaryAttribute":"There are two species of mountain lizards: S. graciosus and S. occidentalis.\u00a0 The table shows the..","TertiaryAttribute":null,"Payload":{"QuestionText":"<div><span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">There are two species of mountain lizards: <em>S. graciosus <\/em>and <em>S. occidentalis<\/em>.&nbsp; The table shows the minimum and maximum temperatures tolerated by each lizard species.&nbsp; The figure shows where these two species are found on a mountain.&nbsp; The black lines and numbers indicate the average minimum and maximum air temperatures at different elevations on the mountain in a typical year.&nbsp; For the statements below, assume that (1) both species of lizards rely on the same resources, (2) all of the shared resources are limited and evenly distributed across the mountain, and (3) aside from temperature, the abiotic and biotic environment is similar at all elevations.<\/span><\/span><\/div>\n\n<div style=\"text-align: center;\"><br \/>\n<img src=\"https:\/\/ssp.qualtrics.com\/CP\/Graphic.php?IM=IM_5BWpzAPZoRKRFf7\" style=\"width: 600px; height: 221px;\" \/><\/div>\n\n<div><br \/>\n<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\"><strong><span style=\"color: windowtext;\">Based on this information and your knowledge about biology, select true or false for each of the following statements.<\/span><\/strong><\/span><\/span><\/div>","QuestionJS":false,"DefaultChoices":false,"QuestionType":"SBS","Selector":"SBSMatrix","Configuration":{"QuestionDescriptionOption":"UseText","ChoiceColumnWidthPixels":671,"RepeatHeaders":"none","ColumnOrder":[1,0]},"QuestionDescription":"There are two species of mountain lizards: S. graciosus and S. occidentalis.\u00a0 The table shows the...","Choices":{"1":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Removing <em>S. occidentalis<\/em> from the mountain would likely enable <em>S. gracious<\/em> to rapidly expand its habitat to include lower elevations.&nbsp;<\/span><\/span>"},"2":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Removing <em>S. graciosus <\/em>from the mountain would likely enable <em>S. occidentalis<\/em> to rapidly expand its habitat to include higher elevations.&nbsp;<\/span><\/span>"},"3":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">If an allele arises in the population of <em>S. graciosus<\/em> that increases the maximum temperature individuals can tolerate, the fitness of <em>S. occidentalis<\/em> lizards would likely be unaffected.&nbsp;<\/span><\/span>"},"4":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">If the average minimum and maximum temperatures at all elevations on the mountain increased by 3<sup>0<\/sup>C, but the thermal tolerance of the lizards did not change, the area of the mountain inhabited by <em>S. graciosus<\/em> would likely decrease.&nbsp;<\/span><\/span>"}},"ChoiceOrder":[1,2,3,4],"Randomization":{"Type":"All","Advanced":null,"EvenPresentation":false,"TotalRandSubset":""},"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[{"ChoiceID":"4","AnswerID":"1","SeriesID":"1","Grades":{"SC1":"1"},"index":0},{"ChoiceID":"1","AnswerID":"1","SeriesID":"2","Grades":{"SC1":"1"},"index":1},{"ChoiceID":"2","AnswerID":"1","SeriesID":"1","Grades":{"SC1":"1"},"index":2},{"ChoiceID":"3","AnswerID":"1","SeriesID":"2","Grades":{"SC1":"1"},"index":3}],"Language":[],"NumberOfQuestions":1,"AdditionalQuestions":{"1":{"QuestionText":"&nbsp;","Answers":{"1":{"Display":"True"},"2":{"Display":"False"}},"RecodeValues":{"1":"1","2":"2"},"VariableNaming":[],"AnalyzeChoices":[],"QuestionType":"Matrix","Selector":"Likert","SubSelector":"SingleAnswer","ChoiceColumnWidthPixels":null,"Configuration":{"ChoiceColumnWidthPixels":10,"QuestionDescriptionOption":"UseText"},"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[{"AnswerID":"1","ChoiceID":"4","Grades":{"SC1":"1"},"index":0},{"AnswerID":"2","ChoiceID":"1","Grades":{"SC1":"1"},"index":1},{"AnswerID":"1","ChoiceID":"2","Grades":{"SC1":"1"},"index":2},{"AnswerID":"2","ChoiceID":"3","Grades":{"SC1":"1"},"index":3}],"DataExportTag":"BM-59#1","QuestionID":"QID282#1","Choices":{"1":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Removing <em>S. occidentalis<\/em> from the mountain would likely enable <em>S. gracious<\/em> to rapidly expand its habitat to include lower elevations.&nbsp;<\/span><\/span>"},"2":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Removing <em>S. graciosus <\/em>from the mountain would likely enable <em>S. occidentalis<\/em> to rapidly expand its habitat to include higher elevations.&nbsp;<\/span><\/span>"},"3":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">If an allele arises in the population of <em>S. graciosus<\/em> that increases the maximum temperature individuals can tolerate, the fitness of <em>S. occidentalis<\/em> lizards would likely be unaffected.&nbsp;<\/span><\/span>"},"4":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">If the average minimum and maximum temperatures at all elevations on the mountain increased by 3<sup>0<\/sup>C, but the thermal tolerance of the lizards did not change, the area of the mountain inhabited by <em>S. graciosus<\/em> would likely decrease.&nbsp;<\/span><\/span>"}},"ChoiceDataExportTags":false,"QuestionDescription":" "}},"ChoiceDataExportTags":false,"QuestionText_Unsafe":"<div><span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Corn plants have several different responses after being damaged by moth larvae.&nbsp; Damaged cells in the corn plant produce a hormone called Hormone X.&nbsp; Hormone X diffuses to other tissues in the plant and triggers the production of compounds called protease inhibitors that help the plant defend against moths.&nbsp; Damaged corn plants also release Hormone X into the air.&nbsp; Hormone X is sensed by other corn plants that respond by producing protease inhibitors.&nbsp; Corn plants also release Chemical Y into the air in response to damage by moth larvae.&nbsp; Chemical Y is only produced by corn plants.&nbsp; Female wasps respond to Chemical Y by laying eggs in the moth larvae eventually killing them.&nbsp; The wasps only parasitize moth larvae, and this species of moth larvae only eats corn plants.&nbsp;&nbsp;<\/span><\/span><br \/>\n<br \/>\n&nbsp;<\/div>\n\n<div style=\"text-align: center;\"><span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">INSERT IMAGE HERE<\/span><\/span><\/div>\n\n<p>&nbsp;<\/p>\n\n<p><span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\"><strong><span style=\"color: windowtext;\">Based on this information and your knowledge about biology, select true or false for each of the following statements.<\/span><\/strong><\/span><\/span><\/p>","RecodeValues":{"1":"1"},"DataExportTag":"BM-59","QuestionID":"QID282"}},{"SurveyID":"SV_dnk8xGmFyNl56Dk","Element":"SQ","PrimaryAttribute":"QID283","SecondaryAttribute":"Timing","TertiaryAttribute":null,"Payload":{"QuestionText":"Timing","DefaultChoices":false,"QuestionType":"Timing","Selector":"PageTimer","Configuration":{"QuestionDescriptionOption":"UseText","MinSeconds":"0","MaxSeconds":"0"},"QuestionDescription":"Timing","Choices":{"1":{"Display":"First Click"},"2":{"Display":"Last Click"},"3":{"Display":"Page Submit"},"4":{"Display":"Click Count"}},"ChoiceOrder":["1","2","3"],"GradingData":[],"Language":[],"QuestionText_Unsafe":"Timing","DataExportTag":"T-BM-59","QuestionID":"QID283"}},{"SurveyID":"SV_dnk8xGmFyNl56Dk","Element":"SQ","PrimaryAttribute":"QID284","SecondaryAttribute":"Researchers established four test plots in a grassland area.\u00a0 Each plot was one square meter in s..","TertiaryAttribute":null,"Payload":{"QuestionText":"<div><span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Researchers established four test plots in a grassland area.&nbsp; Each plot was one square meter in size and was planted with 100 seeds of either a single grass species (Plot A) or an increasing number of different grass species (Plots B, C and D).&nbsp; At the end of one growing season, the total plant biomass from each plot was harvested and measured.&nbsp; The results are shown in the table below.&nbsp; Biomass refers to an organism&rsquo;s total mass, excluding water.<\/span><\/span><\/div>\n\n<div style=\"text-align: center;\"><br \/>\n<img src=\"https:\/\/ssp.qualtrics.com\/CP\/Graphic.php?IM=IM_5d2Jj58x74BlNhr\" style=\"width: 400px; height: 122px;\" \/><\/div>\n<br \/>\n<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\"><strong><span style=\"color: windowtext;\">Based on this information and your knowledge about biology, select true or false for each of the following statements.<\/span><\/strong><\/span><\/span>","QuestionJS":false,"DefaultChoices":false,"QuestionType":"SBS","Selector":"SBSMatrix","Configuration":{"QuestionDescriptionOption":"UseText","ChoiceColumnWidthPixels":671,"RepeatHeaders":"none","ColumnOrder":[1,0]},"QuestionDescription":"Researchers established four test plots in a grassland area.\u00a0 Each plot was one square meter in s...","Choices":{"1":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Increased species diversity correlates with decreased productivity.<\/span><\/span>"},"2":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Once one plant is infected by a pathogen, the entire plant community in Plot A is likely to be more susceptible to spreading of that pathogen than the entire plant community in Plot D.<\/span><\/span>"},"3":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">The increase in biomass that occurs as a plant grows in any of these plots comes primarily from carbon dioxide.<\/span><\/span>"},"4":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">The increased biomass observed in Plot D compared to Plot A could be explained by different species using resources differently.<\/span><\/span>"},"5":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">An ecosystem similar to Plot D would likely support a more diverse community of consumers than an ecosystem similar to Plot A.&nbsp;&nbsp;<\/span><\/span>"}},"ChoiceOrder":[1,2,3,4,"5"],"Randomization":{"Type":"All","Advanced":null,"EvenPresentation":false,"TotalRandSubset":""},"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[{"ChoiceID":"4","AnswerID":"1","SeriesID":"1","Grades":{"SC1":"1"},"index":0},{"ChoiceID":"1","AnswerID":"1","SeriesID":"2","Grades":{"SC1":"1"},"index":1},{"ChoiceID":"2","AnswerID":"1","SeriesID":"1","Grades":{"SC1":"1"},"index":2},{"ChoiceID":"3","AnswerID":"1","SeriesID":"1","Grades":{"SC1":"1"},"index":3},{"ChoiceID":"5","AnswerID":"1","SeriesID":"1","Grades":{"SC1":"1"},"index":4}],"Language":[],"NumberOfQuestions":1,"AdditionalQuestions":{"1":{"QuestionText":"&nbsp;","Answers":{"1":{"Display":"True"},"2":{"Display":"False"}},"RecodeValues":{"1":"1","2":"2"},"VariableNaming":[],"AnalyzeChoices":[],"QuestionType":"Matrix","Selector":"Likert","SubSelector":"SingleAnswer","ChoiceColumnWidthPixels":null,"Configuration":{"ChoiceColumnWidthPixels":10,"QuestionDescriptionOption":"UseText"},"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[{"AnswerID":"1","ChoiceID":"4","Grades":{"SC1":"1"},"index":0},{"AnswerID":"2","ChoiceID":"1","Grades":{"SC1":"1"},"index":1},{"AnswerID":"1","ChoiceID":"2","Grades":{"SC1":"1"},"index":2},{"AnswerID":"1","ChoiceID":"3","Grades":{"SC1":"1"},"index":3},{"AnswerID":"1","ChoiceID":"5","Grades":{"SC1":"1"},"index":4}],"DataExportTag":"BM-60#1","QuestionID":"QID284#1","Choices":{"1":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Increased species diversity correlates with decreased productivity.<\/span><\/span>"},"2":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Once one plant is infected by a pathogen, the entire plant community in Plot A is likely to be more susceptible to spreading of that pathogen than the entire plant community in Plot D.<\/span><\/span>"},"3":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">The increase in biomass that occurs as a plant grows in any of these plots comes primarily from carbon dioxide.<\/span><\/span>"},"4":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">The increased biomass observed in Plot D compared to Plot A could be explained by different species using resources differently.<\/span><\/span>"},"5":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">An ecosystem similar to Plot D would likely support a more diverse community of consumers than an ecosystem similar to Plot A.&nbsp;&nbsp;<\/span><\/span>"}},"ChoiceDataExportTags":false,"QuestionDescription":" "}},"ChoiceDataExportTags":false,"QuestionText_Unsafe":"<div><span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">There are two species of mountain lizards: <em>S. graciosus <\/em>and <em>S. occidentalis<\/em>.&nbsp; The table shows the minimum and maximum temperatures tolerated by each lizard species.&nbsp; The figure shows where these two species are found on a mountain.&nbsp; The black lines and numbers indicate the average minimum and maximum air temperatures at different elevations on the mountain in a typical year.&nbsp; For the statements below, assume that (1) both species of lizards rely on the same resources, (2) all of the shared resources are limited and evenly distributed across the mountain, and (3) aside from temperature, the abiotic and biotic environment is similar at all elevations.<\/span><\/span><br>\n&nbsp;<\/div>\n\n<div style=\"text-align: center;\"><span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">INSERT IMAGE HERE<\/span><\/span><\/div><div style=\"text-align: center;\"><span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\"><br><\/span><\/span><\/div>\n\n<p><span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\"><strong><span style=\"color: windowtext;\">Based on this information and your knowledge about biology, select true or false for each of the following statements.<\/span><\/strong><\/span><\/span><\/p>","RecodeValues":{"1":"1"},"DataExportTag":"BM-60","QuestionID":"QID284"}},{"SurveyID":"SV_dnk8xGmFyNl56Dk","Element":"SQ","PrimaryAttribute":"QID285","SecondaryAttribute":"Timing","TertiaryAttribute":null,"Payload":{"QuestionText":"Timing","DefaultChoices":false,"QuestionType":"Timing","Selector":"PageTimer","Configuration":{"QuestionDescriptionOption":"UseText","MinSeconds":"0","MaxSeconds":"0"},"QuestionDescription":"Timing","Choices":{"1":{"Display":"First Click"},"2":{"Display":"Last Click"},"3":{"Display":"Page Submit"},"4":{"Display":"Click Count"}},"ChoiceOrder":["1","2","3"],"GradingData":[],"Language":[],"QuestionText_Unsafe":"Timing","DataExportTag":"T-BM-60","QuestionID":"QID285"}},{"SurveyID":"SV_dnk8xGmFyNl56Dk","Element":"SQ","PrimaryAttribute":"QID286","SecondaryAttribute":"Human Hormone F is a peptide hormone that causes increased heart rate in humans.\u00a0 When human Horm..","TertiaryAttribute":null,"Payload":{"QuestionText":"<div><span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Human Hormone F is a peptide hormone that causes increased heart rate in humans.&nbsp; When human Hormone F is injected into a mouse&rsquo;s bloodstream, no changes are observed in the mouse&rsquo;s heart rate.&nbsp; &nbsp;&nbsp;<\/span><\/span><\/div>\n\n<div style=\"text-align: center;\">&nbsp;<\/div>\n\n<p><span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\"><strong><span style=\"color: windowtext;\">Based on this information and your knowledge about biology, select true or false for each of the following statements.<\/span><\/strong><\/span><\/span><\/p>","QuestionJS":false,"DefaultChoices":false,"QuestionType":"SBS","Selector":"SBSMatrix","Configuration":{"QuestionDescriptionOption":"UseText","ChoiceColumnWidthPixels":671,"RepeatHeaders":"none","ColumnOrder":[1,0]},"QuestionDescription":"Human Hormone F is a peptide hormone that causes increased heart rate in humans.\u00a0 When human Horm...","Choices":{"1":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">The lack of response could be because Hormone F must be injected directly into heart tissue to have an effect on this mouse&rsquo;s heart.<\/span><\/span>"},"2":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">The lack of response could result from this species of mice having genetic differences that prevent their Hormone F receptor from binding human Hormone F.<\/span><\/span>"},"3":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">The lack of response could result from this particular mouse having a genetic mutation that prevents expression of its own Hormone F.<\/span><\/span>"},"4":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">The lack of response could be because the dose of Hormone F injected was too low to observe an effect in this mouse.<\/span><\/span>"}},"ChoiceOrder":[1,2,3,4],"Randomization":{"Type":"All","Advanced":null,"EvenPresentation":false,"TotalRandSubset":""},"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[{"ChoiceID":"4","AnswerID":"1","SeriesID":"1","Grades":{"SC1":"1"},"index":0},{"ChoiceID":"1","AnswerID":"1","SeriesID":"2","Grades":{"SC1":"1"},"index":1},{"ChoiceID":"2","AnswerID":"1","SeriesID":"1","Grades":{"SC1":"1"},"index":2},{"ChoiceID":"3","AnswerID":"1","SeriesID":"2","Grades":{"SC1":"1"},"index":3}],"Language":[],"NumberOfQuestions":1,"AdditionalQuestions":{"1":{"QuestionText":"&nbsp;","Answers":{"1":{"Display":"True"},"2":{"Display":"False"}},"RecodeValues":{"1":"1","2":"2"},"VariableNaming":[],"AnalyzeChoices":[],"QuestionType":"Matrix","Selector":"Likert","SubSelector":"SingleAnswer","ChoiceColumnWidthPixels":null,"Configuration":{"ChoiceColumnWidthPixels":10,"QuestionDescriptionOption":"UseText"},"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[{"AnswerID":"1","ChoiceID":"4","Grades":{"SC1":"1"},"index":0},{"AnswerID":"2","ChoiceID":"1","Grades":{"SC1":"1"},"index":1},{"AnswerID":"1","ChoiceID":"2","Grades":{"SC1":"1"},"index":2},{"AnswerID":"2","ChoiceID":"3","Grades":{"SC1":"1"},"index":3}],"DataExportTag":"BM-61#1","QuestionID":"QID286#1","Choices":{"1":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">The lack of response could be because Hormone F must be injected directly into heart tissue to have an effect on this mouse&rsquo;s heart.<\/span><\/span>"},"2":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">The lack of response could result from this species of mice having genetic differences that prevent their Hormone F receptor from binding human Hormone F.<\/span><\/span>"},"3":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">The lack of response could result from this particular mouse having a genetic mutation that prevents expression of its own Hormone F.<\/span><\/span>"},"4":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">The lack of response could be because the dose of Hormone F injected was too low to observe an effect in this mouse.<\/span><\/span>"}},"ChoiceDataExportTags":false,"QuestionDescription":" "}},"ChoiceDataExportTags":false,"QuestionText_Unsafe":"<div><span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Researchers established four test plots in a grassland area.&nbsp; Each plot was one square meter in size and was planted with 100 seeds of either a single grass species (Plot A) or an increasing number of different grass species (Plots B, C and D).&nbsp; At the end of one growing season, the total plant biomass from each plot was harvested and measured.&nbsp; The results are shown in the table below.&nbsp; Biomass refers to an organism&rsquo;s total mass, excluding water.<\/span><\/span><br \/>\n&nbsp;<\/div>\n\n<div style=\"text-align: center;\"><span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">INSERT TABLE HERE<\/span><\/span><\/div>\n\n<div style=\"text-align: center;\">&nbsp;<\/div>\n\n<p><span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\"><strong><span style=\"color: windowtext;\">Based on this information and your knowledge about biology, select true or false for each of the following statements.<\/span><\/strong><\/span><\/span><\/p>","RecodeValues":{"1":"1"},"DataExportTag":"BM-61","QuestionID":"QID286"}},{"SurveyID":"SV_dnk8xGmFyNl56Dk","Element":"SQ","PrimaryAttribute":"QID287","SecondaryAttribute":"Timing","TertiaryAttribute":null,"Payload":{"Question
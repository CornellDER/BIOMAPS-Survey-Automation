es,serif;\">Black or African American<\/span><\/span>"},"2":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Asian<\/span><\/span>"},"3":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">White<\/span><\/span>"},"5":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Hispanic or Latinx<\/span><\/span>"},"6":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">American Indian or Alaska Native<\/span><\/span>"},"7":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Native Hawaiian or other Pacific Islander<\/span><\/span>"},"8":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Prefer not to disclose<\/span><\/span>"},"9":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Self-describe:<\/span><\/span>","TextEntry":"true","TextEntrySize":"Small"}},"ChoiceOrder":["6","2","1","5","7","3","9","8"],"Validation":{"Settings":{"ForceResponse":"OFF","ForceResponseType":"ON","Type":"None"}},"Language":[],"QuestionID":"QID192","AnalyzeChoices":{"1":"on","2":"on","3":"on","4":"on","5":"on","6":"on","7":"on","8":"on"},"RecodeValues":{"1":"1","2":"2","3":"3","5":"5","6":"6","7":"7","8":"8","9":"9"},"DataVisibility":{"Private":false,"Hidden":false},"NextChoiceId":10,"NextAnswerId":1}},{"SurveyID":"SV_dnk8xGmFyNl56Dk","Element":"SQ","PrimaryAttribute":"QID193","SecondaryAttribute":"Highest level of education completed by at least one of your parents:","TertiaryAttribute":null,"Payload":{"QuestionText":"<p><span style=\"font-family:&quot;Times New Roman&quot;,&quot;serif&quot;\"><span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Highest level of education completed by at least one of your parents:<\/span><\/span><o:p><\/o:p><\/span><\/p>","DataExportTag":"Educ","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Highest level of education completed by at least one of your parents:","Choices":{"1":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Did not complete high school<\/span><\/span>"},"2":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">High school\/GED<\/span><\/span>"},"3":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Some college (but did not complete college)<\/span><\/span>"},"4":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Associate&rsquo;s degree (2-year degree)<\/span><\/span>"},"5":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Bachelor&rsquo;s degree<\/span><\/span>"},"6":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Master&rsquo;s degree<\/span><\/span>"},"7":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Advanced graduate degree (for example, DVM, MD, PhD)<\/span><\/span>"},"8":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Not sure<\/span><\/span>"}},"ChoiceOrder":["1","2","3","4","5","6","7","8"],"Validation":{"Settings":{"ForceResponse":"OFF","ForceResponseType":"ON","Type":"None"}},"Language":[],"QuestionID":"QID193"}},{"SurveyID":"SV_dnk8xGmFyNl56Dk","Element":"SQ","PrimaryAttribute":"QID194","SecondaryAttribute":"Timing","TertiaryAttribute":null,"Payload":{"QuestionText":"Timing","DefaultChoices":false,"DataExportTag":"T-Age","QuestionType":"Timing","Selector":"PageTimer","Configuration":{"QuestionDescriptionOption":"UseText","MinSecon
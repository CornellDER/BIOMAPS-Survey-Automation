ext_Unsafe":"<span style=\"font-size:16px;\">What is your current class standing?<\/span>","DataExportTag":"Class","QuestionID":"QID166"}},{"SurveyID":"SV_dnk8xGmFyNl56Dk","Element":"SQ","PrimaryAttribute":"QID167","SecondaryAttribute":"Timing","TertiaryAttribute":null,"Payload":{"QuestionText":"Timing","DefaultChoices":false,"QuestionType":"Timing","Selector":"PageTimer","Configuration":{"QuestionDescriptionOption":"UseText","MinSeconds":"0","MaxSeconds":"0"},"QuestionDescription":"Timing","Choices":{"1":{"Display":"First Click"},"2":{"Display":"Last Click"},"3":{"Display":"Page Submit"},"4":{"Display":"Click Count"}},"ChoiceOrder":["1","2","3"],"GradingData":[],"Language":[],"QuestionText_Unsafe":"Timing","DataExportTag":"T-Educ","QuestionID":"QID167"}},{"SurveyID":"SV_dnk8xGmFyNl56Dk","Element":"SQ","PrimaryAttribute":"QID170","SecondaryAttribute":"Assessment Format Thank you for completing this biology assessment.\u00a0 Your responses will help us...","TertiaryAttribute":null,"Payload":{"QuestionText":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\"><strong><u>Assessment Format<\/u><\/strong><br>\n<br>\nThank you for completing this biology assessment.&nbsp; Your responses will help us to improve how we teach biology, so it is important that you answer to the best of your ability.&nbsp; <em>Please do not use outside resources to help you complete this assessment.<\/em><\/span><\/span><br>\n<br>\n<span style=\"font-size:16px;\"><span style=\"font-family: times new roman,times,serif;\"><strong>The assessment contains 15 biology questions and will take roughly 20-40 minutes to complete.<\/strong><\/span><\/span><br>\n<br>\n<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Each question consists of a scenario, followed by a series of true\/false statements.&nbsp; Based on the information given and your knowledge about biology, select true or false for each of the true\/false statements.&nbsp; Once you have answered all of the statements, click the \"right arrow\" at the bottom of the page to move on to the next question.&nbsp; Once you have clicked the \u201cright arrow\u201d at the bottom of the page, you cannot go back to that question.<br>\n<br>\n<strong><u>General Instructions for Completing the Assessment<\/u><\/strong><\/span><\/span>\n<div>&nbsp;<\/div>\n\n<div>1. <span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Complete the assessment in a single session. &nbsp;Be sure to select \u201csubmit\u201d before closing your browser in order to receive credit for completing the test.<\/span><\/span><br>\n&nbsp;<\/div>\n\n<div>2. <span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Complete the assessment on either a laptop or a desktop computer.&nbsp; Do not complete the assessment on a phone or tablet, as the questions and or figures may not be visible.<\/span><\/span><\/div>\n\n<div><span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">&nbsp;<\/span><\/span><br>\n<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\"><strong><u>Local Institutional Information<\/u><\/strong><\/span><\/span><br>\n<br>\n<span style=\"font-size:12.0pt;font-family:&quot;Times New Roman&quot;,&quot;serif&quot;\">This assessment is being administered within your class as part of normal course practices, and you will be awarded a small amount of credit for completing the survey, as determined by your course instructor.<\/span><br>\n<span style=\"font-size:12.0pt;font-family:&quot;Times New Roman&quot;,&quot;serif&quot;\"><\/span><\/div>","DefaultChoices":false,"DataExportTag":"Wel1","QuestionType":"DB","Selector":"TB","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Assessment Format Thank you for completing this biology assessment.\u00a0 Your responses will help us...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"QuestionID":"QID170"}},{"SurveyID":"SV_dnk8xGmFyNl56Dk","Element":"SQ","PrimaryAttribute":"QID171","SecondaryAttribute":"Have you read the\ninstructions and information above?","TertiaryAttribute":null,"Payload":{"QuestionText":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Have you read the instructions and information above?<\/span><\/span>","DataExportTag":"Wel2","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Have you read the\ninstructions and information above?","Choices":{"1":{"Display":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\">Yes<\/span><\/span>"}},"ChoiceOrder":["1"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"Language":[],"QuestionID":"QID171","AnalyzeChoices":{"2":"on"}}},{"SurveyID":"SV_dnk8xGmFyNl56Dk","Element":"SQ","PrimaryAttribute":"QID172","SecondaryAttribute":"Timing","TertiaryAttribute":null,"Payload":{"QuestionText":"Timing","DefaultChoices":false,"DataExportTag":"T-Wel","QuestionType":"Timing","Selector":"PageTimer","Configuration":{"QuestionDescriptionOption":"UseText","MinSeconds":"0","MaxSeconds":"0"},"QuestionDescription":"Timing","Choices":{"1":{"Display":"First Click"},"2":{"Display":"Last Click"},"3":{"Display":"Page Submit"},"4":{"Display":"Click Count"}},"GradingData":[],"Language":[],"QuestionID":"QID172"}},{"SurveyID":"SV_dnk8xGmFyNl56Dk","Element":"SQ","PrimaryAttribute":"QID173","SecondaryAttribute":"Please check\none: I agree to have my survey responses released for\nresearch purposes.","TertiaryAttribute":null,"Payload":{"QuestionText":"<span style=\"font-size:16px;\"><span style=\"font-family:times new roman,times,serif;\"><strong>Please check one:<\/strong> I agree to have my survey responses released for research purposes.<\/span><\/span>","Defa
ortTags":"false","CollectGeoLocation":"false","SurveyTitle":"Online Survey Software | Qualtrics Survey Solutions","SurveyMetaDescription":"Qualtrics sophisticated online survey software solutions make creating online surveys easy. Learn more about Research Suite and get a free account today.","PasswordProtection":"No","AnonymizeResponse":"No","Password":"","RefererCheck":"No","RefererURL":"http:\/\/","EOSMessageLibrary":"","EOSRedirectURL":"http:\/\/","EmailThankYou":"false","ThankYouEmailMessageLibrary":null,"ThankYouEmailMessage":null,"ValidateMessage":"false","ValidationMessageLibrary":null,"InactiveSurvey":"DefaultMessage","InactiveMessageLibrary":"","InactiveMessage":"","AvailableLanguages":{"EN":[]},"libraryId":"","nextButtonMid":"","previousButtonMid":"","headerMid":"","footerMid":"","QuestionsPerPage":"","PageTransition":"None","ExternalCSS":null,"HighlightQuestions":"off"}},{"SurveyID":"SV_4ORlgNIr9YWVxxc","Element":"SQ","PrimaryAttribute":"QID109","SecondaryAttribute":"Timing","TertiaryAttribute":null,"Payload":{"QuestionText":"Timing","DefaultChoices":false,"DataExportTag":"SOS_Timing","QuestionType":"Timing","Selector":"PageTimer","Configuration":{"QuestionDescriptionOption":"UseText","MinSeconds":"0","MaxSeconds":"0"},"QuestionDescription":"Timing","Choices":{"1":{"Display":"First Click"},"2":{"Display":"Last Click"},"3":{"Display":"Page Submit"},"4":{"Display":"Click Count"}},"GradingData":[],"Language":[],"QuestionID":"QID109","QuestionText_Unsafe":"Timing"}},{"SurveyID":"SV_4ORlgNIr9YWVxxc","Element":"SQ","PrimaryAttribute":"QID110","SecondaryAttribute":"You are invited to participate in a collaborative research project being led by Prof. Michelle Sm...","TertiaryAttribute":null,"Payload":{"QuestionText":"<p><span style='font-family:\"Calibri\",sans-serif;&#10;mso-ascii-theme-font:minor-latin;mso-hansi-theme-font:minor-latin;mso-bidi-theme-font:&#10;minor-latin;color:#404040;background:white'>You are invited to participate in a\ncollaborative research project being led by Prof. Michelle Smith, a faculty\nmember in the Department of Ecology and Evolutionary Biology at Cornell\nUniversity. The purpose of this research is to gauge student understanding of\nfundamental biology concepts.<\/span><span style='font-family:\"Calibri\",sans-serif;&#10;mso-ascii-theme-font:minor-latin;mso-hansi-theme-font:minor-latin;mso-bidi-theme-font:&#10;minor-latin;color:#404040'><br>\n<\/span><span style='font-size:11.5pt;font-family:\"Helvetica\",sans-serif;&#10;color:#404040;background:white'>&nbsp;<\/span><span style='font-size:11.5pt;&#10;font-family:\"Helvetica\",sans-serif;color:#404040'><br>\n<\/span><strong><span style='font-family:\"Calibri\",sans-serif'>What\nwe will ask you to do: <\/span><\/strong><span style='font-family:\"Calibri\",sans-serif'>This\nsurvey poses a number of questions asking you to reason about fundamental\nbiology concepts. The primary <\/span><span style='font-family:\"Calibri\",sans-serif;&#10;mso-ascii-theme-font:minor-latin;mso-hansi-theme-font:minor-latin;mso-bidi-theme-font:&#10;minor-latin'>purpose of the survey is for your instructor(s) and department to\nevaluate the effectiveness of their biology courses. <span style=\"color:#404040;&#10;background:white\">This consent form asks for your permission to use your\nresponses for additional research purposes.<\/span><\/span><\/p><p><span style='font-family:\"Calibri\",sans-serif;&#10;mso-ascii-theme-font:minor-latin;mso-hansi-theme-font:minor-latin;mso-bidi-theme-font:&#10;minor-latin'><span style=\"color:#404040;&#10;background:white\"><br><\/span><\/span><strong><span style='font-family:\"Calibri\",sans-serif;font-weight:normal'><\/span><\/strong><\/p>\n\n<p><strong><span style='font-family:&#10;\"Calibri\",sans-serif'>Risks and discomforts: <\/span><\/strong><strong><span style='font-family:\"Calibri\",sans-serif;font-weight:normal'>We do not\nanticipate any risks from participating in this research.<\/span><\/strong><\/p><p><strong><span style='font-family:\"Calibri\",sans-serif;font-weight:normal'><br><\/span><\/strong><\/p>\n\n<p><strong><span style='font-family:&#10;\"Calibri\",sans-serif;mso-bidi-font-weight:normal'>Benefits: <\/span><\/strong><span style='font-family:\"Calibri\",sans-serif;mso-fareast-font-family:Calibri'>There\nare no direct benefits other than the opportunity to learn, practice some new\nmaterial, and contribute to future instructional innovations in biology\neducation. <\/span><strong><span style='font-family:\"Calibri\",sans-serif;&#10;font-weight:normal'><\/span><\/strong><\/p>\n\n<p><strong><span style='font-family:&#10;\"Calibri\",sans-serif'>Compensation for participation: <\/span><\/strong><span style='font-family:\"Calibri\",sans-serif'>You will either receive course credit\nor no compensation for your participation. If your instructor has assigned\ncourse credit for completing this survey, <span style=\"color:black\">you must\nprovide your name and student ID information <strong>at the end of the survey<\/strong> to receive this credit.<\/span><\/span><\/p><p><span style='font-family:\"Calibri\",sans-serif'><span style=\"color:black\"><br><\/span><strong><span style='font-family:\"Calibri\",sans-serif;font-weight:normal'><\/span><\/strong><\/span><\/p>\n\n<p><strong><span style='font-family:&#10;\"Calibri\",sans-serif'>Privacy\/Confidentiality\/Data Security: <\/span><\/strong><span style='font-family:\"Calibri\",sans-serif'>Your identifying information will be\nkept with your survey data for the purposes of matching survey responses. Your\ninstructor will have access to your responses at the end of semester\/quarter.\nYour identity will never be associated with your responses publicly.&nbsp;<\/span><\/p><p><span style='font-family:\"Calibri\",sans-serif'><br><strong><span style='font-family:\"Calibri\",sans-serif;font-weight:normal'><\/span><\/strong><\/span><\/p>\n\n<p><strong><span style='font-family:\"Calibri\",sans-serif'>Taking\npart is voluntary: <\/span><\/strong><strong><span style='font-family:\"Calibri\",sans-serif;&#10;font-weight:normal;mso-bidi-font-weight:bold'>You may choose whether to consent\nto having your survey data used for research purposes. <\/span><\/strong><span style='font-family:\"Calibri\",sans-serif;color:black'>Participation credit (if\nyour instructor has assigned such credit) does not depend on any specific\nanswers you provide in the survey or on whether you consent to have your\nanswers used in research. You may complete this survey for your instructor\nwithout consenting to participate in the research. You must complete this\nsurvey for your instructor to obtain participation credit in your course (if\napplicable).<\/span><\/p>\n\n<p><span style='font-family:\"Calibri\",sans-serif;color:black'>&nbsp;<\/span><\/p>\n\n<p><strong><span style='font-family:\"Calibri\",sans-serif'>If\nyou have questions<\/span><\/strong><strong><span style='font-family:\"Calibri\",sans-serif;&#10;font-weight:normal;mso-bidi-font-weight:bold'>: If you have any questions about\nthis study,<\/span><\/strong><strong><span style='font-family:\"Calibri\",sans-serif'>\n<\/span><\/strong><span style='font-family:\"Calibri\",sans-serif'>please contact Prof.\nMichelle Smith (<\/span><span style='font-family:\"Calibri\",sans-serif'>mks274@cornell.edu<\/span><span style='font-family:\"Calibri\",sans-serif'>).<\/span><\/p>","DefaultChoices":false,"DataExportTag":"Intro","QuestionType":"DB","Selector":"TB","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"You are invited to participate in a collaborative research project being led by Prof. Michelle Sm...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"QuestionID":"QID110","QuestionText_Unsafe":"Thank you for completing this biology assessment. Your responses will help us to improve how we teach biology, so it is important that you answer to the best of your ability.&nbsp;Please do not use outside resources to help you complete this assessment.&nbsp;<br>\n<br>\n<strong>Assessment Format<\/strong><br>\n<br>\nEach question in the test consists of a scenario, followed by a series of <strong>Likely \/ Unlikely<\/strong> statements. Based on the information given and your knowledge about biology, select <strong>Likely \/ Unlikely<\/strong> for each of the statements. Once you have answered all of the statements, click the \"right arrow\" at the bottom of the page to move onto the next question.<br>\n<br>\n<strong>General Instructions for Completing the Assessment<\/strong><div><b><br><\/b>\n<div>1. Be sure to select \u201csubmit\u201d before closing your browser in order to receive credit for completing the test.&nbsp;<\/div><div>2. Complete the assessment on either a laptop or a desktop computer.&nbsp;The questions and\/or figures may not be visible&nbsp;on a phone or tablet.&nbsp;\n\n<br>\n<strong><br><\/strong><\/div><div><strong>Research Consent<\/strong><br>\n&nbsp;<br>\nThis assessment is being administered within your class as part of normal course practices.<br>\n&nbsp;<br>\nYou will also be asked on the next page to release your responses for research purposes.&nbsp; These responses will be used to better understand what students know about biology and to help guide improvements to biology education.&nbsp; Your instructor is not a member of the research team, and your decision on whether to release your responses will have no bearing on the credit that you receive for this assignment.&nbsp;<br>\n<br>\n&nbsp;<\/div><\/div>","DataVisibility":{"Private":false,"Hidden":false},"NextChoiceId":1,"NextAnswerId":1}},{"SurveyID":"SV_4ORlgNIr9YWVxxc","Element":"SQ","PrimaryAttribute":"QID111","SecondaryAttribute":"Statement of Consent","TertiaryAttribute":null,"Payload":{"QuestionText":"<p><strong><span style='font-family:&#10;\"Calibri\",sans-serif'>Statement of Consent<\/span><\/strong><br><\/p>","DataExportTag":"Intro","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Statement of Consent","Choices":{"1":{"Display":"I have read and understood the above information. I consent to take part in the study."}},"ChoiceOrder":["1"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"Language":[],"QuestionID":"QID111","QuestionText_Unsafe":"Have you read the instructions and information above?","DataVisibility":{"Private":false,"Hidden":false},"NextChoiceId":2,"NextAnswerId":1}},{"SurveyID":"SV_4ORlgNIr9YWVxxc","Element":"SQ","PrimaryAttribute":"QID112","SecondaryAttribute":"Timing","TertiaryAttribute":null,"Payload":{"QuestionText":"Timing","DefaultChoices":false,"DataExportTag":"Intro_Time","QuestionType":"Timing","Selector":"PageTimer","Configuration":{"QuestionDescriptionOption":"UseText","MinSeconds":"0","MaxSeconds":"0"},"QuestionDescription":"Timing","Choices":{"1":{"Display":"First Click"},"2":{"Display":"Last Click"},"3":{"Display":"Page Submit"},"4":{"Display":"Click Count"}},"GradingData":[],"Language":[],"QuestionID":"QID112","QuestionText_Unsafe":"Timing"}},{"SurveyID":"SV_4ORlgNIr9YWVxxc","Element":"SQ","PrimaryAttribute":"QID114","SecondaryAttribute":"Please fill in the following information. This information is ONLY to record your participation. ","TertiaryAttribute":null,"Payload":{"QuestionText":"Please fill in the following information. This information is ONLY to record your participation.&nbsp;","DefaultChoices":false,"QuestionType":"TE","Selector":"FORM","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Please fill in the following information. This information is ONLY to record your participation. ","Choices":{"1":{"Display":"First Name"},"2":{"Display":"Last Name"},"3":{"Display":"Student ID"}},"ChoiceOrder":["1","2","3"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":null}},"GradingData":[],"Language":[],"QuestionText_Unsafe":"Please fill in the following information. This information is ONLY to record your participation.&nbsp;","DataExportTag":"PartInfo","QuestionID":"QID114"}},{"SurveyID":"SV_4ORlgNIr9YWVxxc","Element":"SQ","PrimaryAttribute":"QID117","SecondaryAttribute":"Timing","TertiaryAttribute":null,"Payload":{"QuestionText":"Timing","DefaultChoices":false,"QuestionType":"Timing","Selector":"PageTimer","SubSelector":"undefined","Configuration":{"QuestionDescriptionOption":"UseText","MinSeconds":"0","MaxSeconds":"0"},"QuestionDescription":"Timing","Choices":{"1":{"Display":"First Click"},"2":{"Display":"Last Click"},"3":{"Display":"Page Submit"},"4":{"Display":"Click Count"}},"GradingData":[],"Language":[],"QuestionText_Unsafe":"Timing","DataExportTag":"PartInfo_Timing","QuestionID":"QID117"}},{"SurveyID":"SV_4ORlgNIr9YWVxxc","Element":"SQ","PrimaryAttribute":"QID119","SecondaryAttribute":"For questions on the following pages, indicate whether each statement is Likely or Unlikely.\u00a0 We...","TertiaryAttribute":null,"Payload":{"QuestionText":"For questions on the following pages, indicate whether each statement is Likely or Unlikely.&nbsp;<div><br><\/div><div>We are most interested in your thinking and your responses will not influence your class grade - please do not use outside resources.<\/div>","DefaultChoices":false,"DataExportTag":"Prompt","QuestionType":"DB","Selector":"TB","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"For questions on the following pages, indicate whether each statement is Likely or Unlikely.\u00a0 We...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"QuestionID":"QID119","QuestionText_Unsafe":"For questions on the following pages, indicate whether each statement is Likely or Unlikely.&nbsp;<div><br><\/div><div>We are most interested in your thinking and your responses will not influence your class grade - please do not use outside resources.<\/div>"}},{"SurveyID":"SV_4ORlgNIr9YWVxxc","Element"
 the ligand and receptor attract each other across this distance."},"3":{"Display":"a motor protein actively transports the ligand across this space."},"4":{"Display":"the ligand moves across this distance sometimes towards and sometimes away from the receptor."}},"ChoiceDataExportTags":false,"QuestionDescription":" "}},"ChoiceDataExportTags":false,"QuestionID":"QID40","DataVisibility":{"Private":false,"Hidden":false},"NextChoiceId":5,"NextAnswerId":2}},{"SurveyID":"SV_bEnt7FrRHTpcu6G","Element":"SQ","PrimaryAttribute":"QID41","SecondaryAttribute":"Timing","TertiaryAttribute":null,"Payload":{"QuestionText":"Timing","DefaultChoices":false,"DataExportTag":"T8","QuestionType":"Timing","Selector":"PageTimer","Configuration":{"QuestionDescriptionOption":"UseText","MinSeconds":"0","MaxSeconds":"0"},"QuestionDescription":"Timing","Choices":{"1":{"Display":"First Click"},"2":{"Display":"Last Click"},"3":{"Display":"Page Submit"},"4":{"Display":"Click Count"}},"ChoiceOrder":["1","2","3"],"GradingData":[],"Language":[],"QuestionID":"QID41"}},{"SurveyID":"SV_bEnt7FrRHTpcu6G","Element":"SQ","PrimaryAttribute":"QID42","SecondaryAttribute":"Timing","TertiaryAttribute":null,"Payload":{"QuestionText":"Timing","DefaultChoices":false,"DataExportTag":"T9","QuestionType":"Timing","Selector":"PageTimer","Configuration":{"QuestionDescriptionOption":"UseText","MinSeconds":"0","MaxSeconds":"0"},"QuestionDescription":"Timing","Choices":{"1":{"Display":"First Click"},"2":{"Display":"Last Click"},"3":{"Display":"Page Submit"},"4":{"Display":"Click Count"}},"ChoiceOrder":["1","2","3"],"GradingData":[],"Language":[],"QuestionID":"QID42"}},{"SurveyID":"SV_bEnt7FrRHTpcu6G","Element":"SQ","PrimaryAttribute":"QID43","SecondaryAttribute":"Timing","TertiaryAttribute":null,"Payload":{"QuestionText":"Timing","DefaultChoices":false,"DataExportTag":"T10","QuestionType":"Timing","Selector":"PageTimer","Configuration":{"QuestionDescriptionOption":"UseText","MinSeconds":"0","MaxSeconds":"0"},"QuestionDescription":"Timing","Choices":{"1":{"Display":"First Click"},"2":{"Display":"Last Click"},"3":{"Display":"Page Submit"},"4":{"Display":"Click Count"}},"ChoiceOrder":["1","2","3"],"GradingData":[],"Language":[],"QuestionID":"QID43"}},{"SurveyID":"SV_bEnt7FrRHTpcu6G","Element":"SQ","PrimaryAttribute":"QID44","SecondaryAttribute":"Timing","TertiaryAttribute":null,"Payload":{"QuestionText":"Timing","DefaultChoices":false,"DataExportTag":"T11","QuestionType":"Timing","Selector":"PageTimer","Configuration":{"QuestionDescriptionOption":"UseText","MinSeconds":"0","MaxSeconds":"0"},"QuestionDescription":"Timing","Choices":{"1":{"Display":"First Click"},"2":{"Display":"Last Click"},"3":{"Display":"Page Submit"},"4":{"Display":"Click Count"}},"ChoiceOrder":["1","2","3"],"GradingData":[],"Language":[],"QuestionID":"QID44"}},{"SurveyID":"SV_bEnt7FrRHTpcu6G","Element":"SQ","PrimaryAttribute":"QID45","SecondaryAttribute":"Q13","TertiaryAttribute":null,"Payload":{"QuestionText":"<p>13.) The gray lines below represent the amino acid backbone of a water-soluble protein.&nbsp; This protein is comprised of polar and nonpolar residues and folds under physiological conditions, as shown below.<\/p>\n\n<p style=\"text-align: center;\">&nbsp;<br \/>\n<img src=\"https:\/\/cuboulder.qualtrics.com\/CP\/Graphic.php?IM=IM_5cKGxBgYurNJ0Cp\" style=\"width: 782px; height: 296px;\" \/><br \/>\n&nbsp;<\/p>\n\n<p>The following statements describe the folding of this protein in an aqueous environment:<\/p>","DefaultChoices":false,"DataExportTag":"Q13","QuestionType":"SBS","Selector":"SBSMatrix","Configuration":{"QuestionDescriptionOption":"SpecifyLabel","ChoiceColumnWidthPixels":667,"RepeatHeaders":"none","ColumnOrder":[1,0]},"QuestionDescription":"Q13","Choices":{"1":{"Display":"nonpolar side chains will tend to be located on the outer surface of the folded conformation."},"2":{"Display":"the free energy of the protein and its surroundings is lower when the protein is folded than when it is unfolded."},"3":{"Display":"the entropy of the protein is lower when the protein is folded than when it is unfolded."},"4":{"Display":"the entropy of the surrounding water molecules is lower when the protein is folded than when it is unfolded."}},"ChoiceOrder":[1,2,3,4],"Validation":{"Settings":{"ForceResponse":"OFF","ForceResponseType":"ON","Type":"None"}},"GradingData":[{"ChoiceID":"2","AnswerID":"1","SeriesID":"1","Grades":{"SC1":"1"},"index":1},{"ChoiceID":"3","AnswerID":"1","SeriesID":"1","Grades":{"SC1":"1"},"index":2},{"ChoiceID":"1","AnswerID":"1","SeriesID":"2","Grades":{"SC1":"1"},"index":4},{"ChoiceID":"4","AnswerID":"1","SeriesID":"2","Grades":{"SC1":"1"},"index":5}],"Language":[],"NumberOfQuestions":1,"AdditionalQuestions":{"1":{"Answers":{"1":{"Display":"True"},"2":{"Display":"False"}},"QuestionText":"&nbsp;","RecodeValues":[],"VariableNaming":[],"AnalyzeChoices":[],"QuestionType":"Matrix","Selector":"Likert","SubSelector":"SingleAnswer","ChoiceColumnWidthPixels":null,"Configuration":{"ChoiceColumnWidthPixels":10,"QuestionDescriptionOption":"UseText"},"GradingData":[{"AnswerID":"1","ChoiceID":"2","Grades":{"SC1":"1"},"index":0},{"AnswerID":"1","ChoiceID":"3","Grades":{"SC1":"1"},"index":1},{"AnswerID":"2","ChoiceID":"1","Grades":{"SC1":"1"},"index":2},{"AnswerID":"2","ChoiceID":"4","Grades":{"SC1":"1"},"index":3}],"DataExportTag":"Q13#1","QuestionID":"QID45#1","Choices":{"1":{"Display":"nonpolar side chains will tend to be located on the outer surface of the folded conformation."},"2":{"Display":"the free energy of the protein and its surroundings is lower when the protein is folded than when it is unfolded."},"3":{"Display":"the entropy of the protein is lower when the protein is folded than when it is unfolded."},"4":{"Display":"the entropy of the surrounding water molecules is lower when the protein is folded than when it is unfolded."}},"ChoiceDataExportTags":false,"QuestionDescription":" "}},"ChoiceDataExportTags":false,"QuestionID":"QID45","DataVisibility":{"Private":false,"Hidden":false},"NextChoiceId":5,"NextAnswerId":2}},{"SurveyID":"SV_bEnt7FrRHTpcu6G","Element":"SQ","PrimaryAttribute":"QID46","SecondaryAttribute":"Q14","TertiaryAttribute":null,"Payload":{"QuestionText":"<p>14.) An energy diagram is shown below for a simple uncatalyzed biochemical reaction, showing the changes in free energy of the molecular components as the reaction proceeds from reactants through the transition state to products.<br \/>\n&nbsp;<\/p>\n\n<p style=\"text-align: center;\"><img src=\"https:\/\/cuboulder.qualtrics.com\/CP\/Graphic.php?IM=IM_eV9af7XQSN2vDox\" style=\"width: 388px; height: 472px;\" \/><br \/>\n&nbsp;<\/p>\n\n<p>When the reactants are mixed at room temperature, no product formation is detected.&nbsp; If the solution is heated, the reaction proceeds slowly to equilibrium.&nbsp; If an enzyme is added to the solution at room temperature, the reaction proceeds rapidly to equilibrium.&nbsp; These different reactions can be characterized as follows:<\/p>","DefaultChoices":false,"DataExportTag":"Q14","QuestionType":"SBS","Selector":"SBSMatrix","Configuration":{"QuestionDescriptionOption":"SpecifyLabel","ChoiceColumnWidthPixels":691,"RepeatHeaders":"none","ColumnOrder":[1,0]},"QuestionDescription":"Q14","Choices":{"1":{"Display":"at room temperature, the uncatalyzed reaction proceeds at an extremely slow rate."},"2":{"Display":"when the solution is heated, the free energy of some reactant molecules reaches the level of the transition state."},"3":{"Display":"binding to the enzyme raises the free energy of the reactant molecules to the level of the transition state."},"4":{"Display":"when the enzyme catalyzed reaction reaches equilibrium, the forward reaction rate exceeds the reverse reaction rate."}},"ChoiceOrder":[1,2,3,4],"Validation":{"Settings":{"ForceResponse":"OFF","ForceResponseType":"ON","Type":"None"}},"GradingData":[{"ChoiceID":"1","AnswerID":"1","SeriesID":"1","Grades":{"SC1":"1"},"index":0},{"ChoiceID":"2","AnswerID":"1","SeriesID":"1","Grades":{"SC1":"1"},"index":1},{"ChoiceID":"3","AnswerID":"1","SeriesID":"2","Grades":{"SC1":"1"},"index":4},{"ChoiceID":"4","AnswerID":"1","SeriesID":"2","Grades":{"SC1":"1"},"index":5}],"Language":[],"NumberOfQuestions":1,"AdditionalQuestions":{"1":{"Answers":{"1":{"Display":"True"},"2":{"Display":"False"}},"QuestionText":"&nbsp;","RecodeValues":[],"VariableNaming":[],"AnalyzeChoices":[],"QuestionType":"Matrix","Selector":"Likert","SubSelector":"SingleAnswer","ChoiceColumnWidthPixels":null,"Configuration":{"ChoiceColumnWidthPixels":10,"QuestionDescriptionOption":"UseText"},"GradingData":[{"AnswerID":"1","ChoiceID":"1","Grades":{"SC1":"1"},"index":0},{"AnswerID":"1","ChoiceID":"2","Grades":{"SC1":"1"},"index":1},{"AnswerID":"2","ChoiceID":"3","Grades":{"SC1":"1"},"index":2},{"AnswerID":"2","ChoiceID":"4","Grades":{"SC1":"1"},"index":3}],"DataExportTag":"Q14#1","QuestionID":"QID46#1","Choices":{"1":{"Display":"at room temperature, the uncatalyzed reaction proceeds at an extremely slow rate."},"2":{"Display":"when the solution is heated, the free energy of some reactant molecules reaches the level of the transition state."},"3":{"Display":"binding to the enzyme raises the free energy of the reactant molecules to the level of the transition state."},"4":{"Display":"when the enzyme catalyzed reaction reaches equilibrium, the forward reaction rate exceeds the reverse reaction rate."}},"ChoiceDataExportTags":false,"QuestionDescription":" "}},"ChoiceDataExportTags":false,"QuestionID":"QID46","DataVisibility":{"Private":false,"Hidden":false},"NextChoiceId":5,"NextAnswerId":2}},{"SurveyID":"SV_bEnt7FrRHTpcu6G","Element":"SQ","PrimaryAttribute":"QID47","SecondaryAttribute":"Q15","TertiaryAttribute":null,"Payload":{"QuestionText":"<p>15.) Bid1 and Ral4 are transcription factors that bind to the same DNA sequence.&nbsp; To investigate this binding, you purify Bid1 and Ral4, make separate solutions of these proteins at increasing concentrations, and add the same small amount of the DNA sequence to each solution.&nbsp; After allowing the solutions to equilibrate, you measure and plot the percent of the total DNA bound at each different protein concentration, as shown below.&nbsp;<\/p>\n\n<p>&nbsp;<br \/>\n<img src=\"https:\/\/cuboulder.qualtrics.com\/CP\/Graphic.php?IM=IM_6fcX1hIkUnCAY3b\" style=\"width: 800px; height: 430px;\" \/><br \/>\n<br \/>\nBased on these results, you can conclude that:<\/p>","DefaultChoices":false,"DataExportTag":"Q15","QuestionType":"SBS","Selector":"SBSMatrix","Configuration":{"QuestionDescriptionOption":"SpecifyLabel","ChoiceColumnWidthPixels":670,"RepeatHeaders":"none","ColumnOrder":[1,0]},"QuestionDescription":"Q15","Choices":{"1":{"Display":"Bid1 binds with higher affinity to the DNA sequence than Ral4."},"2":{"Display":"Ral4 binds with higher affinity to the DNA sequence at 12 \u03bcM concentration than it does at 2 \u03bcM concentration."},"3":{"Display":"if the two proteins were present together at 2 \u03bcM each, the percent DNA bound by each protein would be equal."},"4":{"Display":"individual Bid1 and Ral4 proteins are unable to dissociate once they bind to DNA."}},"ChoiceOrder":[1,2,3,4],"Validation":{"Settings":{"ForceResponse":"OFF","ForceResponseType":"ON","Type":"None"}},"GradingData":[{"ChoiceID":"1","AnswerID":"1","SeriesID":"1","Grades":{"SC1":"1"},"index":0},{"ChoiceID":"2","AnswerID":"1","SeriesID":"2","Grades":{"SC1":"1"},"index":4},{"ChoiceID":"3","AnswerID":"1","SeriesID":"2","Grades":{"SC1":"1"},"index":5},{"ChoiceID":"4","AnswerID":"1","SeriesID":"2","Grades":{"SC1":"1"},"index":6}],"Language":[],"NumberOfQuestions":1,"AdditionalQuestions":{"1":{"Answers":{"1":{"Display":"True"},"2":{"Display":"False"}},"QuestionText":"&nbsp;","RecodeValues":[],"VariableNaming":[],"AnalyzeChoices":[],"QuestionType":"Matrix","Selector":"Likert","SubSelector":"SingleAnswer","ChoiceColumnWidthPixels":null,"Configuration":{"ChoiceColumnWidthPixels":10,"QuestionDescriptionOption":"UseText"},"GradingData":[{"AnswerID":"1","ChoiceID":"1","Grades":{"SC1":"1"},"index":0},{"AnswerID":"2","ChoiceID":"2","Grades":{"SC1":"1"},"index":1},{"AnswerID":"2","ChoiceID":"3","Grades":{"SC1":"1"},"index":2},{"AnswerID":"2","ChoiceID":"4","Grades":{"SC1":"1"},"index":3}],"DataExportTag":"Q15#1","QuestionID":"QID47#1","Choices":{"1":{"Display":"Bid1 binds with higher affinity to the DNA sequence than Ral4."},"2":{"Display":"Ral4 binds with higher affinity to the DNA sequence at 12 \u03bcM concentration than it does at 2 \u03bcM concentration."},"3":{"Display":"if the two proteins were present together at 2 \u03bcM each, the percent DNA bound by each protein would be equal."},"4":{"Display":"individual Bid1 and Ral4 proteins are unable to dissociate once they bind to DNA."}},"ChoiceDataExportTags":false,"QuestionDescription":" "}},"ChoiceDataExportTags":false,"QuestionID":"QID47","DataVisibility":{"Private":false,"Hidden":false},"NextChoiceId":5,"NextAnswerId":2}},{"SurveyID":"SV_bEnt7FrRHTpcu6G","Element":"SQ","PrimaryAttribute":"QID48","SecondaryAttribute":"Q16","TertiaryAttribute":null,"Payload":{"QuestionText":"<p>16.) The transmembrane receptor protein shown below in the ER membrane is trafficked through the Golgi apparatus to the plasma membrane.&nbsp;<\/p>\n\n<p style=\"text-align: center;\">&nbsp;<\/p>\n\n<p style=\"text-align: center;\"><img src=\"https:\/\/cuboulder.qualtrics.com\/CP\/Graphic.php?IM=IM_0jOVzkwb8bA3ceV\" style=\"width: 800px; height: 505px;\" \/><\/p>\n\n<p>&nbsp;<\/p>\n\n<p>During this process, Domain A will be accessible to the cytosol when the receptor is embedded in:<\/p>","DefaultChoices":false,"DataExportTag":"Q16","QuestionType":"SBS","Selector":"SBSMatrix","Configuration":{"QuestionDescriptionOption":"SpecifyLabel","ChoiceColumnWidthPixels":669,"RepeatHeaders":"none","ColumnOrder":[1,0]},"QuestionDescription":"Q16","Choices":{"1":{"Display":"the ER membrane."},"2":{"Display":"the membrane of a transport vesicle."},"3":{"Display":"the Golgi membrane."},"4":{"Display":"the plasma membrane."}},"ChoiceOrder":[1,2,3,4],"Validation":{"Settings":{"ForceResponse":"OFF","ForceResponseType":"ON","Type":"None"}},"GradingData":[{"ChoiceID":"1","AnswerID":"1","SeriesID":"2","Grades":{"SC1":"1"},"index":4},{"ChoiceID":"2","AnswerID":"1","SeriesID":"2","Grades":{"SC1":"1"},"index":5},{"ChoiceID":"3","AnswerID":"1","SeriesID":"2","Grades":{"SC1":"1"},"index":6},{"ChoiceID":"4","AnswerID":"1","SeriesID":"2","Grades":{"SC1":"1"},"index":3}],"Language":[],"NumberOfQuestions":1,"AdditionalQuestions":{"1":{"Answers":{"1":{"Display":"True"},"2":{"Display":"False"}},"QuestionText":"&nbsp;","RecodeValues":[],"VariableNaming":[],"AnalyzeChoices":[],"QuestionType":"Matrix","Selector":"Likert","SubSelector":"SingleAnswer","ChoiceColumnWidthPixels":null,"Configuration":{"ChoiceColumnWidthPixels":10,"QuestionDescriptionOption":"UseText"},"GradingData":[{"AnswerID":"2","ChoiceID":"1","Grades":{"SC1":"1"},"index":0},{"AnswerID":"2","ChoiceID":"2","Grades":{"SC1":"1"},"index":1},{"AnswerID":"2","ChoiceID":"3","Grades":{"SC1":"1"},"index":2},{"AnswerID":"2","ChoiceID":"4","Grades":{"SC1":"1"},"index":3}],"DataExportTag":"Q16#1","QuestionID":"QID48#1","Choices":{"1":{"Display":"the ER membrane."},"2":{"Display":"the membrane of a transport vesicle."},"3":{"Display":"the Golgi membrane."},"4":{"Display":"the plasma membrane."}},"ChoiceDataExportTags":false,"QuestionDescription":" "}},"ChoiceDataExportTags":false,"QuestionID":"QID48","DataVisibility":{"Private":false,"Hidden":false},"NextChoiceId":5,"NextAnswerId":2}},{"SurveyID":"SV_bEnt7FrRHTpcu6G","Element":"SQ","PrimaryAttribute":"QID49","SecondaryAttribute":"Q17","TertiaryAttribute":null,"Payload":{"QuestionText":"<p>\n\t\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n<\/p><p>17.) Tamoxifen\nis a drug used to treat cancers characterized by high levels of estrogen\nreceptor.&nbsp; Tamoxifen works by binding to\nthe estrogen receptor, blocking estrogen receptor signaling, and preventing\nestrogen-induced cell proliferation.&nbsp;\nSome people with these cancers respond well to tamoxifen, while others\nreceive little benefit from tamoxifen treatment. <\/p>\n\n<p>&nbsp;<\/p>\n\n<p>To\ninvestigate this problem, a genomic study is conducted with cancer patients\nundergoing tamoxifen treatment.&nbsp; DNA\nsamples taken from non-tumor cells are sequenced at different sites spread\nacross the genome where there are known single-nucleotide polymorphisms, called\nSNPs, in the population.&nbsp; The resulting\ndata show that a statistically significant number of responding patients differ\nfrom non-responding patients at one particular nucleotide site.&nbsp; This nucleotide difference could be located:<\/p>","DefaultChoices":false,"DataExportTag":"Q17","QuestionType":"SBS","Selector":"SBSMatrix","Configuration":{"QuestionDescriptionOption":"SpecifyLabel","ChoiceColumnWidthPixels":666,"RepeatHeaders":"none","ColumnOrder":[1,0]},"QuestionDescription":"Q17","Choices":{"1":{"Display":"within the estrogen receptor gene in a region that influences its expression or activity."},"2":{"Display":"in a region genetically linked to the estrogen receptor gene, but not influencing its expression or activity."},"3":{"Display":"in the coding sequence of an enzyme responsible for tamoxifen metabolism."},"4":{"Display":"in the coding sequence of a signaling protein that functions downstream of the estrogen receptor."}},"ChoiceOrder":[1,2,3,4],"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[{"ChoiceID":"1","AnswerID":"1","SeriesID":"1","Grades":{"SC1":"1"},"index":0},{"ChoiceID":"2","AnswerID":"1","SeriesID":"1","Grades":{"SC1":"1"},"index":1},{"ChoiceID":"3","AnswerID":"1","SeriesID":"1","Grades":{"SC1":"1"},"index":2},{"ChoiceID":"4","AnswerID":"1","SeriesID":"1","Grades":{"SC1":"1"},"index":3}],"Language":[],"NumberOfQuestions":1,"AdditionalQuestions":{"1":{"QuestionText":"&nbsp;","Answers":{"1":{"Display":"True"},"2":{"Display":"False"}},"RecodeValues":[],"VariableNaming":[],"AnalyzeChoices":[],"QuestionType":"Matrix","Selector":"Likert","SubSelector":"SingleAnswer","ChoiceColumnWidthPixels":null,"Configuration":{"ChoiceColumnWidthPixels":10,"QuestionDescriptionOption":"UseText"},"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[{"AnswerID":"1","ChoiceID":"1","Grades":{"SC1":"1"},"index":0},{"AnswerID":"1","ChoiceID":"2","Grades":{"SC1":"1"},"index":1},{"AnswerID":"1","ChoiceID":"3","Grades":{"SC1":"1"},"index":2},{"AnswerID":"1","ChoiceID":"4","Grades":{"SC1":"1"},"index":3}],"DataExportTag":"Q17#1","QuestionID":"QID49#1","Choices":{"1":{"Display":"within the estrogen receptor gene in a region that influences its expression or activity."},"2":{"Display":"in a region genetically linked to the estrogen receptor gene, but not influencing its expression or activity."},"3":{"Display":"in the coding sequence of an enzyme responsible for tamoxifen metabolism."},"4":{"Display":"in the coding sequence of a signaling protein that functions downstream of the estrogen receptor."}},"ChoiceDataExportTags":false,"QuestionDescription":" "}},"ChoiceDataExportTags":false,"QuestionID":"QID49"}},{"SurveyID":"SV_bEnt7FrRHTpcu6G","Element":"SQ","PrimaryAttribute":"QID50","SecondaryAttribute":"Q18","TertiaryAttribute":null,"Payload":{"QuestionText":"<p>\n\t\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n18.) In\nhuman female embryos, one copy of the X chromosome is randomly inactivated in\neach cell between the 4-cell and 32-cell stages.&nbsp; A woman is homozygous for a recessive\nX-linked mutation that results in her having all unpigmented skin.&nbsp; If she has children with a man who has all\nnormally pigmented skin, their offspring could include:<\/p>","DefaultChoices":false,"DataExportTag":"Q18","QuestionType":"SBS","Selector":"SBSMatrix","Configuration":{"QuestionDescriptionOption":"SpecifyLabel","ChoiceColumnWidthPixels":667,"RepeatHeaders":"none","ColumnOrder":[1,0]},"QuestionDescription":"Q18","Choices":{"1":{"D
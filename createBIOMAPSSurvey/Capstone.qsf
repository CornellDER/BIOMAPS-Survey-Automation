 in a signaling pathway normally interact.&nbsp; The pathway is initiated by the presence of Signal A at the cell surface.&nbsp; Pointed arrows (&rarr;) indicate that one component activates another component that is otherwise inactive, and blunt arrows (\u2015|) indicate that one component inhibits another component that is otherwise active.<\/p>\n\n<p style=\"text-align: center;\">&nbsp;<\/p>\n\n<p style=\"text-align: center;\"><img src=\"https:\/\/cuboulder.qualtrics.com\/CP\/Graphic.php?IM=IM_3jHu7IPj9s2qdCt\" style=\"width: 800px; height: 48px;\" \/><\/p>\n\n<p style=\"text-align: center;\"><em>&nbsp;<\/em><\/p>\n\n<p>Assuming Signal A is present, this pathway will promote Gene E expression when:<\/p>","DefaultChoices":false,"DataExportTag":"Q10","QuestionType":"SBS","Selector":"SBSMatrix","Configuration":{"QuestionDescriptionOption":"SpecifyLabel","ChoiceColumnWidthPixels":663,"RepeatHeaders":"none","ColumnOrder":[1,0]},"QuestionDescription":"Q10","Choices":{"1":{"Display":"there are no mutations in any genes encoding pathway components."},"2":{"Display":"Receptor Protein A is non-functional."},"3":{"Display":"Protein B is non-functional."},"4":{"Display":"Receptor Protein A and Protein B are both non-functional."}},"ChoiceOrder":[1,2,3,4],"Validation":{"Settings":{"ForceResponse":"OFF","ForceResponseType":"ON","Type":"None"}},"GradingData":[{"ChoiceID":"1","AnswerID":"1","SeriesID":"1","Grades":{"SC1":"1"},"index":0},{"ChoiceID":"3","AnswerID":"1","SeriesID":"1","Grades":{"SC1":"1"},"index":2},{"ChoiceID":"4","AnswerID":"1","SeriesID":"1","Grades":{"SC1":"1"},"index":3},{"ChoiceID":"2","AnswerID":"1","SeriesID":"2","Grades":{"SC1":"1"},"index":4}],"Language":[],"NumberOfQuestions":1,"AdditionalQuestions":{"1":{"Answers":{"1":{"Display":"True"},"2":{"Display":"False"}},"QuestionText":"&nbsp;","RecodeValues":[],"VariableNaming":[],"AnalyzeChoices":[],"QuestionType":"Matrix","Selector":"Likert","SubSelector":"SingleAnswer","ChoiceColumnWidthPixels":null,"Configu
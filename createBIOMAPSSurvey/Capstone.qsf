rst Click"},"2":{"Display":"Last Click"},"3":{"Display":"Page Submit"},"4":{"Display":"Click Count"}},"ChoiceOrder":["1","2","3"],"GradingData":[],"Language":[],"QuestionID":"QID54"}},{"SurveyID":"SV_bEnt7FrRHTpcu6G","Element":"SQ","PrimaryAttribute":"QID55","SecondaryAttribute":"Timing","TertiaryAttribute":null,"Payload":{"QuestionText":"Timing","DefaultChoices":false,"DataExportTag":"T16","QuestionType":"Timing","Selector":"PageTimer","Configuration":{"QuestionDescriptionOption":"UseText","MinSeconds":"0","MaxSeconds":"0"},"QuestionDescription":"Timing","Choices":{"1":{"Display":"First Click"},"2":{"Display":"Last Click"},"3":{"Display":"Page Submit"},"4":{"Display":"Click Count"}},"ChoiceOrder":["1","2","3"],"GradingData":[],"Language":[],"QuestionID":"QID55"}},{"SurveyID":"SV_bEnt7FrRHTpcu6G","Element":"SQ","PrimaryAttribute":"QID56","SecondaryAttribute":"Timing","TertiaryAttribute":null,"Payload":{"QuestionText":"Timing","DefaultChoices":false,"DataExportTag":"T17","QuestionType":"Timing","Selector":"PageTimer","Configuration":{"QuestionDescriptionOption":"UseText","MinSeconds":"0","MaxSeconds":"0"},"QuestionDescription":"Timing","Choices":{"1":{"Display":"First Click"},"2":{"Display":"Last Click"},"3":{"Display":"Page Submit"},"4":{"Display":"Click Count"}},"ChoiceOrder":["1","2","3"],"GradingData":[],"Language":[],"QuestionID":"QID56"}},{"SurveyID":"SV_bEnt7FrRHTpcu6G","Element":"SQ","PrimaryAttribute":"QID57","SecondaryAttribute":"Timing","TertiaryAttribute":null,"Payload":{"QuestionText":"Timing","DefaultChoices":false,"DataExportTag":"T18","QuestionType":"Timing","Selector":"PageTimer","Configuration":{"QuestionDescriptionOption":"UseText","MinSeconds":"0","MaxSeconds":"0"},"QuestionDescription":"Timing","Choices":{"1":{"Display":"First Click"},"2":{"Display":"Last Click"},"3":{"Display":"Page Submit"},"4":{"Display":"Click Count"}},"ChoiceOrder":["1","2","3"],"GradingData":[],"Language":[],"QuestionID":"QID57"}},{"SurveyID":"SV_bEnt7FrRHTpcu6G","Element":"SQ","PrimaryAttribute":"QID58","SecondaryAttribute":"Class","TertiaryAttribute":null,"Payload":{"QuestionText":"What is your current class standing?","DataExportTag":"CY","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","Configuration":{"QuestionDescriptionOption":"SpecifyLabel"},"QuestionDescription":"Class","Choices":{"1":{"Display":"Freshman"},"2":{"Display":"Sophomore"},"3":{"Display":"Junior"},"4":{"Display":"Senior"},"5":{"Display":"Graduate"}},"ChoiceOrder":[1,2,3,4,5],"Validation":{"Settings":{"ForceResponse":"OFF","ForceResponseType":"ON","Type":"None"}},"Language":[],"QuestionID":"QID58"}},{"SurveyID":"SV_bEnt7FrRHTpcu6G","Element":"SQ","PrimaryAttribute":"QID59","SecondaryAttribute":"Directions","TertiaryAttribute":null,"Payload":{"QuestionText":"<span style=\"font-size: 24px;\"><span style=\"color: rgb(0, 0, 205);\">Step 2: For questions on the following pages, indicate whether each statement is true or false.<\/span><\/span>","DefaultChoices":false,"DataExportTag":"ID","QuestionID":"QID59","QuestionType":"DB","Selector":"TB","Configuration":{"QuestionDescriptionOption":"SpecifyLabel"},"QuestionDescription":"Directions","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[]}},{"SurveyID":"SV_bEnt7FrRHTpcu6G","Element":"SQ","PrimaryAttribute":"QID60","SecondaryAttribute":"Timing","TertiaryAttribute":null,"Payload":{"QuestionText":"Timing","DefaultChoices":false,"DataExportTag":"CY+","QuestionType":"Timing","Selector":"PageTimer","Configuration":{"QuestionDescriptionOption":"UseText","MinSeconds":"0","MaxSeconds":"0"},"QuestionDescription":"Timing","Choices":{"1":{"Display":"First Click"},"2":{"Display":"Last Click"},"3":{"Display":"Page Submit"},"4":{"Display":"Click Count"}},"ChoiceOrder":["1","2","3"],"GradingData":[],"Language":[],"QuestionID":"QID60"}},{"SurveyID":"SV_bEnt7FrRHTpcu6G","Element":"SQ","PrimaryAttribute":"QID66","SecondaryAttribute":"\u200b \u200bParticipant Informed Consent Form \u00a0 You are invited to participate in a collaborative resear","TertiaryAttribute":null,"Payload":{"QuestionText":"<div>\u200b\n<p><strong>\u200bParticipant Informed Consent Form<\/strong><\/p>\n\n<p><span style=\"background-color: rgb(255, 255, 255); box-sizing: border-box; color: rgb(64, 64, 64); display: inline; float: none; font-family: arial,helvetica,sans-serif; font-size: 16px; font-style: normal; font-variant: normal; font-weight: 400; letter-spacing: normal; -ms-user-select: auto; orphans: 2; text-align: left; text-decoration: none; text-indent: 0px; text-transform: none; -webkit-text-stroke-width: 0px; white-space: normal; word-spacing: 0px;\">&nbsp;<\/span><\/p>\n<span style=\"display: inline !important; float: none; background-color: rgb(255, 255, 255); color: rgb(64, 64, 64); font-family: &quot;72&quot;,Helvetica Neue,Helvetica,Arial,sans-serif; font-size: 15px; font-style: normal; font-variant: normal; font-weight: 400; letter-spacing: normal; -ms-user-select: auto; orphans: 2; text-align: left; text-decoration: none; text-indent: 0px; text-transform: none; -webkit-text-stroke-width: 0px; white-space: normal; word-spacing: 0px;\"> <\/span>\n\n<p>You are invited to participate in a collaborative research project being led by Prof. Michelle Smith, a faculty member in the Department of Ecology and Evolutionary Biology at Cornell University. The purpose of this research is to gauge student understanding of fundamental biology concepts.<br \/>\n&nbsp;<br \/>\n<strong>What we will ask you to do:<\/strong> This survey poses a number of questions asking you to reason about fundamental biology concepts. The primary purpose of the survey is for your instructor(s) and department to evaluate the effectiveness of their biology courses. This consent form asks for your permission to use your responses for additional research purposes.<\/p>\n<span style=\"display: inline !important; float: none; background-color: rgb(255, 255, 255); color: rgb(64, 64, 64); font-family: &quot;72&quot;,Helvetica Neue,Helvetica,Arial,sans-serif; font-size: 15px; font-style: normal; font-variant: normal; font-weight: 400; letter-spacing: normal; -ms-user-select: auto; orphans: 2; text-align: left; text-decoration: none; text-indent: 0px; text-transform: none; -webkit-text-stroke-width: 0px; white-space: normal; word-spacing: 0px;\"> <\/span>\n\n<p>&nbsp;<\/p>\n<span style=\"display: inline !important; float: none; background-color: rgb(255, 255, 255); color: rgb(64, 64, 64); font-family: &quot;72&quot;,Helvetica Neue,Helvetica,Arial,sans-serif; font-size: 15px; font-style: normal; font-variant: normal; font-weight: 400; letter-spacing: normal; -ms-user-select: auto; orphans: 2; text-align: left; text-decoration: none; text-indent: 0px; text-transform: none; -webkit-text-stroke-width: 0px; white-space: normal; word-spacing: 0px;\"> <\/span>\n\n<p><strong>Risks and discomforts:<\/strong> We do not anticipate any risks from participating in this research.<\/p>\n<span style=\"display: inline !important; float: none; background-color: rgb(255, 255, 255); color: rgb(64, 64, 64); font-family: &quot;72&quot;,Helvetica Neue,Helvetica,Arial,sans-serif; font-size: 15px; font-style: normal; font-variant: normal; font-weight: 400; letter-spacing: normal; -ms-user-select: auto; orphans: 2; text-align: left; text-decoration: none; text-indent: 0px; text-transform: none; -webkit-text-stroke-width: 0px; white-space: normal; word-spacing: 0px;\"> <\/span>\n\n<p>&nbsp;<\/p>\n<span style=\"display: inline !important; float: none; background-color: rgb(255, 255, 255); color: rgb(64, 64, 64); font-family: &quot;72&quot;,Helvetica Neue,Helvetica,Arial,sans-serif; font-size: 15px; font-style: normal; font-variant: normal; font-weight: 400; letter-spacing: normal; -ms-user-select: auto; orphans: 2; text-align: left; text-decoration: none; text-indent: 0px; text-transform: none; -webkit-text-stroke-width: 0px; white-space: normal; word-spacing: 0px;\"> <\/span>\n\n<p><strong>Benefits:<\/strong> There are no direct benefits other than the opportunity to learn, practice some new material, and contribute to future instructional innovations in biology education.<\/p>\n<span style=\"display: inline !important; float: none; background-color: rgb(255, 255, 255); color: rgb(64, 64, 64); font-family: &quot;72&quot;,Helvetica Neue,Helvetica,Arial,sans-serif; font-size: 15px; font-style: normal; font-variant: normal; font-weight: 400; letter-spacing: normal; -ms-user-select: auto; orphans: 2; text-align: left; text-decoration: none; text-indent: 0px; text-transform: none; -webkit-text-stroke-width: 0px; white-space: normal; word-spacing: 0px;\"> <\/span>\n\n<p>&nbsp;<\/p>\n<span style=\"display: inline !important; float: none; background-color: rgb(255, 255, 255); color: rgb(64, 64, 64); font-family: &quot;72&quot;,Helvetica Neue,Helvetica,Arial,sans-serif; font-size: 15px; font-style: normal; font-variant: normal; font-weight: 400; letter-spacing: normal; -ms-user-select: auto; orphans: 2; text-align: left; text-decoration: none; text-indent: 0px; text-transform: none; -webkit-text-stroke-width: 0px; white-space: normal; word-spacing: 0px;\"> <\/span>\n\n<p><strong>Compensation for participation:<\/strong> You will either receive course credit or no compensation for your participation. If your instructor has assigned course credit for completing this survey, you must provide your name and student ID information at the end of the survey to receive this credit.<\/p>\n<span style=\"display: inline !important; float: none; background-color: rgb(255, 255, 255); color: rgb(64, 64, 64); font-family: &quot;72&quot;,Helvetica Neue,Helvetica,Arial,sans-serif; font-size: 15px; font-style: normal; font-variant: normal; font-weight: 400; letter-spacing: normal; -ms-user-select: auto; orphans: 2; text-align: left; text-decoration: none; text-indent: 0px; text-transform: none; -webkit-text-stroke-width: 0px; white-space: normal; word-spacing: 0px;\"> <\/span>\n\n<p>&nbsp;<\/p>\n<span style=\"display: inline !important; float: none; background-color: rgb(255, 255, 255); color: rgb(64, 64, 64); font-family: &quot;72&quot;,Helvetica Neue,Helvetica,Arial,sans-serif; font-size: 15px; font-style: normal; font-variant: normal; font-weight: 400; letter-spacing: normal; -ms-user-select: auto; orphans: 2; text-align: left; text-decoration: none; text-indent: 0px; text-transform: none; -webkit-text-stroke-width: 0px; white-space: normal; word-spacing: 0px;\"> <\/span>\n\n<p><strong>Privacy\/Confidentiality\/Data Security:<\/strong> Your identifying information will be kept with your survey data for the purposes of matching survey responses. Your instructor will have access to your responses at the end of semester\/quarter. Your identity will never be associated with your responses publicly.<\/p>\n<span style=\"display: inline !important; float: none; background-color: rgb(255, 255, 255); color: rgb(64, 64, 64); font-family: &quot;72&quot;,Helvetica Neue,Helvetica,Arial,sans-serif; font-size: 15px; font-style: normal; font-variant: normal; font-weight: 400; letter-spacing: normal; -ms-user-select: auto; orphans: 2; text-align: left; text-decoration: none; text-indent: 0px; text-transform: none; -webkit-text-stroke-width: 0px; white-space: normal; word-spacing: 0px;\"> <\/span>\n\n<p>&nbsp;<\/p>\n<span style=\"display: inline !important; float: none; background-color: rgb(255, 255, 255); color: rgb(64, 64, 64); font-family: &quot;72&quot;,Helvetica Neue,Helvetica,Arial,sans-serif; font-size: 15px; font-style: normal; font-variant: normal; font-weight: 400; letter-spacing: normal; -ms-user-select: auto; orphans: 2; text-align: left; text-decoration: none; text-indent: 0px; text-transform: none; -webkit-text-stroke-width: 0px; white-space: normal; word-spacing: 0px;\"> <\/span>\n\n<p><strong>Taking part is voluntary:<\/strong> You may choose whether to consent to having your survey data used for research purposes. Participation credit (if your instructor has assigned such credit) does not depend on any specific answers you provide in the survey or on whether you consent to have your answers used in research. You may complete this survey for your instructor without consenting to participate in the research. You must complete this survey for your instructor to obtain participation credit in your course (if applicable).<\/p>\n<span style=\"display: inline !important; float: none; background-color: rgb(255, 255, 255); color: rgb(64, 64, 64); font-family: &quot;72&quot;,Helvetica Neue,Helvetica,Arial,sans-serif; font-size: 15px; font-style: normal; font-variant: normal; font-weight: 400; letter-spacing: normal; -ms-user-select: auto; orphans: 2; text-align: left; text-decoration: none; text-indent: 0px; text-transform: none; -webkit-text-stroke-width: 0px; white-space: normal; word-spacing: 0px;\"> <\/span>\n\n<p>&nbsp;<\/p>\n<strong> <span style=\"display: inline !important; float: none; background-color: rgb(255, 255, 255); color: rgb(64, 64, 64); font-family: &quot;72&quot;,Helvetica Neue,Helvetica,Arial,sans-serif; font-size: 15px; font-style: normal; font-variant: normal; font-weight: 400; letter-spacing: normal; -ms-user-select: auto; orphans: 2; text-align: left; text-decoration: none; text-indent: 0px; text-transform: none; -webkit-text-stroke-width: 0px; white-space: normal; word-spacing: 0px;\"> <\/span><\/strong>\n\n<p><strong>If you have questions:<\/strong> If you have any questions about this study, please contact Prof. Michelle Smith (mks274@cornell.edu).<\/p>\n<span style=\"display: inline !important; float: none; background-color: rgb(255, 255, 255); color: rgb(64, 64, 64); font-family: &quot;72&quot;,Helvetica Neue,Helvetica,Arial,sans-serif; font-size: 15px; font-style: normal; font-variant: normal; font-weight: 400; letter-spacing: normal; -ms-user-select: auto; orphans: 2; text-align: left; text-decoration: none; text-indent: 0px; text-transform: none; -webkit-text-stroke-width: 0px; white-space: normal; word-spacing: 0px;\"> <\/span>\n\n<p>&nbsp;<\/p>\n<\/div>","DefaultChoices":false,"QuestionType":"DB","Selector":"TB","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"\u200b \u200bParticipant Informed Consent Form \u00a0 You are invited to participate in a collaborative research...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionText_Unsafe":"<div style=\"text-align: center;\">\u200b<strong>Participant Informed Consent Form<\/strong><\/div>\n&nbsp;<br \/>\nYou are invited to participate in a research project being conducted by Michelle Smith, Natasha Holmes, and Cole Walsh (Cornell University), Sara Brownell and Christian Wright (Arizona State University), Brian Couch (University Nebraska-Lincoln), Alison Crowe (University of Washington), Jennifer Knight and Kate Semsar (University of Colorado-Boulder), and Mindi Summers (University of Calgary).&nbsp; The purpose of this research is to gauge student understanding of fundamental biology concepts.&nbsp; You are invited to participate in this study because you are enrolled in an undergraduate biology course.&nbsp;&nbsp;&nbsp;<br \/>\n&nbsp;<br \/>\n<strong>What Will You Be Asked to Do?<\/strong><br \/>\n&nbsp;<br \/>\nIf you decide to participate, your instructor or program will be ask you to complete the assessment as part of your normal course or program requirements.&nbsp; The assessment is expected to take roughly 30-60 minutes and will take place at a location determined by your course instructor or departmental representative. This consent form asks for your permission to use your responses for additional research purposes.<br \/>\n&nbsp;<br \/>\n<strong>Risks:<\/strong><br \/>\n<br \/>\nThere are no known risks or discomforts associated with this research other than the use of your time and that you may be inconvenienced.<br \/>\n&nbsp;<br \/>\n<strong>Benefits:<\/strong><br \/>\n<br \/>\nThere are no direct benefits to you as a research participant.&nbsp; Your responses may help improve your department&rsquo;s biology curriculum.<br \/>\n&nbsp;<br \/>\n<strong>Compensation:<\/strong><br \/>\n<br \/>\nCredit for completing this survey will be determined by your course instructor or departmental representative.&nbsp; You will receive no additional benefit by choosing to release your responses for research purposes.<br \/>\n&nbsp;<br \/>\n<strong>Confidentiality:<br \/>\n&nbsp; &nbsp;&nbsp;<\/strong><br \/>\nPrior to research analyses, a member of the research team will de-identify your responses by replacing your name with a unique code.&nbsp; A list of names and codes will be stored separately in a locked file cabinet in a researcher&rsquo;s office.&nbsp; Research data will be kept until the project is complete.&nbsp; Information obtained in this study may be published in scientific journals or presented at scientific meetings.&nbsp; Such data will always be reported in de-identified or aggregated formats.<br \/>\n&nbsp;<br \/>\n<strong>Voluntary:<\/strong><br \/>\n<br \/>\nParticipation in this study is voluntary.&nbsp; If you choose to take part in this study, you may stop at any time. You may skip any questions you do not wish to answer. You can refuse to allow your responses to be released for research purposes without harming your relationship with your course instructor\/departmental representative or your institution, or in any other way receive a penalty or loss of benefits to which you are otherwise entitled.<br \/>\n&nbsp;<br \/>\n<strong>Contact Information:<\/strong><br \/>\n<br \/>\nIf you have questions about this study, please ask your course instructor\/departmental representative or contact Dr. Michelle Smith at mks274@cornell.edu.&nbsp;<br \/>\n&nbsp;<br \/>\n<strong>Consent, Right to Receive a Copy:<\/strong><br \/>\n\u200b<br \/>\nYou are voluntarily making a decision whether or not to participate in this research study. &nbsp;Your agreement with the statement below certifies that you have decided to participate having read and understood the information presented. &nbsp;You may print a copy of this consent form to keep.","DataExportTag":"Q66","QuestionID":"QID66","DataVisibility":{"Private":false,"Hidden":false}}},{"SurveyID":"SV_bEnt7FrRHTpcu6G","Element":"SQ","PrimaryAttribute":"QID67","SecondaryAttribute":"\u200bPlease check one answer for each question:","TertiaryAttribute":null,"Payload":{"QuestionText":"<strong>\u200bPlease check one answer for each question:<\/strong>","DefaultChoices":false,"QuestionType":"DB","Selector":"TB","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"\u200bPlease check one answer for each question:","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionText_Unsafe":"<strong>\u200bPlease check one answer for each question:<\/strong>","DataExportTag":"Q67","QuestionID":"QID67"}},{"SurveyID":"SV_bEnt7FrRHTpcu6G","Element":"SQ","PrimaryAttribute":"QID68","SecondaryAttribute":"Statement of Consent","TertiaryAttribute":null,"Payload":{"QuestionText":"<strong>Statement of Consent<\/strong>","QuestionType":"MC","Selector":"MAVR","SubSelector":"TX","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Statement of Consent","Choices":{"5":{"Display":"I have read and understood the above information. I consent to take part in the study."}},"ChoiceOrder":["5"],"Validation":{"Settings":{"ForceResponse":"OFF","ForceResponseType":"ON","Type":"None"}},"Language":[],"NextChoiceId":7,"NextAnswerId":1,"QuestionText_Unsafe":"I agree to have my survey responses released for research purposes.","DataExportTag":"Q68","QuestionID":"QID68","DataVisibility":{"Private":false,"Hidden":false}}},{"SurveyID":"SV_bEnt7FrRHTpcu6G","Element":"SQ","PrimaryAttribute":"QID69","SecondaryAttribute":"Are you over 18?","TertiaryAttribute":null,"Payload":{"QuestionText":"Are you over 18?","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Are you over 18?","Choices":{"5":{"Display":"Yes"},"6":{"Display":"No"}},"ChoiceOrder":["5","6"],"Validation":{"Settings":{"ForceResponse":"OFF","ForceResponseType":"ON","Type":"None"}},"Language":[],"NextChoiceId":7,"NextAnswerId":1,"QuestionText_Unsafe":"Are you over 18?","DataExportTag":"Q69","QuestionID":"QID69"}},{"SurveyID":"SV_bEnt7FrRHTpcu6G","Element":"SQ","PrimaryAttribute":"QID7","SecondaryAttribute":"Informed Consent Form for the project:\n\t\n\tDEVELOPMENT OF CAPSTONE ASSESSMENT FOR MOLECULAR AND CELL.","TertiaryAttribute":null,"Payload":{"QuestionText":"<div style=\"text-align: center;\">\n\t<span style=\"font-family:arial,helvetica,sans-serif;\"><strong>Informed Consent Form for the project:<\/strong><\/span><br \/>\n\t<br \/>\n\t<span style=\"font-family:arial,helvetica,sans-serif;\"><strong>DEVELOPMENT OF CAPSTONE ASSESSMENT FOR MOLECULAR AND CELL BIOLOGY<\/strong><\/span><\/div>\n<br \/>\n<span style=\"font-family:arial,helvetica,sans-serif;\"><strong>Please read the following consent document before proceeding with the survey below.<\/strong>&nbsp; <strong>Pressing submit at the end of this survey signals your consent.<\/strong>&nbsp; We want you to&nbsp;understand what you are being asked to do and what risks and benefits&mdash;if any&mdash;are associated with the study. &nbsp;This should help&nbsp;you decide&nbsp;whether or not you want to participate&nbsp;in the study.<br \/>\n&nbsp;<br \/>\n<strong>Contact Information:<\/strong> You are being asked to take part in a research project conducted by Jennifer Knight, Ph.D, a faculty member in the University of Colorado at Boulder&rsquo;s Department of Molecular, Cellular, and Developmental Biology, 347 UCB, Boulder, CO 80309-0347, and Brian Couch, Ph.D., Science Teaching Fellow, Department of Molecular, Cellular, and Developmental Biology, 347 UCB, Boulder, CO 80309-0347.&nbsp; Dr. Knight can be reached at 303-735-1949.&nbsp;<br \/>\n&nbsp;<br \/>\n<strong>Project Description:<\/strong> The purpose of this project is to measure student understanding of complex topics in biology through the development and administration of a molecular and cell biology concept assessment.&nbsp; This work will help determine concept areas that students find challenging and ultimately help to improve biology education.&nbsp; You will be asked a set of assessment questions as part of your normal course work.&nbsp; Faculty may choose to administer this assessment in class or online, and may attribute extra credit points to the assessment.&nbsp; To understand how these assessment questions correlate to other measures of performance, we are asking permission to have access to your exam and overall course grades as well.&nbsp; This information will be de-identified by your instructor before the research team has access to it, and thus your identity will be protected.&nbsp; The de-identified information gathered will be used strictly for scholarly purposes (e.g. to improve our understanding of how to effectively implement curricular innovations to improve student learning and attitudes in biology courses).<br \/>\n&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br \/>\n<strong>Procedures:<\/strong> Taking part in this study is completely <strong>voluntary<\/strong>.&nbsp; You do not have to participate if you don&#39;t want to.&nbsp; You may also leave the study at any time.&nbsp; If you leave the study before it is finished, there will be no penalty to you, and you will not lose any benefits to which you are otherwise entitled.&nbsp;<br \/>\n&nbsp;<br \/>\nYou will be asked to take assessment questions as part of your course.&nbsp; If such assessment questions are given as extra credit, you may turn in a blank form and still receive credit for participation.&nbsp;&nbsp;<br \/>\n&nbsp;<br \/>\n<strong>Confidentiality:<\/strong> All data from the assessment questions will be de-identified by the research team by assigning each student a randomly generated ID prior to analysis. &nbsp;This same ID will be used by your instructor and be ascribed to your course data. Other than the researchers, only regulatory agencies such as the Office of Human Research Protections and the University of Colorado at Boulder Institutional Review Board may see your individual data as part of routine audits.<br \/>\n&nbsp;<br \/>\n<strong>Risks and Discomforts: <\/strong>The potential risks of participating in this study are minimal. &nbsp;Your participation in this project is strictly voluntary. It has no impact on your grade and you have the right to withdraw at any time. Since all data is de-identified, <strong>your individual privacy will be maintained in all published and written data resulting from this study<\/strong><strong>.<\/strong><br \/>\n&nbsp;<br \/>\n<strong>Benefits:<\/strong> You may not receive any direct benefit from taking part in this study. &nbsp;However, your participation in this study may help us learn what concepts are particularly difficult for students to understand.<br \/>\n&nbsp;<br \/>\n<strong>Source of Funding:<\/strong> Funding for this study is being provided by the University of Colorado Science Education Initiative.&nbsp;<br \/>\n&nbsp;<br \/>\n<strong>Ending Your Participation:<\/strong> You have the right to withdraw your consent or stop participating at any time.&nbsp; You have the right to refuse to answer any question(s) or refuse to participate in any procedure(s) for any reason. &nbsp;Refusing to participate in this study will not result in any penalty or loss of benefits to which you are otherwise entitled.<br \/>\n&nbsp;<br \/>\n<strong>Questions:<\/strong> If you have any questions regarding your participation in this research, you should ask the investigator before signing this form. If you should have questions or concerns during or after your participation, please contact Dr. Jennifer Knight at 303-735-1949.<br \/>\n&nbsp;<br \/>\nIf you have questions regarding your rights as a participant, any concerns regarding this project, or any dissatisfaction with any aspect of this study, you may report them confidentially, if you wish, to the Institutional Review Board, 3100 Marine Street, Rm A15, 563 UCB, 303-735-3702.<br \/>\n&nbsp;<br \/>\n<strong>Authorization:<\/strong> I have read this paper about the study or it was read to me. &nbsp;I know the possible risks and benefits. &nbsp;I know that participating in this study is voluntary. &nbsp;I choose to be in this study. &nbsp;I know that I can withdraw at any time.<br \/>\n&nbsp;<br \/>\n<strong>Your agreement to participate is indicated by completing and submitting this survey.&nbsp; Your signature is not required on any document.&nbsp; Submitting this survey incomplete (with name and ID only) will allow you to receive credit without any agreement to participate in research activities.<\/strong><\/span>","DefaultChoices":false,"DataExportTag":"IC","QuestionType":"DB","Selector":"PTB","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Informed Consent Form for the project:\n\t\n\tDEVELOPMENT OF CAPSTONE ASSESSMENT FOR MOLECULAR AND CELL...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"QuestionID":"QID7"}},{"SurveyID":"SV_bEnt7FrRHTpcu6G","Element":"SQ","PrimaryAttribute":"QID70","SecondaryAttribute":"Click to write the question text","TertiaryAttribute":null,"Payload":{"QuestionText":"Click to write the question text","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Click to write the question text","Choices":{"1":{"Display":"Click to write Choice 1"},"2":{"Display":"Click to write Choice 2"},"3":{"Display":"Click to write Choice 3"}},"ChoiceOrder":["1","2","3"],"Validation":{"Settings":{"ForceResponse":"OFF","ForceResponseType":"ON","Type":"None"}},"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionText_Unsafe":"Click to write the question text","DataExportTag":"Q70","QuestionID":"QID70"}},{"SurveyID":"SV_bEnt7FrRHTpcu6G","Element":"SQ","PrimaryAttribute":"QID71","SecondaryAttribute":"Timing","TertiaryAttribute":null,"Payload":{"QuestionText":"Timing","DefaultChoices":false,"QuestionType":"Timing","Selector":"PageTimer","Configuration":{"QuestionDescriptionOption":"UseText","MinSeconds":"0","MaxSeconds":"0"},"QuestionDescription":"Timing","Choices":{"1":{"Display":"First Click"},"2":{"Display":"Last Click"},"3":{"Display":"Page Submit"},"4":{"Display":"Click Count"}},"GradingData":[],"Language":[],"NextChoiceId":16,"NextAnswerId":1,"QuestionText_Unsafe":"Timing","DataExportTag":"Q71","QuestionID":"QID71"}},{"SurveyID":"SV_bEnt7FrRHTpcu6G","Element":"SQ","PrimaryAttribute":"QID72","SecondaryAttribute":"Gender:","TertiaryAttribute":null,"Payload":{"QuestionText":"Gender:","DataExportTag":"Gender","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Gender:","Choices":{"1":{"Display":"Male"},"2":{"Display":"Female"},"3":{"Display":"Self-describe:","TextEntry":"true"},"4":{"Display":"Prefer not to disclose"}},"ChoiceOrder":["2","1","3","4"],"Validation":{"Settings":{"ForceResponse":"OFF","ForceResponseType":"ON","Type":"None"}},"Language":[],"NextChoiceId":5,"NextAnswerId":1,"QuestionID":"QID72","DataVisibility":{"Private":false,"Hidden":false}}},{"SurveyID":"SV_bEnt7FrRHTpcu6G","Element":"SQ","PrimaryAttribute":"QID73","SecondaryAttribute":"Race\/ethnicity? (select all that apply)","TertiaryAttribute":null,"Payload":{"QuestionText":"Race\/ethnicity? (select all that apply)","DataExportTag":"Race","QuestionType":"MC","Selector":"MAVR","SubSelector":"TX","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Race\/ethnicity? (select all that apply)","C
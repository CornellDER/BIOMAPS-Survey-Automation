HTpcu6G","Element":"SQ","PrimaryAttribute":"QID10","SecondaryAttribute":"Name","TertiaryAttribute":null,"Payload":{"QuestionText":"<p><font color=\"#000020\" size=\"5\">Enter your information below<\/font><\/p>","DefaultChoices":false,"DataExportTag":"ID","QuestionType":"TE","Selector":"FORM","Configuration":{"QuestionDescriptionOption":"SpecifyLabel"},"QuestionDescription":"Name","Choices":{"1":{"Display":"First Name:","TextEntry":"on","TextEntryLength":"Long"},"2":{"Display":"Last Name:","TextEntry":"on","TextEntryLength":"Long"},"3":{"Display":"Student ID:","TextEntry":"on","TextEntryLength":"Long"}},"ChoiceOrder":["1","2","3"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":null}},"GradingData":[],"Language":[],"QuestionID":"QID10","DataVisibility":{"Private":false,"Hidden":false},"NextChoiceId":4,"NextAnswerId":1,"SearchSource":{"AllowFreeResponse":"false"}}},{"SurveyID":"SV_bEnt7FrRHTpcu6G","Element":"SQ","PrimaryAttribute":"QID11","SecondaryAttribute":"Timing","TertiaryAttribute":null,"Payload":{"QuestionText":"Timing","DefaultChoices":false,"DataExportTag":"ID+","QuestionType":"Timing","Selector":"PageTimer","SubSelector":"undefined","Configuration":{"QuestionDescriptionOption":"UseText","MinSeconds":"0","MaxSeconds":"0"},"QuestionDescription":"Timing","Choices":{"1":{"Display":"First Click"},"2":{"Display":"Last Click"},"3":{"Display":"Page Submit"},"4":{"Display":"Click Count"}},"ChoiceOrder":["1","2","3"],"GradingData":[],"Language":[],"QuestionID":"QID11"}},{"SurveyID":"SV_bEnt7FrRHTpcu6G","Element":"SQ","PrimaryAttribute":"QID18","SecondaryAttribute":"Q1","TertiaryAttribute":null,"Payload":{"QuestionText":"<p>\n\t1.) Originally a marine species, stickleback fish now live in both marine and freshwater environments.&nbsp; Marine sticklebacks have pelvic spines that protect them from marine predators.&nbsp; Freshwater sticklebacks do not have pelvic spines, which reduces their likelihood of being caught by freshwater predators that can grasp onto these spines.&nbsp; The lack of spines in freshwater sticklebacks results from a heritable mutation that disrupts the function of the <em>Pitx1<\/em> gene.&nbsp; This mutation could have <u>first occurred<\/u>:<br><\/p>","DefaultChoices":false,"DataExportTag":"Q1","QuestionType":"SBS","Selector":"SBSMatrix","Configuration":{"QuestionDescriptionOption":"SpecifyLabel","ChoiceColumnWidthPixels":669,"RepeatHeaders":"none","ColumnOrder":[1,0]},"QuestionDescription":"Q1","Choices":{"1":{"Display":"in freshwater sticklebacks to intentionally avoid predation."},"2":{"Display":"in a skin cell that is part of the pelvic spine."},"3":{"Display":"prior to the establishment of a freshwater population."},"4":{"Display":"independently of the environmental change."}},"ChoiceOrder":[1,2,3,4],"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[{"ChoiceID":"3","AnswerID":"1","SeriesID":"1","Grades":{"SC1":"1"},"index":2},{"ChoiceID":"4","AnswerID":"1","SeriesID":"1","Grades":{"SC1":"1"},"index":3},{"ChoiceID":"1","AnswerID":"1","SeriesID":"2","Grades":{"SC1":"1"},"index":4},{"ChoiceID":"2","AnswerID":"1","SeriesID":"2","Grades":{"SC1":"1"},"index":5}],"Language":[],"NumberOfQuestions":1,"AdditionalQuestions":{"1":{"QuestionText":"&nbsp;","Answers":{"1":{"Display":"True"},"2":{"Display":"False"}},"RecodeValues":[],"VariableNaming":[],"AnalyzeChoices":[],"QuestionType":"Matrix","Selector":"Likert","SubSelector":"SingleAnswer","ChoiceColumnWidthPixels":null,"Configuration":{"ChoiceColumnWidthPixels":10,"QuestionDescriptionOption":"UseText"},"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[{"AnswerID":"1","ChoiceID":"3","Grades":{"SC1":"1"},"index":0},{"AnswerID":"1","ChoiceID":"4","Grades":{"SC1":"1"},"index":1},{"AnswerID":"2","ChoiceID":"1","Grades":{"SC1":"1"},"index":2},{"AnswerID":"2","ChoiceID":"2","Grades":{"SC1":"1"},"index":3}],"DataExportTag":"Q1#1","QuestionID":"QID18#1","Choices":{"1":{"Display":"in freshwater sticklebacks to intentionally avoid predation."},"2":{"Display":"in a skin cell that is part of the pelvic spine."},"3":{"Display":"prior to the establishment of a freshwater population."},"4":{"Display":"independently of the environmental change."}},"ChoiceDataExportTags":false,"QuestionDescription":" "}},"ChoiceDataExportTags":false,"QuestionID":"QID18","QuestionJS":false}},{"SurveyID":"SV_bEnt7FrRHTpcu6G","Element":"SQ","PrimaryAttribute":"QID19","SecondaryAttribute":"Timing","TertiaryAttribute":null,"Payload":{"QuestionText":"Timing","DefaultChoices":false,"DataExportTag":"T1","QuestionType":"Timing","Selector":"PageTimer","Configuration":{"QuestionDescriptionOption":"UseText","MinSeconds":"0","MaxSeconds":"0"},"QuestionDescription":"Timing","Choices":{"1":{"Display":"First Click"},"2":{"Display":"Last Click"},"3":{"Display":"Page Submit"},"4":{"Display":"Click Count"}},"ChoiceOrder":["1","2","3"],"GradingData":[],"Language":[],"QuestionID":"QID19"}},{"SurveyID":"SV_bEnt7FrRHTpcu6G","Element":"SQ","PrimaryAttribute":"QID20","SecondaryAttribute":"Q2","TertiaryAttribute":null,"Payload":{"QuestionText":"<p>2.) Bacteria can multiply in liquid media containing nutrients and energy sources.&nbsp; You place 9,000 Strain A bacteria and 1,000 Strain B bacteria into media containing glucose and lactose, and you allow this culture to grow without further additions.&nbsp; At different time points, you remove small samples and determine the <u>proportions<\/u> of Strain A and Strain B bacteria in the population, resulting in the observed growth curves shown below.&nbsp;<\/p>\n\n<p style=\"text-align: center;\">&nbsp;<\/p>\n\n<p style=\"text-align: center;\"><img src=\"https:\/\/cuboulder.qualtrics.com\/CP\/Graphic.php?IM=IM_cYjG3X3MQ8oHgvH\" style=\"width: 800px; height: 322px;\" \/><\/p>\n\n<p>&nbsp;<\/p>\n\n<p>These data could result from Strain B bacteria:<\/p>","DefaultChoices":false,"DataExportTag":"Q2","QuestionType":"SBS","Selector":"SBSMatrix","Configuration":{"QuestionDescriptionOption":"SpecifyLabel","ChoiceColumnWidthPixels":669,"RepeatHeaders":"none","ColumnOrder":[1,0]},"QuestionDescription":"Q2","Choices":{"1":{"Display":"multiplying more slowly than Strain A bacteria during the first 10 hours."},"2":{"Display":"multiplying at the same rate as Strain A bacteria where the two curves cross."},"3":{"Display":"multiplying more rapidly than Strain A bacteria as nutrients become depleted."},"4":{"Display":"utilizing lactose once the preferred glucose energy source becomes depleted."}},"ChoiceOrder":[1,2,3,4],"Validation":{"Settings":{"ForceResponse":"OFF","ForceResponseType":"ON","Type":"None"}},"GradingData":[{"ChoiceID":"3","AnswerID":"1","SeriesID":"1","Grades":{"SC1":"1"},"index":2},{"ChoiceID":"4","AnswerID":"1","SeriesID":"1","Grades":{"SC1":"1"},"index":3},{"ChoiceID":"1","AnswerID":"1","SeriesID":"2","Grades":{"SC1":"1"},"index":4},{"ChoiceID":"2","AnswerID":"1","SeriesID":"2","Grades":{"SC1":"1"},"index":3}],"Language":[],"NumberOfQuestions":1,"AdditionalQuestions":{"1":{"Answers":{"1":{"Display":"True"},"2":{"Display":"False"}},"QuestionText":"&nbsp;","RecodeValues":[],"VariableNaming":[],"AnalyzeChoices":[],"QuestionType":"Matrix","Selector":"Likert","SubSelector":"SingleAnswer","ChoiceColumnWidthPixels":null,"Configuration":{"ChoiceColumnWidthPixels":10,"QuestionDescriptionOption":"UseText"},"GradingData":[{"AnswerID":"1","ChoiceID":"3","Grades":{"SC1":"1"},"index":0},{"AnswerID":"1","ChoiceID":"4","Grades":{"SC1":"1"},"index":1},{"AnswerID":"2","ChoiceID":"1","Grades":{"SC1":"1"},"index":2},{"AnswerID":"2","ChoiceID":"2","Grades":{"SC1":"1"},"index":3}],"DataExportTag":"Q2#1","QuestionID":"QID20#1","Choices":{"1":{"Display":"multiplying more slowly than Strain A bacteria during the first 10 hours."},"2":{"Display":"multiplying at the same rate as Strain A bacteria where the two curves cross."},"3":{"Display":"multiplying more rapidly than Strain A bacteria as nutrients become depleted."},"4":{"Display":"utilizing lactose once the preferred glucose energy source becomes depleted."}},"ChoiceDataExportTags":false,"QuestionDescription":" "}},"ChoiceDataExportTags":false,"QuestionID":"QID20","QuestionJS":false,"DataVisibility":{"Private":false,"Hidden":false},"NextChoiceId":5,"NextAnswerId":2}},{"SurveyID":"SV_bEnt7FrRHTpcu6G","Element":"SQ","PrimaryAttribute":"QID21","SecondaryAttribute":"Timing","TertiaryAttribute":null,"Payload":{"QuestionText":"Timing","DefaultChoices":false,"DataExportTag":"T2","QuestionType":"Timing","Selector":"PageTimer","Configuration":{"QuestionDescriptionOption":"UseText","MinSeconds":"0","MaxSeconds":"0"},"QuestionDescription":"Timing","Choices":{"1":{"Display":"First Click"},"2":{"Display":"Last Click"},"3":{"Display":"Page Submit"},"4":{"Display":"Click Count"}},"ChoiceOrder":["1","2","3"],"GradingData":[],"Language":[],"QuestionID":"QID21"}},{"SurveyID":"SV_bEnt7FrRHTpcu6G","Element":"SQ","PrimaryAttribute":"QID23","SecondaryAttribute":"Q3","TertiaryAttribute":null,"Payload":{"QuestionText":"3.) A\npopulation of squirrels lives in the flatlands.&nbsp;\nA small portion of that population moves to an adjacent mountain range\nwhere there are no other squirrels and becomes isolated from the parent\npopulation.&nbsp; After many generations, the\nnumber and frequency of alleles that determine coat color are different between\nthe two populations.&nbsp; This could be\nbecause:","DefaultChoices":false,"DataExportTag":"Q3","QuestionType":"SBS","Selector":"SBSMatrix","Configuration":{"QuestionDescriptionOption":"SpecifyLabel","ChoiceColumnWidthPixels":669,"RepeatHeaders":"none","ColumnOrder":[1,0]},"QuestionDescription":"Q3","Choices":{"1":{"Display":"the group that moved to the mountains had different allele frequencies than the parent population."},"2":{"Display":"inbreeding among the mountain squirrels caused new alleles to occur within this population."},"3":{"Display":"mountain predators were more successful at catching squirrels with certain alleles."},"4":{"Display":"different new alleles arose in the two populations after their initial separation."}},"ChoiceOrder":[1,2,3,4],"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[{"ChoiceID":"1","AnswerID":"1","SeriesID":"1","Grades":{"SC1":"1"},"index":0},{"ChoiceID":"3","AnswerID":"1","SeriesID":"1","Grades":{"SC1":"1"},"index":2},{"ChoiceID":"4","AnswerID":"1","SeriesID":"1","Grades":{"SC1":"1"},"index":3},{"ChoiceID":"2","AnswerID":"1","SeriesID":"2","Grades":{"SC1":"1"},"index":4}],"Language":[],"NumberOfQuestions":1,"AdditionalQuestions":{"1":{"QuestionText":"&nbsp;","Answers":{"1":{"Display":"True"},"2":{"Display":"False"}},"RecodeValues":[],"VariableNaming":[],"AnalyzeChoices":[],"QuestionType":"Matrix","Selector":"Likert","SubSelector":"SingleAnswer","ChoiceColumnWidthPixels":null,"Configuration":{"ChoiceColumnWidthPixels":10,"QuestionDescriptionOption":"UseText"},"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[{"AnswerID":"1","ChoiceID":"1","Grades":{"SC1":"1"},"index":0},{"AnswerID":"1","ChoiceID":"3","Grades":{"SC1":"1"},"index":1},{"AnswerID":"1","ChoiceID":"4","Grades":{"SC1":"1"},"index":2},{"AnswerID":"2","ChoiceID":"2","Grades":{"SC1":"1"},"index":3}],"DataExportTag":"Q3#1","QuestionID":"QID23#1","Choices":{"1":{"Display":"the group that moved to the mountains had different allele frequencies than the parent population."},"2":{"Display":"inbreeding among the mountain squirrels caused new alleles to occur within this population."},"3":{"Display":"mountain predators were more successful at catching squirrels with certain alleles."},"4":{"Display":"different new alleles arose in the two populations after their initial separation."}},"ChoiceDataExportTags":false,"QuestionDescription":" "}},"ChoiceDataExportTags":false,"QuestionID":"QID23"}},{"SurveyID":"SV_bEnt7FrRHTpcu6G","Element":"SQ","PrimaryAttribute":"QID24","SecondaryAttribute":"Timing","TertiaryAttribute":null,"Payload":{"QuestionText":"Timing","DefaultChoices":false,"DataExportTag":"T3","QuestionType":"Timing","Selector":"PageTimer","Configuration":{"QuestionDescriptionOption":"UseText","MinSeconds":"0","MaxSeconds":"0"},"QuestionDescription":"Timing","Choices":{"1":{"Display":"First Click"},"2":{"Display":"Last Click"},"3":{"Display":"Page Submit"},"4":{"Display":"Click Count"}},"ChoiceOrder":["1","2","3"],"GradingData":[],"Language":[],"QuestionID":"QID24"}},{"SurveyID":"SV_bEnt7FrRHTpcu6G","Element":"SQ","PrimaryAttribute":"QID25","SecondaryAttribute":"Q4","TertiaryAttribute":null,"Payload":{"QuestionText":"<p>4.) The\n<em>NeuN<\/em> gene is normally transcribed in\nneurons, but not in liver cells.&nbsp; This\ndifference could be because:<\/p>\n\n<p><\/p>","DefaultChoices":false,"DataExportTag":"Q4","QuestionType":"SBS","Selector":"SBSMatrix","Configuration":{"QuestionDescriptionOption":"SpecifyLabel","ChoiceColumnWidthPixels":670,"RepeatHeaders":"none","ColumnOrder":[1,0]},"QuestionDescription":"Q4","Choices":{"1":{"Display":"the sequence of DNA bases within the NeuN promoter is different in neurons and liver cells."},"2":{"Display":"DNA bases within the NeuN promoter are chemically modified in liver cells, but not in neurons."},"3":{"Display":"a transcription factor that activates NeuN expression in neurons is absent in liver cells."},"4":{"Display":"a protein present in both cell types activates NeuN transcription in neurons, but not in liver cells."}},"ChoiceOrder":[1,2,3,4],"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[{"ChoiceID":"2","AnswerID":"1","SeriesID":"1","Grades":{"SC1":"1"},"index":0},{"ChoiceID":"4","AnswerID":"1","SeriesID":"1","Grades":{"SC1":"1"},"index":1},{"ChoiceID":"1","AnswerID":"1","SeriesID":"2","Grades":{"SC1":"1"},"index":2},{"ChoiceID":"3","AnswerID":"1","SeriesID":"1","Grades":{"SC1":"1"},"index":3}],"Language":[],"NumberOfQuestions":1,"AdditionalQuestions":{"1":{"QuestionText":"&nbsp;","Answers":{"1":{"Display":"True"},"2":{"Display":"False"}},"RecodeValues":[],"VariableNaming":[],"AnalyzeChoices":[],"QuestionType":"Matrix","Selector":"Likert","SubSelector":"SingleAnswer","ChoiceColumnWidthPixels":null,"Configuration":{"ChoiceColumnWidthPixels":10,"QuestionDescriptionOption":"UseText"},"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[{"AnswerID":"1","ChoiceID":"2","Grades":{"SC1":"1"},"index":0},{"AnswerID":"1","ChoiceID":"4","Grades":{"SC1":"1"},"index":1},{"AnswerID":"2","ChoiceID":"1","Grades":{"SC1":"1"},"index":2},{"AnswerID":"1","ChoiceID":"3","Grades":{"SC1":"1"},"index":3}],"DataExportTag":"Q4#1","QuestionID":"QID25#1","Choices":{"1":{"Display":"the sequence of DNA bases within the NeuN promoter is different in neurons and liver cells."},"2":{"Display":"DNA bases within the NeuN promoter are chemically modified in liver cells, but not in neurons."},"3":{"Display":"a transcription factor that activates NeuN expression in neurons is absent in liver cells."},"4":{"Display":"a protein present in both cell types activates NeuN transcription in neurons, but not in liver cells."}},"ChoiceDataExportTags":false,"QuestionDescription":" "}},"ChoiceDataExportTags":false,"QuestionID":"QID25"}},{"SurveyID":"SV_bEnt7FrRHTpcu6G","Element":"SQ","PrimaryAttribute":"QID27","SecondaryAttribute":"Q5","TertiaryAttribute":null,"Payload":{"QuestionText":"<p>5.) Tau is a microtubule-associated protein that plays a key role in the development of certain brain disorders.&nbsp; To analyze normal Tau expression, mouse brain extracts are made at different developmental stages, separated on an SDS-PAGE gel, and analyzed by Western blot with antibodies recognizing only mouse Tau protein, as shown below.<br \/>\n&nbsp;<\/p>\n\n<p style=\"text-align: center;\"><img src=\"https:\/\/cuboulder.qualtrics.com\/CP\/Graphic.php?IM=IM_eV4HqsefzdMD4DH\" style=\"width: 469px; height: 201px;\" \/><\/p>\n\n<p><em>&nbsp;<\/em><\/p>\n\n<p>The two different size protein products observed at different developmental stages could result from:<\/p>","DefaultChoices":false,"DataExportTag":"Q5","QuestionType":"SBS","Selector":"SBSMatrix","Configuration":{"QuestionDescriptionOption":"SpecifyLabel","ChoiceColumnWidthPixels":665,"RepeatHeaders":"none","ColumnOrder":[1,0]},"QuestionDescription":"Q5","Choices":{"1":{"Display":"transcription of Tau DNA in different directions."},"2":{"Display":"different RNA-binding proteins present at different stages."},"3":{"Display":"translation of Tau mRNAs of different sizes."},"4":{"Display":"different chemical modifications of Tau protein."}},"ChoiceOrder":[1,2,3,4],"Validation":{"Settings":{"ForceResponse":"OFF","ForceResponseType":"ON","Type":"None"}},"GradingData":[{"ChoiceID":"2","AnswerID":"1","SeriesID":"1","Grades":{"SC1":"1"},"index":0},{"ChoiceID":"4","AnswerID":"1","SeriesID":"1","Grades":{"SC1":"1"},"index":1},{"ChoiceID":"1","AnswerID":"1","SeriesID":"2","Grades":{"SC1":"1"},"index":2},{"ChoiceID":"3","AnswerID":"1","SeriesID":"1","Grades":{"SC1":"1"},"index":3}],"Language":[],"NumberOfQuestions":1,"AdditionalQuestions":{"1":{"Answers":{"1":{"Display":"True"},"2":{"Display":"False"}},"QuestionText":"&nbsp;","RecodeValues":[],"VariableNaming":[],"AnalyzeChoices":[],"QuestionType":"Matrix","Selector":"Likert","SubSelector":"SingleAnswer","ChoiceColumnWidthPixels":null,"Configuration":{"ChoiceColumnWidthPixels":10,"QuestionDescriptionOption":"UseText"},"GradingData":[{"AnswerID":"1","ChoiceID":"2","Grades":{"SC1":"1"},"index":0},{"AnswerID":"1","ChoiceID":"4","Grades":{"SC1":"1"},"index":1},{"AnswerID":"2","ChoiceID":"1","Grades":{"SC1":"1"},"index":2},{"AnswerID":"1","ChoiceID":"3","Grades":{"SC1":"1"},"index":3}],"DataExportTag":"Q5#1","QuestionID":"QID27#1","Choices":{"1":{"Display":"transcription of Tau DNA in different directions."},"2":{"Display":"different RNA-binding proteins present at different stages."},"3":{"Display":"translation of Tau mRNAs of different sizes."},"4":{"Display":"different chemical modifications of Tau protein."}},"ChoiceDataExportTags":false,"QuestionDescription":" "}},"ChoiceDataExportTags":false,"QuestionID":"QID27","DataVisibility":{"Private":false,"Hidden":false},"NextChoiceId":5,"NextAnswerId":2}},{"SurveyID":"SV_bEnt7FrRHTpcu6G","Element":"SQ","PrimaryAttribute":"QID30","SecondaryAttribute":"Q6","TertiaryAttribute":null,"Payload":{"QuestionText":"<p>\n\n\n\n6.) During\nthe process of normal development, a frog cell undergoes mitosis to produce two\nnon-dividing daughter cells.&nbsp; After\nmigrating to separate locations within the embryo, each cell independently\nencounters the same signaling molecule, but one cell responds while the other\ncell does not respond.&nbsp; The two cells\ncould have responded differently because: <\/p>","DefaultChoices":false,"DataExportTag":"Q6","QuestionType":"SBS","Selector":"SBSMatrix","Configuration":{"QuestionDescriptionOption":"SpecifyLabel","ChoiceColumnWidthPixels":666,"RepeatHeaders":"none","ColumnOrder":[1,0]},"QuestionDescription":"Q6","Choices":{"1":{"Display":"they have different DNA content as a result of recombination between sister chromatids."},"2":{"Display":"the dividing cell that gave rise to them had an uneven distribution of mRNAs."},"3":{"Display":"the dividing cell that gave rise to them had an uneven distribution of proteins."},"4":{"Display":"they were exposed to different signaling molecules during migration."}},"ChoiceOrder":[1,2,3,4],"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[{"ChoiceID":"2","AnswerID":"1","SeriesID":"1","Grades":{"SC1":"1"},"index":1},{"ChoiceID":"3","AnswerID":"1","SeriesID":"1","Grades":{"SC1":"1"},"index":2},{"ChoiceID":"4","AnswerID":"1","SeriesID":"1","Grades":{"SC1":"1"},"index":3},{"ChoiceID":"1","AnswerID":"1","SeriesID":"2","Grades":{"SC1":"1"},"index":4}],"Language":[],"NumberOfQuestions":1,"AdditionalQuestions":{"1":{"QuestionText":"&nbsp;","Answers":{"1":{"Display":"True"},"2":{"Display":"False"}},"RecodeValues":[],